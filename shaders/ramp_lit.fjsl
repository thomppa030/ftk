shader_type spatial;

// Diffuse lookup through a 1D gradient ramp. The X axis of the ramp
// texture maps to NdotL (0 = shadow side, 1 = lit side). Y is unused
// — make the ramp a single row, or stack multiple rows and pick one
// here. Drop a sunset-gradient PNG in to get cheap skin/foliage shading.

uniform sampler2D ramp;
uniform float warmth : hint_range(0.0, 2.0, 0.05) = 1.0;

void fragment() {
    // ALBEDO stays as the base texture; the ramp recolors the lighting.
}

void light() {
    // Sample diffuse color from the ramp by NdotL, then bias by light color.
    vec3 ramp_col = texture(ramp, vec2(NdotL, 0.5)).rgb;
    DIFFUSE_LIGHT += ALBEDO * ramp_col * warmth;

    // Cheap warm specular peak so the lit side still pops.
    vec3 H = normalize(VIEW_DIR + LIGHT_DIR);
    float spec = pow(max(dot(NORMAL, H), 0.0), 24.0);
    SPECULAR_LIGHT += vec3(spec) * 0.3;
}
