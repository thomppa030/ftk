#version 460

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "fjell_ddgi.glsl"

layout(set = 0, binding = 1) uniform sampler2D radiance_tex;
layout(rgba16f, set = 0, binding = 4) uniform image2D probe_offset_image;

layout(push_constant) uniform PushConstants {
    uint first_frame;
    float max_trace_dist;
};

void main() {
    int probe_index = int(gl_GlobalInvocationID.x);
    int total_probes = ddgi.probe_counts.x * ddgi.probe_counts.y * ddgi.probe_counts.z;
    if (probe_index >= total_probes) return;

    // Only update offsets for probes in the current batch
    if (probe_index < ddgi.probe_update_offset ||
        probe_index >= ddgi.probe_update_offset + ddgi.probe_update_count) return;

    int closest_backface_index = -1;
    float closest_backface_distance = 1e8;

    int closest_frontface_index = -1;
    float closest_frontface_distance = 1e8;

    int farthest_frontface_index = -1;
    float farthest_frontface_distance = 0.0;

    int backfaces_count = 0;

    for (int ray_index = 0; ray_index < ddgi.probe_rays; ++ray_index) {
        ivec2 ray_coord = ivec2(ray_index, probe_index - ddgi.probe_update_offset);

        float ray_distance = texelFetch(radiance_tex, ray_coord, 0).w;

        if (ray_distance <= 0.0) {
            ++backfaces_count;
            if (-ray_distance < closest_backface_distance) {
                closest_backface_distance = -ray_distance;
                closest_backface_index = ray_index;
            }
        } else {
            if (ray_distance < closest_frontface_distance) {
                closest_frontface_distance = ray_distance;
                closest_frontface_index = ray_index;
            } else if (ray_distance > farthest_frontface_distance) {
                farthest_frontface_distance = ray_distance;
                farthest_frontface_index = ray_index;
            }
        }
    }

    vec3 cell_offset_limit = ddgi.max_probe_offset * ddgi.probe_spacing;

    vec4 current_offset = vec4(0.0);
    if (first_frame == 0) {
        int pxy = ddgi.probe_counts.x * ddgi.probe_counts.y;
        ivec2 offset_coord = ivec2(probe_index % pxy, probe_index / pxy);
        current_offset.rgb = imageLoad(probe_offset_image, offset_coord).rgb;
    }

    vec3 full_offset = vec3(1e4);

    bool inside_geometry = (float(backfaces_count) / float(ddgi.probe_rays)) > 0.25;
    if (inside_geometry && closest_backface_index != -1) {
        vec3 backface_dir = closest_backface_distance *
            normalize(mat3(ddgi.random_rotation) * spherical_fibonacci(float(closest_backface_index), float(ddgi.probe_rays)));

        vec3 pos_off = (current_offset.xyz + cell_offset_limit) / backface_dir;
        vec3 neg_off = (current_offset.xyz - cell_offset_limit) / backface_dir;
        vec3 max_off = max(pos_off, neg_off);

        float scale = min(min(max_off.x, max_off.y), max_off.z) - 0.001;
        full_offset = current_offset.xyz - backface_dir * scale;
    } else if (closest_frontface_distance < 0.05) {
        vec3 farthest_dir = min(0.2, farthest_frontface_distance) *
            normalize(mat3(ddgi.random_rotation) * spherical_fibonacci(float(farthest_frontface_index), float(ddgi.probe_rays)));
        vec3 closest_dir = normalize(mat3(ddgi.random_rotation) *
            spherical_fibonacci(float(closest_frontface_index), float(ddgi.probe_rays)));

        if (dot(farthest_dir, closest_dir) < 0.5) {
            full_offset = current_offset.xyz + farthest_dir;
        }
    }

    if (all(lessThan(abs(full_offset), cell_offset_limit))) {
        current_offset.xyz = full_offset;
    }

    int pxy = ddgi.probe_counts.x * ddgi.probe_counts.y;
    imageStore(probe_offset_image, ivec2(probe_index % pxy, probe_index / pxy), current_offset);
}
