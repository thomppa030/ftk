#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;
    vec4 light_color;
    vec4 camera_position;
    vec4 ambient_color;
    mat4 cascade_vp[3];
    vec4 cascade_splits;
    uvec4 tile_info;
    mat4 inv_projection;
} ubo;

struct DrawData {
    mat4 model;
    uint material_id;
    uint meshlet_offset;
    uint meshlet_count;
    uint vertex_offset;
};

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

struct Meshlet {
    uint vertex_offset;
    uint triangle_offset;
    uint vertex_count;
    uint triangle_count;
};

struct MeshletBounds {
    vec4 bounding_sphere;
    vec4 cone_apex;
    vec4 cone_axis_cutoff;
};

layout(set = 3, binding = 0) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
};

layout(set = 3, binding = 1) readonly buffer BoundsBuffer {
    MeshletBounds bounds[];
};

layout(push_constant) uniform PushConstants {
    uint first_draw;
} push;

struct TaskPayload {
    uint draw_index;
    uint meshlet_indices[32];
};

taskPayloadSharedEXT TaskPayload payload;

void main() {
    uint draw_idx = push.first_draw + gl_DrawID;
    DrawData dd = draws[draw_idx];

    uint meshlet_count = dd.meshlet_count;
    uint meshlet_base = dd.meshlet_offset;
    uint tid = gl_LocalInvocationIndex;

    // Pass through: each thread handles one meshlet, no culling for now
    // TODO: add frustum + cone culling once basic rendering is verified
    payload.draw_index = draw_idx;

    if (tid < meshlet_count) {
        payload.meshlet_indices[tid] = meshlet_base + tid;
    }

    EmitMeshTasksEXT(min(meshlet_count, 32u), 1, 1);
}
