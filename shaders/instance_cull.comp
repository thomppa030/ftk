#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Per-instance frustum culling + compaction for the vertex render path.
// One workgroup per GpuInstancedDraw; N threads process N instances in
// chunks of WG_SIZE. Visible instances compacted via subgroupBallot +
// cross-subgroup prefix sum through shared memory. Thread 0 patches the
// matching VkDrawIndexedIndirectCommand's instanceCount in-place.

#include "fjell_global_ubo.glsl"
#include "fjell_cull.glsl"

layout(local_size_x = 64) in;

// Set 0: global UBO (view, projection — for frustum planes).
FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

// Set 1: pass-local buffers.
struct InstancedDraw {
    vec4 local_aabb_min;
    vec4 local_aabb_max;
    uint first_instance;
    uint instance_count;
    uint indirect_cmd_index;
    uint _pad;
};

layout(set = 1, binding = 0) readonly buffer InstancedDrawBuffer {
    InstancedDraw draws[];
};

layout(set = 1, binding = 1) readonly buffer InstanceTransformsBuffer {
    mat4 instance_transforms[];
};

layout(set = 1, binding = 2) writeonly buffer VisibleTransformsBuffer {
    mat4 visible_transforms[];
};

// VkDrawIndexedIndirectCommand is 5 uint32s (20 bytes, tightly packed).
// We view it as a raw uint array and patch index `i*5 + 1` (instanceCount).
layout(set = 1, binding = 3) buffer IndirectBuffer {
    uint indirect_words[];
};

// Up to 8 subgroups per 64-thread workgroup (64/8 = 8). +1 slot stores the
// per-chunk total. 16 = comfortable margin across GPU vendors.
shared uint s_subgroup_counts[16];
shared uint s_wg_offset;

void main() {
    uint draw_id = gl_WorkGroupID.x;
    InstancedDraw d = draws[draw_id];

    mat4 vp = ubo.projection * ubo.view;
    vec4 planes[6];
    for (int i = 0; i < 6; ++i) {
        planes[i] = cull_frustum_plane(vp, i);
    }

    if (gl_LocalInvocationIndex == 0) {
        s_wg_offset = 0u;
    }
    barrier();

    uint tid = gl_LocalInvocationIndex;
    uint num_subgroups = gl_NumSubgroups;
    uint subgroup_id = gl_SubgroupID;

    // Process instances in chunks of WG_SIZE (= 64)
    for (uint chunk_base = 0u; chunk_base < d.instance_count; chunk_base += gl_WorkGroupSize.x) {
        uint inst_id = chunk_base + tid;
        bool in_range = inst_id < d.instance_count;

        // Transform model-local AABB by this instance's world matrix to get a world AABB.
        // Corner-expansion using abs(M) and centre+extents is exact for an axis-aligned
        // model AABB transformed by an arbitrary affine matrix.
        bool visible = false;
        mat4 m;
        if (in_range) {
            m = instance_transforms[d.first_instance + inst_id];
            visible = cull_obb_frustum(planes, d.local_aabb_min.xyz, d.local_aabb_max.xyz, m);
        }

        // Subgroup-level compaction via ballot + exclusive bit count.
        uvec4 ballot = subgroupBallot(visible);
        uint sg_offset = subgroupBallotExclusiveBitCount(ballot);
        uint sg_count = subgroupBallotBitCount(ballot);

        // One lane per subgroup publishes its count into shared memory.
        if (subgroupElect()) {
            s_subgroup_counts[subgroup_id] = sg_count;
        }
        barrier();

        // Workgroup-wide exclusive prefix sum across subgroup counts.
        // Serial scan in thread 0 — N subgroups is tiny (≤ 8 on current HW).
        // We publish: s_subgroup_counts[s] = exclusive prefix, s_subgroup_counts[num_subgroups] = total.
        if (tid == 0u) {
            uint acc = 0u;
            for (uint s = 0u; s < num_subgroups; ++s) {
                uint c = s_subgroup_counts[s];
                s_subgroup_counts[s] = acc;
                acc += c;
            }
            s_subgroup_counts[num_subgroups] = acc;  // total for this chunk
        }
        barrier();

        uint sg_prefix = s_subgroup_counts[subgroup_id];
        uint chunk_total = s_subgroup_counts[num_subgroups];
        uint chunk_offset = s_wg_offset;

        if (visible) {
            uint out_slot = chunk_offset + sg_prefix + sg_offset;
            visible_transforms[d.first_instance + out_slot] = m;
        }

        // Thread 0 advances the running workgroup offset for the next chunk.
        if (tid == 0u) {
            s_wg_offset = chunk_offset + chunk_total;
        }
        barrier();
    }

    // Patch the indirect command's instanceCount (word index 1 of 5) with the
    // final visible count. Layout: [indexCount, instanceCount, firstIndex,
    // vertexOffset, firstInstance].
    if (gl_LocalInvocationIndex == 0) {
        indirect_words[d.indirect_cmd_index * 5u + 1u] = s_wg_offset;
    }
}
