#version 460

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) readonly buffer CounterBuffer {
    uint count;
};

layout(set = 0, binding = 1) writeonly buffer DispatchBuffer {
    uint groupCountX;
    uint groupCountY;
    uint groupCountZ;
};

layout(push_constant) uniform PushConstants {
    uint max_count; // clamp dispatch to culled buffer capacity
};

void main() {
    uint clamped = min(count, max_count);
    groupCountX = (clamped + 63) / 64;
    groupCountY = 1;
    groupCountZ = 1;
}
