#version 460

// SSR / RT reflection composite: blend reflection color into scene color
// using material properties. Source is picked at dispatch time by the
// `source` push constant — both inputs are bound; the inactive one is
// cleared to black by its trace pass.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform sampler2D ssr_texture;
layout(set = 1, binding = 1, rgba16f) uniform image2D scene_color;
layout(set = 1, binding = 2) uniform sampler2D mr_texture;
layout(set = 1, binding = 3) uniform sampler2D rt_reflection_texture;

layout(push_constant) uniform PushConstants {
    uint viewport_width;
    uint viewport_height;
    float intensity;
    uint source; // 0 = ssr, 1 = rt
};

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(viewport_width) || coord.y >= int(viewport_height)) return;

    vec4 refl = (source == 1u)
        ? texelFetch(rt_reflection_texture, coord, 0)
        : texelFetch(ssr_texture, coord, 0);
    if (refl.a <= 0.001) return;

    vec4 color = imageLoad(scene_color, coord);

    vec2 mr = texelFetch(mr_texture, coord, 0).rg;
    float metallic = mr.r;
    float roughness = mr.g;

    // Fresnel-at-grazing factor: metallic → F0 ≈ 1, dielectric → F0 ≈ 0.04.
    // SSR also attenuates by roughness (it traces a single mirror reflection
    // and relies on this term to fake glossy/blurry highlights). RT already
    // roughness-biased its hit via GGX importance sampling, so multiplying
    // again would double-dip.
    float reflection_strength = mix(0.04, 1.0, metallic);
    if (source == 0u) {
        reflection_strength *= (1.0 - roughness * roughness);
    }

    color.rgb += refl.rgb * refl.a * intensity * reflection_strength;

    imageStore(scene_color, coord, color);
}
