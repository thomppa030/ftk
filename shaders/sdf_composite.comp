#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, r16f) uniform writeonly image3D scene_sdf;
// The slot of the object nearest each voxel, NO_SDF_SLOT where none reaches.
layout(set = 0, binding = 3, r16ui) uniform writeonly uimage3D scene_sdf_index;
const uint NO_SDF_SLOT = 0xFFFFu;

layout(std430, set = 0, binding = 1) readonly buffer MeshSdfData {
    int mesh_sdf_packed[];  // int16 values packed as pairs in int32
};

layout(std430, set = 0, binding = 2) readonly buffer SdfMetadata {
    // Per-instance: mat4 world_to_sdf (64), vec3 sdf_min (12), float sdf_scale (4),
    //               vec3 sdf_max (12), uint grid_offset (4),
    //               uvec3 grid_resolution (12), uint slot (4),
    //               vec3 mesh_min (12), pad (4), vec3 mesh_max (12), pad (4),
    //               uint kind (4), pad (4), vec2 terrain_origin (8),
    //               float terrain_size (4), float terrain_height_scale (4),
    //               float terrain_height_offset (4), pad (4) = 176 bytes
    uint instance_data[];
};

const uint INSTANCE_WORDS = 44u;
const uint KIND_MESH = 0u;
const uint KIND_TERRAIN = 1u;

layout(push_constant) uniform PushConstants {
    vec3 volume_min;
    uint instance_offset;   // first instance of this region in instance_data
    vec3 volume_max;
    uint instance_count;
    ivec3 region_min;       // first voxel written by this dispatch
    uint resolution;
    ivec3 region_extent;    // voxels written along each axis
    float max_distance;     // distances clamp here; the band an instance reaches
};

// Read a single int16 value from the packed buffer
float read_sdf(uint offset) {
    uint word_idx = offset / 2u;
    uint word = uint(mesh_sdf_packed[word_idx]);
    int val;
    if ((offset & 1u) == 0u)
        val = int(word << 16) >> 16;  // lower 16 bits, sign-extended
    else
        val = int(word) >> 16;        // upper 16 bits, sign-extended
    return float(val) / 32767.0;
}

// Read instance data helpers
mat4 read_instance_mat4(uint inst, uint word_offset) {
    uint base = inst * INSTANCE_WORDS + word_offset;
    mat4 m;
    for (int c = 0; c < 4; c++) {
        for (int r = 0; r < 4; r++) {
            m[c][r] = uintBitsToFloat(instance_data[base + c * 4 + r]);
        }
    }
    return m;
}

vec3 read_instance_vec3(uint inst, uint word_offset) {
    uint base = inst * INSTANCE_WORDS + word_offset;
    return vec3(uintBitsToFloat(instance_data[base]),
                uintBitsToFloat(instance_data[base + 1u]),
                uintBitsToFloat(instance_data[base + 2u]));
}

float read_instance_float(uint inst, uint word_offset) {
    return uintBitsToFloat(instance_data[inst * INSTANCE_WORDS + word_offset]);
}

uint read_instance_uint(uint inst, uint word_offset) {
    return instance_data[inst * INSTANCE_WORDS + word_offset];
}

vec2 read_instance_vec2(uint inst, uint word_offset) {
    uint base = inst * INSTANCE_WORDS + word_offset;
    return vec2(uintBitsToFloat(instance_data[base]), uintBitsToFloat(instance_data[base + 1u]));
}

// ── Terrain ──
// A terrain's grid holds its normalized heights, one per sample, and the
// distance is derived here rather than baked: the heights change under the
// sculpt brush and a bake per stroke would be far too slow.

// World-space surface height at a point given in 0..1 across the field,
// bilinear like the mesh shader and the CPU query, clamped at the edges.
float terrain_height(uint grid_offset, uint samples, vec2 uv, float height_scale, float height_offset) {
    vec2 g = clamp(uv, vec2(0.0), vec2(1.0)) * float(samples - 1u);
    ivec2 p0 = ivec2(floor(g));
    ivec2 p1 = min(p0 + 1, ivec2(int(samples) - 1));
    vec2 f = g - vec2(p0);
    float h00 = read_sdf(grid_offset + uint(p0.y * int(samples) + p0.x));
    float h10 = read_sdf(grid_offset + uint(p0.y * int(samples) + p1.x));
    float h01 = read_sdf(grid_offset + uint(p1.y * int(samples) + p0.x));
    float h11 = read_sdf(grid_offset + uint(p1.y * int(samples) + p1.x));
    float h = mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
    return height_offset + h * height_scale;
}

// Signed distance from a point to the heightfield, approximately: the
// vertical gap scaled by the slope under the point, which is exact for a
// plane, then tightened against surface points on a ring around the point so
// a cliff face a metre to the side is not missed. Outside the field's
// footprint the distance is to the field's box, as for a mesh outside its
// grid.
float terrain_distance(vec3 world_pos, uint grid_offset, uint samples, vec2 origin, float size,
                       float height_scale, float height_offset, float max_dist) {
    vec2 local = world_pos.xz - origin;
    vec2 outside = max(max(-local, local - vec2(size)), vec2(0.0));
    float texel = size / float(samples - 1u);
    vec2 uv = local / size;

    float h = terrain_height(grid_offset, samples, uv, height_scale, height_offset);
    float gap = world_pos.y - h;
    if (dot(outside, outside) > 0.0) {
        return length(vec3(outside.x, max(gap, 0.0), outside.y));
    }

    vec2 du = vec2(texel / size, 0.0);
    vec2 dv = vec2(0.0, texel / size);
    float hx = (terrain_height(grid_offset, samples, uv + du, height_scale, height_offset) -
                terrain_height(grid_offset, samples, uv - du, height_scale, height_offset)) / (2.0 * texel);
    float hz = (terrain_height(grid_offset, samples, uv + dv, height_scale, height_offset) -
                terrain_height(grid_offset, samples, uv - dv, height_scale, height_offset)) / (2.0 * texel);
    float d = gap * inversesqrt(1.0 + hx * hx + hz * hz);

    if (gap > 0.0) {
        // Ring at the gap's own radius: ground rising at 45 degrees or more
        // within that reach shows up here.
        float r = clamp(gap, texel, max_dist);
        for (int i = 0; i < 8; ++i) {
            float a = float(i) * 0.78539816;
            vec2 p = local + vec2(cos(a), sin(a)) * r;
            float ph = terrain_height(grid_offset, samples, p / size, height_scale, height_offset);
            d = min(d, distance(world_pos, vec3(origin.x + p.x, ph, origin.y + p.y)));
        }
    }
    return d;
}

// Trilinear sample from per-mesh SDF grid
float sample_mesh_sdf(vec3 grid_coord, uint grid_offset, uvec3 grid_res) {
    // Clamp to grid bounds
    vec3 clamped = clamp(grid_coord, vec3(0.0), vec3(grid_res - uvec3(1)) - vec3(0.001));
    ivec3 p0 = ivec3(floor(clamped));
    ivec3 p1 = min(p0 + 1, ivec3(grid_res) - 1);
    vec3 frac = clamped - vec3(p0);

    // 8 corner samples
    float c000 = read_sdf(grid_offset + uint(p0.z * int(grid_res.x * grid_res.y) + p0.y * int(grid_res.x) + p0.x));
    float c100 = read_sdf(grid_offset + uint(p0.z * int(grid_res.x * grid_res.y) + p0.y * int(grid_res.x) + p1.x));
    float c010 = read_sdf(grid_offset + uint(p0.z * int(grid_res.x * grid_res.y) + p1.y * int(grid_res.x) + p0.x));
    float c110 = read_sdf(grid_offset + uint(p0.z * int(grid_res.x * grid_res.y) + p1.y * int(grid_res.x) + p1.x));
    float c001 = read_sdf(grid_offset + uint(p1.z * int(grid_res.x * grid_res.y) + p0.y * int(grid_res.x) + p0.x));
    float c101 = read_sdf(grid_offset + uint(p1.z * int(grid_res.x * grid_res.y) + p0.y * int(grid_res.x) + p1.x));
    float c011 = read_sdf(grid_offset + uint(p1.z * int(grid_res.x * grid_res.y) + p1.y * int(grid_res.x) + p0.x));
    float c111 = read_sdf(grid_offset + uint(p1.z * int(grid_res.x * grid_res.y) + p1.y * int(grid_res.x) + p1.x));

    // Trilinear interpolation
    float c00 = mix(c000, c100, frac.x);
    float c10 = mix(c010, c110, frac.x);
    float c01 = mix(c001, c101, frac.x);
    float c11 = mix(c011, c111, frac.x);
    float c0 = mix(c00, c10, frac.y);
    float c1 = mix(c01, c11, frac.y);
    return mix(c0, c1, frac.z);
}

void main() {
    ivec3 local = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(local, region_extent))) return;
    ivec3 gid = region_min + local;

    // World-space position of this voxel center
    vec3 uvw = (vec3(gid) + 0.5) / float(resolution);
    vec3 world_pos = mix(volume_min, volume_max, uvw);

    // Nothing within reach leaves the voxel at the clamp distance, and
    // naming no object
    float min_dist = max_distance;
    uint nearest = NO_SDF_SLOT;

    for (uint n = 0u; n < instance_count; n++) {
        uint i = instance_offset + n;
        uint slot = read_instance_uint(i, 27u);
        if (read_instance_uint(i, 36u) == KIND_TERRAIN) {
            uint grid_offset = read_instance_uint(i, 23u);
            uint samples = read_instance_uint(i, 24u);
            vec2 origin = read_instance_vec2(i, 38u);
            float size = read_instance_float(i, 40u);
            float height_scale = read_instance_float(i, 41u);
            float height_offset = read_instance_float(i, 42u);
            float d = terrain_distance(world_pos, grid_offset, samples, origin, size,
                                       height_scale, height_offset, max_distance);
            if (d < min_dist) {
                min_dist = d;
                nearest = slot;
            }
            continue;
        }
        mat4 world_to_sdf = read_instance_mat4(i, 0u);
        vec3 sdf_min = read_instance_vec3(i, 16u);
        float sdf_scale = read_instance_float(i, 19u);
        vec3 sdf_max = read_instance_vec3(i, 20u);
        uint grid_offset = read_instance_uint(i, 23u);
        uvec3 grid_res = uvec3(read_instance_uint(i, 24u),
                               read_instance_uint(i, 25u),
                               read_instance_uint(i, 26u));
        vec3 mesh_min = read_instance_vec3(i, 28u);
        vec3 mesh_max = read_instance_vec3(i, 32u);

        // Transform world position to object's SDF grid space
        vec3 local_pos = (world_to_sdf * vec4(world_pos, 1.0)).xyz;

        // The grid stores local-space distances. The rows of the inverse
        // model matrix have length 1/scale per axis, and the smallest axis
        // scale keeps the world-space value a lower bound when the scale is
        // not uniform.
        float inv_scale = max(max(length(vec3(world_to_sdf[0][0], world_to_sdf[1][0], world_to_sdf[2][0])),
                                  length(vec3(world_to_sdf[0][1], world_to_sdf[1][1], world_to_sdf[2][1]))),
                              length(vec3(world_to_sdf[0][2], world_to_sdf[1][2], world_to_sdf[2][2])));
        float to_world = 1.0 / max(inv_scale, 1e-6);

        vec3 sdf_uvw = (local_pos - sdf_min) / (sdf_max - sdf_min);
        float dist;
        if (any(lessThan(sdf_uvw, vec3(0.0))) || any(greaterThan(sdf_uvw, vec3(1.0)))) {
            // Outside the baked grid nothing was sampled, but the mesh lies
            // inside its bounds, so the distance to those bounds is a lower
            // bound on the distance to the surface. That keeps sphere
            // tracing through this field conservative instead of stepping
            // blindly past a grid it never entered.
            vec3 outside = max(max(mesh_min - local_pos, local_pos - mesh_max), vec3(0.0));
            dist = length(outside);
        } else {
            vec3 grid_coord = sdf_uvw * vec3(grid_res - uvec3(1));
            dist = sample_mesh_sdf(grid_coord, grid_offset, grid_res) * sdf_scale;
        }

        // Union: take minimum
        if (dist * to_world < min_dist) {
            min_dist = dist * to_world;
            nearest = slot;
        }
    }

    imageStore(scene_sdf, gid, vec4(min_dist));
    imageStore(scene_sdf_index, gid, uvec4(nearest));
}
