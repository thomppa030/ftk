#version 460

// Blends this frame's shaft march into the history.
//
// A pass of its own rather than the tail of the march, because judging history
// takes the finished march: a dispatch cannot read what its neighbours are
// still writing.

#include "fjell_global_ubo.glsl"

// How far away a sky pixel is reprojected from. Far enough that a frame of
// camera movement cannot shift it measurably — at ten kilometres a metre of
// travel is a fiftieth of a pixel — and near enough to stay well inside a
// float's precision.
#define FJELL_SHAFT_SKY_DISTANCE 10000.0

// How far a neighbour's ray may differ in length from this pixel's and still
// count as the same surface, as a share of this pixel's own, with a floor in
// metres so the share does not close to nothing right in front of the camera.
//
// Looser than the upsample's, which compares four taps within one half-res
// cell. This compares across cells, and on ground seen at a shallow angle one
// cell up the screen is already several percent further away: a tolerance that
// tight would call a flat field a row of silhouettes and filter none of it.
#define FJELL_SHAFT_NEIGHBOUR_TOLERANCE 0.1
#define FJELL_SHAFT_LENGTH_FLOOR 0.05

// How much of each frame comes from the history, where the history is good.
//
// What it buys is quiet: the march is dithered, and this is how many frames of
// it a pixel averages — about (1 + b) / (1 - b) of them, so three at a half and
// twelve at 0.85. What it costs is lag, in how long a beam takes to follow the
// light when something moves through it or the sun does. The 3x3 mean in main()
// already quietens every frame several times over before any history is mixed
// in, which is what lets this sit lower than it could on the raw march.
#define FJELL_SHAFT_HISTORY_BLEND 0.5

// How far the ray a piece of history was resolved for may differ in length
// from this frame's before the history stops counting, in the same form. The
// same surface seen a frame later has very nearly the same ray: what moves it
// is the camera closing in, a few centimetres a frame. Anything near this
// tolerance is a different surface.
#define FJELL_SHAFT_HISTORY_TOLERANCE 0.1

// How much a neighbour has to count toward the mean before it also bounds the
// history. Below this it is mostly a different surface, and letting it widen
// the range is how history from that other surface gets through.
#define FJELL_SHAFT_CLAMP_WEIGHT 0.3

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D shafts_out;
layout(set = 1, binding = 1) uniform sampler2D shafts_raw;
layout(set = 1, binding = 2) uniform sampler2D shafts_history;
layout(set = 1, binding = 3) uniform sampler2D depth_texture;
layout(set = 1, binding = 4) uniform sampler2D velocity_texture;
#include "fjell_sun_shafts.glsl"

layout(push_constant) uniform PushConstants {
    uvec2 output_size;
    uvec2 full_size;
    float max_reach;
    // Zero while there is no history worth the name: the first frame, and the
    // one after a resize.
    uint history_valid;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.output_size.x) || coord.y >= int(pc.output_size.y)) return;

    // This frame's value and the range history is held to, from one read of
    // the 3x3 around the pixel.
    //
    // The mean is the pass's spatial filter. The march dithers with
    // interleaved gradient noise, which is built so that any 3x3 block holds a
    // well-spread set of offsets, and averaging one is what that noise is for.
    //
    // The range is what rejects history that no longer describes what is here:
    // whatever this pixel showed last frame, it cannot now be far outside what
    // its neighbours on the same surface show. Taken from the unfiltered
    // neighbours, so the march's own noise is inside it and does not get valid
    // history thrown out.
    //
    // Both count a neighbour only so far as its ray ran about as long as this
    // one's. A shaft value is mostly a function of ray length, so across a
    // silhouette the 3x3 holds two populations — short rays on the figure,
    // long ones past it — and a range spanning both would pass exactly the
    // history it is there to stop, while a mean of both would smear the figure
    // into the air behind it.
    vec4 centre = texelFetch(shafts_raw, coord, 0);
    float tolerance = max(FJELL_SHAFT_LENGTH_FLOOR, centre.a * FJELL_SHAFT_NEIGHBOUR_TOLERANCE);

    vec3 sum = vec3(0.0);
    float total_weight = 0.0;
    vec3 range_min = centre.rgb;
    vec3 range_max = centre.rgb;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 tap = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(pc.output_size) - 1);
            vec4 neighbour = texelFetch(shafts_raw, tap, 0);
            float diff = (neighbour.a - centre.a) / tolerance;
            float weight = exp(-diff * diff);
            sum += neighbour.rgb * weight;
            total_weight += weight;
            if (weight > FJELL_SHAFT_CLAMP_WEIGHT) {
                range_min = min(range_min, neighbour.rgb);
                range_max = max(range_max, neighbour.rgb);
            }
        }
    }
    // The centre always weighs one, so the total cannot vanish.
    vec3 result = sum / total_weight;

    if (pc.history_valid != 0u) {
        ShaftRay ray = shaft_ray(coord, pc.output_size, pc.full_size, pc.max_reach);

        // Where this pixel was last frame.
        //
        // A ray that ends on something goes where that surface went, which the
        // velocity buffer already holds: the screen-space motion of whatever
        // is under the pixel, camera and object both. The light was collected
        // along the ray rather than at its end, so no single point is where it
        // "came from" — but the end is what the eye follows, and any point
        // nearer along the ray moves differently from it the moment the camera
        // translates. A figure the camera tracks sideways stays put on screen
        // while the air halfway to them slides past, and history taken from
        // there is the long, bright rays beside them laid over their short one.
        //
        // Read at the texel the march took its depth from, so the velocity is
        // of the surface that set the ray's length, and applied to this
        // pixel's own centre, so that nothing moving means the very same texel
        // and the history is not resampled for no reason.
        //
        // A ray that hit nothing has no surface and no velocity. Its light is
        // effectively infinitely far, and infinitely far things do not shift
        // when the camera moves, only when it turns — so it reprojects by
        // rotation alone. Carrying the ray out from the *previous* eye rather
        // than this one is what drops the translation: the direction is what
        // survives to infinity.
        vec2 prev_uv;
        bool in_front = true;
        if (ray.raw_depth >= 1.0) {
            vec3 prev_eye = -(transpose(mat3(ubo.prev_view)) * ubo.prev_view[3].xyz);
            vec4 prev_clip = ubo.prev_view_proj
                           * vec4(prev_eye + ray.dir * FJELL_SHAFT_SKY_DISTANCE, 1.0);
            in_front = prev_clip.w > 0.0;
            prev_uv = (prev_clip.xy / prev_clip.w) * 0.5 + 0.5;
        } else {
            ivec2 full = shaft_full_coord(coord, pc.output_size, pc.full_size);
            vec2 uv = (vec2(coord) + 0.5) / vec2(pc.output_size);
            prev_uv = uv - texelFetch(velocity_texture, full, 0).rg;
        }
        if (in_front) {
        if (all(greaterThanEqual(prev_uv, vec2(0.0))) &&
                all(lessThanEqual(prev_uv, vec2(1.0)))) {
                vec4 history = texture(shafts_history, prev_uv);

                // Was that history resolved for a ray like this one? Its length
                // is kept in the history's alpha, and a figure stepping onto a
                // pixel cuts the ray there from the far hillside to a few
                // metres: that alone says the history is of something else,
                // whatever its value, which is the case the clamp below cannot
                // see — a figure and the air behind it can hold much the same
                // light and still not be each other's history. It is also what
                // a camera cut looks like from here, with nothing else in the
                // renderer to announce one.
                //
                // A weight rather than a test, because the lookup is bilinear
                // and at a silhouette the length it returns is a mix of both
                // sides; that fades the history out across the edge instead of
                // switching it.
                float length_tolerance =
                    max(FJELL_SHAFT_LENGTH_FLOOR, centre.a * FJELL_SHAFT_HISTORY_TOLERANCE);
                float length_diff = (history.a - centre.a) / length_tolerance;
                float same_ray = exp(-length_diff * length_diff);

                vec3 held = clamp(history.rgb, range_min, range_max);
                result = mix(result, held, FJELL_SHAFT_HISTORY_BLEND * same_ray);
            }
        }
    }

    imageStore(shafts_out, coord, vec4(result, centre.a));
}
