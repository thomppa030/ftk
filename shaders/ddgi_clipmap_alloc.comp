#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "fjell_ddgi.glsl"

// Reassigns probe slots after the clipmap level moves.
//
// Structured after Lumen's radiance cache update (LumenRadianceCache.usf
// ClearProbeIndirectionCS, LumenRadianceCacheUpdate.usf UpdateCacheStateCS
// / AllocateUsedProbesCS), which solves the same problem: keep a probe's
// accumulated lighting when its world cell is still covered after the
// level moves, and only trace genuinely new cells.
//
// Runs as three dispatches over the cell grid, selected by `phase`:
//
//   CLEAR — every cell of the new mapping starts INVALID. A cell nothing
//           claims stays INVALID rather than holding a stale slot.
//   REUSE — each cell of the OLD mapping converts its coordinate to a
//           world position, converts that back to a coordinate under the
//           NEW origin, and if it still lands inside the level, carries
//           its slot over. Otherwise the slot goes on the free list.
//   ALLOC — cells still INVALID after REUSE are genuinely new; each takes
//           a slot off the free list and starts from scratch.
//
// The world position is what ties the two mappings together, rather than
// a cell delta computed on the CPU. That is deliberate: a delta has to be
// exactly right or every cell maps to the wrong slot at once, and it
// silently encodes an assumption (that both origins sit a whole number of
// cells apart) that nothing in the shader can check. Round-tripping
// through world space re-derives the answer from the geometry both sides
// already agree on.

layout(r32ui, set = 0, binding = 1) uniform readonly uimage3D indirection_prev;
layout(r32ui, set = 0, binding = 2) uniform uimage3D indirection_next;

layout(std430, set = 0, binding = 3) buffer SlotGrid {
    uvec4 slot_grid[];  // xyz = grid coord this slot holds, w = flags
};

layout(std430, set = 0, binding = 4) buffer ProbeStatus {
    uint probe_status[];
};

layout(std430, set = 0, binding = 5) buffer FreeList {
    uint free_count;
    uint free_slots[];
};

#define ALLOC_PHASE_CLEAR 0u
#define ALLOC_PHASE_REUSE 1u
#define ALLOC_PHASE_ALLOC 2u

#define INVALID_PROBE_INDEX 0xFFFFFFFFu

layout(push_constant) uniform PushConstants {
    vec3 prev_origin;    // this level's origin the old mapping was built for
    uint phase;
    uint full_reset;     // 1 = discard the old mapping entirely
    int level;           // which clipmap level this dispatch rebuilds
};

// Levels are packed side by side along X in the indirection texture,
// matching Lumen (ProbeCoord.x + ClipmapIndex * Resolution).
ivec3 indirection_texel(ivec3 cell) {
    return ivec3(cell.x + level * ddgi.probe_counts.x, cell.y, cell.z);
}

// Slots are a single global pool; a level's slice of it starts here.
int level_slot_base() {
    return level * ddgi.probe_counts.x * ddgi.probe_counts.y * ddgi.probe_counts.z;
}

bool covers(ivec3 cell) {
    return all(greaterThanEqual(cell, ivec3(0)))
        && all(lessThan(cell, ddgi.probe_counts));
}

int cell_to_linear(ivec3 cell) {
    return cell.x + cell.y * ddgi.probe_counts.x
         + cell.z * ddgi.probe_counts.x * ddgi.probe_counts.y;
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (!covers(cell)) return;

    if (phase == ALLOC_PHASE_CLEAR) {
        imageStore(indirection_next, indirection_texel(cell), uvec4(INVALID_PROBE_INDEX, 0, 0, 0));
        return;
    }

    if (phase == ALLOC_PHASE_REUSE) {
        // Nothing to carry over on a full reset — the free list is seeded
        // with every slot rather than being fed from the old mapping. Push
        // through the same atomic the non-reset path uses, so the slot a
        // cell contributes and the position it lands in stay consistent
        // however the invocations are ordered.
        if (full_reset != 0) {
            uint at = atomicAdd(free_count, 1u);
            free_slots[at] = uint(level_slot_base() + cell_to_linear(cell));
            return;
        }

        // `cell` is read against the PREVIOUS origin here.
        uint slot = imageLoad(indirection_prev, indirection_texel(cell)).r;
        if (slot == INVALID_PROBE_INDEX) return;

        // Where this probe actually sits in the world, then where that
        // falls in the new mapping.
        float cell_size = ddgi_level_cell_size(level);
        vec3 world_pos = prev_origin + vec3(cell) * cell_size;
        ivec3 new_cell = ivec3(floor((world_pos - ddgi_level_origin(level)) / cell_size
                                     + vec3(0.5)));

        if (covers(new_cell)) {
            // Still covered: keep the slot and everything accumulated in it.
            imageStore(indirection_next, indirection_texel(new_cell), uvec4(slot, 0, 0, 0));
            slot_grid[slot] = uvec4(uvec3(new_cell), uint(level));
        } else {
            // Fell off the edge — the slot is up for grabs.
            uint at = atomicAdd(free_count, 1u);
            free_slots[at] = slot;
        }
        return;
    }

    // ALLOC: anything still INVALID is a newly covered cell.
    if (imageLoad(indirection_next, indirection_texel(cell)).r != INVALID_PROBE_INDEX) return;

    uint remaining = atomicAdd(free_count, -1u);
    uint total = uint(ddgi_total_probes());

    // Empty list, or the counter wrapped past zero. Should not happen while
    // the freed and newly-covered sets match in size, but a cell with no
    // slot must stay INVALID rather than claim one out of range — the
    // sample side skips INVALID cells, so this degrades to "no indirect
    // here" instead of reading another probe's lighting.
    if (remaining == 0u || remaining > total) return;

    uint slot = free_slots[remaining - 1u];
    if (slot >= total) return;

    imageStore(indirection_next, indirection_texel(cell), uvec4(slot, 0, 0, 0));
    slot_grid[slot] = uvec4(uvec3(cell), uint(level));

    // Its contents belong to a different world position, so the irradiance
    // update must overwrite rather than blend into it.
    probe_status[slot] = PROBE_STATUS_UNINITIALIZED;
}
