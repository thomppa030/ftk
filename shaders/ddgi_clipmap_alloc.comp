#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "fjell_ddgi.glsl"

// Reallocates probe slots after the clipmap level shifts.
//
// One invocation per cell of the newly-positioned level. A cell whose
// world position was already covered before the shift keeps the slot it
// had, so its accumulated irradiance survives — that is the common case,
// and the reason the level snaps to its own cell grid instead of
// following the camera continuously. Only cells along the leading edge
// are newly covered; they take over slots left behind by cells that fell
// off the trailing edge, and start from scratch.
//
// Runs as two dispatches over the same cell grid, selected by the `phase`
// push constant. Both need to have seen every cell before any slot is
// handed out, so they cannot be merged into one:
//
//   FREE  — cells that dropped off the trailing edge push their slot
//           onto a free list.
//   ALLOC — cells still covered keep their slot; newly-covered cells pop
//           one off the free list.
//
// The free list is a plain stack with an atomic counter, so which cell
// gets which slot depends on invocation order. That is fine: a freed slot
// carries no information worth preserving (its contents belong to a world
// position no longer covered), so any 1:1 assignment is equivalent. The
// two sets are the same size by construction — they are the symmetric
// difference of two boxes of equal extent — so the list neither runs dry
// nor ends the pass with slots left on it.

layout(r32ui, set = 0, binding = 1) uniform readonly uimage3D indirection_prev;
layout(r32ui, set = 0, binding = 2) uniform writeonly uimage3D indirection_next;

layout(std430, set = 0, binding = 3) buffer SlotGrid {
    uvec4 slot_grid[];  // xyz = grid coord this slot holds, w = flags
};

layout(std430, set = 0, binding = 4) buffer ProbeStatus {
    uint probe_status[];
};

layout(std430, set = 0, binding = 5) buffer FreeList {
    uint free_count;
    uint free_slots[];
};

#define ALLOC_PHASE_FREE  0u
#define ALLOC_PHASE_ALLOC 1u

layout(push_constant) uniform PushConstants {
    ivec3 shift_cells;   // whole cells the origin moved, current - previous
    uint phase;
    uint full_reset;     // 1 = discard everything (first frame, or a jump
                         //     past the level extent)
};

bool covers(ivec3 cell) {
    return all(greaterThanEqual(cell, ivec3(0)))
        && all(lessThan(cell, ddgi.probe_counts));
}

// Was this cell (expressed against the CURRENT origin) already covered
// before the shift? Its coordinate against the previous origin is the
// cell plus the shift.
bool was_covered_before(ivec3 cell) {
    return covers(cell + shift_cells);
}

// Does this cell (expressed against the PREVIOUS origin) still fall
// inside the level after the shift? False means it dropped off the
// trailing edge and its slot is free.
bool still_covered_after(ivec3 prev_cell) {
    return covers(prev_cell - shift_cells);
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (!covers(cell)) return;

    int linear = cell.x + cell.y * ddgi.probe_counts.x
               + cell.z * ddgi.probe_counts.x * ddgi.probe_counts.y;

    if (full_reset != 0) {
        // No previous mapping worth keeping — hand out slots in cell
        // order and retrace the whole volume. Only the ALLOC phase does
        // anything; there is nothing to free.
        if (phase == ALLOC_PHASE_ALLOC) {
            uint slot = uint(linear);
            imageStore(indirection_next, cell, uvec4(slot, 0, 0, 0));
            slot_grid[slot] = uvec4(uvec3(cell), 0);
            probe_status[slot] = PROBE_STATUS_UNINITIALIZED;
        }
        return;
    }

    if (phase == ALLOC_PHASE_FREE) {
        // This invocation's cell is read as a coordinate against the
        // PREVIOUS origin here — the question is whether the probe that
        // used to live at this cell is still needed anywhere.
        if (!still_covered_after(cell)) {
            uint slot = imageLoad(indirection_prev, cell).r;
            uint at = atomicAdd(free_count, 1u);
            free_slots[at] = slot;
        }
        return;
    }

    if (was_covered_before(cell)) {
        // Same world cell as before the shift: keep the slot, and with it
        // the irradiance that has accumulated in it.
        uint slot = imageLoad(indirection_prev, cell + shift_cells).r;
        imageStore(indirection_next, cell, uvec4(slot, 0, 0, 0));
        slot_grid[slot] = uvec4(uvec3(cell), 0);
        return;
    }

    // Newly covered: take a slot off the free list. Its contents belong
    // to a different world position, so mark it UNINITIALIZED — the
    // update pass then overwrites it outright instead of blending new
    // radiance into the previous occupant's.
    uint remaining = atomicAdd(free_count, -1u);
    uint slot;
    if (remaining == 0u || remaining > uint(ddgi.probe_counts.x * ddgi.probe_counts.y * ddgi.probe_counts.z)) {
        // Empty list (or the counter wrapped past zero). Unreachable
        // while the freed and newly-covered sets match in size; fall back
        // to this cell's own linear index rather than reading past the
        // end of the list.
        slot = uint(linear);
    } else {
        slot = free_slots[remaining - 1u];
    }

    imageStore(indirection_next, cell, uvec4(slot, 0, 0, 0));
    slot_grid[slot] = uvec4(uvec3(cell), 0);
    probe_status[slot] = PROBE_STATUS_UNINITIALIZED;
}
