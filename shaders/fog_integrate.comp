#version 460

// Volumetric fog: front-to-back Frostbite energy-conserving integration

#include "fjell_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler3D scatter_volume;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D integrated_volume;

#include "fjell_fog_push.glsl"

float slice_to_depth(float t) {
    return pc.near_plane * pow(pc.far_plane / pc.near_plane, t);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.volume_dims.x) || coord.y >= int(pc.volume_dims.y)) return;

    vec3 accumulated_light = vec3(0.0);
    float transmittance = 1.0;

    int depth_slices = int(pc.volume_dims.z);
    float inv_depth_slices = 1.0 / float(depth_slices);

    // Carry d0 forward — d1 of slice z is d0 of slice z+1, so one slice_to_depth per iter
    float d0 = pc.near_plane;

    for (int z = 0; z < depth_slices; ++z) {
        // Sample scattering and extinction
        vec3 uvw = (vec3(coord, z) + 0.5) / vec3(pc.volume_dims.xyz);
        vec4 scatter_ext = texture(scatter_volume, uvw);

        vec3 in_scattering = scatter_ext.rgb;
        float extinction = scatter_ext.a;

        // Compute slice thickness
        float t1 = float(z + 1) * inv_depth_slices;
        float d1 = slice_to_depth(t1);
        float slice_thickness = d1 - d0;

        // Frostbite energy-conserving integration.
        //
        // The slice is integrated in two halves so the stored value is the
        // integral up to the slice's *centre*, which is where trilinear
        // filtering places the texel when the composite pass samples this
        // volume at an arbitrary depth. Storing the integral to the slice's
        // far edge instead leaves a half-slice offset, and a surface whose
        // depth sweeps across slices — terrain on a slope — then reads the
        // fog as a staircase. The error only shows where density changes
        // sharply between neighbouring slices, which is a fog volume's edge.
        float half_thickness = slice_thickness * 0.5;
        float inv_extinction = 1.0 / max(extinction, 1e-7);

        // Front half: up to the centre. This is what gets stored.
        float tr_half = exp(-extinction * half_thickness);
        vec3 half_light = in_scattering * (1.0 - tr_half) * inv_extinction;

        vec3 centre_light = accumulated_light + transmittance * half_light;
        float centre_transmittance = transmittance * tr_half;

        imageStore(integrated_volume, ivec3(coord, z),
                   vec4(centre_light, centre_transmittance));

        // Back half: carry the full slice forward for the next iteration.
        // Extinction is constant across the slice, so the second half repeats
        // the first rather than needing its own exp().
        accumulated_light = centre_light + centre_transmittance * half_light;
        transmittance = centre_transmittance * tr_half;

        d0 = d1;
    }
}
