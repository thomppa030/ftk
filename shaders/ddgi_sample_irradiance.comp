#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define FJELL_DDGI_CAGE
#define FJELL_DDGI_CAGE_IRRADIANCE_BINDING 3
#define FJELL_DDGI_CAGE_VISIBILITY_BINDING 4
#define FJELL_DDGI_CAGE_OFFSET_BINDING     5
#define FJELL_DDGI_CAGE_STATUS_BINDING     6
#include "fjell_ddgi.glsl"

layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2) uniform sampler2D normal_tex;

layout(rgba16f, set = 0, binding = 7) uniform writeonly image2D indirect_out;

layout(push_constant) uniform PushConstants {
    uint output_resolution_half;
};

vec3 world_position_from_depth(vec2 uv, float depth) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = ddgi.inv_view_proj * ndc;
    return world.xyz / world.w;
}

// ── 8-probe trilinear cage sampling ─────────────────────────────────────

// ── Diagnostic views ────────────────────────────────────────────────────
// Mirror fjell::DdgiDebugMode. These replace the pass's indirect output,
// so they are only meaningful with the lighting channel set to raw DDGI —
// the surface composite multiplies this by albedo and kD, which turns any
// diagnostic color into a shade of the surface underneath it.
#define DDGI_DEBUG_OFF            0u
#define DDGI_DEBUG_GRID_CELL      1u
#define DDGI_DEBUG_PROBE_STATUS   2u
#define DDGI_DEBUG_CAGE_WEIGHT    3u
#define DDGI_DEBUG_NO_VISIBILITY  4u
#define DDGI_DEBUG_PROBE_DISTANCE 5u
// Where each cage probe's rays could actually hit something. Probes whose
// trace reach extends past the acceleration structure's bounds see empty
// space in that direction, so they record sky where geometry exists.
#define DDGI_DEBUG_TRACE_REACH    6u
// Nearest probe's irradiance with no cage, no weights, no interpolation.
// If a pattern survives here it is in the probes' stored data; if it only
// appears once the cage runs, the cage is producing it.
#define DDGI_DEBUG_RAW_PROBE      7u
// How many of the 8 cage probes had their Chebyshev weight floored to the
// 0.05 minimum. Black = none rejected, white = all eight. Isolates the one
// non-uniform weight term that can darken a cell interior.
#define DDGI_DEBUG_CHEB_REJECT    8u

/// The cage cell each pixel lands in, hashed to a color. Artifacts that
/// align with these cells come from the cage or the probes; ones that do
/// not come from somewhere else entirely.
vec3 debug_grid_cell(ivec3 base_grid) {
    return fract(sin(vec3(dot(vec3(base_grid), vec3(12.9898, 78.233, 37.719)),
                          dot(vec3(base_grid), vec3(93.9898, 67.345, 21.123)),
                          dot(vec3(base_grid), vec3(43.3321, 12.987, 91.451))))
                 * 43758.5453);
}

// The cage itself lives in fjell_ddgi.glsl, shared with every other reader
// of the probe field. What stays here is this pass's diagnostics: they
// answer questions about the screen-space sample (which cell did this
// pixel land in, what did the weights do) and have no meaning to a
// reflection ray.
vec3 sample_irradiance(vec3 world_pos, vec3 normal, out float out_cage_weight) {
    DdgiCageSample trace = ddgi_sample_cage(world_pos, normal, ddgi.camera_position,
                                            ddgi.debug_options == DDGI_DEBUG_NO_VISIBILITY);
    out_cage_weight = trace.sum_weight;

    switch (ddgi.debug_options) {
        case DDGI_DEBUG_GRID_CELL:
            return debug_grid_cell(trace.base_grid);

        case DDGI_DEBUG_PROBE_DISTANCE: {
            // Euclidean distance to the nearest cage corner, so probes read as
            // dots rather than as the planes through them. Taking the min per
            // axis independently instead would light up every cell boundary —
            // correct, but it draws a grid of lines and is hard to compare
            // against a blob-shaped artifact.
            vec3 d = min(trace.alpha, 1.0 - trace.alpha);
            // Normalized so a probe is white and the cell centre (the furthest
            // point, at length(0.5,0.5,0.5)) is black.
            return vec3(1.0 - clamp(length(d) / 0.866, 0.0, 1.0));
        }

        case DDGI_DEBUG_TRACE_REACH: {
            // Distance from this position to the nearest face of the probe
            // grid box, normalized against one cell. Red at and outside the
            // boundary, green well inside it. A feature that lines up with the
            // red band comes from the grid's edge — either the acceleration
            // structure not covering it, or probes there having nothing to
            // trace against.
            float edge = ddgi_grid_depth(world_pos);
            if (edge < 0.0) return vec3(1.0, 0.0, 1.0);   // outside the grid
            return mix(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0),
                       clamp(edge / 2.0, 0.0, 1.0));
        }

        case DDGI_DEBUG_RAW_PROBE: {
            // Snap to the nearest probe and read it directly. Every pixel in a
            // cell shows the same value, so the result is flat-shaded per cell:
            // any variation is between probes, not within the interpolation.
            ivec3 nearest = clamp(trace.base_grid + ivec3(greaterThan(trace.alpha, vec3(0.5))),
                                  ivec3(0), ddgi.probe_counts - ivec3(1));
            int idx = ddgi_grid_to_probe_index(nearest);
            vec2 uv = get_probe_uv(normal, idx, ddgi.irr_tex_w, ddgi.irr_tex_h, ddgi.irr_side);
            return ddgi_decode_irradiance(ddgi_cage_irradiance(uv));
        }

        case DDGI_DEBUG_PROBE_STATUS: {
            // Green active, red off (buried), blue asleep.
            ivec3 nearest = clamp(trace.base_grid + ivec3(greaterThan(trace.alpha, vec3(0.5))),
                                  ivec3(0), ddgi.probe_counts - ivec3(1));
            uint st = ddgi_cage_probe_status(ddgi_grid_to_probe_index(nearest));
            if (st == PROBE_STATUS_OFF) return vec3(1.0, 0.0, 0.0);
            if (st == PROBE_STATUS_SLEEP) return vec3(0.0, 0.0, 1.0);
            return vec3(0.0, 1.0, 0.0);
        }

        case DDGI_DEBUG_CHEB_REJECT:
            // Red channel: fraction of cage probes whose Chebyshev weight hit
            // the floor. Green: fraction that were tested at all (i.e. sat
            // beyond mean_dist). A dark-dot pattern showing up in red is the
            // occlusion test rejecting probes; one showing only in green means
            // the test ran but did not reject.
            return vec3(trace.cheb_floored / 8.0, trace.cheb_tested / 8.0, 0.0);
    }

    return trace.irradiance;
}

// ── Main ────────────────────────────────────────────────────────────────

ivec2 pixel_offsets[4] = ivec2[](ivec2(0,0), ivec2(0,1), ivec2(1,0), ivec2(1,1));

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);

    int res_div = (output_resolution_half == 1) ? 2 : 1;
    vec2 out_res = ddgi.resolution / float(res_div);

    if (coords.x >= int(out_res.x) || coords.y >= int(out_res.y)) return;

    float raw_depth = 1.0;
    int chosen_sample = 0;

    if (output_resolution_half == 1) {
        // Pick the 2x2 sample whose depth is closest to the block average.
        // Choosing the farthest (or nearest) sample lands on the background
        // surface at depth discontinuities, so the reconstructed position —
        // and the probe cell it falls in — jumps across edges. That shows up
        // as angle-dependent jitter at grazing angles, where a half-res block
        // spans a wide depth range. The median-like pick stays on the
        // representative surface.
        float depths[4];
        float avg = 0.0;
        int valid = 0;
        for (int j = 0; j < 4; ++j) {
            depths[j] = texelFetch(depth_tex, coords * 2 + pixel_offsets[j], 0).r;
            if (depths[j] < 1.0) { avg += depths[j]; ++valid; }
        }
        avg = valid > 0 ? avg / float(valid) : 1.0;

        float best_diff = 1e9;
        for (int j = 0; j < 4; ++j) {
            float diff = abs(depths[j] - avg);
            if (depths[j] < 1.0 && diff < best_diff) {
                best_diff = diff;
                chosen_sample = j;
            }
        }
        raw_depth = depths[chosen_sample];
    } else {
        raw_depth = texelFetch(depth_tex, coords, 0).r;
    }


    // The sky: no surface, nothing to light.
    if (raw_depth >= 1.0) {
        imageStore(indirect_out, coords, vec4(0.0));
        return;
    }

    // Decode normal
    vec2 encoded_normal;
    if (output_resolution_half == 1) {
        encoded_normal = texelFetch(normal_tex, coords * 2 + pixel_offsets[chosen_sample], 0).rg;
    } else {
        encoded_normal = texelFetch(normal_tex, coords, 0).rg;
    }
    vec3 normal = normalize(oct_decode(encoded_normal));

    // Reconstruct world position at the centre of the pixel the depth came
    // from. At half resolution that is the chosen full-res pixel, not the
    // centre of the 2x2 block: pairing one pixel's depth with another's
    // screen position puts the point off the surface, most at grazing angles
    // where depth changes fastest across a pixel.
    ivec2 depth_pixel = (output_resolution_half == 1)
        ? coords * 2 + pixel_offsets[chosen_sample]
        : coords;
    vec2 screen_uv = (vec2(depth_pixel) + 0.5) / ddgi.resolution;
    vec3 world_pos = world_position_from_depth(screen_uv, raw_depth);

    float cage_weight = 0.0;
    vec3 irradiance = sample_irradiance(world_pos, normal, cage_weight);

    // The share of this pixel's diffuse ambient the probes give, in alpha,
    // with the irradiance scaled by it: the grid's cover, and none where no
    // probe could be read (untraced since a reset, or deep inside geometry).
    // The surface composite gives the rest to the sky's IBL.
    float coverage = cage_weight >= 1e-6 ? ddgi_grid_coverage(world_pos) : 0.0;

    if (ddgi.debug_options == DDGI_DEBUG_CAGE_WEIGHT) {
        // The cage divides by this, so darkening caused by the weights
        // collapsing shows here while darkening from the probes' own
        // irradiance does not. Log-scaled: weights are products of
        // trilinear, backface and visibility terms and span a wide range.
        irradiance = vec3(clamp(log2(1.0 + cage_weight * 8.0) / 4.0, 0.0, 1.0));
        coverage = 1.0;
    } else if (ddgi.debug_options != DDGI_DEBUG_OFF) {
        // A diagnostic view is shown whole, wherever it lands.
        coverage = 1.0;
    }

    imageStore(indirect_out, coords, vec4(irradiance * coverage, coverage));
}
