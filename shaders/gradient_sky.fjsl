shader_type sky;

// Two-colour zenith/horizon gradient that follows the day: a day profile's
// zenith_color and horizon_color tracks animate the colours, the sun warms
// the horizon around it, the moon and stars come out at night. Set on a
// WorldEnvironmentNode via the Sky Shader inspector field.
//
// The sun, the moon, the galaxy and the stars are drawn by functions in
// shaders/include/sky/, each taking its look as one struct. This file holds
// the dials and fills the structs from them; what each dial does is told on
// the struct's field.

#include "sky/painted_sun.glsl"
#include "sky/painted_moon.glsl"
#include "sky/painted_milky_way.glsl"
#include "sky/painted_stars.glsl"

uniform vec3 zenith_color : hint_color = vec3(0.349, 0.584, 0.767);
uniform vec3 horizon_color : hint_color = vec3(0.978, 0.827, 0.626);
uniform float horizon_softness : hint_range(0.05, 1.0, 0.01) = 0.35;
uniform float sun_warmth : hint_range(0.0, 2.0, 0.05) = 0.6;
uniform float sun_warmth_size : hint_range(1.0, 60.0, 0.5) = 18.0;

// ── Sun ─────────────────────────────────────────────────────────────────────
group "Sun";
uniform float sun_size : hint_range(0.1, 8.0, 0.01) = 1.8;
uniform float sun_halo_size : hint_range(0.0, 45.0, 0.1) = 8.0;
uniform float sun_halo : hint_range(0.0, 4.0, 0.05) = 1.0;
uniform float sun_halo_core : hint_range(0.1, 6.0, 0.05) = 1.5;
uniform float sun_halo_spread : hint_range(0.0, 1.0, 0.01) = 0.45;
uniform float sun_halo_stretch : hint_range(0.0, 1.0, 0.01) = 1.0;

group "Painted sun";
uniform float sun_stylize : hint_range(0.0, 1.0, 0.01) = 1.0;
uniform float sun_form_scale : hint_range(0.5, 4.0, 0.01) = 1.2;
uniform float sun_tear : hint_range(0.0, 0.5, 0.01) = 0.06;
uniform float sun_corona : hint_range(0.0, 1.5, 0.01) = 0.22;
uniform float sun_core : hint_range(0.0, 0.95, 0.01) = 0.62;
uniform float sun_hot : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform float sun_boil : hint_range(0.0, 0.5, 0.005) = 0.06;
uniform vec3 sun_rim_color : hint_color = vec3(1.00, 0.42, 0.10);
uniform vec3 sun_body_color : hint_color = vec3(1.30, 0.85, 0.35);
uniform vec3 sun_hot_color : hint_color = vec3(1.50, 1.35, 1.05);

// ── Moon ────────────────────────────────────────────────────────────────────
group "Moon";
uniform float moon_size : hint_range(0.1, 8.0, 0.01) = 0.5;
uniform float moon_halo : hint_range(0.0, 4.0, 0.05) = 0.3;
uniform float moon_halo_size : hint_range(0.0, 30.0, 0.1) = 4.0;

group "Painted moon";
uniform float moon_stylize : hint_range(0.0, 1.0, 0.01) = 1.0;
uniform float moon_form_scale : hint_range(0.3, 4.0, 0.01) = 1.0;
uniform float moon_maria : hint_range(0.0, 1.0, 0.01) = 0.75;
uniform float moon_pattern : hint_range(0.0, 50.0, 0.1) = 31.7;
uniform float moon_terminator_tear : hint_range(0.0, 0.5, 0.01) = 0.12;
uniform vec3 moon_highland_color : hint_color = vec3(1.00, 1.00, 0.96);
uniform vec3 moon_maria_color : hint_color = vec3(0.55, 0.60, 0.70);
uniform vec3 moon_night_color : hint_color = vec3(0.035, 0.045, 0.07);

// ── Galaxy ──────────────────────────────────────────────────────────────────
group "Galaxy shape";
uniform float galaxy_arm_width : hint_range(0.02, 0.6, 0.01) = 0.2;
uniform float galaxy_bulge_width : hint_range(0.05, 0.9, 0.01) = 0.42;
uniform float galaxy_centre_turn : hint_range(0.0, 360.0, 1.0) = 0.0;
uniform float galaxy_form_scale : hint_range(0.5, 8.0, 0.01) = 2.6;
uniform float galaxy_pattern : hint_range(0.0, 50.0, 0.1) = 11.0;
uniform float galaxy_dust : hint_range(0.0, 1.0, 0.01) = 0.8;

group "Galaxy light";
uniform float galaxy_brightness : hint_range(0.0, 4.0, 0.01) = 1.0;
uniform vec3 galaxy_haze_color : hint_color = vec3(0.16, 0.18, 0.25);
uniform vec3 galaxy_body_color : hint_color = vec3(0.26, 0.28, 0.35);
uniform vec3 galaxy_core_color : hint_color = vec3(0.40, 0.37, 0.34);
uniform vec3 galaxy_dust_color : hint_color = vec3(0.09, 0.10, 0.15);

// ── Stars ───────────────────────────────────────────────────────────────────
group "Stars";
uniform float stars_brightness : hint_range(0.0, 4.0, 0.01) = 1.0;
uniform float stars_hero_share : hint_range(0.0, 1.0, 0.01) = 1.0;
uniform float stars_hero_size : hint_range(0.0, 1.0, 0.01) = 0.9;
uniform float stars_glint : hint_range(0.0, 1.0, 0.01) = 1.0;
uniform float stars_saturation : hint_range(0.0, 1.0, 0.01) = 0.8;

// ── Cloud shape ─────────────────────────────────────────────────────────────
group "Cloud shape";
// How hard the silhouette is cut. Higher clears more of the sky and leaves
// the cloud that survives standing with a steeper edge.
uniform float cloud_contrast : hint_range(0.0, 1.0, 0.01) = 1.0;
// How torn the shapes are. 0 is round and billowy, 1 is filamented and wispy.
uniform float cloud_wisp : hint_range(0.0, 1.0, 0.01) = 1.0;
// How hard a cloud's outline is: how far the sky takes to become cloud. The
// silhouette itself does not move.
uniform float cloud_edge : hint_range(0.0, 1.0, 0.01) = 1.0;
// How many flat values a cloud's shading is cut into. The silhouette is only
// half of a drawn cloud: a crisp edge around a smooth grey wash is a
// photograph in a drawn outline, and it shows the moment the sheet greys.
// 0 keeps the wash.
uniform float cloud_shade_bands : hint_range(0.0, 8.0, 1.0) = 4.0;
// How hard the step between those values is. Below 1 is a contrast curve
// rather than a quantiser and barely reads; flat colour is the point.
uniform float cloud_shade_hardness : hint_range(0.0, 1.0, 0.01) = 1.0;
// How strongly the sky between the clouds hazes over. The cut keeps the half
// of the field that became cloud and throws the rest away, but that half is
// the same flow continuing below the threshold: drawn faintly, its dips are
// thin darker tendrils through the gaps, and a gap reads as air with
// something in it rather than a hole cut in a sheet. 0 leaves it clear.
uniform float cloud_haze : hint_range(0.0, 0.5, 0.01) = 0.12;
// How much thin, dark cloud shows at the edges of the bright shapes. Right at
// the threshold the field is barely cloud: too thin to catch the sun, thick
// enough to block the sky, and it comes out as small sharp scraps along the
// silhouettes. An edge effect, not a veil — a few percent of the sky.
uniform float cloud_scraps : hint_range(0.0, 1.0, 0.01) = 0.55;
// How far the shaded side of a cloud falls toward black. A mid-grey shadow
// tone cannot draw the depth between clouds: a sky wants white through slate
// through near-black, and the dark end is what makes a gap read as somewhere
// further away rather than a hole of flat colour. 0 keeps the slate.
uniform float cloud_depth : hint_range(0.0, 1.0, 0.01) = 0.75;
// How fast a cloud changes shape, as distinct from how fast the wind carries
// it. Drift alone slides the whole field rigidly and reads as a photograph
// being dragged past; this drifts the octaves against each other, so a cloud
// reorganises as it travels. 0 leaves the field rigid.
uniform float cloud_churn : hint_range(0.0, 4.0, 0.05) = 1.0;

// ── Cloud palette ───────────────────────────────────────────────────────────
group "Cloud palette";
// The four values a cloud is drawn from, deepest shadow to lit top, which the
// banded thickness steps through. A palette, not a gradient: these are the
// colours, and a mood is a set of them.
//
// Two colours mixed between can only interpolate a line, so whatever the
// darkest and lightest are, everything between is on the way from one to the
// other. Four stops can turn — cold through the shadows, warm at the top —
// which is what a painted sky does and a straight mix cannot reach.
uniform vec3 cloud_shade0 : hint_color = vec3(0.045, 0.050, 0.070);
uniform vec3 cloud_shade1 : hint_color = vec3(0.180, 0.200, 0.260);
uniform vec3 cloud_shade2 : hint_color = vec3(0.520, 0.530, 0.570);
uniform vec3 cloud_shade3 : hint_color = vec3(0.960, 0.960, 0.950);
// How far the palette is used. 0 falls back to the two-tone blend, which is a
// line between the darkest and lightest stops.
uniform float cloud_palette : hint_range(0.0, 1.0, 0.01) = 1.0;

// ── Cloud scale ─────────────────────────────────────────────────────────────
group "Cloud scale";
// How big one cloud is and how high the sheet sits. These only mean anything
// together: straight up you are as close to the sheet as you ever get, so a
// cloud there is `2*atan(size / 2 / height)` wide, and that is the widest it
// can look. Too large a ratio and one cloud fills the screen overhead.
// Real cumulus run 500-1000 m across with their base at 1000-2000 m.
uniform float cloud_size : hint_range(100.0, 4000.0, 10.0) = 600.0;
uniform float cloud_height : hint_range(300.0, 8000.0, 50.0) = 2200.0;

PaintedSun sun_look() {
    PaintedSun look;
    look.size = sun_size;
    look.halo_size = sun_halo_size;
    look.halo = sun_halo;
    look.halo_core = sun_halo_core;
    look.halo_spread = sun_halo_spread;
    look.halo_stretch = sun_halo_stretch;
    look.stylize = sun_stylize;
    look.form_scale = sun_form_scale;
    look.tear = sun_tear;
    look.corona = sun_corona;
    look.core = sun_core;
    look.hot = sun_hot;
    look.boil = sun_boil;
    look.rim_color = sun_rim_color;
    look.body_color = sun_body_color;
    look.hot_color = sun_hot_color;
    return look;
}

PaintedMoon moon_look() {
    PaintedMoon look;
    look.size = moon_size;
    look.halo = moon_halo;
    look.halo_size = moon_halo_size;
    look.stylize = moon_stylize;
    look.form_scale = moon_form_scale;
    look.maria = moon_maria;
    look.pattern = moon_pattern;
    look.terminator_tear = moon_terminator_tear;
    look.highland_color = moon_highland_color;
    look.maria_color = moon_maria_color;
    look.night_color = moon_night_color;
    return look;
}

PaintedMilkyWay galaxy_look() {
    PaintedMilkyWay look;
    look.arm_width = galaxy_arm_width;
    look.bulge_width = galaxy_bulge_width;
    look.centre_turn = galaxy_centre_turn;
    look.form_scale = galaxy_form_scale;
    look.pattern = galaxy_pattern;
    look.dust = galaxy_dust;
    look.brightness = galaxy_brightness;
    look.haze_color = galaxy_haze_color;
    look.body_color = galaxy_body_color;
    look.core_color = galaxy_core_color;
    look.dust_color = galaxy_dust_color;
    return look;
}

PaintedStars stars_look() {
    PaintedStars look;
    look.brightness = stars_brightness;
    look.hero_share = stars_hero_share;
    look.hero_size = stars_hero_size;
    look.glint = stars_glint;
    look.saturation = stars_saturation;
    return look;
}

void sky() {
    // Vertical blend driven by view-up dot. Power shapes the horizon band.
    float t = clamp(VIEW_DIR.y * 0.5 + 0.5, 0.0, 1.0);
    t = pow(t, horizon_softness);
    SKY = mix(horizon_color, zenith_color, t) * SKY_TINT;

    // The sky warms around the sun while it is near the horizon. Measured
    // as the true angle to the sun, not the compass bearing: on the bearing
    // alone the warmth is a column running up the whole sky, and it has to
    // be spread over most of the horizon before it looks centred on
    // anything. `sun_warmth_size` is the half-bright angle in degrees.
    float low_sun = 1.0 - smoothstep(0.0, 0.35, SUN_ELEVATION);
    float to_sun = degrees(acos(clamp(dot(VIEW_DIR, SUN_DIR), -1.0, 1.0)));
    float toward = exp2(-to_sun * to_sun / max(sun_warmth_size * sun_warmth_size, 1e-3));
    SKY += SUN_COLOR * 0.15 * sun_warmth * low_sun * toward;

    // How much of a body here is above the horizon: the bodies sink past it
    // rather than blinking out.
    float horizon_fade = fjell_horizon_fade(VIEW_DIR, CAMERA_POS.y, FJELL_BODY_HORIZON_SOFTNESS);

    // The galaxy before the stars, which crowd into its band.
    float band;
    vec3 galaxy = painted_milky_way(galaxy_look(), VIEW_DIR, STARS, CELESTIAL_AXIS, CELESTIAL_ANGLE,
                                    horizon_fade, band);
    vec3 stars = painted_stars(stars_look(), VIEW_DIR, STARS, CELESTIAL_AXIS, CELESTIAL_ANGLE, band,
                               horizon_fade);
    SKY += stars + galaxy;
    SKY += painted_moon(moon_look(), VIEW_DIR, MOON_DIR, SUN_DIR, MOON_COLOR, horizon_fade);
    // The disc only, and not into the lighting cubemap: the directional light
    // already carries the sun, and adding the disc there counts it twice.
    if (!SKY_FOR_LIGHTING) {
        SKY += painted_sun(sun_look(), VIEW_DIR, SUN_DIR, SUN_COLOR, TIME,
                           fjell_air_mass_gain(VIEW_DIR, 0.25), horizon_fade);
    }

    // The weather's clouds over everything, arriving from the front, lit
    // from inside when lightning strikes.
    fjell_cloud_contrast = cloud_contrast;
    fjell_cloud_wisp = cloud_wisp;
    fjell_cloud_edge = cloud_edge;
    fjell_cloud_shade_bands = cloud_shade_bands;
    fjell_cloud_shade_hardness = cloud_shade_hardness;
    fjell_cloud_haze = cloud_haze;
    fjell_cloud_scraps = cloud_scraps;
    fjell_cloud_depth = cloud_depth;
    fjell_cloud_churn = cloud_churn;
    fjell_cloud_time = TIME;
    fjell_cloud_shade0 = cloud_shade0;
    fjell_cloud_shade1 = cloud_shade1;
    fjell_cloud_shade2 = cloud_shade2;
    fjell_cloud_shade3 = cloud_shade3;
    fjell_cloud_palette = cloud_palette;
    fjell_cloud_size = cloud_size;
    fjell_cloud_height = cloud_height;
    vec4 cloud = cloud_layer(CAMERA_POS, VIEW_DIR, CLOUD_COVERAGE, CLOUD_DENSITY,
                             WIND_DRIFT, FRONT_DIR, FRONT_EDGE, FRONT_SOFTNESS,
                             SUN_DIR, SUN_COLOR, MOON_COLOR, AMBIENT_LIGHT);
    SKY = mix(SKY, cloud.rgb, cloud.a);
    SKY += cloud.rgb * cloud.a * LIGHTNING * 3.0;
}
