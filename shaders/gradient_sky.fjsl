shader_type sky;

// Two-colour zenith/horizon gradient that follows the day: a day profile's
// zenith_color and horizon_color tracks animate the colours, the sun warms
// the horizon around it, the moon and stars come out at night. Set on a
// WorldEnvironmentNode via the Sky Shader inspector field.

uniform vec3 zenith_color : hint_color = vec3(0.349, 0.584, 0.767);
uniform vec3 horizon_color : hint_color = vec3(0.978, 0.827, 0.626);
uniform float horizon_softness : hint_range(0.05, 1.0, 0.01) = 0.35;
uniform float sun_size : hint_range(0.99, 0.99995, 0.0001) = 0.9995;
uniform float sun_halo : hint_range(0.0, 4.0, 0.05) = 1.0;
uniform float sun_warmth : hint_range(0.0, 2.0, 0.05) = 0.6;
uniform float moon_size : hint_range(0.99, 0.99995, 0.0001) = 0.9994;

void sky() {
    // Vertical blend driven by view-up dot. Power shapes the horizon band.
    float t = clamp(VIEW_DIR.y * 0.5 + 0.5, 0.0, 1.0);
    t = pow(t, horizon_softness);
    SKY = mix(horizon_color, zenith_color, t) * SKY_TINT;

    // The horizon warms toward the sun while it is near it.
    float low_sun = 1.0 - smoothstep(0.0, 0.35, SUN_ELEVATION);
    float toward = pow(max(dot(normalize(vec3(VIEW_DIR.x, 0.0, VIEW_DIR.z)),
                            normalize(vec3(SUN_DIR.x, 0.0, SUN_DIR.z))), 0.0), 3.0);
    SKY += SUN_COLOR * 0.15 * sun_warmth * low_sun * toward * (1.0 - t);

    SKY += star_field(VIEW_DIR, STARS, CELESTIAL_AXIS, CELESTIAL_ANGLE);
    SKY += moon_disc(VIEW_DIR, MOON_DIR, SUN_DIR, MOON_COLOR, moon_size);
    if (!SKY_FOR_LIGHTING) {
        SKY += sun_disc(VIEW_DIR, SUN_DIR, SUN_COLOR, sun_size, sun_halo);
    }

    // The weather's clouds over everything, arriving from the front, lit
    // from inside when lightning strikes.
    vec4 cloud = cloud_layer(CAMERA_POS, VIEW_DIR, CLOUD_COVERAGE, CLOUD_DENSITY,
                             WIND_DRIFT, FRONT_DIR, FRONT_EDGE, FRONT_SOFTNESS,
                             SUN_DIR, SUN_COLOR, MOON_COLOR, AMBIENT_LIGHT);
    SKY = mix(SKY, cloud.rgb, cloud.a);
    SKY += cloud.rgb * cloud.a * LIGHTNING * 3.0;
}
