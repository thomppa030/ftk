#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D current_color;
layout(set = 0, binding = 1) uniform sampler2D history_color;
layout(set = 0, binding = 2) uniform sampler2D velocity_tex;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D resolve_output;
layout(set = 0, binding = 4) uniform sampler2D depth_tex;

layout(push_constant) uniform TaaPush {
    vec2 texel_size;
    float blend_factor;
    float pad;
};

#include "fjell_luma_weight.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(current_color, 0);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) * texel_size;

    // Pick velocity from the closest-depth pixel in the 3×3 neighborhood,
    // not from the center. Around a moving silhouette the center pixel is
    // often the background while the closest depth belongs to the foreground;
    // reprojecting with the foreground velocity gives the right history.
    // Otherwise the silhouette edge ghosts as TAA pulls in stale background.
    vec2 closest_uv = uv;
    float closest_depth = texture(depth_tex, uv).r;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            vec2 tap_uv = uv + vec2(dx, dy) * texel_size;
            float tap_depth = texture(depth_tex, tap_uv).r;
            if (tap_depth < closest_depth) {
                closest_depth = tap_depth;
                closest_uv = tap_uv;
            }
        }
    }
    vec2 velocity = texture(velocity_tex, closest_uv).rg;
    vec2 history_uv = uv - velocity;

    // Current frame color, weighted for stable clamping
    vec3 current_hdr = texture(current_color, uv).rgb;
    vec3 current = luma_weight(current_hdr);

    // Neighborhood min/max for variance clipping
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 sample_uv = uv + vec2(dx, dy) * texel_size;
            vec3 s = luma_weight(texture(current_color, sample_uv).rgb);
            m1 += s;
            m2 += s * s;
        }
    }

    // Variance clipping AABB
    m1 /= 9.0;
    m2 /= 9.0;
    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0.0)));
    vec3 aabb_min = m1 - 1.25 * sigma;
    vec3 aabb_max = m1 + 1.25 * sigma;

    // Sample and clamp history
    vec3 history_hdr = texture(history_color, history_uv).rgb;
    vec3 history = luma_weight(history_hdr);
    history = clamp(history, aabb_min, aabb_max);

    // Reject history if reprojected UV is off-screen
    bool oob = history_uv.x < 0.0 || history_uv.x > 1.0 ||
               history_uv.y < 0.0 || history_uv.y > 1.0;

    // Trust the current frame more as reprojected velocity grows: a moving
    // surface's history sample is only as accurate as the velocity that
    // located it, and that error scales with how far the sample traveled —
    // a fixed low blend_factor (tuned for a static scene's noise reduction)
    // accumulates that error across many frames and reads as persistent
    // softness under any motion, even though each individual frame's
    // reprojection is only slightly off. Ramp linearly over one texel of
    // motion up to full speed; motion at or above that is already fast
    // enough that leaning on history buys nothing but blur.
    float speed = length(velocity) / length(texel_size);
    float motion_alpha = mix(blend_factor, 1.0, clamp(speed, 0.0, 1.0));
    float alpha = oob ? 1.0 : motion_alpha;

    // Blend in the weighted space, convert back to HDR
    vec3 resolved = mix(history, current, alpha);
    resolved = luma_unweight(resolved);

    imageStore(resolve_output, pixel, vec4(resolved, 1.0));
}
