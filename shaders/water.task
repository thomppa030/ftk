#version 460
#extension GL_EXT_mesh_shader : require

#include "fjell_water_clipmap.glsl"

// One task invocation per water patch.
//
// Bounded water lays its patches over a square grid; infinite water walks the
// clipmap's levels, which is where the level and patch coordinate stop being
// the same arithmetic. Both hand the mesh stage a patch origin and a cell
// size, so the mesh stage does not know which mode it is in.

layout(local_size_x = 1) in;

// Mirrors WaterPushConstants in water_pass.hpp and the block in water.mesh
// and the water FJSL template. Every stage declares the same block.
layout(push_constant) uniform PushConstants {
    vec2  world_origin;      // water min corner, world XZ (bounded only)
    float world_size;        // extent in metres, square (bounded only)
    float surface_height;    // world Y of the surface at rest
    uint  patches_per_side;  // bounded only
    uint  patch_quads;
    uint  water_material_id;
    float delta_time;
    // Where the sea travels. Unused by this stage; present so the push block
    // matches WaterPushConstants and the fragment stage, which does read it.
    vec2  wave_direction;
    // Nonzero when the surface is the camera-following clipmap rather than a
    // placed square.
    uint  infinite;
    uint  _pad;
} push;

// Set 2 is the water's own. Binding 1 is the clipmap's level table, read by
// this stage and the mesh stage; infinite water alone uses it.
layout(set = 2, binding = 1) uniform WaterClipmapBuffer {
    FjellWaterClipmap clipmap;
} clip;

struct TaskPayload {
    // World XZ of this patch's minimum corner, and the metres between its
    // vertices. Resolving them here means the mesh stage generates a patch
    // the same way in either mode.
    vec2  patch_origin;
    float cell_size;
    // Which level this patch belongs to, and the level's own extent, for the
    // geomorph that lands with the level transitions.
    uint  level;
};

taskPayloadSharedEXT TaskPayload payload;

void main() {
    uint patch_index = gl_WorkGroupID.x;

    if (push.infinite != 0u) {
        FjellWaterPatch addr = fjell_water_patch(clip.clipmap, patch_index);
        FjellWaterClipmapLevel level = clip.clipmap.levels[addr.level];
        float span = level.cell_size * float(push.patch_quads);
        payload.patch_origin = level.origin + vec2(addr.coord) * span;
        payload.cell_size = level.cell_size;
        payload.level = addr.level;
    } else {
        uint patch_x = patch_index % push.patches_per_side;
        uint patch_z = patch_index / push.patches_per_side;
        // The bounded surface divides its extent into patches, so a patch's
        // cell is whatever that comes to rather than a power of two.
        float span = push.world_size / float(push.patches_per_side);
        payload.patch_origin = push.world_origin + vec2(patch_x, patch_z) * span;
        payload.cell_size = span / float(push.patch_quads);
        payload.level = 0u;
    }

    EmitMeshTasksEXT(1, 1, 1);
}
