#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "fjell_global_ubo.glsl"

layout(local_size_x = 32) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

#include "fjell_draw_data.glsl"
#include "fjell_meshlet.glsl"

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

layout(set = 3, binding = 0) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
};

layout(set = 3, binding = 1) readonly buffer BoundsBuffer {
    MeshletBounds bounds[];
};

layout(push_constant) uniform PushConstants {
    uint first_draw;
} push;

struct TaskPayload {
    uint draw_index;
    uint instance_index;   // CPU-driven path doesn't instance — always 0
    uint meshlet_indices[32];
};

taskPayloadSharedEXT TaskPayload payload;

void main() {
    uint draw_idx = push.first_draw + gl_DrawID;
    DrawData dd = draws[draw_idx];

    uint meshlet_count = dd.meshlet_count;
    uint meshlet_base = dd.meshlet_offset;
    uint tid = gl_LocalInvocationIndex;
    uint batch = gl_WorkGroupID.x;
    uint batch_start = batch * 32;

    uint batch_count = min(meshlet_count - batch_start, 32u);

    payload.draw_index = draw_idx;
    payload.instance_index = 0u;

    if (tid < batch_count) {
        payload.meshlet_indices[tid] = meshlet_base + batch_start + tid;
    }

    EmitMeshTasksEXT(batch_count, 1, 1);
}
