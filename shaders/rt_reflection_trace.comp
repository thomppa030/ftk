#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

// ── Ray-traced reflections: trace ─────────────────────────────────────
// Per pixel: read depth + normal + MR, importance-sample the GGX lobe sized
// to roughness, and trace one ray. A hit returns the radiance at the hit
// point: direct sun (N·L, no shadow ray), DDGI indirect and emission. A miss
// returns the sky. Output goes to the raw image, which the denoise
// accumulates and the SSR composite applies Fresnel/roughness to.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ── DDGI (binding 0 UBO) and its cage for hit-point indirect ───────────
// The same cage the screen-space pass reads, so a reflection is lit by the
// probe field the way the surface beside it is.

#define FJELL_DDGI_CAGE
#define FJELL_DDGI_CAGE_IRRADIANCE_BINDING 10
#define FJELL_DDGI_CAGE_VISIBILITY_BINDING 11
#define FJELL_DDGI_CAGE_OFFSET_BINDING     12
#define FJELL_DDGI_CAGE_STATUS_BINDING     13
#include "fjell_ddgi.glsl"

#include "fjell_common.glsl"

layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 2) uniform sampler2D depth_tex;
layout(set = 0, binding = 3) uniform sampler2D normal_tex;
layout(set = 0, binding = 4) uniform sampler2D mr_tex;
layout(set = 0, binding = 5) uniform samplerCube sky_cubemap;
layout(rgba16f, set = 0, binding = 6) uniform writeonly image2D reflection_out;

// Sun light for the hit's direct term.
layout(std140, set = 0, binding = 14) uniform ReflectionConstants {
    vec4 sun_dir_intensity;  // xyz = toward-light dir, w = intensity
    vec4 sun_color;          // xyz = color
} rc;

layout(push_constant) uniform PushConstants {
    uint frame_index;
    float max_trace_dist;
    float intensity;
    float trace_cell_size;   // metres between traced-geometry vertices
};

// ── Material access (set 1 = bindless) ─────────────────────────────────

#include "fjell_gpu_types.glsl"

layout(set = 1, binding = 0) uniform sampler2D textures[];
layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

// ── Traced geometry (set 0, bindings 7-9) ──────────────────────────────

#define FJELL_RT_VERTEX_BINDING   7
#define FJELL_RT_INDEX_BINDING    8
#define FJELL_RT_INSTANCE_BINDING 9
#include "fjell_rt_hit.glsl"

// Where a dielectric stops being worth a reflection ray, and where it starts
// being worth less. Past the cutoff no ray is traced; between the two the
// result is ramped down to meet it, so the surface does not carry a visible
// line at the point where tracing stops.
//
// The band sits ABOVE where wet ground lands. A water film pins roughness to
// WET_ROUGHNESS (0.35, fjell_weather_surface.glsl), so a fade beginning there
// would start attenuating the very surfaces this is for, and specular AA —
// which widens roughness with the pixel's world footprint — would then walk
// wet ground down the ramp as the camera pulls back. The reflection would
// fade out with distance for reasons the surface knows nothing about.
const float RT_ROUGHNESS_CUTOFF = 0.65;
const float RT_ROUGHNESS_FADE_START = 0.5;

// How far a ray starts from the surface that spawned it.
//
// The shaded surface and the traced surface are not the same surface. Terrain
// is rasterized from the full-resolution height texture but ray-traced against
// a decimated mesh (TerrainAsset::build_ray_mesh, RAY_MESH_STEP), and between
// two of the coarse mesh's vertices the two disagree by roughly half the
// height the real ground covers over one coarse cell. On flat ground that is
// nothing; on a slope it is centimetres to metres, and it is entirely one-
// sided — the coarse mesh cuts corners, so it sits above the true surface on
// every convex slope.
//
// A ray launched from the rasterized position therefore starts *inside* the
// traced terrain wherever the ground is not flat. It hits it immediately, at
// almost zero distance, and comes back with the ground's own dark radiance
// where it should have come back with the sky. That reads as dark patches
// following the slopes, which is exactly where the two surfaces differ.
//
// The offset scales with how far the two can drift: the coarse cell size and
// the surface's tilt away from the ray. A constant would have to be the worst
// case everywhere, which on flat ground floats every reflection off its own
// surface and loses contact shadowing.
const float RT_RAY_BIAS_MIN = 0.05;
const float RT_RAY_BIAS_SLOPE_SCALE = 0.75;

// ── Hash + Halton ──────────────────────────────────────────────────────

uint hash_pixel(uvec2 p, uint frame) {
    uint x = p.x * 1973u + p.y * 9277u + frame * 26699u;
    x ^= x >> 16u;
    x *= 0x45d9f3bu;
    x ^= x >> 16u;
    x *= 0x45d9f3bu;
    x ^= x >> 16u;
    return x;
}

float halton(uint index, uint base) {
    float f = 1.0;
    float r = 0.0;
    uint i = index;
    while (i > 0u) {
        f /= float(base);
        r += f * float(i % base);
        i /= base;
    }
    return r;
}

// ── GGX-D importance sampling ─────────────────────────────────────────
// Returns a microfacet half-vector in tangent space. roughness is α
// (linear roughness from the material), not perceptual.

vec3 sample_ggx_half(vec2 xi, float alpha) {
    float a2 = alpha * alpha;
    float cos_theta = sqrt((1.0 - xi.x) / (1.0 + (a2 - 1.0) * xi.x));
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * PI * xi.y;
    return vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
}

mat3 build_tbn(vec3 N) {
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    return mat3(T, B, N);
}

vec3 world_from_depth(vec2 uv, float depth) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = ddgi.inv_view_proj * ndc;
    return world.xyz / world.w;
}

// ── The trace ──────────────────────────────────────────────────────────

// The radiance a reflection ray brings back.
vec3 trace_radiance(vec3 origin, vec3 direction) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF,
                          origin, 0.001, direction, max_trace_dist);
    // Every instance is opaque, so there is no candidate to judge.
    while (rayQueryProceedEXT(q)) {}

    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return textureLod(sky_cubemap, normalize(direction), 0.0).rgb;
    }

    RtHit hit = rt_committed_hit(q);
    RtSurface surface;
    if (!rt_resolve_hit(hit, surface)) {
        return vec3(0.0);
    }

    vec3 N = rt_surface_normal(surface);
    vec3 world_pos = origin + direction * hit.t;
    vec2 uv = rt_surface_uv(surface);
    vec3 albedo = rt_surface_albedo(surface, uv);

    // Sun direct. No shadow ray: the sun lights through walls in
    // reflections, the accepted trade for cost.
    vec3 sun_dir = normalize(rc.sun_dir_intensity.xyz);
    float NdotL = max(dot(N, sun_dir), 0.0);
    vec3 sun_radiance = albedo * rc.sun_color.rgb * rc.sun_dir_intensity.w * NdotL;

    // DDGI indirect at the hit point.
    DdgiCageTrace cage;
    vec3 indirect = ddgi_sample_cage(world_pos, N, false, cage) * albedo;

    return sun_radiance + indirect + rt_surface_emission(surface, uv);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(reflection_out);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    float depth = textureLod(depth_tex, uv, 0).r;
    if (depth >= 1.0) {
        imageStore(reflection_out, pixel, vec4(0.0));
        return;
    }

    vec3 world_pos = world_from_depth(uv, depth);
    vec2 normal_enc = textureLod(normal_tex, uv, 0).rg;
    vec3 N = oct_decode(normal_enc);

    // mr_tex: r = metallic, g = roughness (perceptual)
    vec2 mr = textureLod(mr_tex, uv, 0).rg;
    float metallic = mr.r;
    float perceptual_roughness = mr.g;
    float alpha = perceptual_roughness * perceptual_roughness;

    // Rough dielectrics reflect too little to be worth a ray, so they are not
    // traced. The cutoff is a fade rather than a step: a dielectric's
    // reflection is already weak near it, but it is not zero, and dropping it
    // to nothing in one texel draws the boundary on the surface. Terrain is
    // where this shows — its roughness comes from blended layers, slope and
    // specular AA, so it drifts smoothly across the cutoff and the untraced
    // side reads as dark patches against ground the reflection has lifted.
    //
    // The ray is still skipped past the cutoff, so nothing is spent on
    // surfaces that would contribute nothing; only the last stretch before it
    // is ramped, and a metal is never faded.
    float rough_fade = 1.0;
    if (metallic < 0.1) {
        rough_fade = 1.0 - smoothstep(RT_ROUGHNESS_FADE_START, RT_ROUGHNESS_CUTOFF,
                                      perceptual_roughness);
        if (rough_fade <= 0.0) {
            imageStore(reflection_out, pixel, vec4(0.0));
            return;
        }
    }

    vec3 view_dir = normalize(ddgi.camera_position - world_pos);

    // Build sampling frame around N, sample GGX half vector, reflect
    // view dir around it.
    mat3 tbn = build_tbn(N);
    uint h = hash_pixel(uvec2(pixel), frame_index);
    vec2 xi = vec2(halton((h & 0xFFFFu) + 1u, 2u),
                   halton(((h >> 16) & 0xFFFFu) + 1u, 3u));

    vec3 H_local = sample_ggx_half(xi, alpha);
    vec3 H = normalize(tbn * H_local);
    vec3 ray_dir = reflect(-view_dir, H);

    // If the perturbed ray goes below the surface horizon, fall back to
    // the mirror reflect — better than wasting the trace.
    if (dot(ray_dir, N) < 0.0) {
        ray_dir = reflect(-view_dir, N);
    }

    // Start the ray clear of the surface it will trace against, which is not
    // the surface it was shaded from (see RT_RAY_BIAS_MIN). How far the two
    // can differ over one coarse cell is that cell's length times how steeply
    // the ground runs across it, so the bias follows the tilt: nothing on flat
    // ground, most where the slope is steepest. `ray_dir` is used rather than
    // the normal because a ray leaving along the surface travels furthest
    // through the gap between the two representations.
    float grazing = 1.0 - abs(dot(ray_dir, N));
    float bias = max(RT_RAY_BIAS_MIN,
                     trace_cell_size * RT_RAY_BIAS_SLOPE_SCALE * grazing);
    vec3 ray_origin = world_pos + N * bias;

    vec3 radiance = max(trace_radiance(ray_origin, ray_dir), vec3(0.0));
    // Cap fireflies — secondary rays can land on tiny bright emissives
    // and explode the variance.
    radiance = min(radiance, vec3(50.0));
    radiance *= intensity * rough_fade;

    imageStore(reflection_out, pixel, vec4(radiance, 1.0));
}
