#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "fjell_ddgi.glsl"

// Blends each probe's irradiance with its six face-adjacent neighbours.
//
// Ported from Lumen's FilterProbeRadianceWithGatherCS
// (LumenRadianceCache.usf). Lumen runs this by default
// (r.Lumen.RadianceCache.SpatialFilterProbes = 1) and it is the reason a
// probe grid does not show its own lattice: the 8-probe cage blends with a
// weight that varies across every cell, so any disagreement between
// neighbouring probes appears as a grid of crevices in the interpolated
// result. Filtering removes the disagreement rather than hiding it.
//
// Two guards keep this from leaking light through geometry:
//
//   Occlusion — a neighbour is only used for a direction it can actually
//   see. Tested both ways (can this probe see the neighbour's sample point,
//   and can the neighbour see ours), because a thin wall between two probes
//   is often visible from only one side.
//
//   Parallax — a neighbour whose hit point lies far off this probe's cone
//   direction is looking at different geometry, and its radiance says
//   nothing about what we see. Rejected past a maximum angle.

layout(set = 0, binding = 1) uniform sampler2D irradiance_src;
layout(set = 0, binding = 2) uniform sampler2D visibility_tex;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D irradiance_dst;

layout(std430, set = 0, binding = 5) readonly buffer ProbeStatusSSBO {
    uint probe_status[];
};

layout(push_constant) uniform PushConstants {
    // Beyond this angle (radians) a neighbour is looking at different
    // geometry. Lumen's SpatialFilterMaxRadianceHitAngle, default 0.2.
    float max_hit_angle;
    // 0 = copy interiors through the filter, 1 = wrap the border ring.
    uint border_phase;
};

const ivec3 NEIGHBOR_OFFSETS[6] = ivec3[](
    ivec3(-1, 0, 0), ivec3(1, 0, 0),
    ivec3( 0,-1, 0), ivec3(0, 1, 0),
    ivec3( 0, 0,-1), ivec3(0, 0, 1)
);

/// Where a probe's tile starts in the atlas. Probes are laid out row-major
/// in tiles of (side + 2) texels.
ivec2 probe_tile_origin(int probe_index, int tile) {
    int per_row = ddgi.irr_tex_w / tile;
    return ivec2(probe_index % per_row, probe_index / per_row) * tile;
}

/// The same octahedral texel in another probe's tile. Both probes store
/// the same direction at the same offset within their tile, so filtering
/// compares like with like.
ivec2 same_texel_in_probe(ivec2 coords, int from_probe, int to_probe, int tile) {
    return coords - probe_tile_origin(from_probe, tile) + probe_tile_origin(to_probe, tile);
}

// See ddgi_irradiance_update.comp — a border texel mirrors the interior
// texel opposite it.
int octahedral_border_offset(uint interior_index, int side) {
    return side - 1 - 2 * int(interior_index);
}

/// Mean hit distance this probe recorded in `dir`, from the visibility
/// atlas. Used as a cheap stand-in for Lumen's per-probe depth atlas.
float probe_depth(int probe_index, vec3 dir) {
    vec2 uv = get_probe_uv(dir, probe_index, ddgi.vis_tex_w, ddgi.vis_tex_h, ddgi.vis_side);
    return textureLod(visibility_tex, uv, 0).r;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= ddgi.irr_tex_w || coords.y >= ddgi.irr_tex_h) return;

    uint probe_with_border_side = uint(ddgi.irr_side + 2);
    uint probe_last_pixel = uint(ddgi.irr_side + 1);

    uint px = gl_GlobalInvocationID.x % probe_with_border_side;
    uint py = gl_GlobalInvocationID.y % probe_with_border_side;
    bool border_pixel = (px == 0) || (px == probe_last_pixel)
                     || (py == 0) || (py == probe_last_pixel);

    if (border_phase != 0u) {
        // Border ring mirrors the filtered interior, same as the update
        // pass does for the unfiltered one.
        if (!border_pixel) return;

        bool corner = (px == 0 || px == probe_last_pixel)
                   && (py == 0 || py == probe_last_pixel);
        bool row = (px > 0 && px < probe_last_pixel);

        ivec2 source = coords;
        if (corner) {
            source.x += int(px == 0 ? ddgi.irr_side : -ddgi.irr_side);
            source.y += int(py == 0 ? ddgi.irr_side : -ddgi.irr_side);
        } else if (row) {
            source.x += octahedral_border_offset(px - 1, ddgi.irr_side);
            source.y += (py > 0) ? -1 : 1;
        } else {
            source.x += (px > 0) ? -1 : 1;
            source.y += octahedral_border_offset(py - 1, ddgi.irr_side);
        }
        imageStore(irradiance_dst, coords, texelFetch(irradiance_src, source, 0));
        return;
    }

    if (border_pixel) return;

    int probe_index = get_probe_index_from_pixels(coords, int(probe_with_border_side), ddgi.irr_tex_w);
    int total_probes = ddgi.probe_counts.x * ddgi.probe_counts.y * ddgi.probe_counts.z;
    if (probe_index >= total_probes) return;

    vec4 self = texelFetch(irradiance_src, coords, 0);

    // A probe the status pass disabled carries nothing worth spreading, and
    // must not pull its neighbours down either.
    if (probe_status[probe_index] == PROBE_STATUS_OFF) {
        imageStore(irradiance_dst, coords, self);
        return;
    }

    // The world direction this texel represents. Neighbours are sampled at
    // the SAME octahedral texel, so they contribute their own estimate of
    // radiance arriving from this direction.
    vec3 cone_dir = oct_decode(normalized_oct_coord(coords, ddgi.irr_side));

    ivec3 probe_grid = ddgi_probe_index_to_grid(probe_index);
    vec3 probe_pos = ddgi_grid_to_world_no_offsets(probe_grid);
    float self_depth = probe_depth(probe_index, cone_dir);

    // Offset the occlusion test points off the probe centres. Two probes
    // sitting either side of a thin wall both record a short depth toward
    // it; comparing at the centres alone would miss that.
    float cell = min(ddgi.probe_spacing.x, min(ddgi.probe_spacing.y, ddgi.probe_spacing.z));
    float occlusion_offset = 2.0 * cell;

    vec3 lighting = self.rgb;
    float total_weight = 1.0;

    for (int i = 0; i < 6; ++i) {
        ivec3 n_grid = probe_grid + NEIGHBOR_OFFSETS[i];
        if (any(lessThan(n_grid, ivec3(0)))
            || any(greaterThanEqual(n_grid, ddgi.probe_counts))) continue;

        int n_index = ddgi_grid_to_probe_index(n_grid);
        if (probe_status[n_index] == PROBE_STATUS_OFF) continue;

        vec3 n_pos = ddgi_grid_to_world_no_offsets(n_grid);
        float n_depth = probe_depth(n_index, cone_dir);

        float occlusion_weight = 1.0;

        // Can this probe see the neighbour's sample point?
        {
            vec3 test_pos = n_pos + occlusion_offset * cone_dir;
            vec3 to_test = test_pos - probe_pos;
            float d = probe_depth(probe_index, normalize(to_test));
            if (d * d < dot(to_test, to_test)) occlusion_weight = 0.0;
        }

        // And in reverse — a thin wall is often only visible from one side.
        {
            vec3 test_pos = probe_pos + occlusion_offset * cone_dir;
            vec3 to_test = test_pos - n_pos;
            float d = probe_depth(n_index, normalize(to_test));
            if (d * d < dot(to_test, to_test)) occlusion_weight = 0.0;
        }

        if (occlusion_weight <= 0.0) continue;

        // Clamp the neighbour's hit distance to our own. A neighbour that
        // sees much further would subtend a small angle and so be trusted
        // too much, washing out contact shadows.
        float clamped = min(n_depth, self_depth);
        vec3 n_hit = n_pos + cone_dir * clamped;
        vec3 to_hit = n_hit - probe_pos;

        float len = length(to_hit);
        if (len < 1e-5) continue;
        float angle = acos(clamp(dot(to_hit, cone_dir) / len, -1.0, 1.0));
        float angle_weight = 1.0 - clamp(angle / max(max_hit_angle, 1e-4), 0.0, 1.0);
        if (angle_weight <= 0.0) continue;

        float weight = angle_weight * occlusion_weight;
        ivec2 n_coords = same_texel_in_probe(coords, probe_index, n_index,
                                             int(probe_with_border_side));
        lighting += texelFetch(irradiance_src, n_coords, 0).rgb * weight;
        total_weight += weight;
    }

    imageStore(irradiance_dst, coords, vec4(lighting / total_weight, self.a));
}
