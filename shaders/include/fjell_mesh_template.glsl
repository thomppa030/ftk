#version 460
#extension GL_EXT_mesh_shader : require

#include "fjell_global_ubo.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_meshlet.glsl"

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
#include "fjell_environment.glsl"
#include "fjell_wind.glsl"
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

#include "fjell_draw_data.glsl"

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

#include "fjell_instance_transforms.glsl"

layout(set = 3, binding = 0) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
};

layout(set = 3, binding = 2) readonly buffer MeshletVertexBuffer {
    uint meshlet_vertices[];
};

layout(set = 3, binding = 3) readonly buffer MeshletTriangleBuffer {
    uint meshlet_triangles_packed[];
};

// Vertex data as raw floats — C++ Vertex is 60 bytes (15 floats)
layout(set = 3, binding = 4) readonly buffer VertexBuffer {
    float vertex_data[];
};

// Layout: position(3) + color(3) + tex_coord(2) + normal(3) + tangent(4)

vec3 fetch_position(uint vi) {
    uint b = vi * VERTEX_STRIDE;
    return vec3(vertex_data[b], vertex_data[b+1], vertex_data[b+2]);
}

vec3 fetch_color(uint vi) {
    uint b = vi * VERTEX_STRIDE + 3;
    return vec3(vertex_data[b], vertex_data[b+1], vertex_data[b+2]);
}

vec2 fetch_tex_coord(uint vi) {
    uint b = vi * VERTEX_STRIDE + 6;
    return vec2(vertex_data[b], vertex_data[b+1]);
}

vec3 fetch_normal(uint vi) {
    uint b = vi * VERTEX_STRIDE + 8;
    return vec3(vertex_data[b], vertex_data[b+1], vertex_data[b+2]);
}

vec4 fetch_tangent(uint vi) {
    uint b = vi * VERTEX_STRIDE + 11;
    return vec4(vertex_data[b], vertex_data[b+1], vertex_data[b+2], vertex_data[b+3]);
}

struct TaskPayload {
    uint draw_index;
    uint meshlet_index;
    uint instance_index;
};

taskPayloadSharedEXT TaskPayload payload;

uint get_triangle_index(uint meshlet_tri_offset, uint local_tri, uint vertex_in_tri) {
    uint byte_offset = (meshlet_tri_offset * 3) + (local_tri * 3) + vertex_in_tri;
    uint word = meshlet_triangles_packed[byte_offset / 4];
    uint byte_in_word = byte_offset % 4;
    return (word >> (byte_in_word * 8)) & 0xFF;
}

// Outputs matching mesh.vert → mesh.frag interface
layout(location = 0) out vec3 frag_color[];
layout(location = 1) out vec2 frag_tex_coord[];
layout(location = 2) out vec3 frag_world_pos[];
layout(location = 3) out vec3 frag_world_normal[];
layout(location = 4) out vec3 frag_TBN_T[];
layout(location = 5) out vec3 frag_TBN_B[];
layout(location = 6) out vec3 frag_TBN_N[];
layout(location = 7) flat out uint frag_draw_index[];
layout(location = 8) out vec4 frag_clip_pos[];
layout(location = 9) out vec4 frag_prev_clip_pos[];

// ── Built-ins ──
// What vertex() reads and writes. main() fills them, calls the hook, and
// places the vertex from what it left. They live at file scope so the hook
// is a function of its own: a `return` in it ends the hook and keeps what it
// set. WORLD_VERTEX is read-only: VERTEX, in object space, is what moves.
GpuMaterial mat;
vec3 VERTEX;
vec3 NORMAL;
vec2 UV;
mat4 MODEL;
float TIME;
vec3 WIND_DIR;
float WIND_SPEED;
float TIME_OF_DAY;
vec3 WORLD_VERTEX;

// ── The shader's parameters and file-scope helpers (generated by FJSL parser) ──
/*FJSL_VERTEX_GLOBALS*/

// ── vertex() hook ──
void fjell_hook_vertex() {
/*FJSL_VERTEX_USER_CODE*/
}

void main() {
    uint meshlet_idx = payload.meshlet_index;
    Meshlet m = meshlets[meshlet_idx];

    DrawData dd = draws[payload.draw_index];
    mat4 model = (dd.instance_count > 1u)
        ? instance_transforms[dd.first_instance + payload.instance_index]
        : dd.model;
    mat4 prev_model = (dd.instance_count > 1u)
        ? instance_transforms[dd.first_instance + payload.instance_index]
        : dd.prev_model;
    uint material_id = dd.material_id;
    mat = materials[material_id];
    mat3 normal_matrix = transpose(inverse(mat3(model)));

    SetMeshOutputsEXT(m.vertex_count, m.triangle_count);

    uint tid = gl_LocalInvocationIndex;

    // Emit vertices
    if (tid < m.vertex_count) {
        uint global_vertex = meshlet_vertices[m.vertex_offset + tid] + dd.vertex_offset;

        VERTEX = fetch_position(global_vertex);
        NORMAL = fetch_normal(global_vertex);
        UV = fetch_tex_coord(global_vertex);
        MODEL = model;
        TIME = ubo.time;
        WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
        WIND_SPEED = env_ubo.wind_dir_speed_gust.w;
        TIME_OF_DAY = env_ubo.weather1.w;
        // Where this vertex sits in the world before vertex() moves it, for
        // shaders whose displacement is a function of world position rather
        // than of the mesh. Read-only: writing it does not move the vertex,
        // VERTEX does, in object space.
        WORLD_VERTEX = (model * vec4(VERTEX, 1.0)).xyz;

        // ── User vertex code ──
        fjell_hook_vertex();

        vec4 world_pos = model * vec4(VERTEX, 1.0);
        vec4 clip_pos = ubo.projection * ubo.view * world_pos;
        gl_MeshVerticesEXT[tid].gl_Position = clip_pos;

        frag_clip_pos[tid] = ubo.unjittered_vp * world_pos;
        vec4 prev_world_pos = prev_model * vec4(VERTEX, 1.0);
        frag_prev_clip_pos[tid] = ubo.prev_unjittered_vp * prev_world_pos;

        frag_color[tid] = fetch_color(global_vertex);
        frag_tex_coord[tid] = UV;
        frag_world_pos[tid] = world_pos.xyz;
        frag_draw_index[tid] = payload.draw_index;

        vec3 world_normal = normal_matrix * NORMAL;
        frag_world_normal[tid] = world_normal;

        // TBN for normal mapping
        vec4 tan = fetch_tangent(global_vertex);
        vec3 T = normalize(normal_matrix * tan.xyz);
        vec3 N = normalize(world_normal);
        vec3 B = cross(N, T) * tan.w;
        frag_TBN_T[tid] = T;
        frag_TBN_B[tid] = B;
        frag_TBN_N[tid] = N;
    }

    // Emit triangles
    for (uint t = tid; t < m.triangle_count; t += 64) {
        uint i0 = get_triangle_index(m.triangle_offset, t, 0);
        uint i1 = get_triangle_index(m.triangle_offset, t, 1);
        uint i2 = get_triangle_index(m.triangle_offset, t, 2);
        gl_PrimitiveTriangleIndicesEXT[t] = uvec3(i0, i1, i2);
    }
}
