#version 460
#extension GL_EXT_nonuniform_qualifier : require

// FJSL terrain template. The terrain mesh shader generates the surface from
// the height texture; this fragment stage blends up to four layer materials
// — ordinary .fjmat files — by the painted weight texture and lights the
// result with the scene's surface shading.
//
// Two hooks. layers() runs first and may rewrite LAYER_WEIGHTS and TRIPLANAR
// from SLOPE (degrees from horizontal), WORLD_POS and the shader's own
// uniforms — this is where rock takes over on cliffs and snow above a
// height. fragment() then sees the blended ALBEDO, NORMAL, ROUGHNESS,
// METALLIC, EMISSION and AO exactly as a spatial shader does and may adjust
// them. light() works as for spatial.

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_renderer_constants.glsl"

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 0, binding = 4) uniform sampler2D depth_texture;
layout(set = 0, binding = 8) uniform sampler2D screen_color_texture;
layout(set = 0, binding = 9) uniform sampler3D scene_sdf;

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

// Binding 0 is the height texture, read by the mesh stage only.
layout(set = 2, binding = 1) uniform sampler2D weight_tex;

// Mirrors TerrainPushConstants in terrain_pass.hpp and the block in
// terrain.task / terrain.mesh.
layout(push_constant) uniform PushConstants {
    vec2  world_origin;
    float world_size;
    float height_scale;
    float height_offset;
    uint  patches_per_side;
    uint  patch_quads;
    uint  view_index;   // 0 camera, 1..3 shadow cascade; unused by the fragment
    uint  terrain_material_id;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
    uvec4 layer_material_ids;
    vec4  layer_uv_scales;      // metres per texture repeat, per layer
} push;

layout(location = 0) in vec3 frag_color;
layout(location = 1) in vec2 frag_tex_coord;
layout(location = 2) in vec3 frag_world_pos;
layout(location = 3) in vec3 frag_world_normal;
layout(location = 4) in vec4 frag_clip_pos;
layout(location = 5) in vec4 frag_prev_clip_pos;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;
layout(location = 3) out vec2 out_velocity;

#include "fjell_surface_lighting.glsl"
#include "fjell_weather_surface.glsl"

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

// One-hot weights for a layer index, for layers() to mix toward:
//   LAYER_WEIGHTS = mix(LAYER_WEIGHTS, layer_mask(1.0), t);
vec4 layer_mask(float layer) {
    int i = int(clamp(layer + 0.5, 0.0, 3.0));
    return vec4(i == 0, i == 1, i == 2, i == 3);
}

// ── light() hook ── see fjell_spatial_template.glsl for the contract.
void fjell_light(
    vec3 LIGHT_DIR, vec3 LIGHT_COLOR, float LIGHT_INTENSITY, float NdotL,
    vec3 NORMAL, vec3 VIEW_DIR, vec3 ALBEDO, float METALLIC, float ROUGHNESS, vec3 F0,
    inout vec3 DIFFUSE_LIGHT, inout vec3 SPECULAR_LIGHT)
{
/*FJSL_LIGHT_USER_CODE*/
}

// What one layer contributes at this point, already scaled by its weight.
struct LayerSample {
    vec3 albedo;
    vec3 normal;     // world space
    float metallic;
    float roughness;
    vec3 emission;
};

// Triplanar blend weights: which of the three world axes a surface faces,
// sharpened so most of the surface reads from a single projection.
vec3 triplanar_weights(vec3 N) {
    vec3 w = abs(N);
    w = pow(w, vec3(4.0));
    return w / (w.x + w.y + w.z);
}

// Sample a layer's textures. Flat ground maps world XZ straight to UV; steep
// ground blends in the two side projections by TRIPLANAR so a cliff face is
// not one row of texels stretched down its height.
LayerSample sample_layer(uint layer, float weight, vec3 world_pos, vec3 N,
                         mat3 TBN, float triplanar) {
    GpuMaterial mat = materials[push.layer_material_ids[layer]];
    vec2 uv_scale = vec2(mat.base_params[7], mat.base_params[8]);
    if (uv_scale.x == 0.0) uv_scale.x = 1.0;
    if (uv_scale.y == 0.0) uv_scale.y = 1.0;
    float metres = max(push.layer_uv_scales[layer], 0.001);
    vec3 p = world_pos / metres;
    vec2 uv_y = p.xz * uv_scale;

    vec4 base_factor = vec4(mat.base_params[0], mat.base_params[1], mat.base_params[2], mat.base_params[3]);
    vec3 emission_factor = vec3(mat.base_params[9], mat.base_params[10], mat.base_params[11]);
    bool has_normal_map = mat.base_params[6] > 0.5;

    // The layer indices are push constants, uniform across the draw, so the
    // descriptor index needs no nonuniformEXT.
    #define LAYER_TEX(slot) textures[mat.texture_indices[slot]]

    vec3 albedo = texture(LAYER_TEX(0), uv_y).rgb;
    vec4 mr = texture(LAYER_TEX(2), uv_y);
    vec3 emission = texture(LAYER_TEX(3), uv_y).rgb;
    vec3 normal = N;
    if (has_normal_map) {
        vec3 tn = texture(LAYER_TEX(1), uv_y).rgb * 2.0 - 1.0;
        normal = normalize(TBN * tn);
    }

    if (triplanar > 0.001) {
        vec3 bw = triplanar_weights(N);
        vec2 uv_x = p.zy * uv_scale;
        vec2 uv_z = p.xy * uv_scale;

        vec3 albedo_x = texture(LAYER_TEX(0), uv_x).rgb;
        vec3 albedo_z = texture(LAYER_TEX(0), uv_z).rgb;
        vec4 mr_x = texture(LAYER_TEX(2), uv_x);
        vec4 mr_z = texture(LAYER_TEX(2), uv_z);
        vec3 em_x = texture(LAYER_TEX(3), uv_x).rgb;
        vec3 em_z = texture(LAYER_TEX(3), uv_z).rgb;

        vec3 albedo_tri = albedo_x * bw.x + albedo * bw.y + albedo_z * bw.z;
        vec4 mr_tri = mr_x * bw.x + mr * bw.y + mr_z * bw.z;
        vec3 em_tri = em_x * bw.x + emission * bw.y + em_z * bw.z;

        vec3 normal_tri = N;
        if (has_normal_map) {
            // Whiteout blend: each projection's tangent normal is bent by the
            // surface normal's components in that plane, then swizzled into
            // world axes and weighted like the colour.
            vec3 tx = texture(LAYER_TEX(1), uv_x).rgb * 2.0 - 1.0;
            vec3 ty = texture(LAYER_TEX(1), uv_y).rgb * 2.0 - 1.0;
            vec3 tz = texture(LAYER_TEX(1), uv_z).rgb * 2.0 - 1.0;
            tx = vec3(tx.xy + N.zy, abs(tx.z) * N.x);
            ty = vec3(ty.xy + N.xz, abs(ty.z) * N.y);
            tz = vec3(tz.xy + N.xy, abs(tz.z) * N.z);
            normal_tri = normalize(tx.zyx * bw.x + ty.xzy * bw.y + tz.xyz * bw.z);
        }

        albedo = mix(albedo, albedo_tri, triplanar);
        mr = mix(mr, mr_tri, triplanar);
        emission = mix(emission, em_tri, triplanar);
        normal = normalize(mix(normal, normal_tri, triplanar));
    }
    #undef LAYER_TEX

    LayerSample s;
    s.albedo = albedo * base_factor.rgb * weight;
    s.normal = normal * weight;
    s.metallic = mr.b * mat.base_params[4] * weight;
    s.roughness = clamp(mr.g * mat.base_params[5], 0.04, 1.0) * weight;
    s.emission = emission * emission_factor * weight;
    return s;
}

void main() {
    GpuMaterial mat = materials[push.terrain_material_id];

    // ── Built-in inputs ──
    vec3 WORLD_POS = frag_world_pos;
    vec3 WORLD_NORMAL = normalize(frag_world_normal);
    vec2 UV = frag_world_pos.xz;             // metres, before any layer's tiling
    vec2 TERRAIN_UV = frag_tex_coord;        // 0..1 across the whole terrain
    vec3 VIEW_DIR = normalize(ubo.camera_position.xyz - frag_world_pos);
    float TIME = ubo.time;
    #define SCREEN_TEXTURE screen_color_texture
    vec2 SCREEN_UV = gl_FragCoord.xy / vec2(textureSize(screen_color_texture, 0));
    #define DEPTH_TEXTURE depth_texture
    #define SDF_TEXTURE scene_sdf
    // Angle from horizontal in degrees: 0 on flat ground, 90 on a vertical
    // face. Degrees because that is how a slope is described when authoring.
    float SLOPE = degrees(acos(clamp(WORLD_NORMAL.y, 0.0, 1.0)));

    // Heightfield tangent frame: U runs along world +X, V along world +Z.
    vec3 T = normalize(vec3(1.0, 0.0, 0.0) - WORLD_NORMAL * WORLD_NORMAL.x);
    vec3 B = cross(T, WORLD_NORMAL);
    mat3 TBN = mat3(T, B, WORLD_NORMAL);

    // ── Layer weights ──
    // Painted weights, then the layers() hook. A weight texture that sums to
    // nothing (unpainted ground) reads as all layer 0.
    vec4 LAYER_WEIGHTS = texture(weight_tex, TERRAIN_UV);
    float TRIPLANAR = smoothstep(45.0, 65.0, SLOPE);
    {
/*FJSL_LAYERS_USER_CODE*/
    }
    float weight_sum = LAYER_WEIGHTS.x + LAYER_WEIGHTS.y + LAYER_WEIGHTS.z + LAYER_WEIGHTS.w;
    LAYER_WEIGHTS = weight_sum > 0.0001 ? LAYER_WEIGHTS / weight_sum : vec4(1.0, 0.0, 0.0, 0.0);
    TRIPLANAR = clamp(TRIPLANAR, 0.0, 1.0);

    // ── Blend the layers ──
    vec3 ALBEDO = vec3(0.0);
    vec3 NORMAL = vec3(0.0);
    float METALLIC = 0.0;
    float ROUGHNESS = 0.0;
    vec3 EMISSION = vec3(0.0);
    float AO = 1.0;
    for (uint i = 0u; i < 4u; ++i) {
        float w = LAYER_WEIGHTS[i];
        // A layer that contributes nothing costs nothing: its textures are
        // never fetched.
        if (w < 0.002) continue;
        LayerSample s = sample_layer(i, w, WORLD_POS, WORLD_NORMAL, TBN, TRIPLANAR);
        ALBEDO += s.albedo;
        NORMAL += s.normal;
        METALLIC += s.metallic;
        ROUGHNESS += s.roughness;
        EMISSION += s.emission;
    }
    NORMAL = normalize(NORMAL);
    ROUGHNESS = clamp(ROUGHNESS, 0.04, 1.0);
    float ALPHA = 1.0;

    // ── Weather built-ins ──
    float WETNESS = env_ubo.weather1.x;
    float SNOW = env_ubo.weather1.y;
    float PRECIPITATION = env_ubo.weather0.z;
    float CLOUD_COVERAGE = env_ubo.weather0.x;
    vec3 WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
    float WIND_SPEED = env_ubo.wind_dir_speed_gust.w;
    float TIME_OF_DAY = env_ubo.weather1.w;
    // How open this point is to the sky, one where nothing shelters it.
    // Nothing measures shelter at present, so everything is open: rain
    // reaches every surface it can land on.
    float SKY_EXPOSURE = 1.0;

    // ── Custom param reads (generated by FJSL parser) ──
/*FJSL_CUSTOM_PARAMS*/

    // ── User fragment code ──
    {
/*FJSL_USER_CODE*/
    }

    // ── Weather response (generated by FJSL parser) ──
/*FJSL_WEATHER*/

    // Specular antialiasing: widen roughness where normals vary across the pixel
    ROUGHNESS = specular_aa_roughness(NORMAL, WORLD_POS, max(ROUGHNESS, 0.089));

    // ── PBR lighting ──
    fjell_shade_surface(NORMAL, VIEW_DIR, WORLD_POS, frag_world_normal,
                        ALBEDO, ALPHA, METALLIC, ROUGHNESS, EMISSION, AO,
                        frag_clip_pos, frag_prev_clip_pos);
}
