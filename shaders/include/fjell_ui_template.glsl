#version 460
#extension GL_EXT_nonuniform_qualifier : require

// FJSL ui template. One quad of the game UI, drawn by UiRenderer through a
// pipeline built for the `shader_type ui;` .fjsl that a node's material
// names. The user writes fragment() and fills ALBEDO and ALPHA; UV, SIZE,
// PIXEL, SCREEN_UV, TIME, COLOR, TEXTURE, HAS_TEXTURE, FILL, FILL_TARGET,
// FILL_VELOCITY, FILL_AGITATION, HOVER, ACTIVE and FOCUS are in scope. The
// quad's corners, border, clip rect and opacity are applied afterwards
// through the same helpers the fixed UI shader uses, so a material paints
// only the fill.
//
// Compiled twice: as is for screen-space UI, and with FJELL_UI_WORLD defined
// for worldspace widgets, which carry the extra varyings and attachments the
// scene colour pass expects (see ui_quad_world.frag).

#include "fjell_ui_common.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_ui_quad_shape.glsl"

layout(set = 1, binding = 0) uniform sampler2D textures[];

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer CustomParamBuffer {
    float custom_params[];
};

layout(location = 0) in vec2 frag_uv;
layout(location = 1) flat in uint frag_quad_index;

layout(location = 0) out vec4 out_color;

#ifdef FJELL_UI_WORLD
layout(location = 2) in vec4 frag_clip_pos;
layout(location = 3) in vec4 frag_prev_clip_pos;

layout(location = 1) out vec2 out_metallic_roughness; // unused, masked at pipeline creation
layout(location = 2) out vec2 out_normal;              // unused, masked at pipeline creation
layout(location = 3) out vec2 out_velocity;
#endif

// The node's `src` texture. Index 0 is the engine's white texture, so
// sampling it without a src is well defined; HAS_TEXTURE says which it was.
#define TEXTURE textures[nonuniformEXT(quads[frag_quad_index].texture_id)]

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

void main() {
    UiQuad q = quads[frag_quad_index];

    fjell_ui_quad_clip(q, frag_uv);
    FjellUiShape shape = fjell_ui_quad_shape(q, frag_uv);

    vec2 UV = frag_uv;
    vec2 SIZE = q.rect.zw;
    vec2 PIXEL = UV * SIZE;
    vec2 SCREEN_UV = (q.rect.xy + PIXEL) / q.viewport_size;
    float TIME = ubo.time;
    vec4 COLOR = srgb_to_linear(q.color);
    bool HAS_TEXTURE = q.texture_id != 0u;
    float FILL = q.state.x;
    float HOVER = q.state.y;
    float ACTIVE = q.state.z;
    float FOCUS = q.state.w;
    float FILL_TARGET = q.bar.x;      // where the bar's value is; FILL follows it
    float FILL_VELOCITY = q.bar.y;    // bar widths per second, negative while draining
    float FILL_AGITATION = q.bar.z;   // 0..1, stirred up by sudden changes, dies away

    vec3 ALBEDO = COLOR.rgb;
    float ALPHA = COLOR.a;

    // ── User fragment code ──
    {
/*FJSL_USER_CODE*/
    }

    out_color = fjell_ui_quad_finish(vec4(ALBEDO, ALPHA), shape, q);

#ifdef FJELL_UI_WORLD
    // Screen-space velocity of this billboard, so TAA reprojects the widget
    // by its own motion rather than the background's (see ui_quad_world.frag).
    vec2 cur_ndc = frag_clip_pos.xy / frag_clip_pos.w;
    vec2 prev_ndc = frag_prev_clip_pos.xy / frag_prev_clip_pos.w;
    out_velocity = (cur_ndc - prev_ndc) * 0.5;
#endif
}
