#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "fjell_common.glsl"

struct GpuMaterial {
    uint texture_indices[8];   // 32 bytes — slots 0-3: PBR, 4-7: custom
    float base_params[12];     // 48 bytes — PBR params
    uint param_offset;         // 4 bytes  — offset into params SSBO (in floats)
    uint param_count;          // 4 bytes  — number of custom floats
    uint padding[2];           // 8 bytes  — align to 96
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;    // xyz = dir toward light, w = intensity
    vec4 light_color;        // xyz = color
    vec4 camera_position;    // xyz = eye pos
    vec4 ambient_color;      // xyz = color, w = intensity
    mat4 cascade_vp[3];      // light-space matrices per cascade
    vec4 cascade_splits;     // xyz = split distances
    uvec4 tile_info;         // x = tiles_x, y = tiles_y, z = point_count, w = spot_count
    mat4 inv_projection;
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    float time;
    float gi_intensity;
} ubo;

layout(set = 0, binding = 1) uniform sampler2DArrayShadow shadow_map;
layout(set = 0, binding = 5) uniform sampler2D ao_texture;
layout(set = 0, binding = 6) uniform samplerCube sky_cubemap;
layout(set = 0, binding = 7) uniform sampler2D brdf_lut;
layout(set = 0, binding = 4) uniform sampler2D depth_texture;
layout(set = 0, binding = 8) uniform sampler2D screen_color_texture;
layout(set = 0, binding = 9) uniform sampler3D scene_sdf;
layout(set = 0, binding = 10) uniform sampler2D gi_indirect;

struct GpuPointLight {
    vec4 position_radius;   // xyz = world pos, w = radius
    vec4 color_intensity;   // xyz = color, w = intensity
};

struct GpuSpotLight {
    vec4 position_radius;       // xyz = world pos, w = radius
    vec4 direction_inner_cos;   // xyz = dir, w = cos(inner_angle)
    vec4 color_intensity;       // xyz = color, w = intensity
    float outer_cos;
    float pad0;
    float pad1;
    float pad2;
};

layout(set = 0, binding = 2) readonly buffer LightBuffer {
    GpuPointLight point_lights[1024];
    GpuSpotLight spot_lights[1024];
};

const uint MAX_LIGHTS_PER_TILE = 256; // must match renderer_constants.hpp

layout(set = 0, binding = 3) readonly buffer TileLightIndexBuffer {
    uint tile_data[]; // [tile_count counts][tile_count * MAX_LIGHTS_PER_TILE indices]
};

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

#include "fjell_draw_data.glsl"

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

layout(location = 0) in vec3 frag_color;
layout(location = 1) in vec2 frag_tex_coord;
layout(location = 2) in vec3 frag_world_pos;
layout(location = 3) in vec3 frag_world_normal;
layout(location = 4) in mat3 frag_TBN;
layout(location = 7) flat in uint frag_draw_index;
layout(location = 8) in vec4 frag_clip_pos;
layout(location = 9) in vec4 frag_prev_clip_pos;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;
layout(location = 3) out vec2 out_velocity;

#include "fjell_pbr.glsl"
#include "fjell_shadow.glsl"
#include "fjell_lighting.glsl"

// ── Depth reconstruction helpers ──
float linearize_depth(float d) {
    float n = ubo.projection[3][2] / ubo.projection[2][2];
    float f = ubo.projection[3][2] / (ubo.projection[2][2] + 1.0);
    return n * f / (f - d * (f - n));
}

vec3 reconstruct_world_pos(vec2 screen_uv, float raw_depth) {
    vec4 ndc = vec4(screen_uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 world = ubo.inv_view_proj * ndc;
    return world.xyz / world.w;
}

// ── Custom texture defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

void main() {
    uint material_id = draws[frag_draw_index].material_id;
    GpuMaterial mat = materials[material_id];

    // ── Built-in PBR inputs ──
    vec2 uv_scale = vec2(mat.base_params[7], mat.base_params[8]);
    if (uv_scale.x == 0.0) uv_scale.x = 1.0;
    if (uv_scale.y == 0.0) uv_scale.y = 1.0;
    vec2 UV = frag_tex_coord * uv_scale;
    vec3 WORLD_POS = frag_world_pos;
    vec3 WORLD_NORMAL = frag_world_normal;
    mat3 TBN = frag_TBN;
    vec3 VIEW_DIR = normalize(ubo.camera_position.xyz - frag_world_pos);
    vec3 COLOR = frag_color;
    float TIME = ubo.time;
    #define SCREEN_TEXTURE screen_color_texture
    vec2 SCREEN_UV = gl_FragCoord.xy / vec2(textureSize(screen_color_texture, 0));
    #define DEPTH_TEXTURE depth_texture
    #define SDF_TEXTURE scene_sdf
    vec3 LIGHT_DIR = normalize(ubo.light_direction.xyz);
    vec3 LIGHT_COLOR = ubo.light_color.xyz;
    float LIGHT_INTENSITY = ubo.light_direction.w;

    // PBR texture samplers as built-in inputs
    #define BASE_COLOR_TEX textures[nonuniformEXT(mat.texture_indices[0])]
    #define NORMAL_TEX textures[nonuniformEXT(mat.texture_indices[1])]
    #define METALLIC_ROUGHNESS_TEX textures[nonuniformEXT(mat.texture_indices[2])]
    #define EMISSIVE_TEX textures[nonuniformEXT(mat.texture_indices[3])]

    // PBR factor inputs
    vec4 BASE_COLOR_FACTOR = vec4(mat.base_params[0], mat.base_params[1], mat.base_params[2], mat.base_params[3]);
    float METALLIC_FACTOR = mat.base_params[4];
    float ROUGHNESS_FACTOR = mat.base_params[5];
    float HAS_NORMAL_MAP = mat.base_params[6];

    // ── Built-in outputs (PBR defaults) ──
    vec4 base_sample = texture(BASE_COLOR_TEX, UV) * BASE_COLOR_FACTOR * vec4(COLOR, 1.0);
    vec3 ALBEDO = base_sample.rgb;
    float ALPHA = base_sample.a;
    vec4 mr_sample = texture(METALLIC_ROUGHNESS_TEX, UV);
    float METALLIC = mr_sample.b * METALLIC_FACTOR;
    float ROUGHNESS = clamp(mr_sample.g * ROUGHNESS_FACTOR, 0.04, 1.0);
    vec3 NORMAL = frag_world_normal;
    vec3 EMISSION = texture(EMISSIVE_TEX, UV).rgb;
    float AO = 1.0;

    // Apply normal map if available
    if (HAS_NORMAL_MAP > 0.5) {
        vec3 tangent_normal = texture(NORMAL_TEX, UV).rgb * 2.0 - 1.0;
        NORMAL = normalize(TBN * tangent_normal);
    } else {
        NORMAL = normalize(frag_world_normal);
    }

    // Flip normal for back faces (double-sided rendering)
    if (!gl_FrontFacing) NORMAL = -NORMAL;

    // ── Custom param reads (generated by FJSL parser) ──
/*FJSL_CUSTOM_PARAMS*/

    // ── User fragment code ──
    {
/*FJSL_USER_CODE*/
    }

    // ── PBR lighting (same as mesh.frag) ──
    float normal_len = length(frag_world_normal);
    if (normal_len < 0.001) {
        // No normals — render unlit
        out_color = vec4(ALBEDO, ALPHA);
        out_metallic_roughness = vec2(0.0);
        out_normal = vec2(0.0);
        vec2 cn = frag_clip_pos.xy / frag_clip_pos.w;
        vec2 pn = frag_prev_clip_pos.xy / frag_prev_clip_pos.w;
        out_velocity = (cn - pn) * 0.5;
        return;
    }

    vec3 N = NORMAL;
    vec3 V = VIEW_DIR;
    vec3 L = normalize(ubo.light_direction.xyz);
    vec3 H = normalize(V + L);
    float light_intensity = ubo.light_direction.w;

    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.001);
    float NdotH = max(dot(N, H), 0.0);
    float HdotV = max(dot(H, V), 0.0);

    vec3 F0 = mix(vec3(0.04), ALBEDO, METALLIC);

    float D = distribution_GGX(NdotH, ROUGHNESS);
    float G = geometry_smith(NdotV, NdotL, ROUGHNESS);
    vec3  F = fresnel_schlick(HdotV, F0);

    vec3 specular = (D * G * F) / (4.0 * NdotV * NdotL + 0.0001);

    vec3 kD = (vec3(1.0) - F) * (1.0 - METALLIC);
    vec3 diffuse = kD * ALBEDO / PI;

    float shadow = shadow_factor(WORLD_POS, N, NdotL);

    vec3 radiance = ubo.light_color.xyz * light_intensity;
    vec3 Lo = (diffuse + specular) * radiance * NdotL * shadow;

    Lo += accumulate_tile_lights(WORLD_POS, N, V, NdotV, ALBEDO, METALLIC, ROUGHNESS, F0);

    // Screen-space AO from GTAO pass
    vec2 ao_uv = gl_FragCoord.xy / (vec2(textureSize(ao_texture, 0)) * 2.0);
    float screen_ao = texture(ao_texture, ao_uv).r;
    // Combine screen-space AO with material AO output
    float final_ao = screen_ao * AO;

    // IBL diffuse
    vec3 F_ibl = fresnel_schlick_roughness(NdotV, F0, ROUGHNESS);
    vec3 kD_ibl = (1.0 - F_ibl) * (1.0 - METALLIC);
    vec3 irradiance = textureLod(sky_cubemap, N, 5.0).rgb;
    vec3 diffuse_ibl = kD_ibl * ALBEDO * irradiance;

    // IBL specular
    vec3 R = reflect(-V, N);
    vec3 prefiltered = textureLod(sky_cubemap, R, ROUGHNESS * 9.0).rgb;
    vec2 env_brdf = texture(brdf_lut, vec2(NdotV, ROUGHNESS)).rg;
    vec3 specular_ibl = prefiltered * (F_ibl * env_brdf.x + env_brdf.y);

    float ibl_intensity = ubo.ambient_color.w; // reuse ambient_intensity for IBL strength
    vec3 ambient = (diffuse_ibl + specular_ibl) * final_ao * ibl_intensity;

    // DDGI indirect diffuse
    float gi_intensity = ubo.gi_intensity;
    vec2 gi_uv = gl_FragCoord.xy / (vec2(textureSize(ao_texture, 0)) * 2.0);
    vec3 gi_sample = texture(gi_indirect, gi_uv).rgb;
    vec3 gi_diffuse = gi_sample * kD_ibl * ALBEDO * gi_intensity;
    ambient += gi_diffuse * final_ao;

    vec3 color = ambient + Lo * mix(final_ao, 1.0, 0.5) + EMISSION;

    out_color = vec4(color, ALPHA);
    out_metallic_roughness = vec2(METALLIC, ROUGHNESS);
    out_normal = oct_encode(N);

    // Screen-space velocity (current NDC - previous NDC, in UV space)
    vec2 cur_ndc = frag_clip_pos.xy / frag_clip_pos.w;
    vec2 prev_ndc = frag_prev_clip_pos.xy / frag_prev_clip_pos.w;
    out_velocity = (cur_ndc - prev_ndc) * 0.5;
}
