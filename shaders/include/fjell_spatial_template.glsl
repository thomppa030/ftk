#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_renderer_constants.glsl"

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 0, binding = 4) uniform sampler2D depth_texture;
layout(set = 0, binding = 8) uniform sampler2D screen_color_texture;
layout(set = 0, binding = 9) uniform sampler3D scene_sdf;

#include "fjell_bindless.glsl"

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

#include "fjell_draw_data.glsl"

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

layout(location = 0) in vec3 frag_color;
layout(location = 1) in vec2 frag_tex_coord;
layout(location = 2) in vec3 frag_world_pos;
layout(location = 3) in vec3 frag_world_normal;
layout(location = 4) in mat3 frag_TBN;
layout(location = 7) flat in uint frag_draw_index;
layout(location = 8) in vec4 frag_clip_pos;
layout(location = 9) in vec4 frag_prev_clip_pos;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;
layout(location = 3) out vec2 out_velocity;

#include "fjell_surface_lighting.glsl"
#include "fjell_weather_surface.glsl"

layout(set = 0, binding = 16) uniform sampler2D motion_field_tex;
#include "fjell_motion_field.glsl"

// ── Depth reconstruction helpers ──
float linearize_depth(float d) {
    float n = ubo.projection[3][2] / ubo.projection[2][2];
    float f = ubo.projection[3][2] / (ubo.projection[2][2] + 1.0);
    return n * f / (f - d * (f - n));
}

vec3 reconstruct_world_pos(vec2 screen_uv, float raw_depth) {
    vec4 ndc = vec4(screen_uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 world = ubo.inv_view_proj * ndc;
    return world.xyz / world.w;
}

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── Built-ins ──
// What fragment() reads and writes. main() fills them, calls the hook, and
// shades from what it left. They live at file scope so the hook is a
// function of its own: a `return` in it ends the hook and keeps what it set.
GpuMaterial mat;

vec2 UV;
vec3 WORLD_POS;
vec3 WORLD_NORMAL;
mat3 TBN;
vec3 VIEW_DIR;
vec3 COLOR;
float TIME;
#define SCREEN_TEXTURE screen_color_texture
vec2 SCREEN_UV;
#define DEPTH_TEXTURE depth_texture
#define SDF_TEXTURE scene_sdf
vec3 LIGHT_DIR;
vec3 LIGHT_COLOR;
float LIGHT_INTENSITY;

// Weather
float WETNESS;
float SNOW;
float PRECIPITATION;
float CLOUD_COVERAGE;
vec3 WIND_DIR;
float WIND_SPEED;

// What has moved through here, read from the world's motion field, so
// anything carrying a motion source marks a surface without the surface
// knowing what marked it: a wake behind a boat, grass bent by a runner, a
// track pressed into snow.
vec2 MOTION_VELOCITY;
float MOTION_SPEED;
float MOTION_RECENCY;
float MOTION_HEIGHT;
vec2 MOTION_AWAY;
float MOTION_EDGE;
float TIME_OF_DAY;
// How open this point is to the sky, one where nothing shelters it.
float SKY_EXPOSURE;

// PBR texture samplers
#define BASE_COLOR_TEX FjellTexture(mat.texture_indices[0])
#define NORMAL_TEX FjellTexture(mat.texture_indices[1])
#define METALLIC_ROUGHNESS_TEX FjellTexture(mat.texture_indices[2])
#define EMISSIVE_TEX FjellTexture(mat.texture_indices[3])

// PBR factors
vec4 BASE_COLOR_FACTOR;
float METALLIC_FACTOR;
float ROUGHNESS_FACTOR;
float HAS_NORMAL_MAP;
// What the GI paths read as this material's emission; the seed in main()
// applies it so a surface lights the scene the way it looks.
vec3 EMISSION_FACTOR;

// Outputs, seeded with the PBR defaults before the hook runs
vec3 ALBEDO;
float ALPHA;
float METALLIC;
float ROUGHNESS;
vec3 NORMAL;
vec3 EMISSION;
float AO;

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

// ── light() hook ──
// Called once per light (sun + each tile point/spot). Inputs are locals in
// scope at the call site; outputs are accumulated into DIFFUSE_LIGHT and
// SPECULAR_LIGHT. The values you write here are scaled by the per-light
// radiance, attenuation, and shadow factor *after* this function runs, so
// keep the body BRDF-style (no need to multiply by NdotL, no need to apply
// shadow yourself — both are folded in by the caller).
//
// Inputs (read-only):
//   vec3 LIGHT_DIR        normalized direction from surface toward the light
//   vec3 LIGHT_COLOR      sRGB color of this light
//   float LIGHT_INTENSITY (sun: ubo.light_direction.w; local: color_intensity.w)
//   float NdotL           clamped dot(N, L)
//   vec3 NORMAL, VIEW_DIR, ALBEDO
//   float METALLIC, ROUGHNESS
//   vec3 F0
// Outputs (write-add):
//   vec3 DIFFUSE_LIGHT, SPECULAR_LIGHT
//
// Default body below is standard GGX PBR. User-provided light() replaces it.
void fjell_light(
    vec3 LIGHT_DIR, vec3 LIGHT_COLOR, float LIGHT_INTENSITY, float NdotL,
    vec3 NORMAL, vec3 VIEW_DIR, vec3 ALBEDO, float METALLIC, float ROUGHNESS, vec3 F0,
    inout vec3 DIFFUSE_LIGHT, inout vec3 SPECULAR_LIGHT)
{
/*FJSL_LIGHT_USER_CODE*/
}

// ── fragment() hook ──
void fjell_hook_fragment() {
/*FJSL_USER_CODE*/
}

void main() {
    mat = materials[draws[frag_draw_index].material_id];

    // ── Built-in inputs ──
    vec2 uv_scale = vec2(mat.base_params[7], mat.base_params[8]);
    if (uv_scale.x == 0.0) uv_scale.x = 1.0;
    if (uv_scale.y == 0.0) uv_scale.y = 1.0;
    UV = frag_tex_coord * uv_scale;
    WORLD_POS = frag_world_pos;
    WORLD_NORMAL = frag_world_normal;
    TBN = frag_TBN;
    VIEW_DIR = normalize(ubo.camera_position.xyz - frag_world_pos);
    COLOR = frag_color;
    TIME = ubo.time;
    SCREEN_UV = gl_FragCoord.xy / vec2(textureSize(screen_color_texture, 0));
    LIGHT_DIR = normalize(ubo.light_direction.xyz);
    LIGHT_COLOR = ubo.light_color.xyz;
    LIGHT_INTENSITY = ubo.light_direction.w;

    WETNESS = env_ubo.weather1.x;
    SNOW = env_ubo.weather1.y;
    PRECIPITATION = env_ubo.weather0.z;
    CLOUD_COVERAGE = env_ubo.weather0.x;
    WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
    WIND_SPEED = env_ubo.wind_dir_speed_gust.w;

    MotionSample _motion = motion_at(WORLD_POS);
    MOTION_VELOCITY = _motion.velocity;
    MOTION_SPEED = length(_motion.velocity);
    MOTION_RECENCY = _motion.recency;
    MOTION_HEIGHT = _motion.height;
    MotionGradient _motion_grad = _motion.recency > 0.0
        ? motion_gradient(WORLD_POS, MOTION_FIELD_TEXEL_M)
        : MotionGradient(vec2(0.0), 0.0);
    MOTION_AWAY = _motion_grad.direction;
    MOTION_EDGE = _motion_grad.sharpness;
    TIME_OF_DAY = env_ubo.weather1.w;
    // Nothing measures shelter at present, so everything is open: rain
    // reaches every surface it can land on.
    SKY_EXPOSURE = 1.0;

    BASE_COLOR_FACTOR = vec4(mat.base_params[0], mat.base_params[1], mat.base_params[2], mat.base_params[3]);
    METALLIC_FACTOR = mat.base_params[4];
    ROUGHNESS_FACTOR = mat.base_params[5];
    HAS_NORMAL_MAP = mat.base_params[6];
    EMISSION_FACTOR = vec3(mat.base_params[9], mat.base_params[10], mat.base_params[11]);

    // ── Built-in outputs (PBR defaults) ──
    // Shaders that add to EMISSION build on the factor; a shader with no
    // emissive texture starts from black.
    vec4 base_sample = texture(BASE_COLOR_TEX, UV) * BASE_COLOR_FACTOR * vec4(COLOR, 1.0);
    ALBEDO = base_sample.rgb;
    ALPHA = base_sample.a;
    vec4 mr_sample = texture(METALLIC_ROUGHNESS_TEX, UV);
    METALLIC = mr_sample.b * METALLIC_FACTOR;
    ROUGHNESS = clamp(mr_sample.g * ROUGHNESS_FACTOR, 0.04, 1.0);
    EMISSION = texture(EMISSIVE_TEX, UV).rgb * EMISSION_FACTOR;
    AO = 1.0;

    // Apply normal map if available
    if (HAS_NORMAL_MAP > 0.5) {
        vec3 tangent_normal = texture(NORMAL_TEX, UV).rgb * 2.0 - 1.0;
        NORMAL = normalize(TBN * tangent_normal);
    } else {
        NORMAL = normalize(frag_world_normal);
    }

    // Flip normal for back faces (double-sided rendering)
    if (!gl_FrontFacing) NORMAL = -NORMAL;

    // ── User fragment code ──
    fjell_hook_fragment();

    // ── Weather response (generated by FJSL parser) ──
/*FJSL_WEATHER*/

    // Specular antialiasing: widen roughness where normals vary across the pixel
    ROUGHNESS = specular_aa_roughness(NORMAL, WORLD_POS, max(ROUGHNESS, 0.089));

    // ── PBR lighting ──
    fjell_shade_surface(NORMAL, VIEW_DIR, WORLD_POS, frag_world_normal,
                        ALBEDO, ALPHA, METALLIC, ROUGHNESS, EMISSION, AO,
                        frag_clip_pos, frag_prev_clip_pos);
}
