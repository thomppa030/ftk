#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_renderer_constants.glsl"

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 0, binding = 4) uniform sampler2D depth_texture;
layout(set = 0, binding = 8) uniform sampler2D screen_color_texture;
layout(set = 0, binding = 9) uniform sampler3D scene_sdf;

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

#include "fjell_draw_data.glsl"

layout(set = 2, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

layout(location = 0) in vec3 frag_color;
layout(location = 1) in vec2 frag_tex_coord;
layout(location = 2) in vec3 frag_world_pos;
layout(location = 3) in vec3 frag_world_normal;
layout(location = 4) in mat3 frag_TBN;
layout(location = 7) flat in uint frag_draw_index;
layout(location = 8) in vec4 frag_clip_pos;
layout(location = 9) in vec4 frag_prev_clip_pos;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;
layout(location = 3) out vec2 out_velocity;

#include "fjell_surface_lighting.glsl"
layout(set = 0, binding = 16) uniform sampler2D overhead_depth_tex;
#include "fjell_sky_exposure.glsl"
#include "fjell_weather_surface.glsl"

// ── Depth reconstruction helpers ──
float linearize_depth(float d) {
    float n = ubo.projection[3][2] / ubo.projection[2][2];
    float f = ubo.projection[3][2] / (ubo.projection[2][2] + 1.0);
    return n * f / (f - d * (f - n));
}

vec3 reconstruct_world_pos(vec2 screen_uv, float raw_depth) {
    vec4 ndc = vec4(screen_uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 world = ubo.inv_view_proj * ndc;
    return world.xyz / world.w;
}

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

// ── light() hook ──
// Called once per light (sun + each tile point/spot). Inputs are locals in
// scope at the call site; outputs are accumulated into DIFFUSE_LIGHT and
// SPECULAR_LIGHT. The values you write here are scaled by the per-light
// radiance, attenuation, and shadow factor *after* this function runs, so
// keep the body BRDF-style (no need to multiply by NdotL, no need to apply
// shadow yourself — both are folded in by the caller).
//
// Inputs (read-only):
//   vec3 LIGHT_DIR        normalized direction from surface toward the light
//   vec3 LIGHT_COLOR      sRGB color of this light
//   float LIGHT_INTENSITY (sun: ubo.light_direction.w; local: color_intensity.w)
//   float NdotL           clamped dot(N, L)
//   vec3 NORMAL, VIEW_DIR, ALBEDO
//   float METALLIC, ROUGHNESS
//   vec3 F0
// Outputs (write-add):
//   vec3 DIFFUSE_LIGHT, SPECULAR_LIGHT
//
// Default body below is standard GGX PBR. User-provided light() replaces it.
void fjell_light(
    vec3 LIGHT_DIR, vec3 LIGHT_COLOR, float LIGHT_INTENSITY, float NdotL,
    vec3 NORMAL, vec3 VIEW_DIR, vec3 ALBEDO, float METALLIC, float ROUGHNESS, vec3 F0,
    inout vec3 DIFFUSE_LIGHT, inout vec3 SPECULAR_LIGHT)
{
/*FJSL_LIGHT_USER_CODE*/
}

void main() {
    uint material_id = draws[frag_draw_index].material_id;
    GpuMaterial mat = materials[material_id];

    // ── Built-in PBR inputs ──
    vec2 uv_scale = vec2(mat.base_params[7], mat.base_params[8]);
    if (uv_scale.x == 0.0) uv_scale.x = 1.0;
    if (uv_scale.y == 0.0) uv_scale.y = 1.0;
    vec2 UV = frag_tex_coord * uv_scale;
    vec3 WORLD_POS = frag_world_pos;
    vec3 WORLD_NORMAL = frag_world_normal;
    mat3 TBN = frag_TBN;
    vec3 VIEW_DIR = normalize(ubo.camera_position.xyz - frag_world_pos);
    vec3 COLOR = frag_color;
    float TIME = ubo.time;
    #define SCREEN_TEXTURE screen_color_texture
    vec2 SCREEN_UV = gl_FragCoord.xy / vec2(textureSize(screen_color_texture, 0));
    #define DEPTH_TEXTURE depth_texture
    #define SDF_TEXTURE scene_sdf
    vec3 LIGHT_DIR = normalize(ubo.light_direction.xyz);
    vec3 LIGHT_COLOR = ubo.light_color.xyz;
    float LIGHT_INTENSITY = ubo.light_direction.w;

    // ── Weather built-ins ──
    float WETNESS = env_ubo.weather1.x;
    float SNOW = env_ubo.weather1.y;
    float PRECIPITATION = env_ubo.weather0.z;
    float CLOUD_COVERAGE = env_ubo.weather0.x;
    vec3 WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
    float WIND_SPEED = env_ubo.wind_dir_speed_gust.w;
    float TIME_OF_DAY = env_ubo.weather1.w;
    // How open this point is to the sky, one where nothing shelters it.
    float SKY_EXPOSURE = sky_exposure(WORLD_POS);

    // PBR texture samplers as built-in inputs
    #define BASE_COLOR_TEX textures[nonuniformEXT(mat.texture_indices[0])]
    #define NORMAL_TEX textures[nonuniformEXT(mat.texture_indices[1])]
    #define METALLIC_ROUGHNESS_TEX textures[nonuniformEXT(mat.texture_indices[2])]
    #define EMISSIVE_TEX textures[nonuniformEXT(mat.texture_indices[3])]

    // PBR factor inputs
    vec4 BASE_COLOR_FACTOR = vec4(mat.base_params[0], mat.base_params[1], mat.base_params[2], mat.base_params[3]);
    float METALLIC_FACTOR = mat.base_params[4];
    float ROUGHNESS_FACTOR = mat.base_params[5];
    float HAS_NORMAL_MAP = mat.base_params[6];
    // What the GI paths read as this material's emission; the seed below
    // applies it so a surface lights the scene the way it looks. Shaders that
    // add to EMISSION build on that; a shader with no emissive texture starts
    // from black, exactly as before.
    vec3 EMISSION_FACTOR = vec3(mat.base_params[9], mat.base_params[10], mat.base_params[11]);

    // ── Built-in outputs (PBR defaults) ──
    vec4 base_sample = texture(BASE_COLOR_TEX, UV) * BASE_COLOR_FACTOR * vec4(COLOR, 1.0);
    vec3 ALBEDO = base_sample.rgb;
    float ALPHA = base_sample.a;
    vec4 mr_sample = texture(METALLIC_ROUGHNESS_TEX, UV);
    float METALLIC = mr_sample.b * METALLIC_FACTOR;
    float ROUGHNESS = clamp(mr_sample.g * ROUGHNESS_FACTOR, 0.04, 1.0);
    vec3 NORMAL = frag_world_normal;
    vec3 EMISSION = texture(EMISSIVE_TEX, UV).rgb * EMISSION_FACTOR;
    float AO = 1.0;

    // Apply normal map if available
    if (HAS_NORMAL_MAP > 0.5) {
        vec3 tangent_normal = texture(NORMAL_TEX, UV).rgb * 2.0 - 1.0;
        NORMAL = normalize(TBN * tangent_normal);
    } else {
        NORMAL = normalize(frag_world_normal);
    }

    // Flip normal for back faces (double-sided rendering)
    if (!gl_FrontFacing) NORMAL = -NORMAL;

    // ── Custom param reads (generated by FJSL parser) ──
/*FJSL_CUSTOM_PARAMS*/

    // ── User fragment code ──
    {
/*FJSL_USER_CODE*/
    }

    // ── Weather response (generated by FJSL parser) ──
/*FJSL_WEATHER*/

    // Specular antialiasing: widen roughness where normals vary across the pixel
    ROUGHNESS = specular_aa_roughness(NORMAL, WORLD_POS, max(ROUGHNESS, 0.089));

    // ── PBR lighting ──
    fjell_shade_surface(NORMAL, VIEW_DIR, WORLD_POS, frag_world_normal,
                        ALBEDO, ALPHA, METALLIC, ROUGHNESS, EMISSION, AO,
                        frag_clip_pos, frag_prev_clip_pos);
}
