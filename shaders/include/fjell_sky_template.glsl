#version 460
#extension GL_EXT_nonuniform_qualifier : require

// FJSL sky template. The user writes one sky() function that fills SKY for
// the direction VIEW_DIR looks in, with the sun, moon, time of day and
// weather in scope from the environment. Compiled twice from the same
// source:
//
//   as is                     the fullscreen fragment SkyPass draws behind
//                             the scene when WorldEnvironmentNode.sky_shader
//                             points at a `shader_type sky;` .fjsl
//   with FJELL_SKY_CUBEMAP    a compute shader SkyCubemapPass runs over the
//                             six faces of the lighting cubemap, so the sky
//                             the shader paints is also the sky that lights
//                             the world (IBL, DDGI misses, reflections).
//
// SKY_FOR_LIGHTING tells the two apart: the direct light already provides
// the sun, so a sky skips its sun disc when it is being captured for
// lighting or the disc would be counted twice.

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_environment.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_air_mass.glsl"
#include "fjell_sky_bodies.glsl"
#include "fjell_clouds_2d.glsl"

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);

#include "fjell_bindless.glsl"

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

// Both variants share one push block: the fragment reads the viewport size,
// the cubemap variant the face size, both the sky's material row.
layout(push_constant) uniform PushConstants {
    float viewport_width;
    float viewport_height;
    uint  sky_material_id;
    uint  face_size;
} push;

#ifdef FJELL_SKY_CUBEMAP
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 2, binding = 0, rgba16f) uniform writeonly image2DArray sky_cube;

vec3 cube_dir(uint face, vec2 uv) {
    vec3 dir;
    switch (face) {
        case 0: dir = vec3( 1.0, -uv.y, -uv.x); break; // +X
        case 1: dir = vec3(-1.0, -uv.y,  uv.x); break; // -X
        case 2: dir = vec3( uv.x,  1.0,  uv.y); break; // +Y
        case 3: dir = vec3( uv.x, -1.0, -uv.y); break; // -Y
        case 4: dir = vec3( uv.x, -uv.y,  1.0); break; // +Z
        default: dir = vec3(-uv.x, -uv.y, -1.0); break; // -Z
    }
    return normalize(dir);
}
#else
layout(set = 0, binding = 6) uniform samplerCube sky_cubemap;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;
#endif

// ── Built-ins ──
// What sky() reads, and SKY, the colour it writes. fjell_sky() fills them,
// calls the hook, and returns SKY. They live at file scope so the hook is a
// function of its own: a `return` in it ends the hook and keeps what it set.
vec3 VIEW_DIR;
bool SKY_FOR_LIGHTING;
vec3 SUN_DIR;
vec3 SUN_COLOR;
float SUN_ELEVATION;
vec3 MOON_DIR;
vec3 MOON_COLOR;
float MOON_ELEVATION;
float MOON_PHASE;
vec3 CAMERA_POS;
vec3 AMBIENT_LIGHT;
float TIME;
float TIME_OF_DAY;
float STARS;
vec3 CELESTIAL_AXIS;
float CELESTIAL_ANGLE;
float CLOUD_COVERAGE;
float CLOUD_DENSITY;
float PRECIPITATION;
vec3 WIND_DIR;
float WIND_SPEED;
vec2 WIND_DRIFT;
vec2 FRONT_DIR;
float FRONT_EDGE;
float FRONT_SOFTNESS;
vec3 SKY_TINT;
float LIGHTNING;
vec3 SKY;

// ── The shader's uniforms and file-scope helpers (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

// ── sky() hook ──
void fjell_hook_sky() {
/*FJSL_USER_CODE*/
}

vec3 fjell_sky(vec3 view_dir, bool for_lighting) {
    VIEW_DIR = view_dir;
    SKY_FOR_LIGHTING = for_lighting;

    // ── Bodies ──
    SUN_DIR = normalize(env_ubo.sun_dir_intensity.xyz);
    SUN_COLOR = env_ubo.sun_color.rgb * env_ubo.sun_dir_intensity.w;
    SUN_ELEVATION = asin(clamp(SUN_DIR.y, -1.0, 1.0));
    MOON_DIR = normalize(env_ubo.moon_dir_intensity.xyz);
    MOON_COLOR = env_ubo.moon_color.rgb * env_ubo.moon_dir_intensity.w;
    MOON_ELEVATION = asin(clamp(MOON_DIR.y, -1.0, 1.0));
    MOON_PHASE = env_ubo.moon_color.w;

    // ── Scene ──
    CAMERA_POS = ubo.camera_position.xyz;
    AMBIENT_LIGHT = ubo.ambient_color.rgb * ubo.ambient_color.w;

    // ── Time ──
    TIME = ubo.time;
    TIME_OF_DAY = env_ubo.weather1.w;
    STARS = env_ubo.sky_tint_star.w;
    // The rotation that carried the noon sun to where it is now; the star
    // field turns with it.
    CELESTIAL_AXIS = env_ubo.celestial_axis.xyz;
    CELESTIAL_ANGLE = env_ubo.celestial_axis.w;

    // ── Weather ──
    CLOUD_COVERAGE = env_ubo.weather0.x;
    CLOUD_DENSITY = env_ubo.weather0.y;
    PRECIPITATION = env_ubo.weather0.z;
    WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
    WIND_SPEED = env_ubo.wind_dir_speed_gust.w;
    WIND_DRIFT = env_ubo.wind_drift.xy;
    FRONT_DIR = env_ubo.front.xy;
    FRONT_EDGE = env_ubo.front.z;
    FRONT_SOFTNESS = env_ubo.front.w;
    SKY_TINT = env_ubo.sky_tint_star.rgb;
    LIGHTNING = env_ubo.weather1.z;

    SKY = vec3(0.0);

    // ── User sky code ──
    fjell_hook_sky();

    return SKY;
}

void main() {
#ifdef FJELL_SKY_CUBEMAP
    uint face = gl_GlobalInvocationID.z;
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push.face_size) || coord.y >= int(push.face_size) || face >= 6) return;
    vec2 uv = (vec2(coord) + 0.5) / float(push.face_size) * 2.0 - 1.0;
    vec3 sky = fjell_sky(cube_dir(face, uv), true);
    imageStore(sky_cube, ivec3(coord, face), vec4(sky, 1.0));
#else
    vec2 ndc = vec2(
        (gl_FragCoord.x / push.viewport_width) * 2.0 - 1.0,
        (gl_FragCoord.y / push.viewport_height) * 2.0 - 1.0
    );
    vec4 world_near = ubo.inv_view_proj * vec4(ndc, 0.0, 1.0);
    vec4 world_far  = ubo.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 view_dir = normalize(world_far.xyz / world_far.w - world_near.xyz / world_near.w);

    out_color = vec4(fjell_sky(view_dir, false), 1.0);
    out_metallic_roughness = vec2(0.0);
    out_normal = vec2(0.0);
#endif
}
