#version 460
#extension GL_EXT_nonuniform_qualifier : require

// FJSL sky template. One fullscreen draw per frame written by SkyPass
// when WorldEnvironmentNode.sky_shader points at a `shader_type sky;`
// .fjsl. User writes a single sky() function that fills the SKY output;
// VIEW_DIR, SUN_DIR, SUN_COLOR, and TIME are in scope.

#include "fjell_common.glsl"

// Mirror the spatial template's GpuMaterial layout so the same materials
// SSBO row format works for sky shaders too. param_offset/count are
// allocated by ResourceManager just like a normal material.
struct GpuMaterial {
    uint texture_indices[8];
    float base_params[12];
    uint param_offset;
    uint param_count;
    uint padding[2];
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;    // xyz = dir toward light, w = intensity
    vec4 light_color;        // xyz = color
    vec4 camera_position;
    vec4 ambient_color;
    mat4 cascade_vp[3];
    vec4 cascade_splits;
    uvec4 tile_info;
    mat4 inv_projection;
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    mat4 unjittered_vp;
    mat4 prev_unjittered_vp;
    float time;
    float gi_intensity;
    float jitter_x;
    float jitter_y;
    float ss_gi_intensity;
} ubo;

layout(set = 0, binding = 6) uniform samplerCube sky_cubemap;

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

layout(set = 1, binding = 2) readonly buffer ParamsBuffer {
    float custom_params[];
};

layout(push_constant) uniform PushConstants {
    float viewport_width;
    float viewport_height;
    uint  sky_material_id;
    uint  _pad;
} push;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec2 out_metallic_roughness;
layout(location = 2) out vec2 out_normal;

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

void main() {
    vec2 ndc = vec2(
        (gl_FragCoord.x / push.viewport_width) * 2.0 - 1.0,
        (gl_FragCoord.y / push.viewport_height) * 2.0 - 1.0
    );
    vec4 world_near = ubo.inv_view_proj * vec4(ndc, 0.0, 1.0);
    vec4 world_far  = ubo.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 VIEW_DIR = normalize(world_far.xyz / world_far.w - world_near.xyz / world_near.w);

    vec3 SUN_DIR = normalize(ubo.light_direction.xyz);
    vec3 SUN_COLOR = ubo.light_color.rgb * ubo.light_direction.w;
    float TIME = ubo.time;

    vec3 SKY = vec3(0.0);

    // ── User sky code ──
    {
/*FJSL_USER_CODE*/
    }

    out_color = vec4(SKY, 1.0);
    out_metallic_roughness = vec2(0.0);
    out_normal = vec2(0.0);
}
