#version 460
#extension GL_EXT_nonuniform_qualifier : require

// FJSL post template. The user writes one color() that turns the exposed
// scene colour into the display colour: COLOR comes in as the scene after
// TAA times the exposure, and goes out display-linear, 0..1 expected. The
// tone curve, a grade, a vignette are all the shader's; the template only
// keeps the result non-negative, encodes it to sRGB and dithers it for the
// 8-bit output, so an author never sees the output format.
//
// The post pass draws this once per layer of post process volumes over the
// same scene colour, writing the layer's weight in alpha; the pipeline blends
// it over what the layers below left. A post shader's uniforms are per
// viewport, since each blends by its own camera, so they are read from the
// pass's own buffer at push.param_base rather than from the material row,
// which supplies only the textures.

#include "fjell_global_ubo.glsl"
#include "fjell_environment.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_common.glsl"
#include "fjell_color_space.glsl"
#include "fjell_lut.glsl"
#include "tonemap/tonemap.glsl"

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

// The pass inputs. The depth is the graph's surface_depth: the opaque scene
// with the water laid over it, so a sea pixel is the sea and not its bed. The
// normal and velocity are the G-buffer's, which the water writes too. Depth,
// normal and velocity are sampled nearest: none of them means anything
// between two pixels.
layout(set = 2, binding = 0) uniform sampler2D scene_color;
layout(set = 2, binding = 1) uniform sampler2D bloom_color;
layout(set = 2, binding = 2) uniform sampler2D surface_depth;
layout(set = 2, binding = 3) readonly buffer PostParams {
    float post_params[];
};
layout(set = 2, binding = 4) uniform sampler2D scene_normal;
layout(set = 2, binding = 5) uniform sampler2D scene_velocity;

// Mirrors the push block in PostPass::record_into.
layout(push_constant) uniform PushConstants {
    uint  material_id;
    uint  param_base;
    float exposure;
    float luminance;
    float has_bloom;
    float layer_weight;
} push;

layout(location = 0) out vec4 out_color;

#define DEPTH_TEXTURE surface_depth

// Linear view-space distance from a depth buffer sample.
float linearize_depth(float d) {
    float n = ubo.projection[3][2] / ubo.projection[2][2];
    float f = ubo.projection[3][2] / (ubo.projection[2][2] + 1.0);
    return n * f / (f - d * (f - n));
}

// ── Around the pixel ──
// What COLOR, DEPTH and the G-buffer hold at any uv, for a shader that looks
// at its neighbours and for the helpers in fjell_post_effects.glsl.

// The scene colour texture itself, after TAA and before the exposure.
#define SCENE_TEXTURE scene_color

// One texel of the scene, in UV.
vec2 post_texel_size() {
    return 1.0 / vec2(textureSize(scene_color, 0));
}

// The scene colour at uv, exposed the way COLOR is.
vec3 scene_at(vec2 uv) {
    return max(textureLod(scene_color, uv, 0.0).rgb, vec3(0.0)) * exp2(push.exposure);
}

// Linear depth at uv, as DEPTH is.
float depth_at(vec2 uv) {
    return linearize_depth(textureLod(DEPTH_TEXTURE, uv, 0.0).r);
}

// The world normal at uv, or zero where nothing was drawn (the sky). The
// G-buffer stores an unlit surface the way it stores one facing +Z, so an
// unlit surface reads as facing +Z.
vec3 normal_at(vec2 uv) {
    if (textureLod(DEPTH_TEXTURE, uv, 0.0).r >= 1.0) return vec3(0.0);
    return oct_decode(textureLod(scene_normal, uv, 0.0).rg);
}

// How far the surface at uv moved across the screen since last frame, in UV.
vec2 velocity_at(vec2 uv) {
    return textureLod(scene_velocity, uv, 0.0).rg;
}

// Before the generated defines below, so a uniform named like a helper
// (a `vignette` strength) hides the helper rather than breaking it.
#include "fjell_post_effects.glsl"

// ── Custom texture + param defines (generated by FJSL parser) ──
/*FJSL_CUSTOM_TEXTURES*/

// ── User-authored file-scope helpers / constants (generated by FJSL parser) ──
/*FJSL_USER_GLOBALS*/

vec3 fjell_post(vec2 SCREEN_UV, vec2 PIXEL) {
    vec2 VIEWPORT_SIZE = vec2(textureSize(scene_color, 0));
    vec2 TEXEL_SIZE = 1.0 / VIEWPORT_SIZE;

    // ── Exposure ──
    float EXPOSURE = push.exposure;
    float LUMINANCE = push.luminance;
    bool HAS_BLOOM = push.has_bloom > 0.5;
    vec3 COLOR = max(texture(scene_color, SCREEN_UV).rgb, vec3(0.0)) * exp2(EXPOSURE);
    vec3 BLOOM = HAS_BLOOM ? texture(bloom_color, SCREEN_UV).rgb * exp2(EXPOSURE) : vec3(0.0);

    // ── Scene ──
    float DEPTH = linearize_depth(texture(DEPTH_TEXTURE, SCREEN_UV).r);

    // ── Time and sky ──
    float TIME = ubo.time;
    float TIME_OF_DAY = env_ubo.weather1.w;
    vec3 SUN_DIR = normalize(env_ubo.sun_dir_intensity.xyz);

    // ── Weather ──
    vec3 WIND_DIR = env_ubo.wind_dir_speed_gust.xyz;
    float WIND_SPEED = env_ubo.wind_dir_speed_gust.w;
    float CLOUD_COVERAGE = env_ubo.weather0.x;
    float PRECIPITATION = env_ubo.weather0.z;

    // ── User post code ──
    {
/*FJSL_USER_CODE*/
    }

    return COLOR;
}

void main() {
    vec2 uv = gl_FragCoord.xy / vec2(textureSize(scene_color, 0));
    vec3 display = max(fjell_post(uv, gl_FragCoord.xy), vec3(0.0));

    // A triangular dither of one 8-bit step, applied in sRGB where the steps
    // are even, so a smooth gradient does not band on the way out.
    vec3 srgb = linear_to_srgb(display);
    vec2 nuv = gl_FragCoord.xy * vec2(0.7548776662, 0.5698402909);
    float r1 = fract(52.9829189 * fract(dot(nuv, vec2(0.06711056, 0.00583715))));
    float r2 = fract(52.9829189 * fract(dot(nuv.yx + 17.0, vec2(0.06711056, 0.00583715))));
    srgb += vec3(r1 + r2 - 1.0) / 255.0;

    out_color = vec4(srgb_to_linear(srgb), push.layer_weight);
}
