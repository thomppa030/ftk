shader_type spatial;

// hint_albedo multiplies tint into ALBEDO and hint_emission feeds
// emission_strength into EMISSION before fragment() runs, each scaling its
// texture, so nothing here has to apply either.
uniform vec3 tint : hint_color, hint_albedo = vec3(1.0, 1.0, 1.0);
uniform float roughness_override : hint_range(0.0, 1.0, 0.01) = 0.5;
uniform float emission_strength : hint_range(0.0, 5.0, 0.1), hint_emission = 1.0;

void fragment() {
    ROUGHNESS = roughness_override;
}
