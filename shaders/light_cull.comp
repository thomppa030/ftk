#version 460

#include "fjell_global_ubo.glsl"
#include "fjell_gpu_types.glsl"
#include "fjell_renderer_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 0, binding = 4) uniform sampler2D depth_texture;

layout(set = 0, binding = 2) readonly buffer LightBuffer {
    GpuPointLight point_lights[1024];
    GpuSpotLight spot_lights[1024];
};

layout(set = 0, binding = 3) buffer TileLightIndexBuffer {
    uint tile_data[]; // [tile_count counts][tile_count * MAX_LIGHTS_PER_TILE indices]
};

layout(push_constant) uniform PushConstants {
    uvec2 viewport_size;
};

shared uint min_depth_uint;
shared uint max_depth_uint;
shared uint tile_light_count;

// Reconstruct view-space position from screen-space coordinates and depth
vec4 screen_to_view(vec2 screen_coord, float depth) {
    vec2 ndc = screen_coord / vec2(viewport_size) * 2.0 - 1.0;
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 view = ubo.inv_projection * clip;
    return view / view.w;
}

// Test sphere against tile frustum planes
bool sphere_inside_frustum(vec3 center, float radius, vec4 frustum_planes[6]) {
    for (int i = 0; i < 6; i++) {
        if (dot(vec4(center, 1.0), frustum_planes[i]) < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint tile_x = gl_WorkGroupID.x;
    uint tile_y = gl_WorkGroupID.y;
    uint tiles_x = ubo.tile_info.x;
    uint tiles_y = ubo.tile_info.y;
    uint tile_index = tile_y * tiles_x + tile_x;
    uint total_tiles = tiles_x * tiles_y;
    uint local_index = gl_LocalInvocationIndex;

    // Phase 1: Cooperative depth reduction
    if (local_index == 0) {
        min_depth_uint = 0xFFFFFFFF;
        max_depth_uint = 0;
        tile_light_count = 0;
    }
    barrier();

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x < int(viewport_size.x) && pixel.y < int(viewport_size.y)) {
        float depth = texelFetch(depth_texture, pixel, 0).r;
        uint depth_uint = floatBitsToUint(depth);
        atomicMin(min_depth_uint, depth_uint);
        atomicMax(max_depth_uint, depth_uint);
    }
    barrier();

    float min_depth = uintBitsToFloat(min_depth_uint);
    float max_depth = uintBitsToFloat(max_depth_uint);

    // If tile has no valid depth, skip
    if (min_depth >= 1.0) {
        if (local_index == 0) {
            tile_data[tile_index] = 0;
        }
        return;
    }

    // Phase 2: Build tile frustum planes in view space
    vec2 tile_min = vec2(tile_x * 16, tile_y * 16);
    vec2 tile_max = min(tile_min + vec2(16.0), vec2(viewport_size));

    // Four corner points in view space at the near and far depth
    vec4 corners[4];
    corners[0] = screen_to_view(tile_min, min_depth);
    corners[1] = screen_to_view(vec2(tile_max.x, tile_min.y), min_depth);
    corners[2] = screen_to_view(tile_max, min_depth);
    corners[3] = screen_to_view(vec2(tile_min.x, tile_max.y), min_depth);

    // Frustum planes: left, right, bottom, top, near, far
    // For tile culling, we use the simpler approach of testing view-space depth bounds
    // and view-space XY tile bounds at min/max depth
    float near_z = screen_to_view(tile_min, min_depth).z;
    float far_z = screen_to_view(tile_min, max_depth).z;

    // View-space AABB of the tile frustum
    vec4 near_tl = screen_to_view(tile_min, min_depth);
    vec4 near_br = screen_to_view(tile_max, min_depth);
    vec4 far_tl = screen_to_view(tile_min, max_depth);
    vec4 far_br = screen_to_view(tile_max, max_depth);

    vec3 aabb_min = min(min(near_tl.xyz, near_br.xyz), min(far_tl.xyz, far_br.xyz));
    vec3 aabb_max = max(max(near_tl.xyz, near_br.xyz), max(far_tl.xyz, far_br.xyz));

    // Phase 3: Cull lights
    uint point_count = ubo.tile_info.z;
    uint spot_count = ubo.tile_info.w;
    uint thread_count = 16 * 16;

    // Point lights
    for (uint i = local_index; i < point_count; i += thread_count) {
        vec4 pos_radius = point_lights[i].position_radius;
        vec3 light_pos = pos_radius.xyz;
        float radius = pos_radius.w;

        // Transform light to view space
        vec3 view_pos = (ubo.view * vec4(light_pos, 1.0)).xyz;

        // AABB-sphere test in view space
        vec3 closest = clamp(view_pos, aabb_min, aabb_max);
        vec3 diff = view_pos - closest;
        if (dot(diff, diff) < radius * radius) {
            uint slot = atomicAdd(tile_light_count, 1);
            if (slot < MAX_LIGHTS_PER_TILE) {
                tile_data[total_tiles + tile_index * MAX_LIGHTS_PER_TILE + slot] = i;
            }
        }
    }

    // Spot lights (treated as bounding spheres for culling)
    for (uint i = local_index; i < spot_count; i += thread_count) {
        vec4 pos_radius = spot_lights[i].position_radius;
        vec3 light_pos = pos_radius.xyz;
        float radius = pos_radius.w;

        vec3 view_pos = (ubo.view * vec4(light_pos, 1.0)).xyz;

        vec3 closest = clamp(view_pos, aabb_min, aabb_max);
        vec3 diff = view_pos - closest;
        if (dot(diff, diff) < radius * radius) {
            uint slot = atomicAdd(tile_light_count, 1);
            if (slot < MAX_LIGHTS_PER_TILE) {
                // Spot lights indexed after point lights: offset by 1024
                tile_data[total_tiles + tile_index * MAX_LIGHTS_PER_TILE + slot] = 1024 + i;
            }
        }
    }

    barrier();

    // Write final count
    if (local_index == 0) {
        tile_data[tile_index] = min(tile_light_count, MAX_LIGHTS_PER_TILE);
    }
}
