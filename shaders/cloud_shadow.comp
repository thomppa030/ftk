#version 460

// Cloud shadow map: the sun's transmittance through the cloud layer over a
// square of ground that follows the camera. Each texel is a ground point;
// the cloud that shadows it is where the ray from that point toward the
// shadow-casting body meets the cloud sheet, so the shadows lean with a low
// sun and drift with the wind like the clouds in the sky do.

#include "fjell_global_ubo.glsl"
#include "fjell_environment.glsl"
#include "fjell_clouds_2d.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);

layout(set = 1, binding = 0, r8) uniform writeonly image2D shadow_out;

layout(push_constant) uniform PushConstants {
    vec2  min_xz;        // world corner of the map
    float size;          // metres across
    float texture_size;  // texels across
    float ground_y;      // height the ground is assumed at
    float time;
    vec2  pad;
} push;

// How dark the thickest cloud gets under a high sun: a little light always
// scatters through. Softer than it looks, because this multiplies a sun that
// is itself the brightest thing in the scene.
const float MAX_OCCLUSION = 0.7;

// Below this the sun is too low for a cloud shadow to mean anything: the ray
// to the cloud sheet travels kilometres sideways, so the shadow under your
// feet belongs to a cloud far over the horizon. Rather than snapping off at
// some threshold, the shadow fades out across this band, which is roughly the
// last twenty degrees before the horizon.
const float GRAZING_FADE_START = 0.34;   // sin(20 degrees)
const float GRAZING_FADE_END = 0.05;     // sin(3 degrees)

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push.texture_size) || coord.y >= int(push.texture_size)) return;

    vec2 uv = (vec2(coord) + 0.5) / push.texture_size;
    vec3 ground = vec3(push.min_xz.x + uv.x * push.size, push.ground_y, push.min_xz.y + uv.y * push.size);

    vec3 light_dir = normalize(ubo.light_direction.xyz);
    float coverage = env_ubo.weather0.x;
    // How much of a cloud shadow this sun can cast at all.
    float grazing = smoothstep(GRAZING_FADE_END, GRAZING_FADE_START, light_dir.y);
    if (grazing <= 0.0 || coverage <= 0.0) {
        imageStore(shadow_out, coord, vec4(1.0));
        return;
    }

    // The cloud point on the sun's ray through this ground point. Against the
    // same shell the sky traces, not a plane: the two disagree by tens of
    // metres with the sun at eight degrees and hundreds at four, which is far
    // more than this map's couple of metres per texel. Tracing a different
    // surface here would put the shadow somewhere the cloud casting it is not.
    float to_sheet = fjell_cloud_shell_distance(light_dir.y, ground.y, fjell_cloud_height);
    if (to_sheet <= 0.0) {
        imageStore(shadow_out, coord, vec4(1.0));
        return;
    }
    vec3 cloud = ground + light_dir * to_sheet;

    // The detail budget the sky uses is about what a *pixel* can resolve; this
    // map's texels are a couple of metres of ground apiece and it averages five
    // taps, so it resolves more than any view of it will. Asking for the whole
    // field keeps the shadow the cloud's own — a shadow map blurred to a
    // different octave count than the sky draws would put soft shadows under
    // crisp clouds.
    fjell_cloud_lod = 99.0;
    vec2 sheet = fjell_cloud_sheet_pos(cloud.xz, env_ubo.wind_drift.xy);

    // The front is judged from the camera, as the sky does.
    vec3 from_camera = normalize(cloud - ubo.camera_position.xyz);
    float mask = fjell_cloud_front_mask(from_camera, env_ubo.front.xy, env_ubo.front.z, env_ubo.front.w);

    // A cloud shadow is not a stencil: the cloud has depth, the sun has an
    // angular size, and a kilometre and a half of air lies between them and
    // the ground. Averaging a few taps across the sheet is what turns the
    // crisp edge the sky wants into the soft one the ground wants.
    // Measured in metres and converted, not written in sheet units: a sheet
    // unit is `fjell_cloud_size` metres, so a blur authored in units would
    // silently change width whenever the cloud size did, and the softness of
    // every shadow on the ground would ride on an unrelated dial.
    const float SOFTEN_METRES = 130.0;
    const float SOFTEN = SOFTEN_METRES * FJELL_CLOUD_SCALE;
    float amount = 0.0;
    amount += fjell_cloud_amount(sheet, coverage, env_ubo.weather0.y) * 0.4;
    amount += fjell_cloud_amount(sheet + vec2( SOFTEN, 0.0), coverage, env_ubo.weather0.y) * 0.15;
    amount += fjell_cloud_amount(sheet + vec2(-SOFTEN, 0.0), coverage, env_ubo.weather0.y) * 0.15;
    amount += fjell_cloud_amount(sheet + vec2(0.0,  SOFTEN), coverage, env_ubo.weather0.y) * 0.15;
    amount += fjell_cloud_amount(sheet + vec2(0.0, -SOFTEN), coverage, env_ubo.weather0.y) * 0.15;
    amount *= mask;

    float transmittance = 1.0 - clamp(amount, 0.0, 1.0) * MAX_OCCLUSION * grazing;
    imageStore(shadow_out, coord, vec4(transmittance));
}
