#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

// ── Screen-Space GI: trace ─────────────────────────────────────────────
// Traces cosine-weighted hemisphere rays from screen probes, one ray per
// invocation, and stores the radiance each one returns per probe per ray.
// A hit returns what its surface emits and nothing else: SS-GI supplements
// DDGI with smooth, per-pixel emissive GI that tracks moving objects without
// the probe grid's stepping artifacts. DDGI handles sun bounce indirect.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform SsGiConstants {
    mat4 view;
    mat4 projection;
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    mat4 prev_inv_view_proj;
    vec3 camera_position;
    float max_trace_dist;
    vec2 resolution;
    uint probe_spacing;
    uint frame_index;
    uvec2 probe_count;
    float trace_cell_size;
    float pad1;
    vec4 sun_direction_intensity;
    vec4 sun_color;
};

layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 2) uniform sampler2D depth_tex;
layout(set = 0, binding = 3) uniform sampler2D normal_tex;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D radiance_out;

layout(push_constant) uniform PushConstants {
    uint rays_per_probe;
    uint ray_offset;
};

#include "include/fjell_common.glsl"

// ── Material access (set 1 = bindless) ──────────────────────────────────

#include "fjell_gpu_types.glsl"

layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

// ── Traced geometry (set 0, bindings 6-8) ───────────────────────────────

#define FJELL_RT_VERTEX_BINDING   6
#define FJELL_RT_INDEX_BINDING    7
#define FJELL_RT_INSTANCE_BINDING 8
#include "fjell_rt_hit.glsl"

float halton(uint index, uint base) {
    float f = 1.0;
    float r = 0.0;
    uint i = index;
    while (i > 0u) {
        f /= float(base);
        r += f * float(i % base);
        i /= base;
    }
    return r;
}

uint hash_probe(uint x) {
    x ^= x >> 16u;
    x *= 0x45d9f3bu;
    x ^= x >> 16u;
    x *= 0x45d9f3bu;
    x ^= x >> 16u;
    return x;
}

// Extended hemisphere: z ranges from Z_MIN to 1.0
// Z_MIN < 0 lets rays reach slightly below the surface horizon,
// catching emissive objects at the same height as the probe.
const float Z_MIN = -0.3;

// How far a ray starts from the surface that spawned it. The minimum is what
// a surface traced against itself needs; the scale is how much of a coarse
// cell's length a ray has to clear when the traced geometry is coarser than
// what was shaded. See the ray origin in main().
const float SS_GI_RAY_BIAS_MIN = 0.05;
const float SS_GI_RAY_BIAS_SLOPE_SCALE = 0.75;

vec3 extended_hemisphere(vec2 xi) {
    float z = mix(Z_MIN, 1.0, xi.x);
    float r = sqrt(max(0.0, 1.0 - z * z));
    float theta = 2.0 * PI * xi.y;
    return vec3(r * cos(theta), r * sin(theta), z);
}

mat3 build_tbn(vec3 N) {
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    return mat3(T, B, N);
}

vec3 world_from_depth(vec2 uv, float depth) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = inv_view_proj * ndc;
    return world.xyz / world.w;
}

// The radiance a ray brings back: what the surface it hits emits, or nothing
// when it misses (the sky reaches surfaces through IBL, not through SS-GI).
vec3 trace_emission(vec3 origin, vec3 direction) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF,
                          origin, 0.01, direction, max_trace_dist);
    // Every instance is opaque, so there is no candidate to judge.
    while (rayQueryProceedEXT(q)) {}

    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return vec3(0.0);
    }
    RtSurface surface;
    if (!rt_resolve_hit(rt_committed_hit(q), surface)) {
        return vec3(0.0);
    }
    vec2 uv = rt_surface_uv(surface);
    return rt_surface_emission(surface, uv);
}

void main() {
    uint probe_x = gl_GlobalInvocationID.x;
    uint probe_y = gl_GlobalInvocationID.y;
    uint ray_index = gl_GlobalInvocationID.z;

    if (probe_x >= probe_count.x || probe_y >= probe_count.y) return;
    if (ray_index >= rays_per_probe) return;

    ivec2 out_coord = ivec2(probe_x, probe_y * rays_per_probe + ray_index);

    vec2 pixel = (vec2(probe_x, probe_y) + 0.5) * float(probe_spacing);
    vec2 uv = pixel / resolution;

    if (uv.x > 1.0 || uv.y > 1.0) {
        imageStore(radiance_out, out_coord, vec4(0.0));
        return;
    }

    float depth = textureLod(depth_tex, uv, 0).r;
    if (depth >= 1.0) {
        imageStore(radiance_out, out_coord, vec4(0.0));
        return;
    }

    vec3 world_pos = world_from_depth(uv, depth);
    vec2 normal_enc = textureLod(normal_tex, uv, 0).rg;
    vec3 normal = oct_decode(normal_enc);

    mat3 tbn = build_tbn(normal);

    // Extended hemisphere around the surface normal. Z_MIN = -0.3 lets
    // rays reach ~17° below the horizon, catching emissive objects at
    // the same height as the probe without tracing deep into the surface.
    // ray_offset advances the sequence every frame, so successive frames
    // sample different directions and the temporal blend converges instead
    // of averaging one fixed pattern. Without it a small bright emitter is
    // either hit by a fixed ray or missed entirely, and the probe flips
    // between the two as the camera shifts it by a pixel.
    uint probe_id = probe_x + probe_y * probe_count.x;
    uint hashed = hash_probe(probe_id);
    uint seq_index = (hashed + ray_offset + ray_index) & 0xFFFFu;
    vec2 xi = vec2(halton(seq_index + 1u, 2u), halton(seq_index + 1u, 3u));
    vec3 local_dir = extended_hemisphere(xi);
    vec3 ray_dir = normalize(tbn * local_dir);

    // Start the ray clear of the surface it traces against, which is not the
    // surface it was shaded from. Terrain is rasterized from the full-
    // resolution height texture and traced against a decimated mesh
    // (TerrainAsset::build_ray_mesh), so between two of the coarse mesh's
    // vertices the two disagree by roughly half the height the real ground
    // covers over one coarse cell — nothing on the flat, most of a metre on a
    // slope. A ray launched from the rasterized position starts inside the
    // traced terrain there, hits it at once, and reports the ground occluding
    // itself as indirect light.
    //
    // `local_dir.z` is the ray's cosine against the normal, and the hemisphere
    // is deliberately extended below the horizon (Z_MIN), so it runs from -0.3
    // to 1. `1 - z` is what the clearance follows: greatest for the rays
    // aimed under the surface, none for one leaving straight along the normal.
    // Taking the magnitude instead would give the below-horizon rays less
    // clearance than a tangent one, which is backwards — they are the ones
    // that travel furthest through the gap.
    float bias = max(SS_GI_RAY_BIAS_MIN,
                     trace_cell_size * SS_GI_RAY_BIAS_SLOPE_SCALE
                         * (1.0 - local_dir.z));
    vec3 ray_origin = world_pos + normal * bias;

    // Every ray contributes, a miss as zero. Excluding misses would bias
    // probes that trace more toward geometry to have brighter averages.
    vec3 radiance = min(trace_emission(ray_origin, ray_dir), vec3(20.0));

    imageStore(radiance_out, out_coord, vec4(radiance, 1.0));
}
