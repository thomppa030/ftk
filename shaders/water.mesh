#version 460
#extension GL_EXT_mesh_shader : require

// The water's surface for the colour draw: where each vertex lands, shared
// with the depth prepass through fjell_water_mesh.glsl, and then everything
// the fragment stage shades it by — its slopes, its fold, how it moved.
#include "fjell_water_mesh.glsl"

// The simulated sea's previous frame and its derivatives, beside the
// displacement the placement reads.
//   previous:     xyz offset in world axes, w d(offset x)/dz, a frame ago
//   derivatives:  x dh/dx, y dh/dz, z d(offset x)/dx, w d(offset z)/dz
layout(set = 2, binding = 3) uniform sampler2D simulated_previous;
layout(set = 2, binding = 4) uniform sampler2D simulated_derivatives;

// Matches mesh.vert's interface so water shares the scene's fragment
// conventions, plus the two the wave field alone can answer.
layout(location = 0) out vec3 frag_color[];
layout(location = 1) out vec2 frag_tex_coord[];
layout(location = 2) out vec3 frag_world_pos[];
layout(location = 3) out vec3 frag_world_normal[];
layout(location = 4) out vec4 frag_clip_pos[];
layout(location = 5) out vec4 frag_prev_clip_pos[];
// How far the wave lifted this vertex above the flat surface, and how pinched
// the surface is here. Both come out of the same evaluation the displacement
// does, so passing them costs nothing and saves the fragment stage from
// solving the wave field a second time.
layout(location = 6) out float frag_wave_lift[];
layout(location = 7) out float frag_crest[];
// How much of its height the water here has lost to breaking on the ground
// under it: 0 in water deep enough to carry the sea, 1 at the waterline.
layout(location = 8) out float frag_breaking[];
// How much of the swash this vertex carries: 1 at and above the still
// waterline, fading to 0 seaward.
layout(location = 9) out float frag_swash[];

void main() {
    SetMeshOutputsEXT(MAX_VERTS, MAX_TRIS);

    float time = ubo.time;

    // Vertices: position comes from the invocation index, not a vertex buffer.
    // The loop strides by workgroup size because MAX_VERTS exceeds it.
    for (uint i = gl_LocalInvocationIndex; i < MAX_VERTS; i += 64) {
        FjellWaterVertex v = fjell_water_vertex(i, time);
        vec2 rest = v.rest;
        FjellShoreEffect shore = v.shore;

        // Where the surface is measured across, for a shader that wants it.
        // A placed square has a 0..1 across itself; an infinite one has no
        // edges to measure from, so it gets metres and the shader is told as
        // much by the sea having no size.
        vec2 surface_uv = push.infinite != 0u
            ? rest
            : (rest - push.world_origin) / push.world_size;

        // The closed-form contributors' slopes and fold terms, read where the
        // warp reads them, carried through the warp to the world's axes and
        // then through the shore that scaled them. Neither moves, so the
        // previous frame's surface is read and scaled the same way.
        vec3 prev_offset = fjell_water_displace(v.trains_at, time - push.delta_time) * shore.gerstner;
        FjellWaterTangents tangents = fjell_water_shore_tangents(
            fjell_water_warp_tangents(fjell_water_tangents(v.trains_at, time), v.warp.trains.jacobian),
            v.trains, shore.gerstner, shore.gerstner_gradient);
        FjellWaterJacobian jacobian = fjell_water_shore_jacobian(
            fjell_water_warp_jacobian(fjell_water_jacobian_terms(v.trains_at, time),
                                      v.warp.trains.jacobian),
            v.trains, shore.gerstner, shore.gerstner_gradient);

        // The simulated contributor, into the same sums. Displacements add,
        // and so do their derivatives, which is why the normal and the fold
        // measure are taken after this and not before.
        if (water.field.simulated_patch_size > 0.0) {
            vec4 moved = v.simulated;
            vec4 slopes = textureLod(simulated_derivatives, v.simulated_uv, v.simulated_lod);
            float factor = shore.simulated;
            vec2 slope = shore.simulated_gradient;
            prev_offset += textureLod(simulated_previous, v.simulated_uv, v.simulated_lod).xyz * factor;

            // Its slopes along the axes it was read in, carried through the
            // warp to the world's; then, scaled by a factor that changes
            // across the ground, it changes across it by the factor's slope
            // times what it moves the point by as well as by the factor times
            // its own slope.
            mat2 warp = v.warp.simulated.jacobian;
            vec3 read_dx = vec3(slopes.z, slopes.x, moved.w);
            vec3 read_dz = vec3(moved.w, slopes.y, slopes.w);
            vec3 along_x = ((read_dx * warp[0].x) + (read_dz * warp[0].y)) * factor + (moved.xyz * slope.x);
            vec3 along_z = ((read_dx * warp[1].x) + (read_dz * warp[1].y)) * factor + (moved.xyz * slope.y);
            tangents.binormal += along_x;
            tangents.tangent  += along_z;
            jacobian.xx += along_x.x;
            jacobian.zx += along_x.z;
            jacobian.xz += along_z.x;
            jacobian.zz += along_z.z;
        }

        // The wakes, vertically only: their height was placed with the vertex,
        // and they tilt the surface without touching the fold measure.
        if (push.wake_count > 0u) {
            FjellWakeSurface prev_wake = fjell_water_wake_surface(
                push.wake_first, push.wake_count, rest, time - push.delta_time,
                fjell_water_wake_cell(v));
            prev_offset.y += prev_wake.height;
            tangents.binormal.y += v.wake.slope.x;
            tangents.tangent.y += v.wake.slope.y;
        }

        // The swash: its slope from the arriving sea's slope along the
        // shore, and where it stood a frame ago from the sea arriving then,
        // both read where the warp reads the waterline.
        if (v.swash.applies) {
            vec2 arriving_slope = vec2(0.0);
            float arriving_before = 0.0;
            if (v.swash.swing > 0.0f) {
                FjellWaterWarp there_warp = fjell_water_warp_at(v.swash.waterline);
                vec2 trains_there = v.swash.waterline + there_warp.trains.offset;
                FjellWaterTangents there = fjell_water_warp_tangents(
                    fjell_water_tangents(trains_there, time), there_warp.trains.jacobian);
                arriving_slope = vec2(there.binormal.y, there.tangent.y);
                arriving_before = fjell_water_displace(trains_there, time - push.delta_time).y;
                if (water.field.simulated_patch_size > 0.0) {
                    float texels = float(textureSize(simulated_displacement, 0).x);
                    vec2 uv = (v.swash.waterline + there_warp.simulated.offset)
                            / water.field.simulated_patch_size + 0.5 / texels;
                    vec2 read = textureLod(simulated_derivatives, uv, v.simulated_lod).xy;
                    mat2 warp = there_warp.simulated.jacobian;
                    arriving_slope += vec2(dot(read, warp[0]), dot(read, warp[1]));
                    arriving_before += textureLod(simulated_previous, uv, v.simulated_lod).y;
                }
            }
            FjellSwash now = fjell_water_swash_from(v.swash, v.swash_arriving, arriving_slope, 0.0);
            tangents.binormal.y += now.gradient.x;
            tangents.tangent.y += now.gradient.y;
            prev_offset.y += fjell_water_swash_from(v.swash, arriving_before, vec2(0.0), 0.0).lift;
        }

        vec3 world_pos = fjell_water_world_position(v);

        gl_MeshVerticesEXT[i].gl_Position = ubo.projection * ubo.view * vec4(world_pos, 1.0);

        frag_color[i] = vec3(1.0);
        frag_tex_coord[i] = surface_uv;
        frag_world_pos[i] = world_pos;
        frag_world_normal[i] = fjell_water_normal_from(tangents);
        frag_clip_pos[i] = ubo.unjittered_vp * vec4(world_pos, 1.0);

        // The sea moves, so the previous frame's position is where this
        // vertex was one frame ago rather than where it is now — motion
        // vectors want the surface's own motion, not just the camera's.
        vec3 prev_world = vec3(rest.x + prev_offset.x,
                               push.surface_height + prev_offset.y,
                               rest.y + prev_offset.z);
        frag_prev_clip_pos[i] = ubo.prev_unjittered_vp * vec4(prev_world, 1.0);

        frag_wave_lift[i] = v.offset.y;
        frag_crest[i] = clamp(1.0 - fjell_water_determinant(jacobian), 0.0, 1.0);
        frag_breaking[i] = shore.breaking;
        frag_swash[i] = v.swash.applies ? v.swash.share : 0.0;
    }

    fjell_water_patch_triangles();
}
