#version 460

#include "fjell_atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray cubemap;

layout(push_constant) uniform PushConstants {
    vec4 top_color;
    vec4 bottom_color;
    vec4 light_direction;   // xyz = dir toward sun, w = sun intensity
    vec4 light_color;       // xyz = rgb, w unused
    uint face_size;
    uint sky_mode;          // 0 = gradient, 2 = atmospheric scattering
    float atmosphere_rayleigh_scale;
    float atmosphere_mie_scale;
    float atmosphere_mie_g;
    float atmosphere_sun_intensity;
    float atmosphere_mie_coeff;
    float padding0;
};

vec3 cube_dir(uint face, vec2 uv) {
    vec3 dir;
    switch (face) {
        case 0: dir = vec3( 1.0, -uv.y, -uv.x); break; // +X
        case 1: dir = vec3(-1.0, -uv.y,  uv.x); break; // -X
        case 2: dir = vec3( uv.x,  1.0,  uv.y); break; // +Y
        case 3: dir = vec3( uv.x, -1.0, -uv.y); break; // -Y
        case 4: dir = vec3( uv.x, -uv.y,  1.0); break; // +Z
        case 5: dir = vec3(-uv.x, -uv.y, -1.0); break; // -Z
    }
    return normalize(dir);
}

void main() {
    uint face = gl_GlobalInvocationID.z;
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(face_size) || coord.y >= int(face_size) || face >= 6) return;

    vec2 uv = (vec2(coord) + 0.5) / float(face_size) * 2.0 - 1.0;
    vec3 dir = cube_dir(face, uv);

    vec3 color;
    if (sky_mode >= 2u) {
        // Atmosphere mode for IBL: same idea as the sky pass — compute the
        // atmospheric tint, then modulate a gradient backdrop. (When an HDRI
        // is present the engine routes IBL through the HDRI cubemap instead
        // of this compute pass, so we only need the gradient path here.)
        AtmosphereParams ap = make_default_atmosphere_params();
        ap.rayleigh_scale = atmosphere_rayleigh_scale;
        ap.mie_scale      = atmosphere_mie_scale;
        ap.mie_g          = atmosphere_mie_g;
        ap.mie_coeff      = atmosphere_mie_coeff;
        ap.sun_color      = light_color.rgb;
        ap.sun_intensity  = atmosphere_sun_intensity;
        ap.primary_steps  = 12;  // cubemap runs once per param change, can afford fewer steps
        ap.secondary_steps = 6;
        vec3 sun_dir = normalize(light_direction.xyz);
        vec3 tint = atmosphere(dir, sun_dir, ap);
        float t = dir.y * 0.5 + 0.5;
        vec3 gradient = mix(bottom_color.rgb, top_color.rgb, t);
        color = gradient * max(tint, vec3(0.05));
    } else {
        float t = dir.y * 0.5 + 0.5;
        color = mix(bottom_color.rgb, top_color.rgb, t);
    }

    imageStore(cubemap, ivec3(coord, face), vec4(color, 1.0));
}
