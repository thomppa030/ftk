#version 460

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "fjell_ddgi.glsl"

// Turns the GPU-side count of live probes into trace dispatch arguments.
//
// The number of probes that exist is only known on the GPU — the mark and
// alloc passes decide it — so the trace has to be sized from a buffer
// rather than from a value the CPU could have written. Lumen does the same
// thing (RadianceCacheHardwareRayTracingIndirectArgs built from
// ProbeTraceAllocator).
//
// Without this the trace would be bounded by a CPU-side upper bound, which
// with demand-driven allocation is the whole probe pool: almost every
// launched ray would find an empty slot and return.

layout(std430, set = 0, binding = 1) readonly buffer TraceList {
    uint trace_count;
    uint trace_slots[];
};

// VkTraceRaysIndirectCommandKHR: width, height, depth.
layout(std430, set = 0, binding = 2) writeonly buffer TraceArgs {
    uint args_width;
    uint args_height;
    uint args_depth;
};

layout(push_constant) uniform PushConstants {
    // Round-robin window over the trace list, so a large live set is still
    // spread across frames rather than traced all at once.
    uint update_offset;
    uint update_count;
};

void main() {
    // Rows remaining after the window's start, clamped to the budget.
    uint live = trace_count;
    uint remaining = (update_offset < live) ? (live - update_offset) : 0u;
    uint rows = min(remaining, update_count);

    args_width = uint(ddgi.probe_rays);
    args_height = rows;
    args_depth = 1u;
}
