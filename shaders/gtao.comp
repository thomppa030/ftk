#version 460

// GTAO: Ground Truth Ambient Occlusion (Jimenez 2016)
// Horizon-based with analytic cosine-weighted integration.

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 0, binding = 4) uniform sampler2D depth_texture;

layout(set = 1, binding = 0, r8) uniform writeonly image2D ao_output;

layout(push_constant) uniform PushConstants {
    float radius;
    float intensity;
    float thickness;
    float max_pixel_radius;
    uvec2 viewport_size;      // half-res (AO image dimensions)
    uvec2 full_viewport_size; // full-res (depth texture dimensions)
};

const int NUM_DIRECTIONS = 4;
const int NUM_STEPS = 4;

// ── Utility ────────────────────────────────────────────────────────────

float fast_acos(float x) {
    float ax = abs(x);
    float u = ((-0.20491203466059038 + 0.04832927023878897 * ax) * ax + 1.5707963267948966)
              * sqrt(max(0.0, 1.0 - ax));
    return x >= 0.0 ? u : PI - u;
}

// Interleaved gradient noise
float ign(vec2 pos) {
    return fract(52.9829189 * fract(0.06711056 * pos.x + 0.00583715 * pos.y));
}

// ── View-space reconstruction ──────────────────────────────────────────

// Map half-res AO coord to full-res depth coord
ivec2 to_full_res(ivec2 half_coord) {
    return clamp(half_coord * 2 + 1, ivec2(0), ivec2(full_viewport_size) - 1);
}

vec3 reconstruct_view_pos(ivec2 coord, float depth) {
    // Use full viewport for NDC reconstruction (projection is full-res)
    vec2 ndc = (vec2(coord) + 0.5) / vec2(full_viewport_size) * 2.0 - 1.0;
    vec4 vpos = ubo.inv_projection * vec4(ndc, depth, 1.0);
    return vpos.xyz / vpos.w;
}

// The bound depth sampler is VK_FILTER_NEAREST, so filter manually rather
// than relying on the sampler. Interpolating depth across a silhouette is
// wrong, but the horizon march only needs a monotone estimate here and the
// thickness test rejects samples that straddle a large discontinuity.
float sample_depth_bilinear(vec2 full_coord) {
    vec2 f = fract(full_coord);
    ivec2 b = ivec2(floor(full_coord));
    ivec2 hi = ivec2(full_viewport_size) - 1;
    ivec2 c00 = clamp(b,               ivec2(0), hi);
    ivec2 c10 = clamp(b + ivec2(1, 0), ivec2(0), hi);
    ivec2 c01 = clamp(b + ivec2(0, 1), ivec2(0), hi);
    ivec2 c11 = clamp(b + ivec2(1, 1), ivec2(0), hi);
    float d00 = texelFetch(depth_texture, c00, 0).r;
    float d10 = texelFetch(depth_texture, c10, 0).r;
    float d01 = texelFetch(depth_texture, c01, 0).r;
    float d11 = texelFetch(depth_texture, c11, 0).r;
    return mix(mix(d00, d10, f.x), mix(d01, d11, f.x), f.y);
}

// Continuous-coordinate variant. full_coord is a full-res pixel coordinate
// that need not land on a texel centre — the horizon march steps by fractional
// pixel distances, and snapping those to texels quantises the sampled set into
// visible depth-banded stripes.
vec3 reconstruct_view_pos_f(vec2 full_coord, float depth) {
    vec2 ndc = (full_coord + 0.5) / vec2(full_viewport_size) * 2.0 - 1.0;
    vec4 vpos = ubo.inv_projection * vec4(ndc, depth, 1.0);
    return vpos.xyz / vpos.w;
}

vec3 reconstruct_normal(vec3 vpos, ivec2 full_coord) {
    ivec2 cR = min(full_coord + ivec2(2, 0), ivec2(full_viewport_size) - 1);
    ivec2 cL = max(full_coord - ivec2(2, 0), ivec2(0));
    ivec2 cU = min(full_coord + ivec2(0, 2), ivec2(full_viewport_size) - 1);
    ivec2 cD = max(full_coord - ivec2(0, 2), ivec2(0));

    vec3 pr = reconstruct_view_pos(cR, texelFetch(depth_texture, cR, 0).r);
    vec3 pl = reconstruct_view_pos(cL, texelFetch(depth_texture, cL, 0).r);
    vec3 pu = reconstruct_view_pos(cU, texelFetch(depth_texture, cU, 0).r);
    vec3 pd = reconstruct_view_pos(cD, texelFetch(depth_texture, cD, 0).r);

    vec3 dx = (pr - pl) * 0.5;
    vec3 dy = (pu - pd) * 0.5;

    vec3 n = cross(dx, dy);
    float len = length(n);
    return len > 1e-10 ? n / len : vec3(0.0, 0.0, -1.0);
}

// ── GTAO integration ──────────────────────────────────────────────────

// Analytic cosine-weighted AO for a single slice given two horizon angles
// h1, h2: horizon angles (radians), n: projected normal angle on the slice
float integrate_arc(float h1, float h2, float n) {
    float cosN = cos(n);
    float sinN = sin(n);
    return 0.25 * (-cos(2.0 * h1 - n) + cosN + 2.0 * h1 * sinN)
         + 0.25 * (-cos(2.0 * h2 - n) + cosN + 2.0 * h2 * sinN);
}

// ── Main ───────────────────────────────────────────────────────────────

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(viewport_size.x) || coord.y >= int(viewport_size.y)) return;

    // Map half-res pixel to full-res depth texture
    ivec2 full_coord = to_full_res(coord);
    float depth = texelFetch(depth_texture, full_coord, 0).r;
    if (depth >= 1.0) {
        imageStore(ao_output, coord, vec4(1.0));
        return;
    }

    vec3 viewPos = reconstruct_view_pos(full_coord, depth);
    vec3 viewNormal = reconstruct_normal(viewPos, full_coord);
    // Horizons are searched against the view vector; the surface normal is
    // applied afterwards when integrating the arc. Searching against the
    // normal and then clamping to it again double-counts the normal.
    vec3 viewDir = normalize(-viewPos);

    // Project world-space radius to screen pixels (half-res pixel space)
    float pixelsPerWorldUnit = (0.5 * float(viewport_size.y)) / abs(viewPos.z);
    float screenRadius = radius * pixelsPerWorldUnit;
    screenRadius = min(screenRadius, max_pixel_radius);

    float ao_strength = smoothstep(0.5, 1.5, screenRadius);
    if (ao_strength <= 0.0) {
        imageStore(ao_output, coord, vec4(1.0));
        return;
    }
    screenRadius = max(screenRadius, 1.0);

    // Screen-space clamps above can cap the march short of `radius`; measure
    // rejection and falloff against the distance actually covered.
    float worldRadius = screenRadius / max(pixelsPerWorldUnit, 1e-6);

    float noise = ign(vec2(coord));
    float stepSize = screenRadius / float(NUM_STEPS);
    float stepJitter = 0.5 + noise;

    float ao = 0.0;

    for (int dirIdx = 0; dirIdx < NUM_DIRECTIONS; ++dirIdx) {
        // Evenly spaced directions with per-pixel rotation
        float angle = (PI / float(NUM_DIRECTIONS)) * (float(dirIdx) + noise);
        vec2 direction = vec2(cos(angle), sin(angle));

        // Find horizon angles by marching in both directions
        float horizonCosPos = -1.0;
        float horizonCosNeg = -1.0;

        // March positive direction
        for (int step = 1; step <= NUM_STEPS; ++step) {
            // Enforce a minimum per-step separation (Unreal's
            // max(SearchRadius * (fi + Offset), fi + 1)). Without it, a small
            // stepSize puts every step on the same texel, the horizon search
            // degenerates to one repeated sample, and AO goes flat — the
            // plateaus that read as stripes across a receding surface.
            float stepDist = max((float(step) - 1.0 + stepJitter) * stepSize,
                                 float(step));
            vec2 offset = direction * stepDist;
            // Step in full-res pixels and sample without snapping to a texel.
            vec2 fullCoord = vec2(to_full_res(coord)) + offset * 2.0;
            fullCoord = clamp(fullCoord, vec2(0.0), vec2(full_viewport_size) - 1.0);

            float sampleDepth = sample_depth_bilinear(fullCoord);
            if (sampleDepth >= 1.0) continue;

            vec3 samplePos = reconstruct_view_pos_f(fullCoord, sampleDepth);
            vec3 horizonVec = samplePos - viewPos;
            float horizonDist = length(horizonVec);

            if (horizonDist < 1e-4 || horizonDist > worldRadius) continue;

            // Thickness rejection: ignore samples much further away than
            // the AO radius — they're behind the surface, not occluders.
            // Thickness rejection: ignore samples much further from camera
            // than the current pixel (they're behind the surface).
            // In view space, Z is negative; more negative = further away.
            float depthDiff = samplePos.z - viewPos.z;
            if (depthDiff < -thickness) continue;

            float horizonCos = dot(horizonVec / horizonDist, viewDir);

            // Distance falloff — attenuate samples near the radius edge
            float falloff = clamp(1.0 - horizonDist / worldRadius, 0.0, 1.0);

            horizonCos = mix(-1.0, horizonCos, falloff);
            horizonCosPos = max(horizonCosPos, horizonCos);
        }

        // March negative direction
        for (int step = 1; step <= NUM_STEPS; ++step) {
            float stepDist = max((float(step) - 1.0 + stepJitter) * stepSize,
                                 float(step));
            vec2 offset = -direction * stepDist;
            // Step in full-res pixels and sample without snapping to a texel.
            vec2 fullCoord = vec2(to_full_res(coord)) + offset * 2.0;
            fullCoord = clamp(fullCoord, vec2(0.0), vec2(full_viewport_size) - 1.0);

            float sampleDepth = sample_depth_bilinear(fullCoord);
            if (sampleDepth >= 1.0) continue;

            vec3 samplePos = reconstruct_view_pos_f(fullCoord, sampleDepth);
            vec3 horizonVec = samplePos - viewPos;
            float horizonDist = length(horizonVec);

            if (horizonDist < 1e-4 || horizonDist > worldRadius) continue;

            // Thickness rejection: ignore samples much further from camera
            // than the current pixel (they're behind the surface).
            // In view space, Z is negative; more negative = further away.
            float depthDiff = samplePos.z - viewPos.z;
            if (depthDiff < -thickness) continue;

            float horizonCos = dot(horizonVec / horizonDist, viewDir);

            float falloff = clamp(1.0 - horizonDist / worldRadius, 0.0, 1.0);

            horizonCos = mix(-1.0, horizonCos, falloff);
            horizonCosNeg = max(horizonCosNeg, horizonCos);
        }

        // Convert horizon cosines to angles
        float h1 = -fast_acos(horizonCosPos);
        float h2 =  fast_acos(horizonCosNeg);

        // Project the normal onto the slice plane spanned by the search
        // direction and the view vector, then measure its angle from the
        // in-plane perpendicular (Unreal's Gamma in ComputeInnerIntegral).
        vec3 sliceDir = vec3(direction, 0.0);
        vec3 planeNormal = normalize(cross(sliceDir, viewDir));
        vec3 perp = cross(viewDir, planeNormal);
        vec3 projNormal = viewNormal - planeNormal * dot(viewNormal, planeNormal);
        float projLen = length(projNormal);

        float n_angle = 0.0;
        if (projLen > 1e-4) {
            projNormal /= projLen;
            float cosNAngle = clamp(dot(projNormal, perp), -1.0, 1.0);
            n_angle = fast_acos(cosNAngle) - PI * 0.5;
        }

        // Clamp horizon angles to hemisphere around projected normal
        h1 = max(h1, n_angle - PI * 0.5);
        h2 = min(h2, n_angle + PI * 0.5);

        // Analytic integration
        ao += integrate_arc(h1, h2, n_angle) * projLen;
    }

    ao /= float(NUM_DIRECTIONS);
    ao = clamp(pow(ao, intensity), 0.0, 1.0);
    ao = mix(1.0, ao, ao_strength);

    imageStore(ao_output, coord, vec4(ao, ao, ao, 1.0));
}
