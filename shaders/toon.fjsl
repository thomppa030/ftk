shader_type spatial;

// Stepped diffuse + a hard rim. Looks best with a flat ALBEDO and no
// normal map — drop on a sphere or character to see the bands snap.

uniform vec3 tint : hint_color = vec3(0.85, 0.45, 0.30);
uniform float band_count : hint_range(2.0, 8.0, 1.0) = 3.0;
uniform float specular_strength : hint_range(0.0, 2.0, 0.05) = 0.4;
uniform float specular_sharpness : hint_range(1.0, 256.0, 1.0) = 48.0;
uniform float rim_strength : hint_range(0.0, 2.0, 0.05) = 0.6;

void fragment() {
    ALBEDO *= tint;
}

void light() {
    // Quantize diffuse into N bands. Multiplying by NdotL is what the
    // caller does afterwards, so we divide it out and re-step on the
    // banded value to keep the bands flat.
    float bands = floor(NdotL * band_count) / band_count;
    vec3 diffuse = ALBEDO * bands;
    if (NdotL > 0.001) diffuse /= NdotL;
    DIFFUSE_LIGHT += diffuse;

    // Stylized specular: Blinn-Phong, thresholded to a single highlight.
    vec3 H = normalize(VIEW_DIR + LIGHT_DIR);
    float NdotH = max(dot(NORMAL, H), 0.0);
    float spec = pow(NdotH, specular_sharpness);
    spec = step(0.5, spec) * specular_strength;
    SPECULAR_LIGHT += vec3(spec);

    // Rim: brighten silhouettes facing this light.
    float rim = pow(1.0 - max(dot(NORMAL, VIEW_DIR), 0.0), 2.0);
    rim *= step(0.0, NdotL);
    DIFFUSE_LIGHT += rim * rim_strength * ALBEDO;
}
