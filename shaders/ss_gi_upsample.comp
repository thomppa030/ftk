#version 460

// ── Screen-Space GI: Bilateral Upsample ───────────────────────────────
// Upsamples from probe resolution to half-res indirect. Applies a
// bilateral Gaussian blur (sigma=3, 11x11 kernel) across the probe grid
// to smooth probe-to-probe variance. Depth and normal weights prevent
// bleeding across geometric edges.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D resolved_probes; // probe_count.x × probe_count.y
layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2) uniform sampler2D normal_tex;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D indirect_out;

layout(push_constant) uniform PushConstants {
    uvec2 output_size;       // half-res output dimensions
    uvec2 probe_count;
    uint probe_spacing;
    float pad0;
};

#include "include/fjell_common.glsl"

// Gaussian sigma = 3.0 probes — smooth falloff over the kernel
const float GAUSSIAN_SIGMA = 3.0;
const int KERNEL_RADIUS = 5;

float spatial_weight(vec2 d) {
    float d2 = dot(d, d);
    return exp(-d2 / (2.0 * GAUSSIAN_SIGMA * GAUSSIAN_SIGMA));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(output_size.x) || pixel.y >= int(output_size.y)) return;

    // Map half-res pixel to full-res
    vec2 full_pixel = vec2(pixel) * 2.0 + 1.0;
    vec2 screen_uv = full_pixel / vec2(output_size * 2u);

    // Skip sky
    float center_depth = textureLod(depth_tex, screen_uv, 0).r;
    if (center_depth >= 1.0) {
        imageStore(indirect_out, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 center_normal_enc = textureLod(normal_tex, screen_uv, 0).rg;
    vec3 center_normal = oct_decode(center_normal_enc);

    float spacing = float(probe_spacing);
    vec2 probe_coord = full_pixel / spacing - 0.5;
    ivec2 base_probe = ivec2(floor(probe_coord));

    // 11x11 bilateral Gaussian blur across probe grid
    vec3 sum = vec3(0.0);
    float total_weight = 0.0;

    for (int dy = -KERNEL_RADIUS; dy <= KERNEL_RADIUS; dy++) {
        for (int dx = -KERNEL_RADIUS; dx <= KERNEL_RADIUS; dx++) {
            ivec2 probe_id = base_probe + ivec2(dx, dy);
            if (probe_id.x < 0 || probe_id.y < 0 ||
                probe_id.x >= int(probe_count.x) || probe_id.y >= int(probe_count.y))
                continue;

            // Distance in probe units from the pixel's continuous probe_coord,
            // so the Gaussian shifts smoothly across cells instead of snapping.
            vec2 d = vec2(probe_id) - probe_coord;
            float g = spatial_weight(d);

            // Probe center in screen space for bilateral check
            vec2 probe_pixel = (vec2(probe_id) + 0.5) * spacing;
            vec2 probe_uv = probe_pixel / vec2(output_size * 2u);

            // Depth similarity
            float probe_depth = textureLod(depth_tex, probe_uv, 0).r;
            float depth_diff = abs(center_depth - probe_depth);
            float depth_threshold = max(0.01, center_depth * 0.05);
            float depth_w = exp(-depth_diff * depth_diff / (depth_threshold * depth_threshold));

            // Normal similarity. A raw clamped dot product falls to exactly
            // zero past 90 degrees, so near a silhouette or a wall/floor
            // junction every tap in the kernel can vanish at once. Raising a
            // biased dot to a power keeps the edge-stopping behaviour but
            // leaves a small non-zero tail, so the weights degrade smoothly.
            vec2 pn_enc = textureLod(normal_tex, probe_uv, 0).rg;
            vec3 pn = oct_decode(pn_enc);
            float ndot = max(0.0, dot(center_normal, pn));
            float normal_w = pow(ndot, 8.0) + 1e-3;

            float w = g * depth_w * normal_w;

            sum += texelFetch(resolved_probes, probe_id, 0).rgb * w;
            total_weight += w;
        }
    }

    // Falling back to black would punch a hard-edged hole into the bleed
    // wherever the bilateral weights collapse, since a neighbouring pixel
    // whose kernel survived keeps its full value. Use the probe covering
    // this pixel unfiltered instead: less smooth, but continuous.
    vec3 gi;
    if (total_weight > 1e-5) {
        gi = sum / total_weight;
    } else {
        ivec2 nearest = clamp(ivec2(round(probe_coord)), ivec2(0),
                              ivec2(probe_count) - 1);
        gi = texelFetch(resolved_probes, nearest, 0).rgb;
    }

    imageStore(indirect_out, pixel, vec4(gi, 1.0));
}
