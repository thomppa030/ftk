shader_type spatial;

// Stylized rim light + energy-shield look using the fresnel helpers
// from fjell_common.glsl. Standard PBR lighting underneath; the rim
// only writes EMISSION so it doesn't bake into ALBEDO and stays a
// pure additive overlay.

uniform vec3 rim_color : hint_color = vec3(0.3, 0.7, 1.0);
uniform float rim_power : hint_range(0.5, 8.0, 0.1) = 3.0;
uniform float rim_intensity : hint_range(0.0, 5.0, 0.05) = 1.5;

// Optional secondary "core glow" — keep visible across the whole
// surface, useful for shields / holograms. Set scale=0 to disable.
uniform vec3 core_color : hint_color = vec3(0.1, 0.3, 0.6);
uniform float core_bias : hint_range(0.0, 0.5, 0.01) = 0.08;
uniform float core_scale : hint_range(0.0, 2.0, 0.05) = 0.0;
uniform float core_power : hint_range(0.5, 4.0, 0.1) = 1.5;

void fragment() {
    float rim = fresnel_facing(NORMAL, VIEW_DIR, rim_power);
    EMISSION += rim_color * rim * rim_intensity;

    if (core_scale > 0.0) {
        float core = fresnel_bias_scale(NORMAL, VIEW_DIR,
                                        core_bias, core_scale, core_power);
        EMISSION += core_color * core;
    }
}
