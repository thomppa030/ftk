#version 460

// How stirred the air is, in a box that follows the camera. Where the motion
// field records that something passed, this holds what the air did about it
// afterwards, carried forward frame by frame.

#include "noise.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct GpuSource {
    vec4 position_radius;   // xyz world, w metres
    vec4 velocity_reach;    // xyz m/s, w metres of body above position
    vec4 strength;          // x scales what it displaces
};

layout(set = 0, binding = 0) readonly buffer SourceBuffer {
    GpuSource sources[];
};
layout(set = 0, binding = 1) uniform sampler3D density_prev;
layout(set = 0, binding = 2, r16f) uniform writeonly image3D density_out;

layout(push_constant) uniform PushConstants {
    vec4 origin_texel;          // xyz world min corner, w lateral texel size
    vec4 prev_origin_texel_y;   // xyz previous min corner, w vertical texel size
    vec4 extent_decay_dt;       // x lateral extent, y height, z 1/memory, w dt
    vec4 wind_fraction;         // xyz wind m/s, w how much of it applies
    uvec4 res_count;            // x res xz, y res y, z source count
    vec4 tuning;                // x spread, y wake width, z swirl, w carve
    float time;
    float buoyancy;
    float vortex_strength;
    float compression;
} pc;

// How coarse the eddies are and how fast they churn, in metres and in metres
// per second of drift through the noise.
const float SWIRL_METRES = 3.0;
const float SWIRL_DRIFT = 0.15;
const float TWO_PI = 6.28318530718;
// How far apart the rolls of a wake sit, in metres, and how far to the side of
// the path their cores lie as a share of the wake's own width. A body sheds
// them about five of its own widths apart; these are looser than that so a roll
// is several texels across and can be seen at all.
const float VORTEX_SPACING = 2.2;
const float VORTEX_OFFSET = 0.6;
// How far behind a body its rolls keep turning, in metres.
const float VORTEX_REACH = 6.0;
// How hard they turn, against the speed of what shed them.
const float VORTEX_STRENGTH = 0.45;

// Below this the air counts as still and the texel is cleared outright, so the
// field reaches exactly nothing rather than trailing an ever smaller number
// that keeps the pass awake.
const float DEADBAND = 1.0e-3;
// The most of the fog around it a texel may claim to have moved. Air is
// displaced, not destroyed.
const float MAX_MAGNITUDE = 1.0;
// How fast a source has to be going before it stirs anything.
const float STILL_SPEED = 0.05;
// The most a texel may gain or lose to the flow squeezing it in one frame.
// Convergence compounds, so without a ceiling a roll's core would run to the
// clamp in under a second and sit there.
const float MAX_SQUEEZE = 0.04;

vec3 box_extent() {
    return vec3(pc.extent_decay_dt.x, pc.extent_decay_dt.y, pc.extent_decay_dt.x);
}

/// Where a world position sits in the box this frame, and in the box as it
/// stood last frame. Two boxes because the field is carried forward from the
/// previous one, and between frames the box has slid along with the camera.
vec3 world_to_uv(vec3 world_pos) {
    return (world_pos - pc.origin_texel.xyz) / box_extent();
}

vec3 world_to_prev_uv(vec3 world_pos) {
    return (world_pos - pc.prev_origin_texel_y.xyz) / box_extent();
}

bool inside_box(vec3 uv) {
    return all(greaterThanEqual(uv, vec3(0.0))) && all(lessThanEqual(uv, vec3(1.0)));
}

float sample_prev(vec3 world_pos) {
    vec3 uv = world_to_prev_uv(world_pos);
    if (!inside_box(uv)) return 0.0;
    return texture(density_prev, uv).r;
}

/// The rolls a body sheds as it goes. Something moving through air does not
/// leave a straight wake behind it: the flow separates off one side and then
/// the other in turn, and each separation rolls up into a vortex that spins
/// opposite to the one before it. What trails away is two rows of counter-
/// rotating rolls rather than a line.
///
/// Built rather than simulated. The field is half a metre to a texel and a
/// real roll off a walker is about that wide, so the honest version would sit
/// under the resolution and read as nothing; these are scaled up until a roll
/// spans several texels and spaced by a period the source's own speed sets, so
/// they still lengthen as it runs and bunch as it slows.
///
/// Returned as a velocity to advect by, not as density: a roll that turns the
/// air carries whatever the wake already holds around with it, so the fog
/// curls instead of having rings drawn into it.
vec3 vortex_street(GpuSource src, vec3 world_pos, float strength) {
    vec3 flat_vel = vec3(src.velocity_reach.x, 0.0, src.velocity_reach.z);
    float speed = length(flat_vel);
    if (speed <= STILL_SPEED || strength <= 0.0) return vec3(0.0);

    vec3 heading = flat_vel / speed;
    vec3 across = vec3(-heading.z, 0.0, heading.x);
    vec3 to_point = world_pos - src.position_radius.xyz;

    // Where the point sits in the wake: how far behind the body, and how far
    // to one side of the path.
    float behind = -dot(to_point, heading);
    float side = dot(to_point, across);
    if (behind <= 0.0) return vec3(0.0);

    float width = max(src.position_radius.w, 0.05) * pc.tuning.y;

    // One roll per period of the street, and the sign flips from one to the
    // next — which is what makes the two rows turn against each other.
    float phase = behind / max(VORTEX_SPACING, 0.01);
    float turn = sin(phase * TWO_PI);

    // A roll sits off to one side, not on the path, and the side it sits on
    // alternates with it. Nothing turns along the centre line, which is where
    // the trough of the wake runs.
    float offset = side / max(width * VORTEX_OFFSET, 0.01);
    float lobe = offset * exp(-offset * offset);

    // Rolls are born at the body and spin down as they trail away.
    float age = exp(-behind / max(VORTEX_REACH, 0.01));

    // Turning about the upright axis: the air goes round the roll's core
    // rather than toward it.
    vec3 spin = cross(vec3(0.0, 1.0, 0.0), normalize(to_point + heading * 1e-3));
    return spin * turn * lobe * age * strength * speed * VORTEX_STRENGTH;
}

/// Which way the air at a point is going, and how fast. Nothing about this is
/// stored: a velocity field would be another volume to carry, and all three
/// terms here can be had from what is already to hand.
vec3 advect_velocity(vec3 world_pos, float here) {
    // Eddies. The curl of a noise field has no divergence, so advecting along
    // it turns the disturbance rather than blurring it away — the wake keeps
    // what it holds and only changes shape. Sampled in world space and crept
    // through with time, so the eddies belong to the ground rather than to the
    // camera, and a wake left in one place keeps turning the same way.
    vec3 swirl = curl_noise(world_pos / SWIRL_METRES + vec3(pc.time * SWIRL_DRIFT));

    // Air that piled up is denser than what surrounds it and settles; air that
    // was pushed out of the way is filled from above. Either way the sign of
    // the disturbance says which way it goes, and it is slight — this leans a
    // wake over several seconds rather than lifting it off the ground.
    vec3 rise = vec3(0.0, -here * pc.buoyancy, 0.0);

    // Stirred air goes with the weather. Without this a disturbance would sit
    // still in world space while the fog it lives in visibly drifts past it,
    // which reads as two things that are not the same air.
    vec3 wind = pc.wind_fraction.xyz * pc.wind_fraction.w;

    return swirl * pc.tuning.z + rise + wind;
}

/// The rolls every moving thing is shedding here, summed.
vec3 vortex_velocity(vec3 world_pos) {
    if (pc.vortex_strength <= 0.0) return vec3(0.0);
    vec3 total = vec3(0.0);
    for (uint i = 0u; i < pc.res_count.z; ++i) {
        total += vortex_street(sources[i], world_pos, pc.vortex_strength);
    }
    return total;
}

/// Everything moving the air here, as one velocity — what the advection steps
/// along, and what the divergence of the flow is taken of.
vec3 velocity_at(vec3 world_pos) {
    return advect_velocity(world_pos, 0.0) + vortex_velocity(world_pos);
}

/// How much of a body's push reaches a point: 1 along the axis of the capsule
/// it sweeps, falling to 0 at the edge of the wake it leaves.
float source_reach(GpuSource src, vec3 world_pos) {
    vec3 base = src.position_radius.xyz;
    // The body as a segment from its feet to its reach, so a crouching thing
    // stirs less air than a standing one and neither stirs what is over its
    // head.
    vec3 axis = vec3(0.0, max(src.velocity_reach.w, 0.01), 0.0);
    vec3 to_point = world_pos - base;
    float t = clamp(dot(to_point, axis) / dot(axis, axis), 0.0, 1.0);
    float dist = length(to_point - axis * t);

    // Never narrower than a couple of texels, whatever the body. A wake thinner
    // than the grid falls between the points that sample it and leaves nothing
    // at all — which is the difference between a walker and a car reading as a
    // difference in strength rather than in whether anything happened.
    float radius = max(src.position_radius.w * pc.tuning.y, pc.origin_texel.w * 2.0);
    // Falling off across the whole width rather than holding full strength in a
    // core and dropping outside it: a core sized to a body is under a texel
    // across, and what the grid can actually carry is the broad shape.
    return 1.0 - smoothstep(0.0, radius, dist);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (coord.x >= int(pc.res_count.x) || coord.y >= int(pc.res_count.y) ||
        coord.z >= int(pc.res_count.x)) {
        return;
    }

    vec3 res = vec3(float(pc.res_count.x), float(pc.res_count.y), float(pc.res_count.x));
    vec3 world_pos = pc.origin_texel.xyz + (vec3(coord) + 0.5) / res * box_extent();
    float dt = pc.extent_decay_dt.w;

    float here = sample_prev(world_pos);

    // Carried forward by asking what flowed into this texel rather than by
    // pushing what is in it somewhere else: the step is taken backwards along
    // the velocity and the answer read where it lands. Every invocation writes
    // only its own texel and reads only the field of a frame ago, which is what
    // makes the whole thing safe to do at once — and it is stable at any step,
    // unlike scattering forward.
    //
    // Expressed against the previous box rather than as a number of texels
    // scrolled: both boxes are snapped to whole texels, so with nothing moving
    // the step lands exactly on a texel centre and reads back the value stored
    // there. A box that was not snapped would land between eight texels every
    // frame, and a field filtered once a frame melts away.
    vec3 texel_size = box_extent() / res;
    vec3 vel = advect_velocity(world_pos, here) + vortex_velocity(world_pos);
    float field = sample_prev(world_pos - vel * dt);

    // Air that is flowing together gets denser, and air flowing apart thins —
    // which is what a roll does to the fog it is turning, and the part of a
    // wake that reads as something happening rather than as a patch sliding
    // about. Advection alone cannot show it: a step that asks what flowed in
    // conserves whatever it moves, however hard the flow is squeezing.
    //
    // How much the flow converges here is the divergence of it, so the same
    // three taps that turn the air also say where it is piling up. Clamped
    // because a strong convergence compounds every frame and would otherwise
    // run a texel to the ceiling and hold it there.
    if (pc.compression > 0.0) {
        vec3 dx = vec3(texel_size.x, 0.0, 0.0);
        vec3 dy = vec3(0.0, texel_size.y, 0.0);
        vec3 dz = vec3(0.0, 0.0, texel_size.z);
        float divergence =
            (velocity_at(world_pos + dx).x - velocity_at(world_pos - dx).x) / (2.0 * texel_size.x) +
            (velocity_at(world_pos + dy).y - velocity_at(world_pos - dy).y) / (2.0 * texel_size.y) +
            (velocity_at(world_pos + dz).z - velocity_at(world_pos - dz).z) / (2.0 * texel_size.z);
        float squeeze = clamp(-divergence * pc.compression * dt, -MAX_SQUEEZE, MAX_SQUEEZE);
        field *= 1.0 + squeeze;
    }

    // Air pushes on the air beside it, so a wake widens and softens as it ages.
    // With a signed field this is also how it dies: a trough and the heaps
    // beside it cancel as they run together, so the disturbance settles by
    // spreading into itself rather than by being faded out from under the eye.
    float neighbours =
        sample_prev(world_pos + vec3(texel_size.x, 0.0, 0.0)) +
        sample_prev(world_pos - vec3(texel_size.x, 0.0, 0.0)) +
        sample_prev(world_pos + vec3(0.0, texel_size.y, 0.0)) +
        sample_prev(world_pos - vec3(0.0, texel_size.y, 0.0)) +
        sample_prev(world_pos + vec3(0.0, 0.0, texel_size.z)) +
        sample_prev(world_pos - vec3(0.0, 0.0, texel_size.z));
    // A share per second, not per frame: the same spreading whatever the
    // framerate, and slow enough that a wake has time to drift and roll before
    // it has smoothed itself away.
    float bleed = 1.0 - exp(-pc.tuning.x * dt);
    field = mix(field, neighbours / 6.0, bleed);

    // And it forgets, on top of the spreading. Exponential so that it never
    // quite arrives and so there is no frame where it visibly stops.
    field *= exp(-pc.extent_decay_dt.z * dt);

    // What went through here this frame. A body shoves the air in front of it
    // aside: thin down the middle of its path, piled up around the edge of the
    // wake. The two very nearly cancel, which is what lets the field settle
    // back to nothing by spreading alone, and what keeps a walker from draining
    // the fog they walk through.
    for (uint i = 0u; i < pc.res_count.z; ++i) {
        GpuSource src = sources[i];
        float speed = length(src.velocity_reach.xyz);
        if (speed <= STILL_SPEED) continue;

        float reach = source_reach(src, world_pos);
        if (reach <= 0.0) continue;

        // Hollow along the axis and heaped at the rim: reach is 1 in the middle
        // and 0 at the edge, so this is negative where the body is and positive
        // in the shell of air it pushed into.
        float profile = reach * 2.0 - 1.0;
        float carve = profile * src.strength.x * pc.tuning.w * dt;
        field -= carve * reach;
    }

    field = clamp(field, -MAX_MAGNITUDE, MAX_MAGNITUDE);
    if (abs(field) < DEADBAND) field = 0.0;

    imageStore(density_out, coord, vec4(field, 0.0, 0.0, 0.0));
}
