#version 460

// Turns the drawn sea forward to now and lays it out for the transform.
//
// One half of a pair: water::evolve_spectrum() in water_spectrum.cpp computes
// the same three spectra on the CPU, and the engine compares the two through
// the whole transform when asked to (WaterFftPass). Change one and change the
// other, in the same shape.
//
// Each wavevector is written to the texel whose coordinates are its own with
// their bits reversed. The butterfly passes that follow are an in-place
// radix-2 transform, which wants its input in that order, and writing it there
// costs nothing where reordering it afterwards would cost a pass.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer Amplitudes {
    vec2 amplitudes[];   // real, imaginary; row-major, FFT order
} sea;

// rg height, ba horizontal displacement along x.
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D spectra_a;
// rg horizontal displacement along z.
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D spectra_b;

layout(push_constant) uniform PushConstants {
    uint  resolution;
    uint  log2_resolution;
    float k_spacing;     // rad/m between neighbouring wavevectors
    float time;
    float choppiness;
} push;

const float GRAVITY = 9.81;

float wavenumber(uint i) {
    int n = int(i);
    int size = int(push.resolution);
    return float(n < size / 2 ? n : n - size) * push.k_spacing;
}

uint reversed(uint i) {
    return bitfieldReverse(i) >> (32u - push.log2_resolution);
}

void main() {
    uvec2 cell = gl_GlobalInvocationID.xy;
    uint n = push.resolution;
    if (cell.x >= n || cell.y >= n) return;

    uint here = cell.y * n + cell.x;
    uint opposite = ((n - cell.y) % n) * n + (n - cell.x) % n;

    vec2 k = vec2(wavenumber(cell.x), wavenumber(cell.y));
    float k_len = length(k);
    float phase = sqrt(GRAVITY * k_len) * push.time;
    float c = cos(phase);
    float s = sin(phase);

    // h0(k) e^{-i w t} + conj(h0(-k)) e^{+i w t}.
    vec2 a = sea.amplitudes[here];
    vec2 b = sea.amplitudes[opposite];
    vec2 h = vec2(a.x * c + a.y * s + b.x * c + b.y * s,
                  a.y * c - a.x * s - b.y * c + b.x * s);

    vec2 along_x = vec2(0.0);
    vec2 along_z = vec2(0.0);
    if (k_len >= 1e-6) {
        // i (k / |k|) h: a quarter cycle ahead of the height, along k.
        vec2 turned = vec2(-h.y, h.x);
        along_x = turned * (k.x / k_len * push.choppiness);
        along_z = turned * (k.y / k_len * push.choppiness);
    }

    ivec2 target = ivec2(reversed(cell.x), reversed(cell.y));
    imageStore(spectra_a, target, vec4(h, along_x));
    imageStore(spectra_b, target, vec4(along_z, 0.0, 0.0));
}
