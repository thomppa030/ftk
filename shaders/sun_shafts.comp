#version 460

// Analytic sun shafts: half-res screen-space ray-march against cascade
// shadow map to produce crisp directional-light crepuscular rays.
//
// Runs alongside the froxel volumetric fog (which handles atmospheric
// haze + point/spot volumetrics). This pass covers only the directional
// contribution, with ray-marched shadow sampling so shafts get their
// shape directly from the scene geometry via the cascade shadow map.
//
// References:
//   - Tiago Sousa, "CryEngine 3 Graphics Gems" (SIGGRAPH 2013).
//     Describes CryEngine's approach of screen-space ray-marching the
//     cascade shadow map for directional-light god rays.
//   - Sebastien Hillaire, "Physically Based and Unified Volumetric
//     Rendering in Frostbite" (SIGGRAPH 2015).
//     Energy-conserving Beer-Lambert integration used per march segment.
//   - Henyey & Greenstein (1941), "Diffuse radiation in the galaxy".
//     Single-parameter phase function for forward scatter.

#include "fjell_global_ubo.glsl"

// How hard the glow favours the horizon, as an air-mass exponent.
//
// Gentler than the sky's, and for a different reason: a ray toward the
// horizon does cross more air, but this pass spends most of its brightness
// on surfaces rather than on open sky, and there the stretch reads as the
// ground being lit rather than as the air between. The sky's own halo keeps
// the fuller curve, where the argument actually holds.
#define FJELL_SHAFT_HORIZON_STRETCH 0.15

// What is left of the shafts on a ray that met nothing.
//
// Zero: a ray that found no occluder collected the same lit sample at every
// step, so what it returns is the phase times the cone and nothing else —
// functions of the angle to the sun alone, whose level sets are circles. No
// scale on that draws anything but a disc; it only sets how visible the disc
// is. So the pass keeps what only it can draw, beams bounded by the shadows
// of real geometry, and hands open sky to the sky's own halo, which covers
// the same angles behind the clouds and the terrain at full resolution.
//
// The fade rides `occluder` rather than a depth test, so a hillside against
// the sky still comes up through it continuously instead of stepping at the
// silhouette.
#define FJELL_SHAFT_OPEN_SKY 0.0

// How much a beam's edge spreads per metre the light has travelled, in metres
// of penumbra. A shaft is not a solid wedge with a rim: it is light that has
// been spreading since whatever cut it, and the far end of one is soft enough
// that there is no telling where it ends. The surface filter is tuned the other
// way — five centimetres in the near cascade, which is right for the foot of a
// wall and wrong for the air above it.
#define FJELL_SHAFT_SOFTNESS 0.02

// How many points of the shadow filter's disk each step of the march reads.
//
// Not the whole disk. A ray takes dozens of steps and each reads a different
// part of it, so the beam's soft edge is filled in along the ray and across
// the frames the history holds, and reading all of it at every step pays for
// the same filter dozens of times over.
#define FJELL_SHAFT_SHADOW_TAPS 2

// Where along a ray the run-out fade begins, as a share of how far that ray
// reaches. A march ends when it leaves the shadow cascades, and ending at full
// brightness cuts the beam flat across open air; fading over the last stretch
// lets it thin out instead. Earlier than the distance fade below it, which is
// measured against the authored reach and is often not the binding limit — a
// ray climbing toward a low sun leaves the cascades first.
#define FJELL_SHAFT_RUNOUT_START 0.65

// How far away a sky pixel is reprojected from, for the temporal blend. Far
// enough that a frame of camera movement cannot shift it measurably — at ten
// kilometres a metre of travel is a fiftieth of a pixel — and near enough to
// stay well inside a float's precision.
#define FJELL_SHAFT_SKY_DISTANCE 10000.0

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
#include "fjell_environment.glsl"
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);
layout(set = 0, binding = 15) uniform sampler2D cloud_shadow_tex;
#include "fjell_cloud_shadow.glsl"
#include "fjell_air_mass.glsl"

layout(set = 0, binding = 1) uniform sampler2DArrayShadow shadow_map;
#include "fjell_shadow.glsl"

layout(set = 1, binding = 0, r11f_g11f_b10f) uniform writeonly image2D shafts_out;
layout(set = 1, binding = 1) uniform sampler2D depth_texture;
layout(set = 1, binding = 2) uniform sampler2D shafts_history;

layout(push_constant) uniform PushConstants {
    uvec2 output_size;
    uvec2 full_size;
    float max_reach;
    float density;
    float intensity;
    float anisotropy;
    uint step_count;
    uint frame_index;
    float history_blend;
    float directionality;
    float threshold;
} pc;

const float PI = 3.14159265;

// HG with a soft ceiling on the forward peak. Forward-scatter spikes to
// hundreds as g→1, which blows out the horizon around the sun.
//
// A hard `min(phase, 1.0)` is the wrong cure: it does not soften the peak,
// it flattens it. Every direction whose raw phase clears the ceiling comes
// back with the same value, so the spike becomes a disc of constant
// brightness — at g=0.75 a 28° circle of it — which reads as a pasted-on
// halo that nothing in the scene can modulate, since every ray inside it
// carries an identical phase. Rolling the peak over compresses it instead,
// keeping the falloff strictly decreasing so the glow always shades off
// with angle.
float henyey_greenstein(float g, float cos_theta) {
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cos_theta;
    float phase = (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
    return phase / (1.0 + phase);
}

// Dual-lobe phase: forward HG lobe blended with an isotropic lobe. The HG
// peak alone drops by ~50x at 90° to the sun, so shafts vanish unless the
// camera looks toward it. The isotropic share keeps shadow-bounded columns
// readable from the side and from above; the lit-vs-shadowed contrast
// still comes from the cascade march, so the shafts keep their shape.
float shaft_phase(float g, float directionality, float cos_theta) {
    float isotropic = 1.0 / (4.0 * PI);
    return mix(isotropic, henyey_greenstein(g, cos_theta), directionality);
}

// Interleaved gradient noise per pixel — cheap blue-noise-ish dither.
float ign(ivec2 coord, uint frame) {
    vec3 m = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(m.z * fract(dot(vec2(coord) + float(frame) * 5.588238, m.xy)));
}

// Returns shadow in [0,1], or -1 if the sample is outside all cascades
// (caller should stop the march — beyond-cascade in-scatter has no shape
// and would just add a uniform sun-direction blob).
float sample_cascade_shadow(vec3 world_pos, float turn, int first_tap, float softness) {
    return shadow_factor_volumetric(world_pos, turn, first_tap, softness, FJELL_SHAFT_SHADOW_TAPS)
           * cloud_shadow_factor(world_pos);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.output_size.x) || coord.y >= int(pc.output_size.y)) return;

    // Half-res pixel → full-res UV (sample center of 2x2 block)
    vec2 half_uv = (vec2(coord) + 0.5) / vec2(pc.output_size);

    // Sample scene depth at the center of the 2x2 full-res block.
    ivec2 full_coord = ivec2((vec2(coord) + 0.5) * vec2(pc.full_size) / vec2(pc.output_size));
    full_coord = clamp(full_coord, ivec2(0), ivec2(pc.full_size) - 1);
    float raw_depth = texelFetch(depth_texture, full_coord, 0).r;

    // Reconstruct world-space ray through this pixel.
    vec2 ndc = half_uv * 2.0 - 1.0;
    vec4 near_world = ubo.inv_view_proj * vec4(ndc, 0.0, 1.0);
    near_world /= near_world.w;
    vec4 far_world = ubo.inv_view_proj * vec4(ndc, 1.0, 1.0);
    far_world /= far_world.w;
    vec3 ray_dir = normalize(far_world.xyz - near_world.xyz);

    // The march starts at this pixel's own near-plane point rather than the
    // eye. For a perspective camera the two lie on the same ray; for an
    // orthographic camera every pixel has a distinct origin and marching
    // from the eye would give the whole screen one identical ray.
    vec3 ray_origin = near_world.xyz;
    float near_dist = -(ubo.view * vec4(ray_origin, 1.0)).z;

    // March distance: to scene hit, or max_reach for sky pixels. Cap at the
    // furthest cascade's reach — samples beyond it have no shadow data and
    // waste march budget (the loop early-exits anyway when shadow == -1).
    float cascade_limit = ubo.cascade_splits[2];
    vec3 view_forward = -vec3(ubo.view[0][2], ubo.view[1][2], ubo.view[2][2]);
    float cos_angle = max(dot(ray_dir, view_forward), 1e-4);
    float max_ray_dist = min(pc.max_reach, (cascade_limit - near_dist) / cos_angle);

    float scene_dist;
    if (raw_depth >= 1.0) {
        scene_dist = max_ray_dist;
    } else {
        vec4 hit_world = ubo.inv_view_proj * vec4(ndc, raw_depth, 1.0);
        hit_world /= hit_world.w;
        scene_dist = min(distance(ray_origin, hit_world.xyz), max_ray_dist);
    }

    float step_size = scene_dist / float(pc.step_count);
    if (step_size <= 0.0) {
        imageStore(shafts_out, coord, vec4(0.0));
        return;
    }

    // Per-pixel jitter offsets the first step within [0, step_size) so
    // that undersampled rays don't band across screen space.
    float pixel_jitter = ign(coord, pc.frame_index);
    float march_t = step_size * pixel_jitter;

    // Phase is view-dependent but constant along the ray (directional light).
    float cos_theta = dot(ray_dir, ubo.light_direction.xyz);
    float phase = shaft_phase(pc.anisotropy, pc.directionality, cos_theta);

    // A brighter sun does scatter more haze, so the shafts follow its
    // intensity — but through a square root, not straight. Taken linearly
    // the glow around the sun grows with the scene lighting fast enough
    // that taming it means turning the sun down and everything with it;
    // under a root a sun twice as strong lights the haze half again as
    // much, which reads right and leaves `shaft_intensity` in charge.
    // A set sun still draws nothing: its intensity, and the root, are zero.
    vec3 sun_color = ubo.light_color.xyz;
    float sun_response = sqrt(max(ubo.light_direction.w, 0.0));

    // Whether this ray met anything, and how near it was.
    //
    // `scene_dist` is already the world distance the ray travelled before it
    // hit something, clamped to the march's reach, and is the far reach on a
    // ray that hit nothing — so it says both whether an occluder is there and
    // how close, with no extra depth maths. Being a distance rather than a
    // test, it varies continuously across a silhouette instead of stepping at
    // it.
    float occluder = 1.0 - smoothstep(0.0, max_ray_dist, scene_dist);

    // What survives of the march, before the sun's own colour and strength.
    //
    // Not an angular window any more. There used to be a cone around the sun
    // here, clipping the shafts to a fixed spread and holding a floor under
    // them on geometry, because a ray that met nothing returned the phase and
    // nothing else and washed the sky with it. The open-sky fade below answers
    // that directly — it asks whether the ray found an occluder rather than
    // guessing from the angle to the sun — so the cone was left scaling beams
    // that had earned their shape, and cutting the wide ones a real sky keeps.
    // The phase function is the angular falloff, and it is the physical one.
    float shaft_fade = 1.0;

    // Open sky belongs to the sky, not to this pass.
    //
    // A ray that reaches the end of the march without meeting anything has
    // no shadow to shape it: every sample it took was lit, so what it returns
    // is the phase and nothing else — a plate of constant brightness, which is
    // what makes the glow around the sun look pasted on. The sky's own halo
    // covers the same angles with a real falloff, at full resolution, behind
    // the clouds and the terrain, and with no history to smear when the camera
    // moves. It is strictly the better picture of the same light.
    //
    // So the shafts keep what only they can draw — beams bounded by the
    // shadows of real geometry — and hand the open sky over. Faded by
    // `occluder` rather than switched on depth, so a silhouette does not step.
    shaft_fade *= mix(1.0, FJELL_SHAFT_OPEN_SKY, 1.0 - occluder);

    // Stretched toward the horizon by the air the ray looks through. See
    // fjell_air_mass.glsl; the sky's own halo is scaled by the same curve.
    shaft_fade *= fjell_air_mass_gain(ray_dir, FJELL_SHAFT_HORIZON_STRETCH);

    // Everything the march collects is scaled by this at the end, so a ray it
    // zeroes has nothing to march for: open sky, which the fade above hands to
    // the sky, and every ray once the sun has set. Those take no steps at all,
    // and over open water at dawn they are most of the screen.
    float ray_gain = sun_response * pc.intensity * shaft_fade;
    uint steps = ray_gain > 0.0 ? pc.step_count : 0u;

    // Both integrals share the same march; `unshadowed` is what the ray
    // would collect with no occluders and anchors the threshold below.
    float accumulated = 0.0;
    float unshadowed = 0.0;
    float transmittance = 1.0;

    for (uint i = 0; i < steps; ++i) {
        vec3 world_pos = ray_origin + ray_dir * march_t;

        // A beam's edge spreads with how far the light has come since it
        // passed the occluder. The march has no occluder distance to hand, but
        // distance along the ray stands in for it closely enough: the far end
        // of a shaft is the part that has travelled furthest and is the part
        // that should be softest.
        float softness = FJELL_SHAFT_SOFTNESS * march_t;
        // The filter's disk is walked, not drawn at random. Each step reads
        // the points after the ones the step before it read, on a disk turned
        // on by the golden angle, so any short run of steps — and it is a short
        // run that crosses a beam's edge — has covered the whole disk evenly.
        // Random draws cover it only on average, and the shortfall is grain.
        // Where the walk starts is the pixel's own dither value, so neighbours
        // and successive frames start apart.
        float turn = fract(pixel_jitter + float(i) * 0.61803399);
        int first_tap = int(pixel_jitter * float(FJELL_VOLUMETRIC_SHADOW_DISK))
                      + int(i) * FJELL_SHAFT_SHADOW_TAPS;
        float shadow = sample_cascade_shadow(world_pos, turn, first_tap, softness);
        // Beyond the shadow cascades there is no shape to be had, so the march
        // ends — but it has to end by fading out rather than by stopping. A ray
        // climbing toward a low sun leaves the cascades long before it reaches
        // `max_reach`, so the distance fade below is still near one when that
        // happens, and ending outright leaves the beam at full brightness: a
        // flat cut across open air where the coverage ran out, which is nothing
        // in the world.
        //
        // So the run-out is measured forward. Each step asks where the sample
        // some way ahead of it would land, and fades once that one is past the
        // boundary — by the time this ray reaches the edge it has already
        // thinned to nothing, and the seam has nothing to show.
        if (shadow < 0.0) break;

        // `max_ray_dist` already holds where this ray runs out — the nearer of
        // its reach and the furthest cascade — so the fade is a smoothstep
        // toward it and costs nothing.
        float cascade_fade =
            1.0 - smoothstep(max_ray_dist * FJELL_SHAFT_RUNOUT_START, max_ray_dist, march_t);

        // World-space distance fade: each sample's contribution falls off
        // with distance from the camera, independent of the ray's total
        // length. This avoids the disc-shaped artifact where rays close to
        // the sun direction all reach their cascade limit at similar
        // brightness and produce a visible ring when the per-ray fade kicks
        // in. Physical intuition: nearby particles contribute more in-scatter
        // than distant ones.
        float dist_fade = 1.0 - smoothstep(pc.max_reach * 0.5, pc.max_reach, march_t);

        // Beer-Lambert transmittance for this segment. Extinction is kept
        // well below the scattering coefficient (same ratio as the froxel
        // fog) so a dense setting brightens the shafts linearly instead of
        // saturating the ray before it reaches the shadow wedges near the
        // ground, which is where a side or top-down view gets its shape.
        float extinction = pc.density * 0.1;
        float seg_tr = exp(-extinction * step_size);

        // In-scatter: phase × density × (1 - seg_tr)/extinction gives the
        // energy-conserving per-segment contribution; sun radiance and
        // shadow scale it.
        float seg_light = phase * pc.density * dist_fade * cascade_fade
                          * (1.0 - seg_tr) / max(extinction, 1e-6);

        accumulated += transmittance * seg_light * shadow;
        unshadowed += transmittance * seg_light;
        transmittance *= seg_tr;

        march_t += step_size;
        if (transmittance < 0.01) break;
    }

    // Threshold: subtract a share of the unshadowed integral and renormalise
    // so a fully lit ray is unchanged while a partly shadowed one falls off
    // faster than its shadowed share. Deepens beams and shadow wedges once
    // the haze sits on top of a bright scene.
    if (pc.threshold > 0.0) {
        accumulated = max(accumulated - pc.threshold * unshadowed, 0.0) / (1.0 - pc.threshold);
    }

    vec3 result = sun_color * accumulated * ray_gain;

    // Temporal accumulation: blend with previous frame's shafts.
    // Screen-space reproject using prev view-projection.
    if (pc.history_blend > 0.0) {
        // Where to look this pixel up in last frame's buffer. A point halfway
        // along the march stands for the whole ray, which is right while the
        // ray ends on something: the in-scatter it collected came from there
        // and it moves with the camera.
        //
        // A ray that hit nothing ends at the march's reach rather than at a
        // surface, and that is not where its light came from — the sky is
        // effectively infinitely far, and infinitely far things do not shift
        // when the camera moves, only when it turns. Reprojecting one as if
        // it sat a hundred and fifty metres out gives it a parallax it does
        // not have: about a pixel a frame at a walking pace, held for ten
        // frames by an 0.85 blend, which drags the halo across the sky
        // whenever the camera translates.
        //
        // So a sky pixel reprojects by rotation alone. Carrying the ray out
        // from the *previous* eye rather than this one is what drops the
        // translation: the direction is what survives to infinity.
        vec3 repro_world;
        if (raw_depth >= 1.0) {
            vec3 prev_eye = -(transpose(mat3(ubo.prev_view)) * ubo.prev_view[3].xyz);
            repro_world = prev_eye + ray_dir * FJELL_SHAFT_SKY_DISTANCE;
        } else {
            repro_world = ray_origin + ray_dir * (scene_dist * 0.5);
        }
        vec4 prev_clip = ubo.prev_view_proj * vec4(repro_world, 1.0);
        if (prev_clip.w > 0.0) {
            vec2 prev_uv = (prev_clip.xy / prev_clip.w) * 0.5 + 0.5;
            if (all(greaterThanEqual(prev_uv, vec2(0.0))) &&
                all(lessThanEqual(prev_uv, vec2(1.0)))) {
                vec3 history = texture(shafts_history, prev_uv).rgb;
                result = mix(result, history, pc.history_blend);
            }
        }
    }

    imageStore(shafts_out, coord, vec4(result, 1.0));
}
