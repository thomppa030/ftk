#version 460

#include "include/particle_common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 1) readonly buffer Counters {
    uint counters[];
};

layout(std430, set = 0, binding = 3) readonly buffer EmitterBuffer {
    EmitterData emitters[];
};

// VkDrawIndirectCommand array
layout(std430, set = 0, binding = 4) writeonly buffer IndirectDraw {
    uint indirect_cmds[];  // 4 uints per command
};

layout(push_constant) uniform PushConstants {
    float dt;
    uint  random_seed;
    uint  emitter_count;
    uint  total_max_particles;
    uint  sub_emit_pass;
};

void main() {
    uint eidx = gl_GlobalInvocationID.x;
    if (eidx >= emitter_count) return;

    EmitterData em = emitters[eidx];

    // VkDrawIndirectCommand: vertexCount, instanceCount, firstVertex, firstInstance.
    // Only trails are sized here: their strip walks the ring in order, all of
    // it, dead points at zero width. Billboard and mesh emitters draw their
    // alive particles alone, gathered by particle_compact.comp, which writes
    // their commands.
    if ((em.flags & 1u) != 0u) {
        uint alive = counters[em.counter_offset];
        indirect_cmds[eidx * 4 + 0] = min(alive, em.max_particles) * 2;
        indirect_cmds[eidx * 4 + 1] = 1;
        indirect_cmds[eidx * 4 + 2] = 0;
        indirect_cmds[eidx * 4 + 3] = em.base_offset;
    }
}
