// A painted Milky Way, as a contribution to a sky. The other take on the same
// job as `milky_way.fjsl`, with the same ports, so a sky picks one by the path
// its `use` names and the stars are fed by whichever it picked.
//
// By the same hand as the clouds, the sun and the moon: one field, cut hard,
// a few flat values. What was wrong with the band it replaces was its shape
// before anything else — a stripe of one width ruled right round the sky,
// which is a belt and not a galaxy. Seen from inside, a galaxy is lopsided:
// a wide bright bulge toward its centre, thinning to a ragged ribbon on the
// far side, with dust lying along the middle of it in torn dark lanes.
//
// So the band has a centre, its width follows how near the centre a direction
// is, and everything else is the one rule the sun uses: each value is solid
// toward the plane and gives way outward, and where it gives way it tears.
// The haze tears into the sky, the body into the haze, the core into the
// body — and the dust is the same rule cutting the other way, out of them.
//
// Everything is measured on the sphere itself. There is no longitude in here,
// only dot products, so there is no seam where an angle wraps round.
shader_function;

in vec3 view_dir;
// How far the night has come out, the sky's STARS. Zero draws nothing.
in float intensity;
// The rotation that carried the sun from noon to now. Undone on the view
// direction, so the galaxy is fixed to the celestial sphere and wheels with it.
in vec3 axis;
in float angle;
// How much of this direction is above the horizon, 1 well up and 0 below —
// see `fjell_horizon_fade()`. A port because this function does not know
// where the caller's horizon is, or whether it has one.
in float horizon_fade;

out vec3 color;
// How far inside the galaxy this direction is, 0 outside it and 1 on the
// plane. Smooth on purpose, and without the dust: what reads it decides how
// many stars to draw per pixel, and a hard edge there cuts stars in half.
out float band;

group "Galaxy shape";
// How wide the band is on the far side from the centre and at the bulge, as
// the sine of the angle it reaches off the plane. The gap between the two is
// what makes it a galaxy rather than a belt.
uniform float arm_width : hint_range(0.02, 0.6, 0.01) = 0.2;
uniform float bulge_width : hint_range(0.05, 0.9, 0.01) = 0.42;
// Where round the plane the centre sits, in degrees. The plane is fixed — the
// stars crowd into it — so this slides the bulge along it to wherever it
// frames best in the hours a scene is played in.
uniform float centre_turn : hint_range(0.0, 360.0, 1.0) = 0.0;
// How big the forms are, in features across a radian of sky.
uniform float form_scale : hint_range(0.5, 8.0, 0.01) = 2.6;
// Which galaxy this is: slides the field under the band.
uniform float pattern : hint_range(0.0, 50.0, 0.1) = 11.0;
// How much dust lies along the plane. 0 leaves the band whole.
uniform float dust : hint_range(0.0, 1.0, 0.01) = 0.8;

group "Galaxy light";
// Over all of it. The band is faint by nature, but hard shapes drawn too
// faintly stop reading as shapes and start reading as noise.
uniform float brightness : hint_range(0.0, 4.0, 0.01) = 1.0;
// The values, outermost to innermost, and the dust that cuts across them.
uniform vec3 haze_color : hint_color = vec3(0.16, 0.18, 0.25);
uniform vec3 body_color : hint_color = vec3(0.26, 0.28, 0.35);
uniform vec3 core_color : hint_color = vec3(0.40, 0.37, 0.34);
uniform vec3 dust_color : hint_color = vec3(0.09, 0.10, 0.15);

// Rodrigues rotation of `v` about unit `axis` by `angle`.
vec3 rotate_about(vec3 v, vec3 axis, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
}

// One lattice corner's share of the noise below: its gradient, hashed from
// where it is, against the offset to it.
float corner(vec3 i, vec3 f, vec3 o) {
    return dot(normalize(fract(sin(vec3(
                   dot(i + o, vec3(127.1, 311.7, 74.7)),
                   dot(i + o, vec3(269.5, 183.3, 246.1)),
                   dot(i + o, vec3(113.5, 271.9, 124.6)))) * 43758.5453) * 2.0 - 1.0),
               f - o);
}

// Gradient noise on a quintic fade. Spelled here rather than taken from the
// sky's includes: a function composed into someone else's program cannot
// assume what that program has in scope.
//
// Quintic and not smoothstep because smoothstep's second derivative is not
// zero at a cell boundary, so the slope jumps there, and spread across a
// sky-wide gradient that draws faint straight-edged facets. Gradients and not
// values because interpolated values leave the extrema pinned to the lattice,
// which reads as a grid however smooth the fade.
float sky_noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = p - i;
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float d000 = corner(i, f, vec3(0, 0, 0));
    float d100 = corner(i, f, vec3(1, 0, 0));
    float d010 = corner(i, f, vec3(0, 1, 0));
    float d110 = corner(i, f, vec3(1, 1, 0));
    float d001 = corner(i, f, vec3(0, 0, 1));
    float d101 = corner(i, f, vec3(1, 0, 1));
    float d011 = corner(i, f, vec3(0, 1, 1));
    float d111 = corner(i, f, vec3(1, 1, 1));

    float y0 = mix(mix(d000, d100, u.x), mix(d010, d110, u.x), u.y);
    float y1 = mix(mix(d001, d101, u.x), mix(d011, d111, u.x), u.y);
    return mix(y0, y1, u.z);
}


// Doubles the frequency, near enough, and turns it about an axis that is none
// of the lattice's own, so no two octaves share a grid.
vec3 next_octave(vec3 p) {
    return mat3(vec3(0.0, -1.616, -1.212),
                vec3(1.616, 0.7272, -0.9696),
                vec3(1.212, -0.9696, 1.2928)) * p + 3.1;
}

// The clouds' field, on the sphere: a stack of noise folded through abs(),
// which creases it into ridges, multiplied into a plain stack of the same
// noise, which drives most of the field to nothing and leaves isolated forms
// with torn edges. Warped first, so the forms are not laid out on the noise's
// own grid. Roughly -0.2 where it is emptiest, 0 at its median, past 0.8 only
// at the heart of a form.
float folded_field(vec3 p, int octaves) {
    float q = 0.0;
    float amplitude = 0.5;
    vec3 w = p * 0.5;
    for (int i = 0; i < 2; ++i) {
        q += sky_noise(w) * amplitude;
        w = next_octave(w) - 3.1;
        amplitude *= 0.5;
    }
    p += q * 0.6;

    float r = 0.0;
    float f = 0.0;
    float ridge_weight = 0.8;
    float plain_weight = 0.7;
    for (int i = 0; i < octaves; ++i) {
        float n = sky_noise(p) * 1.8;
        r += abs(ridge_weight * n);
        f += plain_weight * n;
        p = next_octave(p);
        ridge_weight *= 0.7;
        plain_weight *= 0.6;
    }
    return f * (r + f);
}

// The one rule. `across` is how far out a point is over the stretch a value
// gives way in: at or under 0 the value is solid, at 1 it is gone, and
// between them it is whatever of the field clears a cut climbing from `low`
// to `high`. `width` is the edge, about a pixel of the field.
float torn(float field, float across, float low, float high, float width) {
    if (across >= 1.0) return 0.0;
    if (across <= 0.0) return 1.0;
    float level = mix(low, high, across);
    return smoothstep(level - width, level + width, field);
}

void main() {
    color = vec3(0.0);
    band = 0.0;

    vec3 dir = rotate_about(view_dir, axis, -angle);

    // The plane, and where along it the centre is. The pole is the one the
    // stars were always crowded about, so a sky that swaps galaxies keeps its
    // constellations where they were.
    const vec3 GALACTIC_POLE = normalize(vec3(0.42, 0.78, -0.47));
    vec3 ahead = normalize(cross(GALACTIC_POLE, vec3(0.0, 1.0, 0.0)));
    vec3 centre = rotate_about(ahead, GALACTIC_POLE, radians(centre_turn));

    // How far off the plane, and how nearly toward the centre. Both are dot
    // products: nothing here is an angle that wraps.
    float off_plane = dot(dir, GALACTIC_POLE);
    vec3 in_plane = dir - GALACTIC_POLE * off_plane;
    float toward = dot(in_plane / max(length(in_plane), 1e-5), centre);
    toward = smoothstep(-0.3, 1.0, toward);
    toward *= toward;

    // 0 on the plane, 1 at the band's edge, wherever along it this is.
    float height = abs(off_plane) / mix(arm_width, bulge_width, toward);
    band = 1.0 - smoothstep(0.0, 1.0, height);
    if (intensity <= 0.0 || height >= 1.0) return;

    // A pixel is about a twenty-fifth of a degree — 1080 lines over a 45
    // degree view — which is what the edge of a cut is as wide as.
    float width = clamp(0.0007 * form_scale * 1.5, 0.004, 0.05);
    float field = folded_field(dir * form_scale + pattern, 4);

    float haze = torn(field, (height - 0.30) / 0.70, -0.25, 0.9, width);
    float body = torn(field, (height - 0.05) / 0.60, -0.25, 0.7, width) * haze;
    // The core is the bulge's own: it has nowhere to be on the far side.
    float core = torn(field, height / max(0.55 * toward, 1e-3), -0.2, 0.8, width) * body;

    // Dust lies along the plane, so its field is stretched along it: reading
    // the noise faster across the plane than along it makes forms that are
    // long the way the band runs. Thickest through the bulge, where there is
    // the most galaxy to be in front of.
    float lanes = 0.0;
    if (dust > 0.0) {
        vec3 along = dir * form_scale * 1.7
                   + GALACTIC_POLE * off_plane * form_scale * 4.0 + pattern + 36.0;
        float dust_field = folded_field(along, 3);
        lanes = torn(dust_field, height / (0.25 + 0.35 * toward),
                     mix(0.7, -0.1, dust), 0.9, width) * body;
    }

    vec3 painted = haze_color * haze;
    painted = mix(painted, body_color, body);
    painted = mix(painted, core_color, core);
    painted = mix(painted, dust_color, lanes);

    color = painted * brightness * intensity * 3.0 * horizon_fade;
}
