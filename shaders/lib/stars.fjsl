// Points of light fixed to the celestial sphere, as a contribution to a sky.
// This is the star field `star_field()` in fjell_sky_bodies.glsl draws, moved
// out unchanged so a sky can swap it for another.
//
// The same rotation that carried the sun from noon to now is undone on the
// view direction, so the stars wheel with the day. Space is cut into cells and
// a few of them hold a star; the neighbouring cells are searched too, since a
// star's direction can fall just outside the cell it was rolled in, so every
// star is a whole round point.
shader_function;

in vec3 view_dir;
// How far the night has come out, the sky's STARS. Zero draws nothing.
in float intensity;
in vec3 axis;
in float angle;
// Drives scintillation. A star field that only rotates reads as a texture
// being dragged across the sky, because the one thing real starlight does
// that a fixed point does not is twinkle: the air it shines through is
// turbulent, and the deeper the column of air the harder it churns.
in float time;
// How far inside a galaxy's band this direction is, 0 to 1. Stars crowd into
// it. A port so the band is whatever the sky's galaxy says it is — wire
// `milky_way.fjsl`'s `band` here — and 0.0 is a sky with no galaxy in it.
in float crowding;
// How much of this direction is above the horizon — see
// `fjell_horizon_fade()`. Stars do not meet the ground: the air thickens
// toward it until they are gone, and this finishes them off at the edge.
in float horizon_fade;

out vec3 color;

float star_hash(vec3 p) {
    p = fract(p * vec3(443.897, 441.423, 437.195));
    p += dot(p, p.yzx + 19.19);
    return fract((p.x + p.y) * p.z);
}

// Rodrigues rotation of `v` about unit `axis` by `angle`.
vec3 rotate_about(vec3 v, vec3 axis, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
}

// One lattice corner's share of the noise below: its gradient, hashed from
// where it is, against the offset to it.
float corner(vec3 i, vec3 f, vec3 o) {
    return dot(normalize(fract(sin(vec3(
                   dot(i + o, vec3(127.1, 311.7, 74.7)),
                   dot(i + o, vec3(269.5, 183.3, 246.1)),
                   dot(i + o, vec3(113.5, 271.9, 124.6)))) * 43758.5453) * 2.0 - 1.0),
               f - o);
}

// Gradient noise on a quintic fade. Spelled here rather than taken from the
// sky's includes: a function composed into someone else's program cannot
// assume what that program has in scope.
//
// Quintic and not smoothstep because smoothstep's second derivative is not
// zero at a cell boundary, so the slope jumps there, and spread across a
// sky-wide gradient that draws faint straight-edged facets. Gradients and not
// values because interpolated values leave the extrema pinned to the lattice,
// which reads as a grid however smooth the fade.
float sky_noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = p - i;
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float d000 = corner(i, f, vec3(0, 0, 0));
    float d100 = corner(i, f, vec3(1, 0, 0));
    float d010 = corner(i, f, vec3(0, 1, 0));
    float d110 = corner(i, f, vec3(1, 1, 0));
    float d001 = corner(i, f, vec3(0, 0, 1));
    float d101 = corner(i, f, vec3(1, 0, 1));
    float d011 = corner(i, f, vec3(0, 1, 1));
    float d111 = corner(i, f, vec3(1, 1, 1));

    float y0 = mix(mix(d000, d100, u.x), mix(d010, d110, u.x), u.y);
    float y1 = mix(mix(d001, d101, u.x), mix(d011, d111, u.x), u.y);
    return mix(y0, y1, u.z);
}

// Octaves of the above. Returns roughly [-1, 1].
float sky_fbm(vec3 p, int octaves) {
    float sum = 0.0;
    float amplitude = 1.0;
    float total = 0.0;
    for (int i = 0; i < octaves; ++i) {
        sum += sky_noise(p) * amplitude;
        total += amplitude;
        p *= 2.02;   // not exactly 2, so octaves do not share lattice planes
        amplitude *= 0.5;
    }
    return sum / max(total, 1e-6);
}

// The colour of a star of a given temperature, as an approximation of the
// blackbody locus over the range stars actually occupy. Cool stars are
// orange-red, the sun's class is near white, hot ones blue-white. `t` walks
// that range from coolest to hottest rather than being a temperature in
// kelvin, since nothing here needs the physical unit.
vec3 star_color(float t) {
    // Three anchors along the locus, eyeballed against the usual chart:
    // ~2500 K, ~6000 K and ~12000 K, normalized so none of them dims the
    // star relative to the others — brightness is the caller's business.
    const vec3 COOL = vec3(1.00, 0.63, 0.35);
    const vec3 MID  = vec3(1.00, 0.95, 0.91);
    const vec3 HOT  = vec3(0.71, 0.81, 1.00);
    return t < 0.5 ? mix(COOL, MID, t * 2.0) : mix(MID, HOT, (t - 0.5) * 2.0);
}

void main() {
    color = vec3(0.0);
    if (intensity <= 0.0) return;

    vec3 dir = rotate_about(view_dir, axis, -angle);
    const float CELLS = 60.0;
    vec3 base = floor(dir * CELLS);
    vec3 sum = vec3(0.0);

    // How many cells hold a star varies across the sky instead of being one
    // constant everywhere. A constant gives every patch of sky the same count
    // and so the same look, which is the tell that reads as procedural; real
    // skies have voids and crowds. The band is the strongest crowd of all.
    // Interpolated noise, so a crowd thins into a void gradually rather than
    // changing count across a cell boundary you can see.
    float clump = sky_fbm(dir * 2.4 + 137.0, 3) * 0.5 + 0.5;
    float density = 0.022 + 0.030 * clump + 0.055 * crowding * crowding;

    // Air mass, near enough: how much atmosphere the line of sight crosses,
    // measured on the *view* direction because that is where the observer's
    // horizon is — the celestial sphere has turned, the air has not.
    float altitude = clamp(view_dir.y, 0.0, 1.0);
    float air_mass = 1.0 - smoothstep(0.0, 0.55, altitude);

    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                vec3 cell = base + vec3(x, y, z);
                float h = star_hash(cell);
                if (h < 1.0 - density) continue;
                // Jittered across the whole cell and a little past it, so
                // neighbours can crowd or leave a gap. Confining each star to
                // the middle of its own cell is what leaves a lattice
                // visible however fine the cells are cut.
                vec3 jitter = vec3(star_hash(cell + 1.0),
                                   star_hash(cell + 2.0),
                                   star_hash(cell + 3.0));
                vec3 star = normalize((cell + 0.5 + (jitter - 0.5) * 1.7) / CELLS);
                // Chord distance on the unit sphere: an angular size, the
                // same on every face and at every latitude.
                float d = length(dir - star);

                // How bright this star is before the air gets to it. Raising
                // a uniform roll to a power skews the field the way a real
                // sky is skewed: a handful of bright stars and very many
                // faint ones, which is what gives the sky depth. A uniform
                // roll instead reads as scattered confetti, every star much
                // like its neighbour.
                float roll = (h - (1.0 - density)) / density;
                float magnitude = pow(roll, 3.5);

                // Only the brightest stars are big enough to show a disc.
                float radius = 0.0012 + 0.0016 * magnitude;
                float point = smoothstep(radius, radius * 0.25, d);

                // Colour correlates with brightness: the bright ones spread
                // to the ends of the locus so the eye finds distinct red and
                // blue among them, while the faint majority stays near white
                // — which is also how they look to the eye, since dim light
                // lands below the threshold where colour vision works.
                float temp = star_hash(cell + 4.0);
                float spread = 0.25 + 0.75 * magnitude;
                vec3 tint = star_color(0.5 + (temp - 0.5) * spread);

                // Scintillation. Two rates well off a common multiple, each
                // with the star's own phase, so neighbours never pulse
                // together and the pattern does not repeat on a beat.
                float phase = star_hash(cell + 6.0) * 6.2831853;
                float rate = 2.3 + star_hash(cell + 7.0) * 3.1;
                float wobble = sin(time * rate + phase) * 0.6
                             + sin(time * rate * 1.73 + phase * 2.4) * 0.4;
                // Faint stars twinkle proportionally harder — they sit close
                // to the threshold of being seen at all, so the same churn
                // in the air takes them in and out of view, and it is scaled
                // by how low the star sits: fierce near the horizon, almost
                // still overhead, which is what makes it read as atmosphere
                // rather than as a flicker effect.
                float depth = 0.14 + 0.16 * (1.0 - magnitude);
                float twinkle = 1.0 + wobble * depth * air_mass;

                sum += tint * point * (0.15 + magnitude) * twinkle;
            }
        }
    }

    color = sum * intensity * 3.0 * horizon_fade;
}
