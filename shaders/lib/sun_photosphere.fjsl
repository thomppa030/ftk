// A sun drawn as a photosphere: convection boiling on a surface, seen close
// up. The other take on the same job as `sun_disc.fjsl`, which draws a
// painted disc with a folded limb — this one goes after the real thing.
//
// The difference that matters is domain warping. Plain fbm, folded or not,
// gives round blobs: every octave is isotropic about the same origin, so
// whatever comes out is lumpy in the same way in every direction. Warping the
// field by another field first stretches and shears those blobs along the
// warp, and convection cells are sheared — they are the tops of columns being
// dragged by their neighbours. It is the same reason the cloud sheet warps
// its fbm before anything else touches it.
//
// Ports are its own rather than `sun_disc.fjsl`'s: this needs no horizon fade
// (a sky that wants one multiplies the result) and its uniforms are named for
// what they are here, so the two suns keep separate authored values instead
// of silently inheriting each other's.
shader_function;

in vec3 view_dir;
in vec3 sun_dir;
in vec3 sun_color;
in float time;

out vec3 color;

group "Photosphere";
// Angular radius in degrees, as seen from the ground.
uniform float radius : hint_range(0.1, 8.0, 0.01) = 1.6;
// How bright the surface draws, against a tonemapper whose white point is 1
// and a bloom threshold that sits there too. Over it, so the sun blooms; not
// far over, or every part of the surface clips to the same white and the
// structure this file exists for is the first thing lost.
uniform float brightness : hint_range(0.2, 4.0, 0.05) = 1.5;

// How big one convection cell is. The whole disc is a couple of hundred
// pixels across, so past about twenty cells they stop resolving and the
// surface reads as noise.
uniform float cell_scale : hint_range(1.0, 24.0, 0.5) = 7.0;
// How hard the field is warped by itself before it is read. 0 is plain fbm
// and round blobs; up from there the cells shear and curl into the lanes
// convection actually makes. The one dial this file is about.
uniform float warp : hint_range(0.0, 2.0, 0.01) = 1.0;
// How fast the surface boils, in noise units per second. The octaves turn
// against each other rather than the field sliding, so cells reorganise
// instead of drifting past.
uniform float boil : hint_range(0.0, 2.0, 0.01) = 0.35;
// How much darker the limb is than the middle. A real sun is visibly darker
// at its edge — the line of sight leaves the photosphere at a shallower
// angle and sees cooler gas — and it is what makes a disc read as a sphere.
uniform float limb_darkening : hint_range(0.0, 1.0, 0.01) = 0.7;
// How far the edge strays from a circle. The limb is where the warped field
// crosses its cut, so it tears rather than wobbling.
uniform float limb_tear : hint_range(0.0, 0.5, 0.005) = 0.07;

group "Photosphere colour";
// The surface runs from the cool floor of a lane to the hot top of a cell.
// Three stops rather than two: a straight mix between dark and bright can
// only interpolate a line, and the middle of a sun is where its colour turns.
uniform vec3 shade_deep : hint_color = vec3(0.65, 0.12, 0.02);
uniform vec3 shade_mid : hint_color = vec3(1.00, 0.45, 0.06);
uniform vec3 shade_hot : hint_color = vec3(1.00, 0.92, 0.72);
// How much the warp field itself tints the surface, separately from how
// bright it is. Colour and value driven by one scalar is what makes a palette
// read as a gradient; the warp is already computed and is uncorrelated enough
// to break that.
uniform float warp_tint : hint_range(0.0, 1.0, 0.01) = 0.35;
uniform vec3 tint_color : hint_color = vec3(0.85, 0.10, 0.02);

group "Photosphere corona";
// How far the corona reaches past the limb, in degrees, and how bright.
uniform float corona_size : hint_range(0.0, 45.0, 0.1) = 10.0;
uniform float corona : hint_range(0.0, 4.0, 0.05) = 1.0;
// How ragged the corona is. Streamers follow the same field the surface
// does, so what leaves the limb is continuous with what is on it.
uniform float corona_streaks : hint_range(0.0, 1.0, 0.01) = 0.6;

float sun_ph_hash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float sun_ph_noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    // Quintic: smoothstep's second derivative is not zero at a cell boundary,
    // so the slope jumps there and a broad gradient draws faint straight
    // facets across the disc.
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    return mix(mix(mix(sun_ph_hash(i),                 sun_ph_hash(i + vec3(1,0,0)), u.x),
                   mix(sun_ph_hash(i + vec3(0,1,0)),   sun_ph_hash(i + vec3(1,1,0)), u.x), u.y),
               mix(mix(sun_ph_hash(i + vec3(0,0,1)),   sun_ph_hash(i + vec3(1,0,1)), u.x),
                   mix(sun_ph_hash(i + vec3(0,1,1)),   sun_ph_hash(i + vec3(1,1,1)), u.x), u.y), u.z);
}

// Rotation about the three axes, one per octave. Turning each octave at its
// own rate is what keeps them from moving as one sheet: rotated together the
// field slides, rotated apart it churns.
mat3 sun_ph_spin(vec3 a) {
    vec3 s = sin(a);
    vec3 c = cos(a);
    mat3 rx = mat3(1.0, 0.0, 0.0,  0.0, c.x, -s.x,  0.0, s.x, c.x);
    mat3 ry = mat3(c.y, 0.0, s.y,  0.0, 1.0, 0.0,  -s.y, 0.0, c.y);
    mat3 rz = mat3(c.z, -s.z, 0.0,  s.z, c.z, 0.0,  0.0, 0.0, 1.0);
    return rz * ry * rx;
}

float sun_ph_fbm(vec3 p, float t) {
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;
    // Each octave turns a little faster than the last, so fine detail races
    // while the coarse forms crawl.
    mat3 spin = sun_ph_spin(vec3(-0.11, 0.013, 0.047) * t);
    for (int i = 0; i < 5; ++i) {
        sum += sun_ph_noise(p) * amplitude;
        total += amplitude;
        p = spin * p * 2.04 + 1.7;   // not exactly 2, so cells never align
        amplitude *= 0.55;
    }
    return sum / max(total, 1e-4);
}

void main() {
    float angle = degrees(acos(clamp(dot(view_dir, sun_dir), -1.0, 1.0)));

    // The disc's own frame: where this pixel sits across the face, in units
    // of the radius. Its length is how far out we are, so the limb and the
    // middle are one measurement.
    vec3 axis = abs(sun_dir.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(sun_dir, axis));
    vec3 up = cross(right, sun_dir);
    vec2 face = vec2(dot(view_dir, right), dot(view_dir, up)) / max(radians(radius), 1e-6);
    float radial = length(face);

    float t = time * boil;
    vec3 st = vec3(face * cell_scale, t * 0.35);

    // ── Domain warp ─────────────────────────────────────────────────────────
    // Three fbm fields displace where the fourth is read. This is the whole
    // point of the file: read straight, the field is round blobs; read at a
    // position another field has pushed around, the blobs stretch and curl
    // along it, which is what convection looks like.
    vec3 q = vec3(sun_ph_fbm(st, t),
                  sun_ph_fbm(st + vec3(1.20, 3.20, 1.52), t),
                  sun_ph_fbm(st + vec3(0.02, 0.12, 0.15), t)) - 0.5;
    float n = sun_ph_fbm(st + q * warp * 2.2 + vec3(1.82, 1.32, 1.09), t);

    // ── The limb ────────────────────────────────────────────────────────────
    // Where the warped field crosses its cut, so the edge tears along the
    // same structure the surface has rather than wobbling independently.
    float limb = 1.0 + (n - 0.5) * limb_tear * 2.0;
    // Soft over a share of the authored radius, not of the strayed limb, so a
    // deep tear stays as crisp as a shallow one.
    float disc = 1.0 - smoothstep(limb - 0.04, limb, radial);

    // ── The surface ─────────────────────────────────────────────────────────
    // Centre-to-limb: the cosine of the angle the line of sight leaves the
    // surface at, which is what limb darkening is a function of.
    float mu = sqrt(max(1.0 - min(radial * radial, 1.0), 0.0));
    float heat = n;
    heat *= mix(1.0, mix(0.45, 1.0, mu), limb_darkening);

    // Two fields, not one. `heat` says how bright, the warp says how the
    // colour turns — driven by a single scalar both would move together and
    // the palette would read as a gradient laid over the disc.
    vec3 body = mix(shade_deep, shade_mid, smoothstep(0.15, 0.5, heat));
    body = mix(body, shade_hot, smoothstep(0.45, 0.85, heat));
    float tint = clamp(dot(abs(q), vec3(0.9)) * 1.6, 0.0, 1.0);
    body = mix(body, tint_color, tint * warp_tint * (1.0 - mu * 0.5));

    // ── The corona ──────────────────────────────────────────────────────────
    // Two lobes, as the air around a bright thing always has: a tight one
    // hugging the limb and a broad one carrying out past it. Streamers come
    // from the same field, so what leaves the limb continues what is on it.
    float out_deg = max(angle - radius * limb, 0.0);
    float near = out_deg / 1.2;
    float wide = out_deg / max(corona_size * 0.45, 1e-4);
    float glow = mix(1.0 / (1.0 + near * near), 1.0 / (1.0 + wide * wide), 0.45);
    glow *= 1.0 - smoothstep(0.35, 1.0, out_deg / max(corona_size, 1e-4));
    // Radial streaks: the field read on the bearing alone, so it does not
    // change along a ray leaving the sun and reads as a ray rather than a
    // patch. Sampled on the unit circle, never on an `atan` bearing, which
    // would tear down the one line where it wraps.
    vec2 bearing = normalize(face + 1e-6);
    float streak = sun_ph_fbm(vec3(bearing * 5.0, t * 0.5 + 40.0), t);
    glow *= mix(1.0, 0.35 + 1.3 * streak, corona_streaks);

    // ── Colour ──────────────────────────────────────────────────────────────
    // The light's hue, not its intensity: how hard the sun lights the ground
    // is a separate question from how bright its disc draws, and folding the
    // two together means taming one by ruining the other.
    float peak = max(sun_color.r, max(sun_color.g, sun_color.b));
    vec3 hue = sun_color / max(peak, 1e-4);
    float lit = step(1e-4, peak);
    vec3 warmed = mix(vec3(1.0), hue, 0.45);

    color = lit * brightness * (body * warmed * disc
                                + shade_hot * warmed * glow * 0.14 * corona);
}
