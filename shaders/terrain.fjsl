shader_type terrain;

// The default terrain surface. Painted layer weights decide what shows where;
// on top of that, steep ground pulls toward one layer and high ground toward
// another, so a freshly generated terrain already reads as landscape before
// anyone paints it. Layer indices refer to the Terrain component's layer
// table: 0 is the first layer.

// Slopes in degrees from horizontal: the slope layer fades in from
// slope_start and fully covers the ground by slope_end.
uniform float slope_layer : hint_range(0.0, 3.0, 1.0) = 1.0;
uniform float slope_start : hint_range(0.0, 90.0, 1.0) = 25.0;
uniform float slope_end : hint_range(0.0, 90.0, 1.0) = 40.0;

// A negative height layer turns the height rule off.
uniform float height_layer : hint_range(-1.0, 3.0, 1.0) = -1.0;
uniform float height_start : hint_range(-1000.0, 1000.0, 1.0) = 80.0;
uniform float height_end : hint_range(-1000.0, 1000.0, 1.0) = 100.0;

void layers() {
    float steep = smoothstep(slope_start, slope_end, SLOPE);
    LAYER_WEIGHTS = mix(LAYER_WEIGHTS, layer_mask(slope_layer), steep);

    if (height_layer >= 0.0) {
        float high = smoothstep(height_start, height_end, WORLD_POS.y);
        // Cliffs stay rock even above the snow line.
        LAYER_WEIGHTS = mix(LAYER_WEIGHTS, layer_mask(height_layer), high * (1.0 - steep));
    }
}

void fragment() {
    // Empty — the blended layers are the surface.
}
