#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "fjell_ddgi.glsl"

layout(set = 0, binding = 1) uniform sampler2D radiance_tex;
layout(rgba16f, set = 0, binding = 2) uniform image2D irradiance_image;

layout(push_constant) uniform PushConstants {
    uint first_frame;
    float max_trace_dist;
};

#define EPSILON 0.0001

int k_read_table[6] = int[](5, 3, 1, -1, -3, -5);

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);

    if (coords.x >= ddgi.irr_tex_w || coords.y >= ddgi.irr_tex_h) return;

    uint probe_with_border_side = uint(ddgi.irr_side + 2);
    uint probe_last_pixel = uint(ddgi.irr_side + 1);

    int probe_index = get_probe_index_from_pixels(coords, int(probe_with_border_side), ddgi.irr_tex_w);

    bool border_pixel = ((gl_GlobalInvocationID.x % probe_with_border_side) == 0) ||
                        ((gl_GlobalInvocationID.x % probe_with_border_side) == probe_last_pixel);
    border_pixel = border_pixel ||
                   ((gl_GlobalInvocationID.y % probe_with_border_side) == 0) ||
                   ((gl_GlobalInvocationID.y % probe_with_border_side) == probe_last_pixel);

    if (!border_pixel) {
        // Skip probes not in the current batch — keep previous value
        if (probe_index < ddgi.probe_update_offset ||
            probe_index >= ddgi.probe_update_offset + ddgi.probe_update_count) {
            return;
        }

        vec4 result = vec4(0.0);
        const float energy_conservation = 0.95;

        uint backfaces = 0;
        uint max_backfaces = uint(ddgi.probe_rays * 0.1);

        for (int ray_index = 0; ray_index < ddgi.probe_rays; ++ray_index) {
            ivec2 sample_pos = ivec2(ray_index, probe_index - ddgi.probe_update_offset);

            vec3 ray_direction = normalize(mat3(ddgi.random_rotation) *
                spherical_fibonacci(float(ray_index), float(ddgi.probe_rays)));
            vec3 texel_direction = oct_decode(normalized_oct_coord(coords, ddgi.irr_side));

            float weight = max(0.0, dot(texel_direction, ray_direction));

            float dist = texelFetch(radiance_tex, sample_pos, 0).w;
            if (dist < 0.0) {
                ++backfaces;
                if (backfaces >= max_backfaces) return;
                continue;
            }

            if (weight >= EPSILON) {
                vec3 radiance = texelFetch(radiance_tex, sample_pos, 0).rgb;
                // Clamp radiance to prevent emissive hotspots from causing flicker
                radiance = min(radiance, vec3(30.0));
                radiance *= energy_conservation;

                // Down-weight sky miss rays so nearby surface bounces dominate.
                // Even with blurred sky sampling (mip 4), HDR skies can still
                // overpower subtle color bleeding from nearby geometry.
                if (dist >= max_trace_dist - 0.1) {
                    weight *= 0.25;
                }

                result += vec4(radiance * weight, weight);
            }
        }

        if (result.w > EPSILON) {
            result.xyz /= result.w;
            result.w = 1.0;
        }

        vec4 previous_value = imageLoad(irradiance_image, coords);

        if (first_frame == 0) {
            result = mix(result, previous_value, ddgi.hysteresis);
        }

        imageStore(irradiance_image, coords, result);
        return;
    }

    // Border pixels: wait for interior, then copy
    groupMemoryBarrier();
    barrier();

    uint probe_pixel_x = gl_GlobalInvocationID.x % probe_with_border_side;
    uint probe_pixel_y = gl_GlobalInvocationID.y % probe_with_border_side;
    bool corner_pixel = (probe_pixel_x == 0 || probe_pixel_x == probe_last_pixel) &&
                        (probe_pixel_y == 0 || probe_pixel_y == probe_last_pixel);
    bool row_pixel = (probe_pixel_x > 0 && probe_pixel_x < probe_last_pixel);

    ivec2 source = coords;

    if (corner_pixel) {
        source.x += int(probe_pixel_x == 0 ? ddgi.irr_side : -ddgi.irr_side);
        source.y += int(probe_pixel_y == 0 ? ddgi.irr_side : -ddgi.irr_side);
    } else if (row_pixel) {
        source.x += k_read_table[probe_pixel_x - 1];
        source.y += (probe_pixel_y > 0) ? -1 : 1;
    } else {
        source.x += (probe_pixel_x > 0) ? -1 : 1;
        source.y += k_read_table[probe_pixel_y - 1];
    }

    imageStore(irradiance_image, coords, imageLoad(irradiance_image, source));
}
