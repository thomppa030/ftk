shader_type spatial;
render_mode unlit, blend_add;

uniform vec3 glow_color : hint_color, hint_albedo = vec3(0.485, 0.798, 1.0);
uniform float glow_strength : hint_range(0.0, 5.0, 0.1), hint_albedo = 2.0;
uniform float glow_alpha : hint_range(0.0, 1.0, 0.01) = 0.5;

void fragment() {
    ALPHA = glow_alpha;
}
