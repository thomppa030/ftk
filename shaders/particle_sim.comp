#version 460

#include "include/particle_common.glsl"
#include "include/noise.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) buffer Counters {
    uint counters[];  // [alive_0, dead_0, alive_1, dead_1, ...]
};

layout(std430, set = 0, binding = 2) buffer DeadList {
    uint dead_indices[];
};

layout(std430, set = 0, binding = 3) readonly buffer EmitterBuffer {
    EmitterData emitters[];
};

layout(std430, set = 0, binding = 5) readonly buffer ModuleBuffer {
    uint module_data[];
};

#include "include/particle_modules.glsl"

// Set 1 = global descriptors (for SDF + depth access)
layout(set = 1, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
} global_ubo;

layout(set = 1, binding = 4) uniform sampler2D depth_texture;
layout(set = 1, binding = 9) uniform sampler3D scene_sdf;

layout(push_constant) uniform PushConstants {
    float dt;
    uint  random_seed;
    uint  emitter_count;
    uint  total_max_particles;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total_max_particles) return;

    Particle p = particles[idx];
    if (p.lifetime <= 0.0) return;

    EmitterData em = emitters[p.emitter_index];

    p.lifetime -= dt;
    if (p.lifetime <= 0.0) {
        if ((em.flags & 1u) != 0u) {
            // Trail emitter: keep particle alive (ring buffer overwrites old slots).
            // Clamp lifetime to a small positive value so the strip stays connected.
            // The age-based color/size fade handles visual disappearance.
            p.lifetime = 0.001;
        } else {
            particles[idx].lifetime = 0.0;
            uint local_idx = idx - em.base_offset;
            uint slot = atomicAdd(counters[em.counter_offset + 1], 1);
            if (slot < em.max_particles) {
                dead_indices[em.dead_list_offset + slot] = local_idx;
            }
            atomicAdd(counters[em.counter_offset], -1);
            return;
        }
    }

    float age = 1.0 - (p.lifetime / p.max_lifetime);

    // Walk update modules (max 32 iterations to prevent GPU hang on corrupt data)
    uint mo = em.module_offset;
    for (int guard = 0; guard < 32; ++guard) {
        uint mtype = module_data[mo];
        uint msize = module_data[mo + 1];
        if (mtype == MOD_TERMINATOR || msize == 0) break;

        if (mtype == MOD_GRAVITY) {
            vec3 force = MOD_VEC3(mo, 2);
            p.velocity += force * dt;
        }
        else if (mtype == MOD_WIND) {
            vec3 dir = MOD_VEC3(mo, 2);
            float str = MOD_FLOAT(mo, 5);
            p.velocity += dir * str * dt;
        }
        else if (mtype == MOD_COLOR_OVER_LIFE) {
            vec4 col_start = MOD_VEC4(mo, 2);
            vec4 col_end = MOD_VEC4(mo, 6);
            p.color = mix(col_start, col_end, age);
        }
        else if (mtype == MOD_SIZE_OVER_LIFE) {
            float s_start = MOD_FLOAT(mo, 2);
            float s_end = MOD_FLOAT(mo, 3);
            p.size = mix(s_start, s_end, age);
        }
        else if (mtype == MOD_DRAG) {
            float drag_coeff = MOD_FLOAT(mo, 2);
            p.velocity *= max(0.0, 1.0 - drag_coeff * dt);
        }
        else if (mtype == MOD_NOISE) {
            float strength = MOD_FLOAT(mo, 2);
            float freq = MOD_FLOAT(mo, 3);
            float scroll = MOD_FLOAT(mo, 4);
            vec3 sample_pos = p.position * freq + vec3(0.0, scroll * (p.max_lifetime - p.lifetime), 0.0);
            p.velocity += curl_noise(sample_pos) * strength * dt;
        }
        else if (mtype == MOD_ATTRACT) {
            vec3 attract_pos = MOD_VEC3(mo, 2);
            float strength = MOD_FLOAT(mo, 5);
            float radius = MOD_FLOAT(mo, 6);
            vec3 dir = attract_pos - p.position;
            float dist = length(dir);
            if (dist > 0.001) {
                float falloff = clamp(1.0 - dist / radius, 0.0, 1.0);
                p.velocity += normalize(dir) * strength * falloff * dt;
            }
        }
        else if (mtype == MOD_VELOCITY_LIMIT) {
            float max_speed = MOD_FLOAT(mo, 2);
            float spd = length(p.velocity);
            if (spd > max_speed) {
                p.velocity = normalize(p.velocity) * max_speed;
            }
        }
        else if (mtype == MOD_CURVE_COLOR_OVER_LIFE) {
            uint n = module_data[mo + 2];
            // LUT layout: [header:2][n:1][pad:1][R:n][G:n][B:n][A:n]
            float r = sample_curve_lut(mo, 4, n, age);
            float g = sample_curve_lut(mo, 4 + n, n, age);
            float b = sample_curve_lut(mo, 4 + n * 2, n, age);
            float a = sample_curve_lut(mo, 4 + n * 3, n, age);
            p.color = vec4(r, g, b, a);
        }
        else if (mtype == MOD_CURVE_SIZE_OVER_LIFE) {
            uint n = module_data[mo + 2];
            p.size = sample_curve_lut(mo, 4, n, age);
        }
        else if (mtype == MOD_COLLISION) {
            uint response_mode = module_data[mo + 2];
            uint collision_source = module_data[mo + 3];
            float restitution = MOD_FLOAT(mo, 4);
            float friction_val = MOD_FLOAT(mo, 5);
            vec3 sdf_min = MOD_VEC3(mo, 6);
            vec3 sdf_max = MOD_VEC3(mo, 10);

            bool collided = false;
            vec3 normal = vec3(0, 1, 0);

            // Source 0 = SDF, 2 = Both (try SDF first)
            if (collision_source == 0u || collision_source == 2u) {
                vec3 sdf_extent = sdf_max - sdf_min;
                vec3 uvw = (p.position - sdf_min) / sdf_extent;
                if (all(greaterThanEqual(uvw, vec3(0.0))) && all(lessThanEqual(uvw, vec3(1.0)))) {
                    float dist = textureLod(scene_sdf, uvw, 0).r;
                    if (dist < 0.0) {
                        vec3 texel = 1.0 / vec3(textureSize(scene_sdf, 0));
                        float dx = textureLod(scene_sdf, uvw + vec3(texel.x, 0, 0), 0).r
                                 - textureLod(scene_sdf, uvw - vec3(texel.x, 0, 0), 0).r;
                        float dy = textureLod(scene_sdf, uvw + vec3(0, texel.y, 0), 0).r
                                 - textureLod(scene_sdf, uvw - vec3(0, texel.y, 0), 0).r;
                        float dz = textureLod(scene_sdf, uvw + vec3(0, 0, texel.z), 0).r
                                 - textureLod(scene_sdf, uvw - vec3(0, 0, texel.z), 0).r;
                        normal = normalize(vec3(dx, dy, dz));
                        p.position += normal * (-dist + 0.01);
                        collided = true;
                    }
                }
            }

            // Source 1 = Depth, 2 = Both (depth as fallback)
            if (!collided && (collision_source == 1u || collision_source == 2u)) {
                vec4 clip = global_ubo.projection * global_ubo.view * vec4(p.position, 1.0);
                if (clip.w > 0.0) {
                    vec3 ndc = clip.xyz / clip.w;
                    vec2 screen_uv = ndc.xy * 0.5 + 0.5;
                    if (all(greaterThanEqual(screen_uv, vec2(0.0))) &&
                        all(lessThanEqual(screen_uv, vec2(1.0)))) {
                        float scene_depth = texture(depth_texture, screen_uv).r;
                        if (ndc.z > scene_depth && scene_depth > 0.0) {
                            vec2 texel = 1.0 / vec2(textureSize(depth_texture, 0));
                            float d_r = texture(depth_texture, screen_uv + vec2(texel.x, 0)).r;
                            float d_u = texture(depth_texture, screen_uv + vec2(0, texel.y)).r;
                            float ddx = d_r - scene_depth;
                            float ddy = d_u - scene_depth;
                            if (abs(ddx) > 1e-6 || abs(ddy) > 1e-6) {
                                vec3 r_dir = vec3(texel.x * 2.0, 0.0, ddx);
                                vec3 u_dir = vec3(0.0, texel.y * 2.0, ddy);
                                normal = normalize(cross(r_dir, u_dir));
                                normal = normalize(mat3(inverse(global_ubo.view)) * normal);
                            }
                            p.position += normal * 0.05;
                            collided = true;
                        }
                    }
                }
            }

            if (collided) {
                if (response_mode == 0u) {
                    float vn = dot(p.velocity, normal);
                    if (vn < 0.0) {
                        p.velocity -= (1.0 + restitution) * vn * normal;
                        vec3 v_tan = p.velocity - dot(p.velocity, normal) * normal;
                        p.velocity -= v_tan * friction_val;
                    }
                } else if (response_mode == 1u) {
                    float vn = dot(p.velocity, normal);
                    if (vn < 0.0) {
                        p.velocity -= vn * normal;
                        p.velocity *= (1.0 - friction_val);
                    }
                } else {
                    p.lifetime = 0.0;
                }
            }
        }

        mo += msize;
    }

    p.position += p.velocity * dt;
    p.rotation += p.rotation_speed * dt;
    particles[idx] = p;
}
