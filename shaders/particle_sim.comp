#version 460

#include "include/particle_common.glsl"
#include "include/noise.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) buffer Counters {
    uint counters[];  // [alive_0, dead_0, alive_1, dead_1, ...]
};

layout(std430, set = 0, binding = 2) buffer DeadList {
    uint dead_indices[];
};

layout(std430, set = 0, binding = 3) readonly buffer EmitterBuffer {
    EmitterData emitters[];
};

layout(std430, set = 0, binding = 5) readonly buffer ModuleBuffer {
    uint module_data[];
};

layout(std430, set = 0, binding = 6) buffer SubEmitterEventBuf {
    SubEmitterEvent sub_events[];
};

layout(std430, set = 0, binding = 7) buffer SubEmitterEventCounters {
    uint sub_event_counts[];
};

#include "include/particle_modules.glsl"
#include "fjell_global_ubo.glsl"
#include "fjell_environment.glsl"

// Set 1 = global descriptors (for SDF + depth access)
FJELL_DECLARE_GLOBAL_UBO(1, 0, global_ubo);
FJELL_DECLARE_ENVIRONMENT_UBO(1, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);

layout(set = 1, binding = 4) uniform sampler2D depth_texture;
layout(set = 1, binding = 9) uniform sampler3D scene_sdf;

layout(push_constant) uniform PushConstants {
    float dt;            // the frame's; the simulation steps by each emitter's own
    uint  random_seed;
    uint  emitter_count;
    uint  total_max_particles;
    uint  sub_emit_pass;
};

// How far from a surface a resting particle settles.
const float CONTACT_DISTANCE = 0.01;
// A bounce slower than this only jitters against the surface; the particle settles instead.
const float REST_SPEED = 0.3;
const int SWEEP_STEPS = 12;

// Scene distance field at a world position. The volume is padded around every
// mesh, so a position outside it is far from anything.
float scene_sdf_distance(vec3 pos, vec3 sdf_min, vec3 sdf_max) {
    vec3 uvw = (pos - sdf_min) / (sdf_max - sdf_min);
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) return 1e4;
    return textureLod(scene_sdf, uvw, 0).r;
}

// Outward surface normal from central differences one voxel apart. Each axis
// is divided by its own voxel size in world units, so a volume that is not a
// cube does not skew the direction.
vec3 scene_sdf_normal(vec3 pos, vec3 sdf_min, vec3 sdf_max) {
    vec3 voxel = (sdf_max - sdf_min) / vec3(textureSize(scene_sdf, 0));
    vec3 g = vec3(
        scene_sdf_distance(pos + vec3(voxel.x, 0, 0), sdf_min, sdf_max)
      - scene_sdf_distance(pos - vec3(voxel.x, 0, 0), sdf_min, sdf_max),
        scene_sdf_distance(pos + vec3(0, voxel.y, 0), sdf_min, sdf_max)
      - scene_sdf_distance(pos - vec3(0, voxel.y, 0), sdf_min, sdf_max),
        scene_sdf_distance(pos + vec3(0, 0, voxel.z), sdf_min, sdf_max)
      - scene_sdf_distance(pos - vec3(0, 0, voxel.z), sdf_min, sdf_max)) / (2.0 * voxel);
    float len = length(g);
    return len > 1e-6 ? g / len : vec3(0.0, 1.0, 0.0);
}

// Sweeps a sphere of `radius` from `start` along the unit `dir` for `travel`.
// Sphere tracing: each step covers exactly the distance to the nearest
// surface, which the field cannot cross without reaching zero, so a thin wall
// stops the particle instead of being skipped. Returns the distance travelled
// to the contact, or -1 when nothing is hit.
float scene_sdf_sweep(vec3 start, vec3 dir, float travel, float radius, vec3 sdf_min, vec3 sdf_max) {
    float t = 0.0;
    for (int i = 0; i < SWEEP_STEPS; ++i) {
        float d = scene_sdf_distance(start + dir * t, sdf_min, sdf_max) - radius;
        if (d < CONTACT_DISTANCE) return t;
        t += d;
        if (t >= travel) return -1.0;
    }
    return -1.0;
}

void emit_sub_event(Particle p, EmitterData em, uint event_type) {
    uint slot = atomicAdd(sub_event_counts[p.emitter_index], 1);
    if (slot >= MAX_SUB_EVENTS_PER_EMITTER) return;
    uint event_idx = em.sub_event_offset + slot;
    sub_events[event_idx].position = p.position;
    sub_events[event_idx].velocity = p.velocity;
    sub_events[event_idx].speed = length(p.velocity);
    sub_events[event_idx].size = p.size;
    sub_events[event_idx].color = p.color;
    sub_events[event_idx].parent_emitter = p.emitter_index;
    sub_events[event_idx].event_type = event_type;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total_max_particles) return;

    Particle p = particles[idx];
    if (p.lifetime <= 0.0) return;

    EmitterData em = emitters[p.emitter_index];
    // The emitter's own step, not the frame's: a paused emitter's is zero,
    // and so is that of an emitter whose scene is not the one dispatching,
    // so a preview rendered between two frames leaves them where they are.
    float step = em.dt;

    // Whether this emitter feeds a child, and on what, comes in the flags:
    // a walk of the module stack per particle just to find out would cost
    // as much as the update walk itself.
    bool has_sub_emitter = (em.flags & 8u) != 0u;
    uint sub_trigger = (em.flags >> 4) & 3u; // 0=death, 1=collision, 2=both

    p.lifetime -= step;
    if (p.lifetime <= 0.0) {
        // Emit death event for sub-emitters
        if (has_sub_emitter && (sub_trigger == SUB_EVENT_DEATH || sub_trigger == 2u)) {
            emit_sub_event(p, em, SUB_EVENT_DEATH);
        }
        // Mark dead — ring buffer emit will overwrite this slot eventually.
        // A trail's strip keeps its slot in ring order and draws it at zero
        // width, so the ribbon shortens from the tail as its points die.
        particles[idx].lifetime = 0.0;
        return;
    }

    float age = 1.0 - (p.lifetime / p.max_lifetime);

    // Share of this frame's travel still to integrate after the module walk;
    // a collision spends part of it reaching the surface.
    float move_fraction = 1.0;

    // Walk update modules (max 32 iterations to prevent GPU hang on corrupt data)
    uint mo = em.module_offset;
    for (int guard = 0; guard < 32; ++guard) {
        uint mtype = module_data[mo];
        uint msize = module_data[mo + 1];
        if (mtype == MOD_TERMINATOR || msize == 0) break;

        if (mtype == MOD_GRAVITY) {
            vec3 force = MOD_VEC3(mo, 2);
            p.velocity += force * step;
        }
        else if (mtype == MOD_WIND) {
            vec3 dir = MOD_VEC3(mo, 2);
            float str = MOD_FLOAT(mo, 5);
            if (module_data[mo + 6] != 0u) {
                // The environment's wind: its direction, its speed with the
                // gust folded in, scaled by the module's strength.
                dir = env_ubo.wind_dir_speed_gust.xyz;
                str *= env_ubo.wind_dir_speed_gust.w;
            }
            p.velocity += dir * str * step;
        }
        else if (mtype == MOD_ORBITAL) {
            uint omode = module_data[mo + 2];
            vec3 axis_or_center = MOD_VEC3(mo, 3);
            float spd = MOD_FLOAT(mo, 6);
            float pul = MOD_FLOAT(mo, 7);

            if (omode == ORBITAL_VORTEX || omode == ORBITAL_SWIRL) {
                // Tangential force around axis
                vec3 ax = normalize(axis_or_center);
                vec3 to_particle = p.position - em.emitter_position;
                vec3 radial = to_particle - dot(to_particle, ax) * ax;
                vec3 tangent = cross(ax, radial);
                float r = length(radial);
                if (r > 0.001) {
                    p.velocity += normalize(tangent) * spd * step;
                    if (omode == ORBITAL_SWIRL) {
                        p.velocity -= normalize(radial) * pul * step;
                    }
                }
            } else {
                // Orbit around center point
                vec3 to_particle = p.position - axis_or_center;
                float r = length(to_particle);
                if (r > 0.001) {
                    vec3 radial = normalize(to_particle);
                    // Pick a tangent: cross with up, fallback to right
                    vec3 up = abs(radial.y) < 0.99 ? vec3(0,1,0) : vec3(1,0,0);
                    vec3 tangent = normalize(cross(up, radial));
                    p.velocity += tangent * spd * step;
                }
            }
        }
        else if (mtype == MOD_COLOR_OVER_LIFE) {
            vec4 col_start = MOD_VEC4(mo, 2);
            vec4 col_end = MOD_VEC4(mo, 6);
            p.color = mix(col_start, col_end, age);
        }
        else if (mtype == MOD_SIZE_OVER_LIFE) {
            float s_start = MOD_FLOAT(mo, 2);
            float s_end = MOD_FLOAT(mo, 3);
            p.size = mix(s_start, s_end, age);
        }
        else if (mtype == MOD_DRAG) {
            float drag_coeff = MOD_FLOAT(mo, 2);
            p.velocity *= max(0.0, 1.0 - drag_coeff * step);
        }
        else if (mtype == MOD_NOISE) {
            float strength = MOD_FLOAT(mo, 2);
            float freq = MOD_FLOAT(mo, 3);
            float scroll = MOD_FLOAT(mo, 4);
            vec3 sample_pos = p.position * freq + vec3(0.0, scroll * (p.max_lifetime - p.lifetime), 0.0);
            p.velocity += curl_noise(sample_pos) * strength * step;
        }
        else if (mtype == MOD_ATTRACT) {
            vec3 attract_pos = MOD_VEC3(mo, 2);
            float strength = MOD_FLOAT(mo, 5);
            float radius = MOD_FLOAT(mo, 6);
            vec3 dir = attract_pos - p.position;
            float dist = length(dir);
            if (dist > 0.001) {
                float falloff = clamp(1.0 - dist / radius, 0.0, 1.0);
                p.velocity += normalize(dir) * strength * falloff * step;
            }
        }
        else if (mtype == MOD_VELOCITY_LIMIT) {
            float max_speed = MOD_FLOAT(mo, 2);
            float spd = length(p.velocity);
            if (spd > max_speed) {
                p.velocity = normalize(p.velocity) * max_speed;
            }
        }
        else if (mtype == MOD_CURVE_COLOR_OVER_LIFE) {
            uint n = module_data[mo + 2];
            // LUT layout: [header:2][n:1][pad:1][R:n][G:n][B:n][A:n]
            float r = sample_curve_lut(mo, 4, n, age);
            float g = sample_curve_lut(mo, 4 + n, n, age);
            float b = sample_curve_lut(mo, 4 + n * 2, n, age);
            float a = sample_curve_lut(mo, 4 + n * 3, n, age);
            p.color = vec4(r, g, b, a);
        }
        else if (mtype == MOD_CURVE_SIZE_OVER_LIFE) {
            uint n = module_data[mo + 2];
            p.size = sample_curve_lut(mo, 4, n, age);
        }
        else if (mtype == MOD_COLLISION) {
            uint response_mode = module_data[mo + 2];
            uint collision_source = module_data[mo + 3];
            float restitution = MOD_FLOAT(mo, 4);
            float friction_val = MOD_FLOAT(mo, 5);
            vec3 sdf_min = MOD_VEC3(mo, 6);
            float radius = p.size * MOD_FLOAT(mo, 9);
            vec3 sdf_max = MOD_VEC3(mo, 10);

            bool collided = false;
            vec3 normal = vec3(0, 1, 0);

            // Source 3 = shelter above. Nothing measures shelter at present,
            // so a particle set to it collides with nothing and rain falls
            // wherever it is emitted. The source is kept so effects that name
            // it still load.

            // Source 0 = SDF, 2 = Both (try SDF first)
            if (collision_source == 0u || collision_source == 2u) {
                float d0 = scene_sdf_distance(p.position, sdf_min, sdf_max) - radius;
                if (d0 < 0.0) {
                    // Already overlapping: spawned inside, or the geometry
                    // moved onto the particle. Push straight out.
                    normal = scene_sdf_normal(p.position, sdf_min, sdf_max);
                    p.position += normal * (CONTACT_DISTANCE - d0);
                    collided = true;
                } else {
                    float speed = length(p.velocity);
                    float travel = speed * step;
                    if (travel > 0.0) {
                        vec3 dir = p.velocity / speed;
                        float t = scene_sdf_sweep(p.position, dir, travel, radius, sdf_min, sdf_max);
                        if (t >= 0.0) {
                            p.position += dir * t;
                            normal = scene_sdf_normal(p.position, sdf_min, sdf_max);
                            move_fraction = 1.0 - t / travel;
                            collided = true;
                        }
                    }
                }
            }

            // Source 1 = Depth, 2 = Both (depth as fallback)
            if (!collided && (collision_source == 1u || collision_source == 2u)) {
                vec4 clip = global_ubo.projection * global_ubo.view * vec4(p.position, 1.0);
                if (clip.w > 0.0) {
                    vec3 ndc = clip.xyz / clip.w;
                    vec2 screen_uv = ndc.xy * 0.5 + 0.5;
                    if (all(greaterThanEqual(screen_uv, vec2(0.0))) &&
                        all(lessThanEqual(screen_uv, vec2(1.0)))) {
                        float scene_depth = texture(depth_texture, screen_uv).r;
                        if (ndc.z > scene_depth && scene_depth > 0.0) {
                            vec2 texel = 1.0 / vec2(textureSize(depth_texture, 0));
                            float d_r = texture(depth_texture, screen_uv + vec2(texel.x, 0)).r;
                            float d_u = texture(depth_texture, screen_uv + vec2(0, texel.y)).r;
                            float ddx = d_r - scene_depth;
                            float ddy = d_u - scene_depth;
                            if (abs(ddx) > 1e-6 || abs(ddy) > 1e-6) {
                                vec3 r_dir = vec3(texel.x * 2.0, 0.0, ddx);
                                vec3 u_dir = vec3(0.0, texel.y * 2.0, ddy);
                                normal = normalize(cross(r_dir, u_dir));
                                normal = normalize(mat3(inverse(global_ubo.view)) * normal);
                            }
                            p.position += normal * 0.05;
                            collided = true;
                        }
                    }
                }
            }

            if (collided) {
                if (response_mode == 2u) {
                    // Collision kill — emit event before killing
                    if (has_sub_emitter && (sub_trigger == SUB_EVENT_COLLISION || sub_trigger == 2u)) {
                        emit_sub_event(p, em, SUB_EVENT_COLLISION);
                    }
                    p.lifetime = 0.0;
                } else {
                    float vn = dot(p.velocity, normal);
                    if (vn < 0.0) {
                        vec3 v_normal = vn * normal;
                        vec3 v_tangent = (p.velocity - v_normal) * (1.0 - friction_val);
                        bool bounce = response_mode == 0u && -vn > REST_SPEED;
                        p.velocity = bounce ? v_tangent - v_normal * restitution : v_tangent;
                    }
                }
            }
        }

        mo += msize;
    }

    p.position += p.velocity * step * move_fraction;
    p.rotation += p.rotation_speed * step;
    particles[idx] = p;
}
