#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// The probe field's own cage, for the bounce at a hit, read the way every
// other reader of the field reads it. Its offsets also place each probe's
// rays.
#define FJELL_DDGI_CAGE
#define FJELL_DDGI_CAGE_IRRADIANCE_BINDING 6
#define FJELL_DDGI_CAGE_VISIBILITY_BINDING 7
#define FJELL_DDGI_CAGE_OFFSET_BINDING     5
#define FJELL_DDGI_CAGE_STATUS_BINDING     4
#include "fjell_ddgi.glsl"

// ── Bindings ────────────────────────────────────────────────────────────

layout(set = 0, binding = 1) uniform sampler3D scene_sdf;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D radiance_out;
layout(set = 0, binding = 3) uniform samplerCube sky_cubemap;

// The point and spot lights that reach the grid (binding 8).
#define FJELL_DDGI_LIGHTS_BINDING 8
#include "fjell_ddgi_lights.glsl"

// Which object is nearest each voxel of the SDF, and the materials each
// object draws with (set 1 holds the materials themselves).
layout(set = 0, binding = 9) uniform usampler3D scene_sdf_index;
layout(set = 0, binding = 10) readonly buffer SdfSlots {
    SdfSlot sdf_slots[];
};

layout(set = 1, binding = 0) uniform sampler2D textures[];
layout(set = 1, binding = 1) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
};

// ── Push constants ──────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    vec3 light_direction;     // toward light
    float light_intensity;
    vec3 light_color;
    float sdf_resolution;
    vec3 sdf_volume_min;
    uint random_seed;         // changes every frame: which local light a hit takes
    vec3 sdf_volume_max;
    float pad_pc1;
};


// ── SDF sphere tracing ──────────────────────────────────────────────────

const int MAX_STEPS = 64;
const float MIN_DIST = 0.005;
const float MAX_TRACE_DIST = 40.0;

float sample_scene_sdf(vec3 world_pos) {
    vec3 uvw = (world_pos - sdf_volume_min) / (sdf_volume_max - sdf_volume_min);
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
        return MAX_TRACE_DIST;
    return texture(scene_sdf, uvw).r;
}

// Whether a march from `origin` along `direction` gets `max_t` away, or out of
// the volume, without touching a surface.
bool sdf_unoccluded(vec3 origin, vec3 direction, float max_t) {
    float t = 0.0;
    for (int i = 0; i < MAX_STEPS && t < max_t; i++) {
        float d = sample_scene_sdf(origin + direction * t);
        if (d < MIN_DIST) {
            return false;
        }
        t += max(d, MIN_DIST);
    }
    return true;
}

// The edge of one voxel of the field, its longest.
float sdf_voxel_size() {
    vec3 voxel = (sdf_volume_max - sdf_volume_min) / sdf_resolution;
    return max(voxel.x, max(voxel.y, voxel.z));
}

// A texture's last mip is its average colour; a sampler clamps past it.
const float WHOLE_TEXTURE_LOD = 16.0;
// What a hit bounces where no object's colour is known.
const vec3 NEUTRAL_ALBEDO = vec3(0.5);

// The colour a probe ray bounces off the object nearest `p`: each of its
// materials' base colour factor (a shader's hint_albedo folded in) times its
// texture's average, averaged over them. One colour per object, not per
// texel: the field only places a hit to within a voxel.
vec3 sdf_hit_albedo(vec3 p) {
    vec3 uvw = (p - sdf_volume_min) / (sdf_volume_max - sdf_volume_min);
    ivec3 size = textureSize(scene_sdf_index, 0);
    ivec3 voxel = clamp(ivec3(uvw * vec3(size)), ivec3(0), size - 1);
    uint slot = texelFetch(scene_sdf_index, voxel, 0).r;
    if (slot == NO_SDF_SLOT || slot >= uint(sdf_slots.length())) {
        return NEUTRAL_ALBEDO;
    }

    SdfSlot object = sdf_slots[slot];
    vec3 sum = vec3(0.0);
    uint count = 0u;
    for (uint i = 0u; i < min(object.material_count, 3u); ++i) {
        uint id = object.material_ids[i];
        if (id >= uint(materials.length())) {
            continue;
        }
        vec3 albedo = vec3(materials[id].base_params[0], materials[id].base_params[1],
                           materials[id].base_params[2]);
        uint base_color_tex = materials[id].texture_indices[0];
        if (base_color_tex > 0u) {
            albedo *= textureLod(textures[nonuniformEXT(base_color_tex)], vec2(0.5),
                                 WHOLE_TEXTURE_LOD).rgb;
        }
        sum += albedo;
        ++count;
    }
    return count > 0u ? sum / float(count) : NEUTRAL_ALBEDO;
}

vec3 estimate_normal(vec3 p) {
    float e = 0.05;
    float d = sample_scene_sdf(p);
    return normalize(vec3(
        sample_scene_sdf(p + vec3(e, 0, 0)) - d,
        sample_scene_sdf(p + vec3(0, e, 0)) - d,
        sample_scene_sdf(p + vec3(0, 0, e)) - d
    ));
}

// ── Main ────────────────────────────────────────────────────────────────

void main() {
    int ray_index = int(gl_GlobalInvocationID.x);
    if (ray_index >= ddgi.probe_rays) return;

    int probe_index = int(gl_GlobalInvocationID.y) + ddgi.probe_update_offset;
    int total_probes = ddgi.probe_counts.x * ddgi.probe_counts.y * ddgi.probe_counts.z;
    if (probe_index >= total_probes) return;

    // Every probe traces every ray, off or not: a probe the update switched
    // off tests its burial again here, the moment it is no longer inside
    // geometry it comes back, and every radiance row the update reads was
    // written this frame.
    ivec3 grid_indices = ddgi_probe_index_to_grid(probe_index);
    vec3 ray_origin = ddgi_grid_to_world(grid_indices, probe_index, ddgi_probe_offset_tex, true);

    // Ray direction: jittered spherical Fibonacci
    vec3 direction = normalize(mat3(ddgi.random_rotation) * spherical_fibonacci(float(ray_index), float(ddgi.probe_rays)));

    // Check if probe is inside geometry
    float origin_sdf = sample_scene_sdf(ray_origin);
    if (origin_sdf < -MIN_DIST) {
        // Inside geometry — record negative distance for backface detection
        imageStore(radiance_out, ivec2(ray_index, probe_index - ddgi.probe_update_offset),
                   vec4(0.0, 0.0, 0.0, origin_sdf));
        return;
    }

    // Sphere trace
    float t = max(origin_sdf, MIN_DIST);
    bool hit = false;

    for (int i = 0; i < MAX_STEPS && t < MAX_TRACE_DIST; i++) {
        vec3 p = ray_origin + direction * t;
        float d = sample_scene_sdf(p);

        if (d < MIN_DIST) {
            hit = true;
            break;
        }
        t += max(d, MIN_DIST);
    }

    vec3 radiance;
    float distance;

    if (hit) {
        vec3 hit_pos = ray_origin + direction * t;
        vec3 N = estimate_normal(hit_pos);

        vec3 albedo = sdf_hit_albedo(hit_pos);

        // The sun, where nothing stands between it and the hit. The march
        // starts a voxel off the surface: the field is too coarse to leave
        // it any closer without finding the surface it starts on.
        radiance = vec3(0.0);
        float NdotL = max(dot(N, light_direction), 0.0);
        float voxel = sdf_voxel_size();
        if (NdotL > 0.0 && light_intensity > 0.0
            && sdf_unoccluded(hit_pos + N * voxel, light_direction, MAX_TRACE_DIST)) {
            radiance = albedo * light_color * light_intensity * NdotL;
        }

        // One point or spot light, picked in proportion to what each gives
        // the hit and scaled by the chance of the pick, where the march
        // toward it gets there. It stops short of the light, which has no
        // surface of its own.
        uint h = fjell_hash(uint(probe_index) * uint(ddgi.probe_rays) + uint(ray_index));
        h = fjell_hash(h ^ random_seed);
        float u = float(h >> 8u) * (1.0 / 16777216.0);
        DdgiLightPick pick = ddgi_pick_light(hit_pos, N, u);
        if (pick.index >= 0
            && sdf_unoccluded(hit_pos + N * voxel, pick.light.to_light,
                              max(pick.light.distance - 2.0 * voxel, 0.0))) {
            radiance += albedo * pick.light.incident;
        }

        // Indirect bounce, as the RT trace does it: the field's irradiance
        // at the hit, gathered last frame, reflected once more.
        radiance += ddgi_sample_cage(hit_pos, N, ray_origin, false).irradiance
                  * albedo * ddgi.infinite_bounces_mult;

        distance = t;
    } else {
        // Miss: the sky, blurred as the RT trace reads it. Mip 0 has extreme
        // HDR peaks (the sun disk) that drown out the bounce light.
        radiance = textureLod(sky_cubemap, direction, 4.0).rgb;
        distance = MAX_TRACE_DIST;
    }

    imageStore(radiance_out, ivec2(ray_index, probe_index - ddgi.probe_update_offset),
               vec4(radiance, distance));
}
