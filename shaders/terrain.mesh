#version 460
#extension GL_EXT_mesh_shader : require

#include "fjell_global_ubo.glsl"

// One workgroup emits one terrain patch, at the level the task shader chose.
// The output declaration is the finest level and bounds the allocation; a
// coarser patch calls SetMeshOutputsEXT with its own smaller counts and leaves
// the rest unused, which is why one pipeline serves every level.
#include "fjell_terrain_grid.glsl"

layout(local_size_x = 64) in;
layout(triangles, max_vertices = MAX_VERTS, max_primitives = MAX_TRIS) out;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

// Set 2 holds the terrain textures: heights here, layer weights at binding 1
// for the fragment stage. Set 1 is the material set the fragment stage reads.
layout(set = 2, binding = 0) uniform sampler2D height_tex;

layout(push_constant) uniform PushConstants {
    vec2  world_origin;
    float world_size;
    float height_scale;
    float height_offset;
    uint  patches_per_side;
    uint  patch_quads;
    // Which projection to write positions through: 0 is the camera, 1..3 the
    // shadow cascade of that index minus one. The cascade matrices already
    // live in the global UBO, so a shadow draw costs an index rather than a
    // second matrix in a block every stage has to carry.
    uint  view_index;
    // Read by the fragment stage; declared here so every stage sees the same
    // block.
    uint  terrain_material_id;
    // Render target size in pixels, and the projected patch height in pixels
    // below which each coarser LOD level takes over. Descending.
    vec2  viewport;
    vec3  lod_thresholds;
    uint  _pad3;
    uvec4 layer_material_ids;
    vec4  layer_uv_scales;
} push;

struct TaskPayload {
    uint patch_x;
    uint patch_z;
    uint level;
    // How far this patch has slid toward the next coarser level, [0,1]. At 1
    // it already draws that level's surface, so the flip is invisible.
    float morph;
    uint neighbour_level[4];
    // Each neighbour's morph too: two patches at one level morph by
    // different amounts when they sit at different distances, and a
    // shared edge has to be built from the same numbers on both sides
    // or it cracks.
    float neighbour_morph[4];
    uint prev_level;
    float prev_morph;
    uint prev_neighbour_level[4];
    float prev_neighbour_morph[4];
};

taskPayloadSharedEXT TaskPayload payload;

// Matches mesh.vert's interface so terrain can share the scene's fragment
// shading conventions.
layout(location = 0) out vec3 frag_color[];
layout(location = 1) out vec2 frag_tex_coord[];
layout(location = 2) out vec3 frag_world_pos[];
layout(location = 3) out vec3 frag_world_normal[];
layout(location = 4) out vec4 frag_clip_pos[];
layout(location = 5) out vec4 frag_prev_clip_pos[];

float sample_height(vec2 uv) {
    return push.height_offset + texture(height_tex, uv).r * push.height_scale;
}

#include "fjell_terrain_seam.glsl"

// Normals come from height differences rather than stored data, so they follow
// edits to the height texture with no extra work.
//
// The difference is taken between NEIGHBOURING VERTICES OF THIS PATCH, placed
// by the same terrain_vertex() that placed this one — not between texels. A
// coarse patch, a morphing one and an edge stitched to a neighbour all draw a
// surface that departs from the height texture, and a normal read from the
// texture describes ground that is not the ground being drawn. The error
// reaches 17 degrees at a ridge, which is most of the band the default
// terrain shader uses to choose between its slope layers, so it shows up as
// specks of the wrong material along coarse edges and on hilltops.
//
// Differencing the placed surface instead costs four more terrain_vertex()
// calls per vertex and is exact at every level: the shaded normal is the
// surface the triangles actually have.
// The drawn height one step off the patch grid, following the surface across a
// patch border rather than stopping at it.
//
// A sample outside this patch is placed on the NEIGHBOUR's surface, at the
// neighbour's level and morph. Clamping back inside instead makes the two
// patches either side of an edge measure their slope over different intervals
// — one leaning in from the left, one from the right — so they disagree about
// the normal at the same piece of ground by as much as a right angle. Matte
// ground hides it; the moment rain drops roughness the highlight turns that
// disagreement into a lit line along every patch edge.
//
// Only ±x and ±z are ever asked for, never a diagonal, so a corner needs its
// two edge neighbours and never the one across the corner — which is why the
// payload's four neighbours are enough.
vec3 patch_height_at(int ix, int iz, uint quads,
                     vec2 patch_uv_min, vec2 patch_uv_size) {
    // Which patch the sample lands in, and where it sits in that patch's own
    // grid. Stepping one of our cells is a fraction of a coarser neighbour's
    // cell, which terrain_vertex_at() takes without rounding.
    vec2 local = vec2(float(ix), float(iz)) / float(quads);
    vec2 patch_step = vec2(0.0);
    uint level = payload.level;
    float morph = payload.morph;

    if (ix < 0) {
        patch_step.x = -1.0;
        level = payload.neighbour_level[0];
        morph = payload.neighbour_morph[0];
    } else if (ix > int(quads)) {
        patch_step.x = 1.0;
        level = payload.neighbour_level[1];
        morph = payload.neighbour_morph[1];
    } else if (iz < 0) {
        patch_step.y = -1.0;
        level = payload.neighbour_level[2];
        morph = payload.neighbour_morph[2];
    } else if (iz > int(quads)) {
        patch_step.y = 1.0;
        level = payload.neighbour_level[3];
        morph = payload.neighbour_morph[3];
    }

    uint nb_quads = terrain_quads_at(level);
    vec2 nb_uv_min = patch_uv_min + patch_step * patch_uv_size;
    // Our position relative to the neighbour's origin, in the neighbour's
    // cells. `local` is still measured from our own patch, so the step moves
    // it into theirs.
    vec2 nb_grid = (local - patch_step) * float(nb_quads);

    // A neighbour so much coarser that the sample would land beyond its far
    // edge would need that patch's own far neighbour to place it, which is not
    // carried. It takes a cliff many times taller than a patch is wide for two
    // adjacent patches to sit that far apart in level, and clamping there only
    // shortens the difference rather than crossing into a third patch.
    nb_grid = clamp(nb_grid, vec2(0.0), vec2(float(nb_quads)));

    vec2 uv;
    float h;
    terrain_vertex_at(nb_grid, nb_quads, level, morph,
                      payload.neighbour_level[0], payload.neighbour_level[1],
                      payload.neighbour_level[2], payload.neighbour_level[3],
                      payload.neighbour_morph[0], payload.neighbour_morph[1],
                      payload.neighbour_morph[2], payload.neighbour_morph[3],
                      nb_uv_min, patch_uv_size, uv, h);
    // Report the position in OUR grid units so the caller's spacing is right:
    // the sample sits one of our cells away whichever patch answered it.
    return vec3(float(ix), h, float(iz));
}

vec3 compute_normal(uint ix, uint iz, uint quads, float metres_per_uv,
                    vec2 patch_uv_min, vec2 patch_uv_size) {
    vec3 l = patch_height_at(int(ix) - 1, int(iz), quads, patch_uv_min, patch_uv_size);
    vec3 r = patch_height_at(int(ix) + 1, int(iz), quads, patch_uv_min, patch_uv_size);
    vec3 d = patch_height_at(int(ix), int(iz) - 1, quads, patch_uv_min, patch_uv_size);
    vec3 u = patch_height_at(int(ix), int(iz) + 1, quads, patch_uv_min, patch_uv_size);

    // Samples sit one cell either side in this patch's own grid, on whichever
    // patch's surface answered them, so the interval is the full two cells
    // everywhere including the border.
    float spacing = patch_uv_size.x / float(quads) * metres_per_uv;
    float dx = (r.x - l.x) * spacing;
    float dz = (u.z - d.z) * spacing;
    return normalize(vec3(-(r.y - l.y) / dx, 1.0, -(u.y - d.y) / dz));
}

void main() {
    uint quads = terrain_quads_at(payload.level);
    uint verts_per_side = quads + 1u;
    uint vert_count = verts_per_side * verts_per_side;
    uint tri_count = quads * quads * 2u;
    SetMeshOutputsEXT(vert_count, tri_count);

    vec2 patch_uv_size = vec2(1.0 / float(push.patches_per_side));
    vec2 patch_uv_min = vec2(float(payload.patch_x), float(payload.patch_z)) * patch_uv_size;

    // Vertices: position comes from the invocation index, not a vertex buffer.
    // The loop strides by workgroup size because the count can exceed it.
    for (uint i = gl_LocalInvocationIndex; i < vert_count; i += 64) {
        uint ix = i % verts_per_side;
        uint iz = i / verts_per_side;

        vec2 uv;
        float height;
        terrain_vertex(ix, iz, quads, payload.level, payload.morph,
                       payload.neighbour_level[0], payload.neighbour_level[1],
                       payload.neighbour_level[2], payload.neighbour_level[3],
                       payload.neighbour_morph[0], payload.neighbour_morph[1],
                       payload.neighbour_morph[2], payload.neighbour_morph[3],
                       patch_uv_min, patch_uv_size, uv, height);

        vec3 world_pos = vec3(push.world_origin.x + uv.x * push.world_size,
                              height,
                              push.world_origin.y + uv.y * push.world_size);

        // Where this same point on the patch sat last frame. Terrain does not
        // move, but its surface does: a patch that changed level or morph slid
        // its vertices, and reporting no motion for that makes the temporal
        // passes reproject to the wrong history and fleck the LOD boundary.
        //
        // The point is identified by its position ACROSS THE PATCH, not by
        // vertex index: at a different level the patch has a different vertex
        // count, so index i is a different place on the ground. Scaling the
        // index into last frame's grid keeps it the same material point, and
        // a fractional result is fine — terrain_vertex() interpolates the
        // edge and the morph continuously.
        uint prev_quads = terrain_quads_at(payload.prev_level);
        vec2 prev_grid = vec2(float(ix), float(iz)) / float(quads) * float(prev_quads);
        vec2 prev_uv;
        float prev_height;
        terrain_vertex_at(prev_grid, prev_quads, payload.prev_level, payload.prev_morph,
                          payload.prev_neighbour_level[0], payload.prev_neighbour_level[1],
                          payload.prev_neighbour_level[2], payload.prev_neighbour_level[3],
                          payload.prev_neighbour_morph[0], payload.prev_neighbour_morph[1],
                          payload.prev_neighbour_morph[2], payload.prev_neighbour_morph[3],
                          patch_uv_min, patch_uv_size, prev_uv, prev_height);
        vec3 prev_world_pos = vec3(push.world_origin.x + prev_uv.x * push.world_size,
                                   prev_height,
                                   push.world_origin.y + prev_uv.y * push.world_size);

        // A shadow draw projects into its cascade; everything else into the
        // camera. The rest of the outputs stay in world space and are the same
        // either way, so only this line forks.
        vec4 clip = push.view_index == 0u
                        ? ubo.projection * ubo.view * vec4(world_pos, 1.0)
                        : ubo.cascade_vp[push.view_index - 1u] * vec4(world_pos, 1.0);
        gl_MeshVerticesEXT[i].gl_Position = clip;

        frag_color[i] = vec3(1.0);
        frag_tex_coord[i] = uv;
        frag_world_pos[i] = world_pos;
        frag_world_normal[i] = compute_normal(ix, iz, quads, push.world_size,
                                              patch_uv_min, patch_uv_size);
        frag_clip_pos[i] = ubo.unjittered_vp * vec4(world_pos, 1.0);
        frag_prev_clip_pos[i] = ubo.prev_unjittered_vp * vec4(prev_world_pos, 1.0);
    }

    // Triangles: fixed grid topology, pure index arithmetic, no index buffer.
    for (uint t = gl_LocalInvocationIndex; t < tri_count; t += 64) {
        uint quad = t >> 1;
        uint qx = quad % quads;
        uint qz = quad / quads;
        uint v0 = qz * verts_per_side + qx;
        uint v1 = v0 + 1;
        uint v2 = v0 + verts_per_side;
        uint v3 = v2 + 1;
        gl_PrimitiveTriangleIndicesEXT[t] =
            ((t & 1u) == 0u) ? uvec3(v0, v2, v1) : uvec3(v1, v2, v3);
    }
}
