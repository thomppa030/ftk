#version 460

layout(local_size_x = 64) in;

#include "fjell_draw_data.glsl"

layout(set = 0, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

struct MeshletInstance {
    uint meshlet_index;
    uint draw_index;
    uint instance_index;
    uint _pad;
};

layout(set = 0, binding = 1) writeonly buffer InstanceBuffer {
    MeshletInstance instances[];
};

layout(set = 0, binding = 2) buffer CounterBuffer {
    uint instance_count;
};

layout(push_constant) uniform PushConstants {
    uint total_draws;
} push;

void main() {
    uint draw_id = gl_GlobalInvocationID.x;
    if (draw_id >= push.total_draws) return;

    DrawData dd = draws[draw_id];
    if (dd.meshlet_count == 0) return;

    uint inst_total = max(dd.instance_count, 1u);
    uint emit_total = dd.meshlet_count * inst_total;
    uint base = atomicAdd(instance_count, emit_total);

    uint slot = 0;
    for (uint inst = 0; inst < inst_total; ++inst) {
        for (uint i = 0; i < dd.meshlet_count; ++i) {
            instances[base + slot].meshlet_index = dd.meshlet_offset + i;
            instances[base + slot].draw_index = draw_id;
            instances[base + slot].instance_index = inst;
            instances[base + slot]._pad = 0u;
            slot++;
        }
    }
}
