#version 460

#include "include/particle_common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) buffer Counters {
    uint counters[];  // [alive_0, dead_0, alive_1, dead_1, ...]
};

layout(std430, set = 0, binding = 2) buffer DeadList {
    uint dead_indices[];
};

layout(std430, set = 0, binding = 3) readonly buffer EmitterBuffer {
    EmitterData emitters[];
};

layout(std430, set = 0, binding = 5) readonly buffer ModuleBuffer {
    uint module_data[];
};

#include "include/particle_modules.glsl"

layout(push_constant) uniform PushConstants {
    float dt;
    uint  random_seed;
    uint  emitter_count;
    uint  total_max_particles;
};

uint hash(uint x) {
    x ^= x >> 16; x *= 0x45d9f3bu; x ^= x >> 16; x *= 0x45d9f3bu; x ^= x >> 16;
    return x;
}

float rand01(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967295.0;
}

vec3 rand_in_sphere(inout uint seed) {
    float u = rand01(seed) * 2.0 - 1.0;
    float phi = rand01(seed) * 6.28318530718;
    float r = pow(rand01(seed), 1.0 / 3.0);
    float s = sqrt(1.0 - u * u);
    return r * vec3(s * cos(phi), s * sin(phi), u);
}

void main() {
    uint emitter_idx = gl_WorkGroupID.y;
    if (emitter_idx >= emitter_count) return;

    uint local_emit_idx = gl_GlobalInvocationID.x;
    EmitterData em = emitters[emitter_idx];
    if (local_emit_idx >= em.emit_count) return;

    // Atomically pop from dead list (CAS loop to avoid unsigned underflow)
    uint dead_idx = em.counter_offset + 1;
    uint slot;
    for (;;) {
        slot = counters[dead_idx];
        if (slot == 0) return; // nothing available
        uint prev = atomicCompSwap(counters[dead_idx], slot, slot - 1);
        if (prev == slot) break; // won the race
        if (prev == 0) return;   // someone else took the last one
    }
    uint local_pi = dead_indices[em.dead_list_offset + slot - 1];
    uint global_pi = em.base_offset + local_pi;

    uint seed = em.random_seed ^ hash(local_emit_idx);

    // Defaults
    Particle p;
    p.position = em.emitter_position;
    p.lifetime = 1.0;
    p.max_lifetime = 1.0;
    p.velocity = vec3(0.0);
    p.color = vec4(1.0);
    p.size = 0.1;
    p.size_end = 0.02;
    p.emitter_index = emitter_idx;
    p.stretch = 0.0;

    // Walk spawn modules
    uint mo = em.module_offset;
    while (true) {
        uint mtype = module_data[mo];
        uint msize = module_data[mo + 1];
        if (mtype == MOD_TERMINATOR) break;

        if (mtype == MOD_INITIAL_LIFETIME) {
            float lt_min = MOD_FLOAT(mo, 2);
            float lt_max = MOD_FLOAT(mo, 3);
            float t = rand01(seed);
            p.lifetime = mix(lt_min, lt_max, t);
            p.max_lifetime = p.lifetime;
        }
        else if (mtype == MOD_INITIAL_POSITION) {
            uint shape = module_data[mo + 2];
            if (shape == SHAPE_SPHERE) {
                float radius = MOD_FLOAT(mo, 3);
                p.position = em.emitter_position + rand_in_sphere(seed) * radius;
            }
            else if (shape == SHAPE_BOX) {
                vec3 he = MOD_VEC3(mo, 4);
                p.position = em.emitter_position + vec3(
                    (rand01(seed) * 2.0 - 1.0) * he.x,
                    (rand01(seed) * 2.0 - 1.0) * he.y,
                    (rand01(seed) * 2.0 - 1.0) * he.z
                );
            }
            else if (shape == SHAPE_CONE) {
                // Cone: spawn on the base disk, direction is up the cone axis
                float radius = MOD_FLOAT(mo, 3);
                float r = sqrt(rand01(seed)) * radius;
                float phi = rand01(seed) * 6.28318530718;
                p.position = em.emitter_position + vec3(r * cos(phi), 0.0, r * sin(phi));
            }
            // SHAPE_POINT: already at emitter_position
        }
        else if (mtype == MOD_INITIAL_VELOCITY) {
            uint vmode = module_data[mo + 2];
            vec3 vmin = MOD_VEC3(mo, 4);
            vec3 vmax = MOD_VEC3(mo, 8);
            if (vmode == VELMODE_RANDOM) {
                p.velocity = mix(vmin, vmax,
                    vec3(rand01(seed), rand01(seed), rand01(seed)));
            } else if (vmode == VELMODE_CONE) {
                vec3 dir = normalize(MOD_VEC3(mo, 12));
                float half_angle = MOD_FLOAT(mo, 15); // already in radians
                float spd_min = MOD_FLOAT(mo, 16);
                float spd_max = MOD_FLOAT(mo, 17);
                // Random direction within cone
                float cos_angle = cos(half_angle);
                float z = mix(cos_angle, 1.0, rand01(seed));
                float phi = rand01(seed) * 6.28318530718;
                float r = sqrt(1.0 - z * z);
                vec3 local = vec3(r * cos(phi), r * sin(phi), z);
                // Rotate local from +Z to dir
                vec3 up = abs(dir.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
                vec3 right = normalize(cross(up, dir));
                up = cross(dir, right);
                p.velocity = (right * local.x + up * local.y + dir * local.z)
                    * mix(spd_min, spd_max, rand01(seed));
            } else {
                // Directional: average of min/max
                p.velocity = (vmin + vmax) * 0.5;
            }
        }
        else if (mtype == MOD_INITIAL_COLOR) {
            p.color = MOD_VEC4(mo, 2);
        }
        else if (mtype == MOD_INITIAL_SIZE) {
            float smin = MOD_FLOAT(mo, 2);
            float smax = MOD_FLOAT(mo, 3);
            float t = rand01(seed);
            p.size = mix(smin, smax, t);
            p.size_end = p.size; // default: no change (SizeOverLife overrides)
        }
        else if (mtype == MOD_INITIAL_STRETCH) {
            p.stretch = MOD_FLOAT(mo, 2);
        }

        mo += msize;
    }

    particles[global_pi] = p;
    atomicAdd(counters[em.counter_offset], 1);
}
