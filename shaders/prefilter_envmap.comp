#version 460

// Prefilter environment cubemap for split-sum specular IBL.
// Each mip level is convolved with the GGX NDF at a specific roughness.
// Dispatched per-mip: (mip_size/8, mip_size/8, 6).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube env_cubemap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray filtered_out;

layout(push_constant) uniform PushConstants {
    uint face_size;      // size of this mip level
    float roughness;     // roughness for this mip (0 = mirror, 1 = fully rough)
    uint sample_count;
};

const float PI = 3.14159265359;

vec3 cube_dir(uint face, vec2 uv) {
    vec2 st = uv * 2.0 - 1.0;
    switch (face) {
        case 0: return normalize(vec3( 1.0,  -st.y, -st.x)); // +X
        case 1: return normalize(vec3(-1.0,  -st.y,  st.x)); // -X
        case 2: return normalize(vec3( st.x,  1.0,   st.y)); // +Y
        case 3: return normalize(vec3( st.x, -1.0,  -st.y)); // -Y
        case 4: return normalize(vec3( st.x, -st.y,  1.0));  // +Z
        case 5: return normalize(vec3(-st.x, -st.y, -1.0));  // -Z
    }
    return vec3(0.0);
}

// Van der Corput radical inverse
float radical_inverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), radical_inverse(i));
}

// GGX importance sampling: returns half-vector in tangent space
vec3 importance_sample_ggx(vec2 xi, float roughness) {
    float a = roughness * roughness;
    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    return vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= face_size || id.y >= face_size) return;

    uint face = id.z;
    vec2 uv = (vec2(id.xy) + 0.5) / float(face_size);
    vec3 N = cube_dir(face, uv);
    vec3 V = N; // view = normal for prefiltering (isotropic assumption)

    // Build tangent frame from N
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);

    vec3 color = vec3(0.0);
    float total_weight = 0.0;

    // Mip 0 (roughness ~0): just copy, no filtering needed
    if (roughness < 0.001) {
        color = textureLod(env_cubemap, N, 0.0).rgb;
        total_weight = 1.0;
    } else {
        for (uint i = 0; i < sample_count; ++i) {
            vec2 xi = hammersley(i, sample_count);
            vec3 H_tangent = importance_sample_ggx(xi, roughness);
            vec3 H = T * H_tangent.x + B * H_tangent.y + N * H_tangent.z;
            vec3 L = reflect(-V, H);

            float NdotL = max(dot(N, L), 0.0);
            if (NdotL > 0.0) {
                // Bias source mip by roughness to reduce fireflies from bright spots
                float mip = roughness * 4.0;
                color += textureLod(env_cubemap, L, mip).rgb * NdotL;
                total_weight += NdotL;
            }
        }
    }

    if (total_weight > 0.0) {
        color /= total_weight;
    }

    imageStore(filtered_out, ivec3(id.xy, face), vec4(color, 1.0));
}
