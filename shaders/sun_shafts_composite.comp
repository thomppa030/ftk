#version 460

// Upsample half-res sun shafts and additively composite into scene color.
// The upsample weighs its four taps by depth as well as coverage, so shaft
// light does not bleed across a silhouette that crosses the half-res grid.
//
// Half-res accumulation + full-res composite follows the standard
// Frostbite / CryEngine post-process pattern (Hillaire 2015; Sousa 2013).

#include "fjell_global_ubo.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 1, binding = 0) uniform sampler2D shafts_tex;   // half-res
layout(set = 1, binding = 1) uniform sampler2D depth_texture; // full-res
layout(set = 1, binding = 2, rgba16f) uniform image2D scene_color;

layout(push_constant) uniform PushConstants {
    uvec2 viewport_size;
    uvec2 shafts_size;
    // How far a tap's surface may sit from this pixel's before it stops
    // counting, as a share of this pixel's own distance.
    //
    // A project setting for now, temporarily: it was exposed to find a value,
    // and 0.05 has held everywhere it has been looked at. It belongs back here
    // as a constant once a second scene agrees.
    float depth_tolerance;
} pc;

// A floor under that share, in metres, so the tolerance does not collapse to
// nothing on a surface right against the near plane and reject its own block.
#define FJELL_SHAFT_DEPTH_FLOOR 0.05

// What sky counts as, in metres. Past anything the shafts are drawn against,
// so sky disagrees with everything near it, and finite so that sky agrees with
// sky rather than every weight vanishing across an open horizon.
#define FJELL_SHAFT_DEPTH_SENTINEL 2000.0

// Half-res tap → the full-res texel that tap marched.
//
// Not the texel under the tap: the march takes one depth sample per half-res
// pixel, at its block centre, and that one sample decided the ray's length and
// so its whole result. Comparing against any other depth would be comparing
// against a surface the tap never saw. This is the same expression the march
// uses, and not `2*c+1` — half-res is an integer divide, so on an odd-sized
// viewport the ratio is a little over two and the mapping drifts.
ivec2 shaft_tap_depth_coord(ivec2 tap) {
    vec2 ratio = vec2(pc.viewport_size) / vec2(pc.shafts_size);
    ivec2 full = ivec2((vec2(tap) + 0.5) * ratio);
    return clamp(full, ivec2(0), ivec2(pc.viewport_size) - 1);
}

/// Raw depth → view-space Z, in metres.
///
/// The weight has to be relative to behave the same near and far, and a
/// relative threshold on raw depth does not: with a tenth-metre near plane and
/// a kilometre far one, half the raw range is spent inside the first twenty
/// centimetres and everything past ten metres is packed into the last
/// hundredth. Five percent of a raw depth out there spans most of what is left
/// of the buffer, so every tap would pass and the filter would do nothing
/// exactly where the shafts live. In metres, five percent is five percent
/// wherever you stand.
///
/// Columns 0 and 1 of inv_projection do not reach rows 2 and 3 for either a
/// perspective or an orthographic projection, so view Z falls out of the raw
/// depth alone and the full unproject is not needed. Dividing by w is what
/// keeps it right for both: an orthographic projection leaves w at one.
float shaft_linear_depth(float raw_depth) {
    float z = ubo.inv_projection[2][2] * raw_depth + ubo.inv_projection[3][2];
    float w = ubo.inv_projection[2][3] * raw_depth + ubo.inv_projection[3][3];
    float view_z = -z / (abs(w) < 1e-6 ? 1e-6 : w);
    // Sky is where that divide runs away. Clamped to a sentinel rather than
    // excluded: a sky tap's zero is the right answer for its direction, not
    // garbage. The march fades open sky on how far the ray got rather than on
    // a depth test, precisely so a silhouette does not step, and rejecting sky
    // taps here would hand that step straight back.
    return clamp(view_z, 0.0, FJELL_SHAFT_DEPTH_SENTINEL);
}

/// The four half-res taps covering this pixel, weighted by coverage and by how
/// near each tap's surface is to this pixel's own.
///
/// With the depths in agreement the weights are the plain bilinear ones, so
/// this is what a hardware bilinear tap would have returned; it only differs
/// where a depth edge actually runs through the footprint.
vec3 upsample_shafts(ivec2 coord, float center_linear) {
    // This pixel in half-res texel units, then the half-texel shift into
    // lattice space that puts the 2x2 around it.
    vec2 h = (vec2(coord) + 0.5) * vec2(pc.shafts_size) / vec2(pc.viewport_size);
    vec2 lattice = h - 0.5;
    ivec2 base = ivec2(floor(lattice));
    vec2 f = lattice - vec2(base);

    float coverage[4];
    coverage[0] = (1.0 - f.x) * (1.0 - f.y);
    coverage[1] =        f.x  * (1.0 - f.y);
    coverage[2] = (1.0 - f.x) *        f.y;
    coverage[3] =        f.x  *        f.y;

    ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

    float threshold = max(FJELL_SHAFT_DEPTH_FLOOR, center_linear * pc.depth_tolerance);

    vec3 sum = vec3(0.0);
    float total_weight = 0.0;
    float best_coverage = -1.0;
    vec3 best_tap = vec3(0.0);

    for (int i = 0; i < 4; ++i) {
        // Clamped rather than skipped, so the screen border keeps the
        // clamp-to-edge behaviour a plain bilinear tap already had.
        ivec2 tap = clamp(base + offsets[i], ivec2(0), ivec2(pc.shafts_size) - 1);

        float tap_raw = texelFetch(depth_texture, shaft_tap_depth_coord(tap), 0).r;
        float diff = center_linear - shaft_linear_depth(tap_raw);
        float depth_w = exp(-diff * diff / (threshold * threshold));

        vec3 tap_shafts = texelFetch(shafts_tex, tap, 0).rgb;
        float w = coverage[i] * depth_w;
        sum += tap_shafts * w;
        total_weight += w;

        if (coverage[i] > best_coverage) {
            best_coverage = coverage[i];
            best_tap = tap_shafts;
        }
    }

    // Falling back to black would punch a hard-edged hole wherever the weights
    // collapse, since a neighbouring pixel whose taps survived keeps its full
    // value. Use the tap covering most of this pixel instead: less smooth, but
    // continuous. Chosen by coverage rather than by depth, because where every
    // depth weight has gone the depths no longer say anything, while coverage
    // still says which half-res pixel this one belongs to.
    return total_weight > 1e-5 ? sum / total_weight : best_tap;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.viewport_size.x) || coord.y >= int(pc.viewport_size.y)) return;

    float center_raw = texelFetch(depth_texture, coord, 0).r;
    vec3 shafts = upsample_shafts(coord, shaft_linear_depth(center_raw));

    vec4 color = imageLoad(scene_color, coord);
    if (ubo.debug_light_channel == DEBUG_LIGHT_CHANNEL_SUN_SHAFTS) {
        // Debug view: the shaft buffer on its own, so its shape and level can
        // be judged without the scene underneath.
        color.rgb = shafts;
    } else {
        color.rgb += shafts;
    }
    imageStore(scene_color, coord, color);
}
