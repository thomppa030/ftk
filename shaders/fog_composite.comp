#version 460

// Volumetric fog: apply fog to scene color using depth

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

layout(set = 1, binding = 0) uniform sampler3D integrated_volume;
layout(set = 1, binding = 1) uniform sampler2D depth_texture;
layout(set = 1, binding = 2, rgba16f) uniform image2D scene_color;

layout(push_constant) uniform PushConstants {
    uvec4 volume_dims;
    float near_plane;
    float far_plane;
    float density;
    float height;
    float height_falloff;
    float scattering;
    float anisotropy;
    float temporal_blend;
    uint viewport_width;
    uint viewport_height;
    float fog_color_r;
    float fog_color_g;
    float fog_color_b;
    float jitter_x;
    float jitter_y;
    float jitter_z;
    float padding;
} pc;

float depth_to_slice(float z) {
    return log(z / pc.near_plane) / log(pc.far_plane / pc.near_plane);
}

// Interleaved gradient noise — screen-space dither without a texture
float ign(ivec2 coord) {
    return fract(52.9829189 * fract(0.06711056 * float(coord.x) + 0.00583715 * float(coord.y)));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.viewport_width) || coord.y >= int(pc.viewport_height)) return;

    // Read scene depth
    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.viewport_width, pc.viewport_height);
    float raw_depth = texelFetch(depth_texture, coord, 0).r;

    // Sky pixels (depth == 1.0) get the full volume integral — the density
    // fade near far_plane in fog_inject ensures the last slice represents
    // "all the fog between camera and sky" without edge artifacts.
    bool is_sky = raw_depth >= 1.0;

    float linear_z;
    if (is_sky) {
        linear_z = pc.far_plane;
    } else {
        vec4 clip_pos = vec4(uv * 2.0 - 1.0, raw_depth, 1.0);
        vec4 view_pos = ubo.inv_projection * clip_pos;
        linear_z = -view_pos.z / view_pos.w;
        linear_z = clamp(linear_z, pc.near_plane, pc.far_plane);
    }

    // Convert to froxel W coordinate
    float w = depth_to_slice(linear_z);
    w = clamp(w, 0.0, 1.0);

    // Dither the UV by half a froxel to break up block edges.
    // The interleaved gradient noise varies per pixel, smoothing the
    // hard froxel boundaries that show up against a bright sky.
    float noise = ign(coord) - 0.5;
    vec2 froxel_size = vec2(1.0) / vec2(pc.volume_dims.xy);
    vec2 dithered_uv = uv + noise * froxel_size * 0.5;

    // Sample integrated fog volume (trilinear)
    vec4 fog = texture(integrated_volume, vec3(dithered_uv, w));
    // fog.rgb = accumulated in-scattered light, fog.a = transmittance

    // Apply fog to scene color. For sky pixels we drop the in-scatter term
    // (fog.rgb) because the skybox already encodes atmospheric scattering
    // and directional shafts are handled by the dedicated sun shafts pass —
    // adding in-scatter here paints a phase-peaked blob around the sun disc.
    // Transmittance still applies so dense fog can dim the sky.
    vec4 color = imageLoad(scene_color, coord);
    vec3 in_scatter = is_sky ? vec3(0.0) : fog.rgb;
    color.rgb = color.rgb * fog.a + in_scatter;
    imageStore(scene_color, coord, color);
}
