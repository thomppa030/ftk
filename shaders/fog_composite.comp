#version 460

// Volumetric fog: apply fog to scene color using depth

#include "fjell_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;
    vec4 light_color;
    vec4 camera_position;
    vec4 ambient_color;
    mat4 cascade_vp[3];
    vec4 cascade_splits;
    uvec4 tile_info;
    mat4 inv_projection;
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    mat4 unjittered_vp;
    mat4 prev_unjittered_vp;
    float time;
} ubo;

layout(set = 1, binding = 0) uniform sampler3D integrated_volume;
layout(set = 1, binding = 1) uniform sampler2D depth_texture;
layout(set = 1, binding = 2, rgba16f) uniform image2D scene_color;

layout(push_constant) uniform PushConstants {
    uvec4 volume_dims;
    float near_plane;
    float far_plane;
    float density;
    float height;
    float height_falloff;
    float scattering;
    float anisotropy;
    float temporal_blend;
    uint viewport_width;
    uint viewport_height;
    float fog_color_r;
    float fog_color_g;
    float fog_color_b;
    float jitter_x;
    float jitter_y;
    float jitter_z;
    float padding;
} pc;

float depth_to_slice(float z) {
    return log(z / pc.near_plane) / log(pc.far_plane / pc.near_plane);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.viewport_width) || coord.y >= int(pc.viewport_height)) return;

    // Read scene depth
    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.viewport_width, pc.viewport_height);
    float raw_depth = texelFetch(depth_texture, coord, 0).r;

    // Convert to linear depth
    // Standard perspective: linear_z = near * far / (far - depth * (far - near))
    // But our projection might use reverse-Z or standard. Use inv_projection.
    vec4 clip_pos = vec4(uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 view_pos = ubo.inv_projection * clip_pos;
    float linear_z = -view_pos.z / view_pos.w;

    // Clamp to fog range
    linear_z = clamp(linear_z, pc.near_plane, pc.far_plane);

    // Convert to froxel W coordinate
    float w = depth_to_slice(linear_z);
    w = clamp(w, 0.0, 1.0);

    // Sample integrated fog volume (trilinear)
    vec4 fog = texture(integrated_volume, vec3(uv, w));
    // fog.rgb = accumulated in-scattered light, fog.a = transmittance

    // Apply fog to scene color
    vec4 color = imageLoad(scene_color, coord);
    color.rgb = color.rgb * fog.a + fog.rgb;
    imageStore(scene_color, coord, color);
}
