#version 460

// ── Screen-Space GI: Resolve + Temporal Accumulation ───────────────────
// Averages per-probe ray radiance, blends with temporal history.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D raw_radiance;    // probe_count.x × (probe_count.y * rays_per_probe)
layout(set = 0, binding = 1) uniform sampler2D history;         // probe_count.x × probe_count.y (prev frame resolved)
layout(set = 0, binding = 2) uniform sampler2D depth_tex;
layout(set = 0, binding = 3) uniform sampler2D normal_tex;
layout(set = 0, binding = 4) uniform sampler2D prev_depth_tex;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D resolved_out;

// Matrices live in the trace's constants UBO rather than push constants,
// which cannot hold three mat4s within the guaranteed 128-byte range.
layout(std140, set = 0, binding = 6) uniform SsGiConstants {
    mat4 view;
    mat4 projection;
    mat4 inv_view_proj;       // this frame, for probe world-position reconstruction
    mat4 prev_view_proj;      // last frame, to find where that position was on screen
    mat4 prev_inv_view_proj;  // last frame, to unproject last frame's depth
    vec3 camera_position;
    float max_trace_dist;
    vec2 ubo_resolution;
    uint ubo_probe_spacing;
    uint ubo_frame_index;
    uvec2 ubo_probe_count;
    float ubo_trace_cell_size;
    float ubo_pad1;
    vec4 sun_direction_intensity;
    vec4 sun_color;
};

layout(push_constant) uniform PushConstants {
    uvec2 probe_count;
    uint rays_per_probe;
    uint frame_index;
    vec2 resolution;
    uint probe_spacing;
    float hysteresis;         // 0.9 = blend 10% new data
};

#include "include/fjell_common.glsl"

void main() {
    ivec2 probe_id = ivec2(gl_GlobalInvocationID.xy);
    if (probe_id.x >= int(probe_count.x) || probe_id.y >= int(probe_count.y)) return;

    // Average all rays for this probe. Every ray contributes — misses
    // are stored as zero radiance (no indirect from sky/void).
    vec3 sum = vec3(0.0);
    for (uint r = 0u; r < rays_per_probe; ++r) {
        ivec2 texel = ivec2(probe_id.x, probe_id.y * int(rays_per_probe) + int(r));
        sum += texelFetch(raw_radiance, texel, 0).rgb;
    }

    // Uniform hemisphere irradiance: average radiance scaled by 2π
    // (uniform hemisphere solid angle) to convert to irradiance.
    vec3 current = (sum / float(rays_per_probe)) * (2.0 * PI);

    // ── Temporal reprojection ──
    // History is indexed by probe, and a probe's screen position is fixed
    // while the world behind it is not. Sampling the same probe every frame
    // blends radiance belonging to whatever the camera used to be looking
    // at, which smears emissive bleeding across the screen under motion.
    // Reconstruct this probe's world position, project it through the
    // previous frame's matrix, and read history where that point used to be.
    vec2 probe_uv = (vec2(probe_id) + 0.5) * float(probe_spacing) / resolution;
    float curr_depth = textureLod(depth_tex, probe_uv, 0).r;

    float blend = hysteresis;

    // Background probes have no surface to track.
    if (curr_depth >= 1.0) {
        blend = 0.0;
    }

    vec4 world_h = inv_view_proj * vec4(probe_uv * 2.0 - 1.0, curr_depth, 1.0);
    vec3 world_pos = world_h.xyz / world_h.w;

    vec4 prev_clip = prev_view_proj * vec4(world_pos, 1.0);
    vec3 prev_ndc = prev_clip.xyz / max(prev_clip.w, 1e-6);
    vec2 prev_uv = prev_ndc.xy * 0.5 + 0.5;

    // Off-screen last frame: nothing to carry forward.
    if (prev_clip.w <= 0.0
        || any(lessThan(prev_uv, vec2(0.0)))
        || any(greaterThan(prev_uv, vec2(1.0)))) {
        blend = 0.0;
    }

    // Disocclusion: the surface visible here now is not the one that was
    // visible at the reprojected position. Reconstruct the world position the
    // previous frame recorded there — prev_depth_tex is last frame's depth, so
    // it has to be unprojected with last frame's matrix — and reject when the
    // two disagree.
    //
    // The tolerance has to scale with view distance. A probe covers
    // probe_spacing pixels, and the world-space size of that footprint grows
    // linearly with distance from the camera, so a fixed metre threshold is
    // far tighter than a pixel far away than it is up close. Holding it fixed
    // rejects history on any camera motion at distance, which collapses the
    // blend to a single unconverged frame precisely where ray variance is
    // highest — the flicker shows up around bright emitters first.
    float prev_depth_val = textureLod(prev_depth_tex, prev_uv, 0).r;
    vec4 prev_world_h = prev_inv_view_proj * vec4(prev_ndc.xy, prev_depth_val, 1.0);
    vec3 prev_world_pos = prev_world_h.xyz / prev_world_h.w;

    // projection[1][1] is 1/tan(fov_y/2); dividing view distance by it gives
    // the world-space height of one NDC unit at that depth.
    float view_dist = distance(world_pos, camera_position);
    float texel_world = (view_dist / max(projection[1][1], 1e-6))
                      * (2.0 * float(probe_spacing) / max(resolution.y, 1.0));
    float reject_dist = max(0.25, texel_world * 2.0);
    if (distance(prev_world_pos, world_pos) > reject_dist) {
        blend = 0.0;
    }

    vec3 prev = textureLod(history, prev_uv, 0).rgb;

    if (frame_index < 2u) {
        blend = 0.0;
    }

    vec3 result = mix(current, prev, blend);

    imageStore(resolved_out, probe_id, vec4(result, 1.0));
}
