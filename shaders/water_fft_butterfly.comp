#version 460

// One stage of the inverse fast Fourier transform, along one axis.
//
// Radix-2, Cooley-Tukey: the input arrives bit-reversed, and stage s combines
// elements 2^(s-1) apart within blocks of 2^s. log2(N) stages along x and then
// log2(N) along z turn an N x N spectrum into the surface. Every texel of a
// stage reads two texels of the stage before and writes one, so the stages
// ping-pong between two images rather than working in place — there is no
// ordering between invocations to make in-place safe.
//
// The result is unnormalised and turns the positive way, which is the plain
// inverse sum water::inverse_transform_reference() writes out in full.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly  image2D a_in;
layout(set = 0, binding = 1, rgba32f) uniform readonly  image2D b_in;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D a_out;
layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D b_out;

layout(push_constant) uniform PushConstants {
    uint resolution;
    uint stage;      // 1 .. log2(resolution)
    uint vertical;   // 0 along x, 1 along z
} push;

const float TAU = 6.28318530717958647692;

vec2 complex_mul(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

// Two complex numbers a texel, each turned by the same twiddle.
vec4 twiddled(vec4 v, vec2 w) {
    return vec4(complex_mul(v.xy, w), complex_mul(v.zw, w));
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (cell.x >= int(push.resolution) || cell.y >= int(push.resolution)) return;

    uint i = push.vertical != 0u ? uint(cell.y) : uint(cell.x);
    uint span = 1u << push.stage;
    uint half_span = span >> 1u;
    uint pos = i & (span - 1u);

    // The lower half of a block takes lower + w * upper, the upper half takes
    // lower - w * upper, with the twiddle set by the place within the half.
    bool lower = pos < half_span;
    uint j = lower ? pos : pos - half_span;
    uint partner = lower ? i + half_span : i - half_span;
    ivec2 other = push.vertical != 0u ? ivec2(cell.x, int(partner)) : ivec2(int(partner), cell.y);

    float angle = TAU * float(j) / float(span);
    vec2 w = vec2(cos(angle), sin(angle));

    vec4 self_a = imageLoad(a_in, cell);
    vec4 self_b = imageLoad(b_in, cell);
    vec4 other_a = imageLoad(a_in, other);
    vec4 other_b = imageLoad(b_in, other);

    if (lower) {
        imageStore(a_out, cell, self_a + twiddled(other_a, w));
        imageStore(b_out, cell, self_b + twiddled(other_b, w));
    } else {
        imageStore(a_out, cell, other_a - twiddled(self_a, w));
        imageStore(b_out, cell, other_b - twiddled(self_b, w));
    }
}
