#version 460
#extension GL_EXT_mesh_shader : require

// One task invocation per terrain patch. Patches outside the frustum being
// drawn into are dropped here; Hi-Z culling and LOD belong here too and land
// with that work.

#include "fjell_global_ubo.glsl"
#include "fjell_terrain_grid.glsl"

layout(local_size_x = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

// Per-patch height bounds: one texel per patch, r = lowest, g = highest, both
// normalized like the height texture. Binding 2 of the terrain set; heights
// (0) and layer weights (1) are read by the later stages.
layout(set = 2, binding = 2) uniform sampler2D patch_bounds_tex;

layout(push_constant) uniform PushConstants {
    vec2  world_origin;      // terrain min corner, world XZ
    float world_size;        // terrain extent in metres (square)
    float height_scale;      // world height of a normalized 1.0 sample
    float height_offset;     // world height of a normalized 0.0 sample
    uint  patches_per_side;
    uint  patch_quads;
    // Which projection this draw writes into: 0 is the camera, 1..3 the shadow
    // cascade of that index minus one. Culling follows it, so a cascade drops
    // the patches it cannot see rather than every view paying for the widest.
    uint  view_index;
    // Read by the fragment stage; declared here so every stage sees the same
    // block.
    uint  terrain_material_id;
    // Render target size in pixels, and the projected patch height in pixels
    // below which each coarser LOD level takes over. Descending.
    vec2  viewport;
    vec3  lod_thresholds;
    uint  _pad3;
    uvec4 layer_material_ids;
    vec4  layer_uv_scales;
} push;

struct TaskPayload {
    uint patch_x;
    uint patch_z;
    // This patch's level, how far it has morphed toward the next coarser one,
    // and the level of the neighbour across each edge: -X, +X, -Z, +Z. The
    // mesh shader needs the neighbours to close seams, and computing them
    // here costs one bounds fetch each instead of four per vertex.
    uint level;
    float morph;
    uint neighbour_level[4];
    // Each neighbour's morph too: two patches at one level morph by different
    // amounts when they sit at different distances, and an edge between them
    // has to be built from the same numbers on both sides or it cracks.
    float neighbour_morph[4];
    // The same, as of last frame, so the mesh stage can place each vertex
    // where it was and report the motion. Terrain does not move, but its
    // surface does: a patch that changed level or morph slid.
    uint prev_level;
    float prev_morph;
    uint prev_neighbour_level[4];
    float prev_neighbour_morph[4];
};

taskPayloadSharedEXT TaskPayload payload;

/// Whether the patch's world-space box has any corner inside the clip volume
/// of `vp`.
///
/// Tested per plane rather than per corner: a box larger than the frustum
/// straddles it with every corner outside, and rejecting on "no corner is
/// inside" would drop exactly the patches a near cascade is made of. A patch
/// survives unless all eight corners fall outside the same plane, which keeps
/// the test conservative — it can pass a patch that is not visible, never drop
/// one that is.
bool box_in_frustum(mat4 vp, vec3 lo, vec3 hi) {
    vec4 clip[8];
    for (uint i = 0u; i < 8u; ++i) {
        vec3 corner = vec3((i & 1u) != 0u ? hi.x : lo.x,
                           (i & 2u) != 0u ? hi.y : lo.y,
                           (i & 4u) != 0u ? hi.z : lo.z);
        clip[i] = vp * vec4(corner, 1.0);
    }
    // x, y in [-w, w] and z in [0, w]: Vulkan clip space, reverse-Z not in use.
    for (uint plane = 0u; plane < 6u; ++plane) {
        bool all_out = true;
        for (uint i = 0u; i < 8u && all_out; ++i) {
            vec4 c = clip[i];
            float d;
            switch (plane) {
                case 0u: d = c.w + c.x; break;
                case 1u: d = c.w - c.x; break;
                case 2u: d = c.w + c.y; break;
                case 3u: d = c.w - c.y; break;
                case 4u: d = c.z;       break;
                default: d = c.w - c.z; break;
            }
            if (d >= 0.0) all_out = false;
        }
        if (all_out) return false;
    }
    return true;
}

// The world-space box of a patch, from its own height bounds texel. Out of
// range patches clamp, so a neighbour query off the edge of the field returns
// the edge patch's box and therefore its level — which is what the edge patch
// itself will use, so the seam agrees.
vec2 patch_box(uint px, uint pz, out vec3 lo, out vec3 hi) {
    ivec2 last = ivec2(int(push.patches_per_side) - 1);
    ivec2 coord = clamp(ivec2(int(px), int(pz)), ivec2(0), last);
    vec2 bounds = texelFetch(patch_bounds_tex, coord, 0).rg;
    float patch_size = push.world_size / float(push.patches_per_side);
    lo = vec3(push.world_origin.x + float(coord.x) * patch_size,
              push.height_offset + bounds.x * push.height_scale,
              push.world_origin.y + float(coord.y) * patch_size);
    hi = vec3(lo.x + patch_size,
              push.height_offset + bounds.y * push.height_scale,
              lo.z + patch_size);
    return bounds;
}

uint level_of(mat4 vp, uint px, uint pz, out float out_morph) {
    vec3 lo;
    vec3 hi;
    patch_box(px, pz, lo, hi);
    return terrain_patch_level_morph(vp, lo, hi, push.viewport, push.lod_thresholds, out_morph);
}

// Last frame's camera, for the velocity the mesh stage writes. A shadow view
// has no history to reproject and no velocity buffer, so it reuses its own
// matrix and every patch reports that it did not move.
mat4 prev_vp() {
    return push.view_index == 0u ? ubo.prev_unjittered_vp
                                 : ubo.cascade_vp[push.view_index - 1u];
}

void main() {
    uint patch_index = gl_WorkGroupID.x;
    uint px = patch_index % push.patches_per_side;
    uint pz = patch_index / push.patches_per_side;

    // The patch's footprint in world XZ, and the height range this patch
    // actually reaches, read from its own texel. Using the whole field's range
    // would be correct but loose: a patch on flat ground would claim the full
    // vertical extent of the terrain and survive tests it should fail.
    vec3 lo;
    vec3 hi;
    patch_box(px, pz, lo, hi);

    mat4 vp = push.view_index == 0u ? ubo.projection * ubo.view
                                    : ubo.cascade_vp[push.view_index - 1u];
    if (!box_in_frustum(vp, lo, hi)) {
        EmitMeshTasksEXT(0, 0, 0);
        return;
    }

    payload.patch_x = px;
    payload.patch_z = pz;
    float morph;
    payload.level = terrain_patch_level_morph(vp, lo, hi, push.viewport,
                                              push.lod_thresholds, morph);
    payload.morph = morph;
    // Neighbours across each edge, in the order the mesh shader expects.
    // Each is the same pure function of that patch's own box, so the patch on
    // the other side of the seam reaches the same number for us.
    payload.neighbour_level[0] = level_of(vp, px - 1u, pz, payload.neighbour_morph[0]);
    payload.neighbour_level[1] = level_of(vp, px + 1u, pz, payload.neighbour_morph[1]);
    payload.neighbour_level[2] = level_of(vp, px, pz - 1u, payload.neighbour_morph[2]);
    payload.neighbour_level[3] = level_of(vp, px, pz + 1u, payload.neighbour_morph[3]);

    // The same selection against last frame's camera. Recomputing it is
    // cheaper than storing a per-patch history and cannot go stale.
    mat4 pvp = prev_vp();
    float pmorph;
    payload.prev_level = terrain_patch_level_morph(pvp, lo, hi, push.viewport,
                                                   push.lod_thresholds, pmorph);
    payload.prev_morph = pmorph;
    payload.prev_neighbour_level[0] = level_of(pvp, px - 1u, pz, payload.prev_neighbour_morph[0]);
    payload.prev_neighbour_level[1] = level_of(pvp, px + 1u, pz, payload.prev_neighbour_morph[1]);
    payload.prev_neighbour_level[2] = level_of(pvp, px, pz - 1u, payload.prev_neighbour_morph[2]);
    payload.prev_neighbour_level[3] = level_of(pvp, px, pz + 1u, payload.prev_neighbour_morph[3]);
    EmitMeshTasksEXT(1, 1, 1);
}
