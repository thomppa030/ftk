#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "fjell_ddgi.glsl"

layout(set = 0, binding = 1) uniform sampler2D radiance_tex;
layout(rg16f, set = 0, binding = 3) uniform image2D visibility_image;

layout(push_constant) uniform PushConstants {
    uint first_frame;
    float max_trace_dist;
};

#define EPSILON 0.0001

int k_read_table[6] = int[](5, 3, 1, -1, -3, -5);

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);

    if (coords.x >= ddgi.vis_tex_w || coords.y >= ddgi.vis_tex_h) return;

    uint probe_with_border_side = uint(ddgi.vis_side + 2);
    uint probe_last_pixel = uint(ddgi.vis_side + 1);

    int probe_index = get_probe_index_from_pixels(coords, int(probe_with_border_side), ddgi.vis_tex_w);

    bool border_pixel = ((gl_GlobalInvocationID.x % probe_with_border_side) == 0) ||
                        ((gl_GlobalInvocationID.x % probe_with_border_side) == probe_last_pixel);
    border_pixel = border_pixel ||
                   ((gl_GlobalInvocationID.y % probe_with_border_side) == 0) ||
                   ((gl_GlobalInvocationID.y % probe_with_border_side) == probe_last_pixel);

    if (!border_pixel) {
        // Skip probes not in the current batch — keep previous value
        if (probe_index < ddgi.probe_update_offset ||
            probe_index >= ddgi.probe_update_offset + ddgi.probe_update_count) {
            return;
        }

        vec4 result = vec4(0.0);
        float probe_max_ray_distance = length(ddgi.probe_spacing) * 1.5;

        for (int ray_index = 0; ray_index < ddgi.probe_rays; ++ray_index) {
            ivec2 sample_pos = ivec2(ray_index, probe_index - ddgi.probe_update_offset);

            vec3 ray_direction = normalize(mat3(ddgi.random_rotation) *
                spherical_fibonacci(float(ray_index), float(ddgi.probe_rays)));
            vec3 texel_direction = oct_decode(normalized_oct_coord(coords, ddgi.vis_side));

            float weight = pow(max(0.0, dot(texel_direction, ray_direction)), 2.5);

            if (weight >= EPSILON) {
                float distance = texelFetch(radiance_tex, sample_pos, 0).w;
                distance = min(abs(distance), probe_max_ray_distance);
                vec3 value = vec3(distance, distance * distance, 0.0);
                result += vec4(value * weight, weight);
            }
        }

        if (result.w > EPSILON) {
            result.xyz /= result.w;
            result.w = 1.0;
        }

        vec2 previous_value = imageLoad(visibility_image, coords).rg;

        if (first_frame == 0) {
            result.rg = mix(result.rg, previous_value, ddgi.hysteresis);
        }

        imageStore(visibility_image, coords, vec4(result.rg, 0.0, 1.0));
        return;
    }

    // Flush the interior image writes before the border copy reads them; see
    // ddgi_irradiance_update.comp for why memoryBarrierImage() and why this
    // relies on a probe tile fitting one 8x8 workgroup.
    memoryBarrierImage();
    barrier();

    uint probe_pixel_x = gl_GlobalInvocationID.x % probe_with_border_side;
    uint probe_pixel_y = gl_GlobalInvocationID.y % probe_with_border_side;
    bool corner_pixel = (probe_pixel_x == 0 || probe_pixel_x == probe_last_pixel) &&
                        (probe_pixel_y == 0 || probe_pixel_y == probe_last_pixel);
    bool row_pixel = (probe_pixel_x > 0 && probe_pixel_x < probe_last_pixel);

    ivec2 source = coords;

    if (corner_pixel) {
        source.x += int(probe_pixel_x == 0 ? ddgi.vis_side : -ddgi.vis_side);
        source.y += int(probe_pixel_y == 0 ? ddgi.vis_side : -ddgi.vis_side);
    } else if (row_pixel) {
        source.x += k_read_table[probe_pixel_x - 1];
        source.y += (probe_pixel_y > 0) ? -1 : 1;
    } else {
        source.x += (probe_pixel_x > 0) ? -1 : 1;
        source.y += k_read_table[probe_pixel_y - 1];
    }

    imageStore(visibility_image, coords, imageLoad(visibility_image, source));
}
