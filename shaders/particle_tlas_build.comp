#version 460

#include "include/particle_common.glsl"
// The instance records' layout is the GPU backend's.
#include "fjell_instance_record.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) writeonly buffer InstanceBuffer {
    InstanceRecord instances[];
};

layout(std430, set = 0, binding = 2) buffer CounterBuffer {
    uint instance_count;
};

// Per-instance data the tracers read at a hit, by the instance's index. MUST
// be written at the SAME compacted idx as instances[idx] so TLAS slot and
// rt_instances slot describe the same particle (matches GpuRtInstance: 4 uints).
struct RtInstanceOut {
    uint material_id;
    uint first_index;
    uint vertex_offset;
    uint flags;
};
layout(std430, set = 0, binding = 3) writeonly buffer RtInstanceBuffer {
    RtInstanceOut rt_instances[];
};

layout(push_constant) uniform PushConstants {
    uint particle_offset;  // base_offset of this emitter in the particle buffer
    uint particle_count;   // max_particles for this emitter
    uint material_id;
    float particle_size;   // average size for transform scale
    uvec2 blas_reference;  // what instance records name the mesh's bottom level by
    uint first_index;      // emitter BLAS geometry offsets (for rt_instances)
    uint vertex_offset;
    uint mask;             // RT_MASK_* of the emitter's particles
};

void main() {
    uint local_id = gl_GlobalInvocationID.x;
    if (local_id >= particle_count) return;

    uint pi = particle_offset + local_id;
    Particle p = particles[pi];

    // Skip dead particles
    if (p.lifetime <= 0.0) return;

    uint idx = atomicAdd(instance_count, 1);

    // Translation and uniform scale.
    float s = p.size;
    float transform[12] = float[12](s,   0.0, 0.0, p.position.x,
                                    0.0, s,   0.0, p.position.y,
                                    0.0, 0.0, s,   p.position.z);
    InstanceRecord inst = instance_record(transform, material_id, mask, blas_reference);

    instances[idx] = inst;

    // Write per-instance geometry data at the SAME idx so a hit's
    // rt_instances[instance] resolves to THIS particle's mesh.
    RtInstanceOut rt;
    rt.material_id = material_id;
    rt.first_index = first_index;
    rt.vertex_offset = vertex_offset;
    rt.flags = 0u;
    rt_instances[idx] = rt;
}
