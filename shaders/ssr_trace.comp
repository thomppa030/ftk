#version 460

// Screen Space Reflections: Hi-Z ray marching in screen space.
// Reads depth + previous frame color, outputs reflection color + validity.

#include "fjell_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;
    vec4 light_color;
    vec4 camera_position;
    vec4 ambient_color;
    mat4 cascade_vp[3];
    vec4 cascade_splits;
    uvec4 tile_info;
    mat4 inv_projection;
} ubo;

layout(set = 0, binding = 4) uniform sampler2D depth_texture;
layout(set = 0, binding = 6) uniform samplerCube sky_cubemap;

layout(set = 1, binding = 0) uniform sampler2D hiz_texture;
layout(set = 1, binding = 1) uniform sampler2D prev_color;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D ssr_output;

layout(push_constant) uniform PushConstants {
    uint viewport_width;
    uint viewport_height;
    uint hiz_mip_count;
    uint max_steps;
    float max_distance;
    float thickness;
    float intensity;
    float pad;
};

// ── View-space reconstruction (same as GTAO) ──────────────────────────

vec3 reconstruct_view_pos(ivec2 coord, float depth) {
    vec2 uv = (vec2(coord) + 0.5) / vec2(viewport_width, viewport_height);
    // Convert pixel coords to NDC, accounting for Vulkan Y-flip in projection.
    // Pixel y=0 is top of screen. With flipped projection, NDC y=+1 is top.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    vec4 vpos = ubo.inv_projection * vec4(ndc, depth, 1.0);
    return vpos.xyz / vpos.w;
}

vec3 reconstruct_normal(vec3 vpos, ivec2 coord) {
    ivec2 cR = min(coord + ivec2(2, 0), ivec2(viewport_width) - 1);
    ivec2 cL = max(coord - ivec2(2, 0), ivec2(0));
    ivec2 cU = min(coord + ivec2(0, 2), ivec2(viewport_height) - 1);
    ivec2 cD = max(coord - ivec2(0, 2), ivec2(0));

    vec3 pr = reconstruct_view_pos(cR, texelFetch(depth_texture, cR, 0).r);
    vec3 pl = reconstruct_view_pos(cL, texelFetch(depth_texture, cL, 0).r);
    vec3 pu = reconstruct_view_pos(cU, texelFetch(depth_texture, cU, 0).r);
    vec3 pd = reconstruct_view_pos(cD, texelFetch(depth_texture, cD, 0).r);

    vec3 dx = (abs(pr.z - vpos.z) < abs(vpos.z - pl.z)) ? (pr - vpos) : (vpos - pl);
    vec3 dy = (abs(pu.z - vpos.z) < abs(vpos.z - pd.z)) ? (pu - vpos) : (vpos - pd);

    vec3 n = cross(dx, dy);
    float len = length(n);
    return len > 1e-10 ? n / len : vec3(0.0, 0.0, -1.0);
}

// ── Screen-space projection ───────────────────────────────────────────

vec3 project_to_screen(vec3 view_pos) {
    vec4 clip = ubo.projection * vec4(view_pos, 1.0);
    clip.xyz /= clip.w;
    // Projection has Vulkan Y-flip (proj[1][1] < 0), so negate Y
    // to get correct UV coordinates matching the depth/color textures.
    return vec3(clip.x * 0.5 + 0.5, -clip.y * 0.5 + 0.5, clip.z);
}

float linearize_depth(float d) {
    // Extract near/far from projection matrix
    float a = ubo.projection[2][2];
    float b = ubo.projection[3][2];
    return b / (d - a);
}

// ── Hi-Z ray march ───────────────────────────────────────────────────

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(viewport_width) || coord.y >= int(viewport_height)) return;

    float depth = texelFetch(depth_texture, coord, 0).r;
    if (depth >= 1.0) {
        imageStore(ssr_output, coord, vec4(0.0));
        return;
    }

    vec3 view_pos = reconstruct_view_pos(coord, depth);
    vec3 normal = reconstruct_normal(view_pos, coord);
    vec3 view_dir = normalize(view_pos); // camera at origin in view space
    vec3 reflect_dir = reflect(view_dir, normal);

    // Sky cubemap fallback for rays that can't be screen-traced
    mat3 inv_view_rot = transpose(mat3(ubo.view));
    vec3 world_reflect = inv_view_rot * reflect_dir;

    // Skip rays reflecting toward the camera (positive Z = toward camera in view space)
    if (reflect_dir.z > 0.0) {
        vec3 env = textureLod(sky_cubemap, world_reflect, 4.0).rgb;
        imageStore(ssr_output, coord, vec4(env, 0.15));
        return;
    }

    // Project start and end points to screen [0,1] UV + depth
    vec3 ray_end_view = view_pos + reflect_dir * max_distance;
    vec3 screen_start = project_to_screen(view_pos);
    vec3 screen_end = project_to_screen(ray_end_view);

    vec3 screen_dir = screen_end - screen_start;

    // Skip rays with negligible screen motion
    vec2 screen_size = vec2(viewport_width, viewport_height);
    float pixel_len = length(screen_dir.xy * screen_size);
    if (pixel_len < 1.0) {
        vec3 env = textureLod(sky_cubemap, world_reflect, 4.0).rgb;
        imageStore(ssr_output, coord, vec4(env, 0.15));
        return;
    }

    // Clip ray to screen bounds [0,1]
    float t_max = 1.0;
    for (int i = 0; i < 2; ++i) {
        if (abs(screen_dir[i]) > 1e-7) {
            float t0 = -screen_start[i] / screen_dir[i];
            float t1 = (1.0 - screen_start[i]) / screen_dir[i];
            float t_near = max(t0, t1); // the edge we'll hit
            if (t_near > 0.0) t_max = min(t_max, t_near);
        }
    }
    t_max = max(t_max, 0.0);

    // Hi-Z trace
    // Hi-Z mip 0 = half-res (2x2 max-pool of depth).
    // Level N covers (2 << N) x (2 << N) screen pixels.
    float t = 0.0;
    int cur_level = 1; // start at mip 1 (4x4 blocks) for faster traversal
    cur_level = min(cur_level, int(hiz_mip_count) - 1);

    // Step past start position to avoid self-intersection
    float initial_step = 8.0 / pixel_len;
    t += initial_step;

    bool hit = false;
    vec3 hit_screen = vec3(0.0);

    for (uint i = 0; i < max_steps && t < t_max; ++i) {
        vec3 cur_screen = screen_start + screen_dir * t;

        // Bounds check
        if (cur_screen.x < 0.0 || cur_screen.x > 1.0 ||
            cur_screen.y < 0.0 || cur_screen.y > 1.0) break;

        // Sample Hi-Z at current mip level
        float hiz_depth = textureLod(hiz_texture, cur_screen.xy, float(cur_level)).r;

        // Cell size at current mip in UV space
        // Hi-Z level 0 = half-res → covers 2 pixels, level N covers 2^(N+1) pixels
        vec2 cell_size = vec2(2 << cur_level) / screen_size;

        if (cur_screen.z > hiz_depth) {
            // Ray is behind the surface — potential hit, refine
            if (cur_level == 0) {
                // At finest Hi-Z level — check thickness using full-res depth
                float scene_depth = texelFetch(depth_texture,
                    ivec2(cur_screen.xy * screen_size), 0).r;
                float linear_ray = linearize_depth(cur_screen.z);
                float linear_surf = linearize_depth(scene_depth);
                float depth_diff = linear_ray - linear_surf;
                // Accept hit if ray is behind surface but within thickness
                if (depth_diff > 0.0 && depth_diff < thickness) {
                    // Reject self-hits: require minimum distance from origin
                    // in both screen-space and depth
                    float pixel_dist = length((cur_screen.xy - screen_start.xy) * screen_size);
                    float z_dist = abs(linearize_depth(cur_screen.z) - linearize_depth(depth));
                    if (pixel_dist > 8.0 && z_dist > thickness * 0.5) {
                        hit = true;
                        hit_screen = cur_screen;
                        break;
                    }
                }
                // Too thick — keep marching
                t += length(cell_size) * 0.5;
            } else {
                // Descend to finer mip
                cur_level--;
            }
        } else {
            // Ray is in front — advance to next cell boundary at this mip
            vec2 cell_pos = cur_screen.xy / cell_size;
            vec2 cell_frac = fract(cell_pos);
            vec2 step_sign = sign(screen_dir.xy);

            // Distance to next cell edge in each axis
            vec2 next_edge;
            next_edge.x = step_sign.x > 0.0 ? (1.0 - cell_frac.x) : cell_frac.x;
            next_edge.y = step_sign.y > 0.0 ? (1.0 - cell_frac.y) : cell_frac.y;
            next_edge = max(next_edge, vec2(0.001)); // avoid zero step

            // Convert to t
            vec2 dt_val = next_edge * cell_size / max(abs(screen_dir.xy), vec2(1e-7));
            float advance = min(dt_val.x, dt_val.y);
            t += advance + 1e-5; // small epsilon to cross boundary

            // Ascend to coarser mip if we can
            if (cur_level < int(hiz_mip_count) - 1) {
                cur_level++;
            }
        }
    }

    if (!hit) {
        // Fallback: sample sky cubemap along reflection direction
        vec3 env_color = textureLod(sky_cubemap, world_reflect, 4.0).rgb;
        float facing = 1.0 - max(dot(view_dir, reflect_dir), 0.0);
        imageStore(ssr_output, coord, vec4(env_color, 0.3 * facing));
        return;
    }

    // ── Compute validity / fade ───────────────────────────────────────

    float validity = 1.0;

    // Screen edge fade
    vec2 edge_dist = min(hit_screen.xy, 1.0 - hit_screen.xy);
    float edge_fade = smoothstep(0.0, 0.05, min(edge_dist.x, edge_dist.y));
    validity *= edge_fade;

    // Distance fade (in view space)
    vec3 hit_view = reconstruct_view_pos(ivec2(hit_screen.xy * screen_size), hit_screen.z);
    float ray_dist = length(hit_view - view_pos);
    float dist_fade = 1.0 - smoothstep(max_distance * 0.5, max_distance, ray_dist);
    validity *= dist_fade;

    // Facing fade — rays nearly parallel to camera get weaker reflections
    float facing = 1.0 - max(dot(view_dir, reflect_dir), 0.0);
    validity *= facing;

    // Sample previous frame color
    vec3 color = texture(prev_color, hit_screen.xy).rgb;

    imageStore(ssr_output, coord, vec4(color, validity));
}
