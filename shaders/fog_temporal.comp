#version 460

// Volumetric fog: temporal reprojection

#include "fjell_common.glsl"
#include "fjell_global_ubo.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);
#include "fjell_environment.glsl"
FJELL_DECLARE_ENVIRONMENT_UBO(0, FJELL_ENVIRONMENT_UBO_BINDING, env_ubo);
layout(set = 0, binding = 16) uniform sampler2D motion_field_tex;
#include "fjell_motion_field.glsl"

layout(set = 1, binding = 0, rgba16f) uniform image3D scatter_volume;
layout(set = 1, binding = 1) uniform sampler3D history_volume;

layout(push_constant) uniform PushConstants {
    uvec4 volume_dims;
    float near_plane;
    float far_plane;
    float density;
    float height;
    float height_falloff;
    float scattering;
    float anisotropy;
    float temporal_blend;
    uint viewport_width;
    uint viewport_height;
    float fog_color_r;
    float fog_color_g;
    float fog_color_b;
    float jitter_x;
    float jitter_y;
    float jitter_z;
    uint volume_count;
} pc;

float slice_to_depth(float t) {
    return pc.near_plane * pow(pc.far_plane / pc.near_plane, t);
}

float depth_to_slice(float z) {
    return log(z / pc.near_plane) / log(pc.far_plane / pc.near_plane);
}

// The six face neighbours, which with the centre bound what this froxel's
// surroundings currently scatter. A full 3×3×3 costs 27 loads per froxel for
// bounds that are barely wider; the cross is the usual trade.
// The most of itself a froxel keeps from history where something has just
// come through. Taken as a ceiling rather than a setting: fog authored to
// hold less history than this already answers movement quickly enough, and
// raising its blend to meet this would make it answer more slowly.
const float MOTION_HISTORY_FLOOR = 0.45;

// How far the neighbourhood window closes on a froxel's own value where a
// wake runs through it. Short of 1 so a disturbed froxel still has somewhere
// to admit history from, and so the bounds keep rejecting a value that is
// merely stale rather than standing in for the measurement itself.
const float MOTION_CLAMP_NARROW = 0.8;

// Above what recency the air counts as still being pushed. The motion field
// fades a mark out over seconds so that slow readers like settling fog have
// something to read; what is changing fast enough to outrun the temporal
// filter is only the newest of it.
const float MOTION_SETTLED_RECENCY = 0.75;

const ivec3 NEIGHBOUR_OFFSETS[6] = ivec3[](
    ivec3(-1, 0, 0), ivec3(1, 0, 0),
    ivec3(0, -1, 0), ivec3(0, 1, 0),
    ivec3(0, 0, -1), ivec3(0, 0, 1)
);

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(coord, ivec3(pc.volume_dims.xyz)))) return;

    // Current value
    vec4 current = imageLoad(scatter_volume, coord);

    // Bounds of what this froxel's neighbourhood scatters this frame. Gathered
    // before anything is written back, so these are the injected values.
    //
    // Another workgroup may already have stored its blended result, which makes
    // a neighbour either the injected value or one already pulled toward these
    // same bounds. The clamp stays conservative either way — the window can
    // come out slightly wider or narrower, never somewhere else — so the race
    // costs nothing worth a second dispatch to avoid.
    vec4 nb_min = current;
    vec4 nb_max = current;
    for (int i = 0; i < 6; ++i) {
        ivec3 n = coord + NEIGHBOUR_OFFSETS[i];
        if (any(lessThan(n, ivec3(0))) ||
            any(greaterThanEqual(n, ivec3(pc.volume_dims.xyz)))) continue;
        vec4 sample_value = imageLoad(scatter_volume, n);
        nb_min = min(nb_min, sample_value);
        nb_max = max(nb_max, sample_value);
    }

    // Reconstruct world position (no jitter for reprojection)
    vec3 froxel_uv = (vec3(coord) + 0.5) / vec3(pc.volume_dims.xyz);
    float linear_depth = slice_to_depth(froxel_uv.z);

    vec2 ndc_xy = froxel_uv.xy * 2.0 - 1.0;
    vec4 near_world = ubo.inv_view_proj * vec4(ndc_xy, 0.0, 1.0);
    near_world /= near_world.w;
    vec4 far_world = ubo.inv_view_proj * vec4(ndc_xy, 1.0, 1.0);
    far_world /= far_world.w;
    vec3 ray_dir = normalize(far_world.xyz - near_world.xyz);
    vec3 view_forward = -vec3(ubo.view[0][2], ubo.view[1][2], ubo.view[2][2]);
    float cos_angle = dot(ray_dir, view_forward);
    float ray_dist = linear_depth / max(cos_angle, 1e-6);
    vec3 world_pos = ubo.camera_position.xyz + ray_dir * ray_dist;

    // Reproject to previous frame
    vec4 prev_clip = ubo.prev_view_proj * vec4(world_pos, 1.0);
    vec3 prev_ndc = prev_clip.xyz / prev_clip.w;

    vec2 prev_uv = prev_ndc.xy * 0.5 + 0.5;

    // Linear depth in *previous frame's* view space. Using the current view
    // matrix here drifts under camera rotation — the froxel grid is camera-
    // relative, so the same world point lands in a different slice if the
    // camera turned between frames.
    float prev_view_z = -(ubo.prev_view * vec4(world_pos, 1.0)).z;
    float prev_depth_uv = depth_to_slice(max(prev_view_z, pc.near_plane));

    vec3 history_uvw = vec3(prev_uv, prev_depth_uv);

    // Check if reprojection is valid (inside volume)
    if (all(greaterThanEqual(history_uvw, vec3(0.0))) &&
        all(lessThanEqual(history_uvw, vec3(1.0)))) {
        vec4 history = texture(history_volume, history_uvw);

        // How recently something passed tells how long ago, not whether the
        // fog here is still changing: the map remembers for seconds, so a
        // walker leaves a corridor metres long that reads as disturbed well
        // after the air in it has settled. Only the freshest of it is worth
        // rejecting history over — behind that the fog is steady again and
        // wants every bit of its filtering.
        float recency = motion_at(world_pos).recency;
        float disturbed = smoothstep(MOTION_SETTLED_RECENCY, 1.0, recency);

        // Leaving the frustum used to be the only thing that could reject
        // history, which is enough while the fog is a fixed function of world
        // position: every sample is then of the same unchanging field. It is
        // not enough once the field itself moves — with nine tenths of each
        // frame coming from history, anything that moves smears over roughly
        // ten frames. Clamping into the neighbourhood is what rejects history
        // that no longer describes what is here.
        //
        // The bounds come from neighbours a concurrent workgroup may already
        // have written, which is harmless while every froxel keeps most of its
        // history: a written neighbour then sits close to an unwritten one. It
        // stops being harmless where a wake makes the two disagree, because a
        // bound taken with min and max moves outward whichever neighbour won
        // the race — and an upper bound that drifts up admits brighter history
        // than is here, which reads as fog lighting up around whatever walked
        // through it. So the window narrows toward this froxel's own value as
        // the disturbance rises.
        //
        // Never all the way: a froxel is sampled at a jitter that moves it
        // about a third of its own width every frame, and blending across
        // those samples is what turns them into one steady value. A window
        // closed completely would leave a wake as the one part of the fog
        // measured once and never averaged, which trades a glow for a
        // sparkle.
        float narrow = disturbed * MOTION_CLAMP_NARROW;
        vec4 lo = mix(nb_min, current, narrow);
        vec4 hi = mix(nb_max, current, narrow);
        history = clamp(history, min(lo, hi), max(lo, hi));

        // Where something came through, the history describes air that had not
        // been disturbed yet, so it is worth less here than anywhere else. A
        // froxel is about a hand across, crossed in a few frames, and at nine
        // tenths of each frame coming from history a walker's wake arrives at
        // something like two fifths of its strength and a runner's at less
        // than a fifth — the faster a thing moves, the less the fog answers
        // it, which is backwards. Discounting history by how recently
        // something passed lets a wake arrive whole whatever its speed.
        //
        // The clamp above cannot do this. Inside a wake every tap it gathers
        // has been stirred together, so its bounds open wide enough to admit
        // the stale value: it catches a wake's edges and this catches its
        // middle.
        //
        // Held short of throwing history away entirely, because the
        // injection's own per-froxel jitter is what temporal blending exists
        // to hide, and a wake is the last place that should start to boil.
        float blend = mix(pc.temporal_blend,
                          min(pc.temporal_blend, MOTION_HISTORY_FLOOR),
                          disturbed);

        current = mix(current, history, blend);
    }

    imageStore(scatter_volume, coord, current);
}
