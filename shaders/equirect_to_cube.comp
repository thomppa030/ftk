#version 460

#include "fjell_common.glsl"

// Convert equirectangular HDR map to cubemap faces.
// Dispatched as (face_size/8, face_size/8, 6) — one face per Z.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D equirect_map;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray cubemap_out;

layout(push_constant) uniform PushConstants {
    uint face_size;
};

vec3 cube_dir(uint face, vec2 uv) {
    // Map [0,1] UV to [-1,1] and compute world direction for each face
    vec2 st = uv * 2.0 - 1.0;
    switch (face) {
        case 0: return normalize(vec3( 1.0,  -st.y, -st.x)); // +X
        case 1: return normalize(vec3(-1.0,  -st.y,  st.x)); // -X
        case 2: return normalize(vec3( st.x,  1.0,   st.y)); // +Y
        case 3: return normalize(vec3( st.x, -1.0,  -st.y)); // -Y
        case 4: return normalize(vec3( st.x, -st.y,  1.0));  // +Z
        case 5: return normalize(vec3(-st.x, -st.y, -1.0));  // -Z
    }
    return vec3(0.0);
}

vec2 dir_to_equirect(vec3 dir) {
    float phi = atan(dir.z, dir.x);      // [-pi, pi]
    float theta = asin(clamp(dir.y, -1.0, 1.0)); // [-pi/2, pi/2]
    vec2 uv;
    uv.x = phi / (2.0 * PI) + 0.5;
    uv.y = -theta / PI + 0.5;
    return uv;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= face_size || id.y >= face_size) return;

    uint face = id.z;
    vec2 uv = (vec2(id.xy) + 0.5) / float(face_size);
    vec3 dir = cube_dir(face, uv);
    vec2 eq_uv = dir_to_equirect(dir);
    // The sampler wraps, which joins the image around the horizon; at the
    // poles it would blend in the opposite one, so the rows stop there.
    float half_texel = 0.5 / float(textureSize(equirect_map, 0).y);
    eq_uv.y = clamp(eq_uv.y, half_texel, 1.0 - half_texel);

    vec3 color = textureLod(equirect_map, eq_uv, 0.0).rgb;
    imageStore(cubemap_out, ivec3(id.xy, face), vec4(color, 1.0));
}
