#version 460

// Luminance histogram for auto-exposure.
// Pass 1: Each workgroup accumulates a local histogram in shared memory,
// then atomically adds to the global histogram buffer.
// Pass 2: A single workgroup reads the histogram, trims outliers,
// and computes weighted average log-luminance.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D hdr_texture;

layout(set = 0, binding = 1) buffer HistogramBuffer {
    uint bins[256];
    float avg_luminance;
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float min_log_lum;   // log2 of minimum luminance (e.g. -10)
    float inv_log_range;  // 1.0 / (max_log_lum - min_log_lum)
    uint pass_id;         // 0 = histogram, 1 = reduce
};

shared uint shared_bins[256];

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    uint local_idx = gl_LocalInvocationIndex;

    if (pass_id == 1) {
        // ── Pass 2: Reduce histogram to average luminance ─────────────
        // Single workgroup (dispatch 1,1,1)
        if (local_idx >= 256) return;

        // Load bin into shared memory
        shared_bins[local_idx] = bins[local_idx];
        barrier();

        // Trim bottom 5% and top 5% of pixels
        uint total_pixels = 0;
        for (uint i = 0; i < 256; ++i)
            total_pixels += shared_bins[i];

        uint trim_low  = total_pixels / 20;  // 5%
        uint trim_high = total_pixels / 20;

        // Only thread 0 does the final reduction
        if (local_idx == 0) {
            uint accumulated = 0;
            float weighted_sum = 0.0;
            uint counted = 0;

            for (uint i = 0; i < 256; ++i) {
                uint count = shared_bins[i];
                uint prev_acc = accumulated;
                accumulated += count;

                // Skip bins in the trimmed tails
                if (accumulated <= trim_low) continue;
                if (prev_acc >= total_pixels - trim_high) break;

                // Clamp contribution within trim bounds
                uint lo_clip = (prev_acc < trim_low) ? trim_low - prev_acc : 0;
                uint hi_clip = (accumulated > total_pixels - trim_high)
                    ? accumulated - (total_pixels - trim_high) : 0;
                uint effective = count - lo_clip - hi_clip;

                // Bin center in log2 luminance space
                float bin_center = (float(i) + 0.5) / 256.0;
                float log_lum = bin_center / inv_log_range + min_log_lum;

                weighted_sum += log_lum * float(effective);
                counted += effective;
            }

            if (counted > 0) {
                avg_luminance = exp2(weighted_sum / float(counted));
            } else {
                avg_luminance = 0.18;  // fallback: middle grey
            }

            // Clear bins for next frame
            for (uint i = 0; i < 256; ++i)
                bins[i] = 0;
        }
        return;
    }

    // ── Pass 1: Build histogram ───────────────────────────────────────

    // Clear shared bins
    if (local_idx < 256)
        shared_bins[local_idx] = 0;
    barrier();

    // Each thread samples one pixel
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x < int(width) && coord.y < int(height)) {
        vec3 color = texelFetch(hdr_texture, coord, 0).rgb;
        float lum = luminance(color);

        if (lum > 1e-5) {
            float log_lum = clamp(
                (log2(lum) - min_log_lum) * inv_log_range,
                0.0, 1.0);
            uint bin = min(uint(log_lum * 255.0), 255u);
            atomicAdd(shared_bins[bin], 1);
        }
    }
    barrier();

    // Merge shared bins into global buffer
    if (local_idx < 256) {
        atomicAdd(bins[local_idx], shared_bins[local_idx]);
    }
}
