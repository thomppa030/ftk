#version 460

#include "fjell_global_ubo.glsl"

layout(local_size_x = 64) in;

FJELL_DECLARE_GLOBAL_UBO(0, 0, ubo);

#include "fjell_draw_data.glsl"
#include "fjell_meshlet.glsl"
#include "fjell_cull.glsl"

layout(set = 1, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

layout(set = 1, binding = 1) readonly buffer InputInstances {
    MeshletInstance instances_in[];
};

layout(set = 2, binding = 2) readonly buffer InstanceTransformsBuffer {
    mat4 instance_transforms[];
};

layout(set = 1, binding = 2) readonly buffer InputCounter {
    uint input_count;
};

// Visible output: binned by pipeline, each bin a segment of its own
layout(set = 1, binding = 3) writeonly buffer OutputInstances {
    MeshletInstance instances_out[];
};

// Per-bin indirect dispatch commands: [groupCountX, groupCountY, groupCountZ] * N
layout(set = 1, binding = 4) buffer OutputCmds {
    uint cmds[];
};

layout(set = 1, binding = 5) readonly buffer BoundsBuffer {
    MeshletBounds bounds[];
};

// Per-draw pipeline bin index
layout(set = 1, binding = 6) readonly buffer PipelineBinBuffer {
    uint pipeline_bin[];
};

// Hi-Z depth pyramid for occlusion culling
layout(set = 1, binding = 7) uniform sampler2D hiz_pyramid;

// What the first pass's Hi-Z test rejected, for the second to test again
layout(set = 1, binding = 8) writeonly buffer CulledInstances {
    MeshletInstance instances_culled[];
};

layout(set = 1, binding = 9) buffer CulledCounter {
    uint culled_count;
};

// Each bin's segment of the visible output: its first slot, and how many
// it holds
layout(set = 1, binding = 10) readonly buffer BinSegments {
    uvec2 bin_segments[];
};

layout(push_constant) uniform PushConstants {
    uint viewport_width;
    uint viewport_height;
    uint hiz_mip_count;
    uint is_second_pass;  // 0 = first pass (prev Hi-Z), 1 = second pass (new Hi-Z)
};

shared vec4 shared_planes[6];

void main() {
    if (gl_LocalInvocationIndex == 0) {
        mat4 vp = ubo.projection * ubo.view;
        for (int i = 0; i < 6; ++i) {
            shared_planes[i] = cull_frustum_plane(vp, i);
        }
    }
    barrier();

    uint id = gl_GlobalInvocationID.x;
    if (id >= input_count) return;

    MeshletInstance inst = instances_in[id];
    MeshletBounds b = bounds[inst.meshlet_index];
    DrawData dd = draws[inst.draw_index];
    mat4 model = (dd.instance_count > 1u)
        ? instance_transforms[dd.first_instance + inst.instance_index]
        : dd.model;

    // Transform bounding sphere to world space
    vec3 center = (model * vec4(b.bounding_sphere.xyz, 1.0)).xyz;
    vec3 scale = vec3(length(model[0].xyz), length(model[1].xyz), length(model[2].xyz));
    float radius = b.bounding_sphere.w * max(scale.x, max(scale.y, scale.z));

    vec4 planes[6];
    for (int i = 0; i < 6; ++i) planes[i] = shared_planes[i];
    bool frustum_visible = cull_sphere_frustum(planes, center, radius);

    vec2 viewport = vec2(float(viewport_width), float(viewport_height));
    vec3 camera_pos = ubo.camera_position.xyz;

    if (is_second_pass == 0) {
        // First pass: frustum + cone + occlusion against previous frame's Hi-Z
        if (!frustum_visible) return;
        if ((dd.flags & DRAW_FLAG_KEEPS_BACK_FACES) == 0u &&
            cull_cone(b.cone_apex.xyz, b.cone_axis_cutoff.xyz, b.cone_axis_cutoff.w,
                      model, camera_pos)) return;

        bool occluded = cull_hiz_sphere(center, radius, ubo.view, ubo.projection,
                                        camera_pos, viewport, int(hiz_mip_count), hiz_pyramid);
        if (occluded) {
            // Save to culled buffer for second pass retry
            uint culled_slot = atomicAdd(culled_count, 1);
            instances_culled[culled_slot] = inst;
            return;
        }
    } else {
        // Second pass: skip frustum/cone (already passed in first pass),
        // test only against the new Hi-Z pyramid
        bool occluded = cull_hiz_sphere(center, radius, ubo.view, ubo.projection,
                                        camera_pos, viewport, int(hiz_mip_count), hiz_pyramid);
        if (occluded) return;
    }

    // Visible — add to its bin's segment
    uint bin = pipeline_bin[inst.draw_index];
    uvec2 segment = bin_segments[bin];
    uint slot = atomicAdd(cmds[bin * 3], 1);
    if (slot < segment.y) {
        instances_out[segment.x + slot] = inst;
    }
}
