#version 460

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 view;
    mat4 projection;
    vec4 light_direction;
    vec4 light_color;
    vec4 camera_position;
    vec4 ambient_color;
    mat4 cascade_vp[3];
    vec4 cascade_splits;
    uvec4 tile_info;
    mat4 inv_projection;
} ubo;

#include "fjell_draw_data.glsl"

layout(set = 1, binding = 0) readonly buffer DrawDataBuffer {
    DrawData draws[];
};

struct MeshletInstance {
    uint meshlet_index;
    uint draw_index;
};

layout(set = 1, binding = 1) readonly buffer InputInstances {
    MeshletInstance instances_in[];
};

layout(set = 1, binding = 2) readonly buffer InputCounter {
    uint input_count;
};

// Visible output: binned by pipeline, each bin is a segment of segment_size entries
layout(set = 1, binding = 3) writeonly buffer OutputInstances {
    MeshletInstance instances_out[];
};

// Per-bin indirect dispatch commands: [groupCountX, groupCountY, groupCountZ] * N
layout(set = 1, binding = 4) buffer OutputCmds {
    uint cmds[];
};

struct MeshletBounds {
    vec4 bounding_sphere; // xyz = center (local space), w = radius
    vec4 cone_apex;       // xyz = cone apex (local space)
    vec4 cone_axis_cutoff; // xyz = axis, w = cutoff (sin half-angle)
};

layout(set = 1, binding = 5) readonly buffer BoundsBuffer {
    MeshletBounds bounds[];
};

// Per-draw pipeline bin index
layout(set = 1, binding = 6) readonly buffer PipelineBinBuffer {
    uint pipeline_bin[];
};

// Hi-Z depth pyramid for occlusion culling
layout(set = 1, binding = 7) uniform sampler2D hiz_pyramid;

// Per-draw pipeline bin index
layout(set = 1, binding = 8) writeonly buffer CulledInstances {
    MeshletInstance instances_culled[];
};

layout(set = 1, binding = 9) buffer CulledCounter {
    uint culled_count;
};

layout(push_constant) uniform PushConstants {
    uint segment_size;    // max instances per bin
    uint viewport_width;
    uint viewport_height;
    uint hiz_mip_count;
    uint is_second_pass;  // 0 = first pass (prev Hi-Z), 1 = second pass (new Hi-Z)
};

shared vec4 shared_planes[6];

void extract_frustum() {
    mat4 vp = ubo.projection * ubo.view;

    shared_planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0],
                            vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]);
    shared_planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0],
                            vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]);
    shared_planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1],
                            vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]);
    shared_planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1],
                            vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]);
    shared_planes[4] = vec4(vp[0][3] + vp[0][2], vp[1][3] + vp[1][2],
                            vp[2][3] + vp[2][2], vp[3][3] + vp[3][2]);
    shared_planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2],
                            vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]);

    for (int i = 0; i < 6; ++i) {
        float len = length(shared_planes[i].xyz);
        shared_planes[i] /= len;
    }
}

bool sphere_frustum_test(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        if (dot(shared_planes[i].xyz, center) + shared_planes[i].w < -radius) {
            return false;
        }
    }
    return true;
}

bool cone_cull(MeshletBounds b, mat4 model, vec3 camera_pos) {
    // Cone backface culling disabled — causes artifacts on convex surfaces
    // (sphere primitives). Frustum + Hi-Z occlusion culling handle the
    // important cases. Re-enable once two-pass occlusion is in place.
    return false;
}

bool occlusion_cull(vec3 center, float radius) {
    if (hiz_mip_count == 0) return false;

    // Project sphere center to clip space
    vec4 clip = ubo.projection * ubo.view * vec4(center, 1.0);
    if (clip.w <= 0.0) return false; // behind camera

    vec3 ndc = clip.xyz / clip.w;

    // Screen-space radius (pixels) using vertical projection scale
    float screen_radius = (radius * abs(ubo.projection[1][1]) / clip.w)
                          * float(viewport_height) * 0.5;

    // UV-space AABB of the projected sphere
    vec2 uv_center = ndc.xy * 0.5 + 0.5;
    vec2 uv_extent = vec2(screen_radius / float(viewport_width),
                          screen_radius / float(viewport_height));

    vec2 uv_min = uv_center - uv_extent;
    vec2 uv_max = uv_center + uv_extent;

    // If sphere projects partially outside screen, don't cull (conservative)
    if (uv_max.x < 0.0 || uv_min.x > 1.0 || uv_max.y < 0.0 || uv_min.y > 1.0)
        return false;

    uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
    uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));

    // Pick mip where the sphere covers ~1 texel.
    // Hi-Z mip 0 = half-res, so shift by 1.
    float diameter = max(screen_radius * 2.0, 1.0);
    float mip = ceil(log2(diameter)) - 1.0;
    mip = clamp(mip, 0.0, float(hiz_mip_count - 1));

    // Sample Hi-Z at 4 corners of the sphere's screen AABB (conservative max)
    float d0 = textureLod(hiz_pyramid, uv_min, mip).r;
    float d1 = textureLod(hiz_pyramid, vec2(uv_max.x, uv_min.y), mip).r;
    float d2 = textureLod(hiz_pyramid, vec2(uv_min.x, uv_max.y), mip).r;
    float d3 = textureLod(hiz_pyramid, uv_max, mip).r;
    float max_depth = max(max(d0, d1), max(d2, d3));

    // Sphere's nearest depth (conservative: center depth minus radius contribution)
    float sphere_near_z = ndc.z;

    // Occluded if the sphere's nearest point is behind the farthest occluder in the tile
    return sphere_near_z > max_depth;
}

void main() {
    if (gl_LocalInvocationIndex == 0) {
        extract_frustum();
    }
    barrier();

    uint id = gl_GlobalInvocationID.x;
    if (id >= input_count) return;

    MeshletInstance inst = instances_in[id];
    MeshletBounds b = bounds[inst.meshlet_index];
    DrawData dd = draws[inst.draw_index];
    mat4 model = dd.model;

    // Transform bounding sphere to world space
    vec3 center = (model * vec4(b.bounding_sphere.xyz, 1.0)).xyz;
    vec3 scale = vec3(length(model[0].xyz), length(model[1].xyz), length(model[2].xyz));
    float radius = b.bounding_sphere.w * max(scale.x, max(scale.y, scale.z));

    bool frustum_visible = sphere_frustum_test(center, radius);

    if (is_second_pass == 0) {
        // First pass: frustum + cone + occlusion against previous frame's Hi-Z
        if (!frustum_visible) return;
        if (cone_cull(b, model, ubo.camera_position.xyz)) return;

        bool occluded = occlusion_cull(center, radius);
        if (occluded) {
            // Save to culled buffer for second pass retry
            uint culled_slot = atomicAdd(culled_count, 1);
            instances_culled[culled_slot] = inst;
            return;
        }
    } else {
        // Second pass: skip frustum/cone (already passed in first pass),
        // test only against the new Hi-Z pyramid
        bool occluded = occlusion_cull(center, radius);
        if (occluded) return;
    }

    // Visible — add to binned output
    uint bin = pipeline_bin[inst.draw_index];
    uint slot = atomicAdd(cmds[bin * 3], 1);
    if (slot < segment_size) {
        instances_out[bin * segment_size + slot] = inst;
    }
}
