shader_type fog;

// The engine's default for the body of a water: what a camera under the
// surface, or an eye looking down into it, sees between itself and the bed.
// Clear water that blues and darkens with distance, and darker the deeper the
// point lies under the surface. A body of water names a .fjmat with this
// shader as its Medium, and tunes it there.
//
// OCCUPANCY is one throughout: which froxels are water at all is decided
// from the surface, not by this shader. ORIGIN is the water node, whose y is
// the surface at rest.

// How much of the light the water takes, in the fog's unit: a tenth per
// metre, so 1.5 is an extinction of 0.15 a metre and about twenty metres of
// visibility, clear coastal water. Open sea is nearer 1, a harbour 3, a
// silted river past 6. The haze's own dial is in the same unit, which is why
// the range here runs so much higher than a fog's.
uniform float density : hint_range(0.0, 12.0, 0.01) = 1.5;
// The colour the water scatters toward the eye.
uniform vec3 color : hint_color = vec3(0.16, 0.46, 0.56);
// How brightly it scatters, at the same thickness.
uniform float scattering : hint_range(0.0, 4.0, 0.01) = 1.0;
// How fast the light gives out with depth below the surface, per metre. The
// deep is dark because the sun has already been through the water above it.
uniform float depth_darkening : hint_range(0.0, 1.0, 0.005) = 0.04;

void density() {
    float below = max(ORIGIN.y - WORLD_POS.y, 0.0);
    DENSITY = density;
    COLOR = color * exp(-below * depth_darkening);
    SCATTERING = scattering;
}
