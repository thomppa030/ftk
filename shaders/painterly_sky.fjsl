shader_type sky;

// Animated noise cloud bands modulated by sun direction. Exercises TIME,
// SUN_DIR, and VIEW_DIR together. Looks closer to Wind Waker / Genshin
// than to physical atmospheric scattering.

uniform vec3 sky_color : hint_color = vec3(0.4, 0.6, 0.9);
uniform vec3 cloud_color : hint_color = vec3(1.0, 0.95, 0.9);
uniform float cloud_density : hint_range(0.0, 1.0, 0.01) = 0.55;
uniform float cloud_scale : hint_range(0.5, 8.0, 0.1) = 2.4;
uniform float cloud_speed : hint_range(0.0, 1.0, 0.01) = 0.05;
uniform float sun_glow : hint_range(0.0, 4.0, 0.05) = 1.5;

// Cheap 2D value noise + fbm. The user-globals extractor preserves these.
float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash21(i + vec2(0.0, 0.0)), hash21(i + vec2(1.0, 0.0)), u.x),
        mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), u.x),
        u.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        p *= 2.0;
        a *= 0.5;
    }
    return v;
}

void sky() {
    // Background gradient skewed by SUN_DIR so the horizon warms near the sun.
    float t = clamp(VIEW_DIR.y * 0.5 + 0.5, 0.0, 1.0);
    float warmth = clamp(dot(VIEW_DIR, SUN_DIR) * 0.5 + 0.5, 0.0, 1.0);
    SKY = mix(sky_color * 0.85, sky_color, t);
    SKY = mix(SKY, SUN_COLOR * 0.4, warmth * (1.0 - t) * 0.5);

    // Cloud band: project view dir into a panorama, sample fbm scrolled by TIME.
    if (VIEW_DIR.y > 0.05) {
        vec2 pan = vec2(atan(VIEW_DIR.z, VIEW_DIR.x), VIEW_DIR.y);
        vec2 uv = pan * cloud_scale + vec2(TIME * cloud_speed, 0.0);
        float n = fbm(uv);
        float cover = smoothstep(1.0 - cloud_density, 1.0, n);
        SKY = mix(SKY, cloud_color, cover * smoothstep(0.05, 0.4, VIEW_DIR.y));
    }

    // Sun glow blooms through the painterly clouds.
    float sun_dot = max(dot(VIEW_DIR, SUN_DIR), 0.0);
    SKY += SUN_COLOR * pow(sun_dot, 16.0) * sun_glow;
}
