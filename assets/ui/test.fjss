/* Game HUD test stylesheet */

#hud {
    flex-direction: column;
    justify-content: space-between;
    padding: 16;
    color: white;
    font-size: 14;
}

.health-bar-container {
    align-self: flex-start;
    width: 200;
    padding: 4;
    gap: 4;
}

.label {
    height: 18;
    color: #cccccc;
}

.health-bar-bg {
    width: 200;
    height: 20;
    background-color: #333333;
    border-radius: 4;
    border: 1 solid #666666;
    box-shadow: 0 2 8 0 rgba(0, 0, 0, 0.4);
}

.health-bar-fill {
    width: 140;
    height: 20;
    background: linear-gradient(90deg, #22aa22, #66dd44);
    border-radius: 4;
}

.bottom-panel {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 8;
    padding: 8;
}

.slot {
    width: 48;
    height: 48;
    background-color: rgba(34, 34, 34, 0.8);
    border-radius: 6;
    border: 2 solid #555555;
    box-shadow: 0 2 6 0 rgba(0, 0, 0, 0.3);
}

.active {
    border-color: #d4a054;
    background: linear-gradient(180deg, #444444, #333333);
    box-shadow: 0 2 8 0 rgba(212, 160, 84, 0.3);
}
