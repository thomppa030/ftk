<widget style="test.fjss">
    <prop name="player.health" type="string" default="100"/>
    <prop name="player.max_health" type="string" default="100"/>
    <prop name="show_debug" type="bool" default="0"/>
    <prop name="fps" type="string" default="60"/>
    <prop name="player.pos" type="string" default="0, 0, 0"/>
    <prop name="active_slot" type="string" default="1"/>

    <panel id="hud" class="overlay">
        <div class="health-bar-container">
            <text class="label">HP: {player.health} / {player.max_health}</text>
            <div class="health-bar-bg">
                <bar class="health-bar-fill" value="{player.health}" max="{player.max_health}"/>
            </div>
        </div>

        <div class="debug-info" if="show_debug">
            <text class="fps-display">FPS: {fps}</text>
            <text class="debug-text">Pos: {player.pos}</text>
        </div>

        <div class="bottom-panel">
            <div class="slot" on:click="select_slot_1" class:active="active_slot==1">
                <div class="slot-icon" src="assets/textures/test.png"/>
            </div>
            <div class="slot" on:click="select_slot_2" class:active="active_slot==2">
                <div class="slot-icon" material="default"/>
            </div>
            <div class="slot" on:click="select_slot_3" class:active="active_slot==3">
                <div class="slot-icon" material="ui_amber"/>
            </div>
            <div class="slot" on:click="select_slot_4" class:active="active_slot==4"/>
        </div>
    </panel>
</widget>
