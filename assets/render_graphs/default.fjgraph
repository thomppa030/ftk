// Default render pipeline — port of pass_setup.cpp::create_all_passes.
// Adding a pass = implement the C++ behavior + add a line here.
//
// Resources block is parsed but informational in v1; per-pass declare()
// drives DAG topology. Fully wired in Step 6 (buffer tracking).
{
    "name": "default",
    "resources": {},

    "passes": [
        // ── Core geometry ──────────────────────────────────────────────
        { "class": "DepthPrePass",     "name": "depth_prepass" },
        { "class": "DepthResolvePass", "name": "depth_resolve" },
        { "class": "HizPass",          "name": "hiz" },
        { "class": "InstanceCullPass", "name": "instance_cull" },
        { "class": "TerrainPass",      "name": "terrain" },

        // ── Mesh shader / GPU-driven cull ────────────────────────────────
        // Skipped on a device without VK_EXT_mesh_shader: their pipelines
        // use mesh/task shader stages, which fails pipeline creation
        // outright rather than degrading at draw time.
        { "class": "MeshletInstancePass", "name": "meshlet_cull",       "enabled_if": "mesh_shaders" },
        { "class": "MeshletCullPass2",    "name": "meshlet_cull_pass2", "enabled_if": "mesh_shaders" },
        { "class": "MeshShaderDepthPass", "name": "mesh_shader_depth",  "enabled_if": "mesh_shaders" },
        { "class": "MeshletVizPass",      "name": "meshlet_viz",        "enabled_if": "mesh_shaders" },
        { "class": "CullVizPass",         "name": "cull_viz",           "enabled_if": "mesh_shaders" },
        // Plain compute, no mesh-shader dependency; currently unused by any
        // caller (kept alive from an earlier occlusion-culling attempt).
        { "class": "CullPass",            "name": "cull" },

        // ── Shadow ─────────────────────────────────────────────────────
        { "class": "ShadowPass",       "name": "shadow" },
        { "class": "LocalShadowPass",  "name": "local_shadows" },

        // ── Debug / visualization ──────────────────────────────────────
        { "class": "DepthVizPass",     "name": "depth_viz" },
        { "class": "DebugPass",        "name": "debug" },
        { "class": "GridPass",         "name": "grid" },
        { "class": "WireframePass",    "name": "wireframe" },
        { "class": "NormalPass",       "name": "normals" },
        { "class": "OverdrawPass",     "name": "overdraw" },
        { "class": "UvVizPass",        "name": "uv_viz" },

        // ── Bloom (5 downsample + 4 upsample) ──────────────────────────
        // BloomDs0Pass IS the BloomCore (shared sampler, layouts, pipelines).
        // BloomDsPass(mip_index) and BloomUsPass(dst_mip) look up the core
        // by name in their post_create().
        { "class": "BloomDs0Pass",     "name": "bloom_ds_0" },
        { "class": "BloomDsPass",      "name": "bloom_ds_1", "params": { "mip_index": 1 } },
        { "class": "BloomDsPass",      "name": "bloom_ds_2", "params": { "mip_index": 2 } },
        { "class": "BloomDsPass",      "name": "bloom_ds_3", "params": { "mip_index": 3 } },
        { "class": "BloomDsPass",      "name": "bloom_ds_4", "params": { "mip_index": 4 } },
        { "class": "BloomUsPass",      "name": "bloom_us_3", "params": { "dst_mip": 3 } },
        { "class": "BloomUsPass",      "name": "bloom_us_2", "params": { "dst_mip": 2 } },
        { "class": "BloomUsPass",      "name": "bloom_us_1", "params": { "dst_mip": 1 } },
        { "class": "BloomUsPass",      "name": "bloom_us_0", "params": { "dst_mip": 0 } },

        // ── Sky ────────────────────────────────────────────────────────
        { "class": "SkyPass",          "name": "sky" },
        { "class": "SkyCubemapPass",   "name": "sky_cubemap" },

        // ── Color ──────────────────────────────────────────────────────
        { "class": "WaterPass",           "name": "water" },
        { "class": "TransparentPass",     "name": "transparent" },
        { "class": "OpaquePass",          "name": "opaque" },
        { "class": "ScreenColorCopyPass", "name": "screen_color_copy" },
        { "class": "DistortionPass",      "name": "distortion" },
        { "class": "DistortionApplyPass", "name": "distortion_apply" },
        { "class": "SubsystemComputePass","name": "subsystem_compute" },
        { "class": "TaaResolvePass",      "name": "taa_resolve" },
        { "class": "ExposurePass",        "name": "exposure" },
        { "class": "TonemapPass",         "name": "tonemap" },

        // ── Screen-space effects ───────────────────────────────────────
        { "class": "GtaoTracePass",    "name": "ao_trace" },
        { "class": "AoBlurHPass",      "name": "ao_blur_h" },
        { "class": "AoBlurVPass",      "name": "ao_blur_v" },
        { "class": "SsrTracePass",     "name": "ssr_trace" },
        { "class": "RtReflectionPass", "name": "rt_reflection" },
        { "class": "SsrCompositePass", "name": "ssr_composite" },
        { "class": "FogInjectPass",    "name": "fog_inject" },
        { "class": "FogTemporalPass",  "name": "fog_temporal" },
        { "class": "FogIntegratePass", "name": "fog_integrate" },
        { "class": "FogCompositePass", "name": "fog_composite" },
        { "class": "SunShaftsPass",    "name": "sun_shafts" },
        { "class": "SunShaftsResolvePass",   "name": "sun_shafts_resolve" },
        { "class": "SunShaftsCompositePass", "name": "sun_shafts_composite" },
        { "class": "ContactShadowPass","name": "contact_shadow" },
        { "class": "CloudShadowPass",  "name": "cloud_shadow" },
        { "class": "MotionFieldPass",  "name": "motion_field" },
        { "class": "FogDensityFieldPass", "name": "fog_density_field" },
        { "class": "WaterFftPass",     "name": "water_fft" },
        { "class": "DdgiPass",         "name": "ddgi" },
        { "class": "SsGiPass",         "name": "ss_gi" },

        // ── Forward+ lighting ──────────────────────────────────────────
        { "class": "LightCullPass",    "name": "light_cull" },
        { "class": "LightVizPass",     "name": "light_heatmap", "params": { "mode": 0 } },
        { "class": "LightVizPass",     "name": "light_grid",    "params": { "mode": 1 } },

        // ── Scene SDF ──────────────────────────────────────────────────
        { "class": "SceneSdfPass",     "name": "scene_sdf" }
    ]
}
