{
    "version": 6,
    "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug",
            "description": "Validation layers, shader and script hot-reload.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "Debug + ASan/UBSan",
            "description": "Debug build with AddressSanitizer + UndefinedBehaviorSanitizer for chasing memory corruption and lifetime bugs. UBSan's vptr check is off: it needs the type info of every polymorphic class the code reaches, which the test library, a part of the engine, does not link. Reuses the debug preset's imgui checkout, so configure `debug` first. GCC/Clang only.",
            "binaryDir": "${sourceDir}/build-asan",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=vptr -fno-omit-frame-pointer -fno-sanitize-recover=all -g",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "FETCHCONTENT_SOURCE_DIR_IMGUI": "${sourceDir}/build/_deps/imgui-src"
            }
        },
        {
            "name": "tracy",
            "inherits": "base",
            "displayName": "Release + Tracy",
            "description": "RelWithDebInfo build with the Tracy profiler client enabled, for capturing real-timing frame traces (plain Debug is too slow to profile meaningfully).",
            "binaryDir": "${sourceDir}/build-tracy",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "FJELL_ENABLE_TRACY": "ON"
            }
        },
        {
            "name": "libraries",
            "inherits": "base",
            "displayName": "Libraries only",
            "description": "ftk's libraries without the engine, tools or tests, as another program's build gets them. Reuses the debug preset's fetched sources, so configure `debug` first; a foundation dependency not listed here is fetched again.",
            "binaryDir": "${sourceDir}/build-libraries",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FJELL_BUILD_ENGINE": "OFF",
                "FETCHCONTENT_SOURCE_DIR_SDL3": "${sourceDir}/build/_deps/sdl3-src",
                "FETCHCONTENT_SOURCE_DIR_GLM": "${sourceDir}/build/_deps/glm-src",
                "FETCHCONTENT_SOURCE_DIR_SPDLOG": "${sourceDir}/build/_deps/spdlog-src",
                "FETCHCONTENT_SOURCE_DIR_STB": "${sourceDir}/build/_deps/stb-src",
                "FETCHCONTENT_SOURCE_DIR_JSON": "${sourceDir}/build/_deps/json-src",
                "FETCHCONTENT_SOURCE_DIR_TRACY": "${sourceDir}/build/_deps/tracy-src",
                "FETCHCONTENT_SOURCE_DIR_IMGUI": "${sourceDir}/build/_deps/imgui-src",
                "FETCHCONTENT_SOURCE_DIR_VULKANMEMORYALLOCATOR": "${sourceDir}/build/_deps/vulkanmemoryallocator-src",
                "FETCHCONTENT_SOURCE_DIR_SPIRV_CROSS": "${sourceDir}/build/_deps/spirv_cross-src"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "tracy",
            "configurePreset": "tracy"
        },
        {
            "name": "libraries",
            "configurePreset": "libraries"
        }
    ]
}
