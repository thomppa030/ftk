+void ImGui::BeginHorizontal(const char* str_id, const ImVec2& size, float align)
+{
+    ImGuiWindow* window = GetCurrentWindow();
+    ImGui_BeginLayout(window->GetID(str_id), ImGuiLayoutType_Horizontal, size, align);
+}
