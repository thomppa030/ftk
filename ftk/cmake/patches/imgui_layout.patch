+void ImGui::BeginHorizontal(const void* ptr_id, const ImVec2& size, float align)
+{
+    ImGuiWindow* window = GetCurrentWindow();
+    ImGui_BeginLayout(window->GetID(ptr_id), ImGuiLayoutType_Horizontal, size, align);
+}
