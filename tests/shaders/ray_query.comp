#version 460
#extension GL_EXT_ray_query : require

// Two rays at one triangle, for tests/library_link/gpu.cpp and
// tests/test_gpu_shader.cpp: the first through its middle, the second well
// clear of it. Each writes whether it hit, and the custom index of the
// instance it hit.

layout(local_size_x = 2, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) writeonly buffer Hits { uint hits[]; } hits_out;

void main() {
    const uint ray = gl_LocalInvocationIndex;
    // The triangle lies in the plane z = 0 around the origin.
    const vec3 origin = ray == 0u ? vec3(0.0, 0.0, -1.0) : vec3(5.0, 5.0, -1.0);
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0,
                          vec3(0.0, 0.0, 1.0), 10.0);
    while (rayQueryProceedEXT(query)) {}
    const bool hit = rayQueryGetIntersectionTypeEXT(query, true) ==
                     gl_RayQueryCommittedIntersectionTriangleEXT;
    hits_out.hits[ray * 2u] = hit ? 1u : 0u;
    hits_out.hits[ray * 2u + 1u] = hit ? rayQueryGetIntersectionInstanceCustomIndexEXT(query, true) : 0u;
}
