#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Declares one binding of every kind, for tests/test_gpu_shader.cpp.

layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Params { vec4 tint; } params;
layout(set = 1, binding = 0) uniform sampler2D source;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D target;
layout(set = 2, binding = 0) readonly buffer Items { uint items[]; };
layout(set = 2, binding = 1) buffer Counts { uint counts[]; } counts_out;
layout(set = 3, binding = 0) uniform texture2D plain;
layout(set = 3, binding = 1) uniform sampler pointy;
layout(set = 4, binding = 0) uniform sampler2D textures[];
layout(set = 4, binding = 1) uniform sampler2D pair[2];

layout(push_constant) uniform Push {
    vec2 offset;
    uint index;
    uint pad;
} push;

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    vec4 value = texture(source, vec2(at) + push.offset) * params.tint;
    value += texture(sampler2D(plain, pointy), vec2(0.5));
    value += texture(textures[nonuniformEXT(push.index)], vec2(0.5));
    value += texture(pair[1], vec2(0.5));
    counts_out.counts[at.x] = items[at.y];
    imageStore(target, at, value);
}
